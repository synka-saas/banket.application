# Banco de dados (PostgreSQL)
# Dono das tabelas: executa migrations e fluxos de sistema (login, cadastro, convites)
POSTGRES_USER=banket_user
POSTGRES_PASSWORD=banket_pass
POSTGRES_DB=banket_db

# Papel usado pela aplicação: sem superuser e sujeito ao RLS (criado pelo scripts/migrate.mjs)
APP_DB_USER=banket_app
APP_DB_PASSWORD=banket_app_pass

# Fora do Docker (ex.: npm run dev no host), aponte para localhost:
# DATABASE_URL=postgres://banket_app:banket_app_pass@localhost:5432/banket_db
# DATABASE_URL_SYSTEM=postgres://banket_user:banket_pass@localhost:5432/banket_db

# Sessão: gere com `openssl rand -base64 48`
JWT_SECRET=

# URL pública da aplicação (links em e-mails)
APP_URL=http://localhost:4321

# Portas do host em produção (deploy blue-green, docker-compose.prod.yml): uma por cor, em 127.0.0.1, atrás do Nginx
APP_PORT_BLUE=5168
APP_PORT_GREEN=5169

# E-mail (Resend). Sem chave, os e-mails são apenas registrados no log.
RESEND_API_KEY=
# Inbox: domínio que recebe as respostas dos clientes (MX → Resend; vazio = respostas vão para o e-mail do usuário).
# A RESEND_API_KEY precisa ser de acesso completo (uma chave "sending only" não lê os e-mails recebidos)
# e segredo de assinatura do webhook https://app.banket.com.br/api/webhooks/resend (whsec_…)
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=Banket <nao-responda@banket.com.br>

# WhatsApp (Cloud API da Meta): avisos às empresas do Perfil Personalizado. Token permanente de usuário do sistema
# (whatsapp_business_messaging + whatsapp_business_management), id do número, id da conta (WABA), App Secret (assinatura
# do webhook https://app.banket.com.br/api/webhooks/whatsapp) e um token de verificação escolhido por você.
# Templates: node scripts/whatsapp-templates.mjs. Sem token/número, os avisos só vão para o log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# Cobrança da assinatura (Stripe, mesmo modelo do Yosp): chave secreta (sk_/rk_), segredo do webhook
# https://app.banket.com.br/api/webhooks/stripe (whsec_…) e versão fixa da API. Sem chave, "Assinar" vira "Falar com a equipe".
# Produtos e preços: node scripts/stripe-bootstrap.mjs (grava os ids em planos.stripe_*).
# Stripe: STRIPE_AMBIENTE=dev (sandbox, padrão) ou prod escolhe o par de chaves abaixo
STRIPE_AMBIENTE=dev
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_SECRET_DEV=
STRIPE_SECRET_KEY_PROD=
STRIPE_WEBHOOK_SECRET_PROD=
STRIPE_API_VERSION=
STRIPE_PIX_EXPIRES_SECONDS=

# IA (OpenAI): sugestões de fontes e cores do template a partir do logotipo. Sem chave, os botões de IA avisam que não está configurado.
OPENAI_TOKEN=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# Diretório de uploads (logos, imagens de template, PDFs)
UPLOAD_DIR=./uploads

# Integração com o Manager Hwesta (HCP, ver INTEGRACAO_HWESTA.md). As chaves são geradas no registro da
# plataforma no Manager; sem elas, as rotas /api/hwesta respondem 503 e a tela de Suporte fica indisponível.
HWESTA_APP_ID=banket
HWESTA_MANAGER_URL=http://hwesta_manager:4329
HWESTA_APP_KEY=
HWESTA_MANAGER_KEY=

# Login com o Google e reuniões com Google Meet (Google Calendar). No Google Cloud: crie um cliente OAuth 2.0
# "Aplicativo da Web", ative a API Google Calendar e cadastre a URI de redirecionamento
# ${APP_URL}/auth/google/callback. Sem as chaves, o botão "Entrar com o Google" e o agendamento ficam ocultos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: só se a URI de redirecionamento for diferente de ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# Agendador do app (rebaixamento e avisos do teste grátis). 1 = desligado neste processo.
# BANKET_SEM_AGENDADOR=

# Banket Busca: endereço público da vitrine (vazio em dev: a vitrine fica em APP_URL/vitrine)
BUSCA_URL=
# Ranking (rankeamento.md): pesos da relevância e regras do bônus/destaques (JSON parcial; vazio = padrão)
# BUSCA_RANKING_PESOS={"distancia":0.3,"avaliacao":0.25,"completude":0.2,"resposta":0.15,"atividade":0.1}
# BUSCA_RANKING_REGRAS={"bonus_pago":0.15,"vagas_destaque":3,"relevancia_minima_destaque":0.4,"max_pagos_seguidos":3,"empate":0.03}
# DB_POOL_VITRINE=6

# Domínio dos cookies de sessão (produção: .banket.com.br): a sessão vale em app. e em busca. Vazio = só o host atual.
COOKIE_DOMAIN=

# Banket Busca: e-mails da equipe (separados por vírgula) que analisam as reivindicações de perfil em
# /equipe/reivindicacoes e recebem o aviso de cada pedido
BANKET_EQUIPE_EMAILS=

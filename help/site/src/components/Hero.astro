---
// Cabeçalho do protótipo, na faixa terracota sólida do Banket. Na home mostra o título grande.
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class="hero" data-noprint>
  <div class="container hero-inner">
    <nav class="hero-nav" aria-label="Principal">
      <a href={base} class="hero-brand">
        <Logo variant="light" height={28} />
        <span class="hero-sep" aria-hidden="true"></span>
        <span class="hero-brand-label">Central de Ajuda</span>
      </a>
      <div class="hero-actions">
        <a href="#suporte" class="hero-link">Fale com o suporte</a>
        <a href="/" class="btn btn-secondary">Voltar para a plataforma<Icon name="arrow-up-right" size={16} /></a>
      </div>
    </nav>
    {home && (
      <div class="hero-title">
        <h1>Como podemos ajudar?</h1>
        <p>Guias passo a passo para usar cada módulo do Banket, da captação do pedido ao pós-evento.</p>
      </div>
    )}
  </div>
</header>

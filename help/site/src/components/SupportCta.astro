---
// Bloco "Não encontrou o que procurava?" do protótipo (âncora #suporte).
import IconTile from './IconTile.astro';
import Icon from './Icon.astro';

const EMAIL = 'contato@yosp.app';
---
<section id="suporte" class="support" data-noprint>
  <IconTile icon="message-square-text" size={48} />
  <div class="support-text">
    <span class="support-title">Não encontrou o que procurava?</span>
    <span class="support-desc">Fale com nossa equipe pelo e-mail ou pela área Suporte do painel. Tenha em mãos o ID da sua conta, em Minha conta › Dados da conta.</span>
  </div>
  <div class="support-btns">
    <a class="btn btn-secondary btn-lg" href={`mailto:${EMAIL}`}><Icon name="mail" size={20} />{EMAIL}</a>
    <a class="btn btn-primary btn-lg" href="/account/support"><Icon name="message-square-text" size={20} />Falar com o suporte</a>
  </div>
</section>

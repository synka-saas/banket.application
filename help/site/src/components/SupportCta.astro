---
// Bloco "Não encontrou o que procurava?" do protótipo (âncora #suporte): leva ao menu Suporte do app.
import IconTile from './IconTile.astro';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
---
<section id="suporte" class="support" data-noprint>
  <IconTile icon="headset" size={48} />
  <div class="support-text">
    <span class="support-title">Não encontrou o que procurava?</span>
    <span class="support-desc">Abra um chamado no menu Suporte do Banket. Nossa equipe responde por lá e você acompanha a conversa no mesmo lugar.</span>
  </div>
  <div class="support-btns">
    <a class="btn btn-secondary btn-lg" href={`${base}suporte/abrir-chamado/`}><Icon name="book" size={18} />Como abrir um chamado</a>
    <a class="btn btn-primary btn-lg" href="/suporte"><Icon name="headset" size={18} />Falar com o suporte</a>
  </div>
</section>

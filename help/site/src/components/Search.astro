---
// Busca com dropdown de resultados (protótipo), alimentada pelo índice do Pagefind
// gerado depois do build (dist/pagefind). O índice fica atrás do login: na home
// pública, quem não entrou recebe o convite para entrar.
import Icon from './Icon.astro';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="container search-wrap" data-noprint>
  <div class="search" data-home={home ? '' : undefined} data-search data-base={base}>
    <label class="search-field">
      <span class="sr-only">Buscar na central de ajuda</span>
      <Icon name="search" size={18} />
      <input type="search" placeholder="Busque por agendamento, checklist, prestador…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" data-search-input />
      <button type="button" class="search-clear" aria-label="Limpar busca" hidden data-search-clear><Icon name="x" size={18} /></button>
    </label>
    <div class="search-drop" id="search-results" role="listbox" hidden data-search-drop></div>
  </div>
</div>

<script>
  type PagefindResult = { data: () => Promise<{ url: string; meta: Record<string, string> }> };
  type Pagefind = {
    options: (o: object) => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: PagefindResult[] } | null>;
  };

  const ICON_FILE = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:block"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const plural = (n: number, s: string, p: string) => `${n} ${n === 1 ? s : p}`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const base = root.dataset.base || '/ajuda/';
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const drop = root.querySelector<HTMLElement>('[data-search-drop]')!;
    let pagefind: Promise<Pagefind | 'login' | 'off'> | null = null;
    let active = -1;

    const load = () =>
      (pagefind ??= (async () => {
        const url = `${base}pagefind/pagefind.js`;
        try {
          const pf: Pagefind = await import(/* @vite-ignore */ url);
          await pf.options({ baseUrl: base });
          return pf;
        } catch {
          // 401 = índice protegido e sem sessão; qualquer outra falha = índice indisponível (ex.: npm run dev).
          try {
            const r = await fetch(url, { method: 'HEAD', credentials: 'same-origin' });
            return r.status === 401 ? 'login' : 'off';
          } catch { return 'off'; }
        }
      })());

    const open = (html: string) => {
      drop.innerHTML = html;
      drop.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      active = -1;
    };
    const close = () => {
      drop.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    const message = (title: string, desc: string) =>
      `<div class="search-empty"><strong>${title}</strong><span>${desc}</span></div>`;

    async function run() {
      const q = input.value.trim();
      clear.hidden = !input.value;
      if (q.length < 2) return close();
      const pf = await load();
      if (pf === 'login') {
        return open(message('Entre para buscar nos artigos', `A busca é exclusiva para clientes Yosp. <a href="${base}entrar/">Entrar na sua conta</a>`));
      }
      if (pf === 'off') {
        return open(message('Busca indisponível no momento', 'Navegue pelas categorias ou tente de novo em instantes.'));
      }
      const search = await pf.debouncedSearch(q, {}, 150);
      if (!search || input.value.trim() !== q) return;
      if (!search.results.length) {
        return open(message(`Nenhum artigo encontrado para “${esc(q)}”`, 'Tente outras palavras ou navegue pelas categorias.'));
      }
      const items = await Promise.all(search.results.slice(0, 6).map((r) => r.data()));
      open(
        `<span class="search-label">${plural(search.results.length, 'artigo encontrado', 'artigos encontrados')}</span>` +
          items
            .map(
              (d, i) =>
                `<a class="search-result" role="option" id="search-opt-${i}" href="${esc(d.url)}">` +
                `<span class="search-result-icon">${ICON_FILE}</span>` +
                `<span class="search-result-text"><span class="search-result-title">${esc(d.meta.title || '')}</span>` +
                `<span class="search-result-cat">${esc(d.meta.cat || '')}</span></span></a>`,
            )
            .join(''),
      );
    }

    input.addEventListener('input', run);
    input.addEventListener('focus', () => { if (input.value.trim().length >= 2) run(); });
    input.addEventListener('keydown', (e) => {
      const opts = [...drop.querySelectorAll<HTMLAnchorElement>('.search-result')];
      if (e.key === 'Escape') { close(); return; }
      if (!opts.length || drop.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + opts.length) % opts.length;
        opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
        input.setAttribute('aria-activedescendant', opts[active].id);
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        window.location.href = opts[Math.max(active, 0)].href;
      }
    });
    clear.addEventListener('click', () => { input.value = ''; clear.hidden = true; close(); input.focus(); });
    document.addEventListener('mousedown', (e) => { if (!root.contains(e.target as Node)) close(); });
  }
</script>

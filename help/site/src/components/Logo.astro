---
// Logotipo do Banket (mesmos arquivos de public/ do app): "light" = texto branco, para o cabeçalho terracota.
interface Props { variant?: 'light' | 'dark'; height?: number }
const { variant = 'dark', height = 32 } = Astro.props;
const base = import.meta.env.BASE_URL;
// Proporção dos PNGs: 1200 × 315
const width = Math.round((height * 1200) / 315);
---
<img src={`${base}logo-${variant}.png`} alt="Banket" width={width} height={height} style="display:block;flex:none" />

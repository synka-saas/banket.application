---
// Página de artigo (tela "Artigo" do protótipo): card com título, resumo e metadados,
// conteúdo do Markdown, "Este artigo foi útil?", anterior/próximo e aside com
// sumário ("Nesta página") e os demais artigos da categoria.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import { getCategories, formatDate, type Category, type Article } from '../../lib/content';

export async function getStaticPaths() {
  const cats = await getCategories();
  return cats.flatMap((cat) =>
    cat.articles.map((article, i) => ({
      params: { categoria: cat.slug, artigo: article.slug },
      props: { cat, article, prev: cat.articles[i - 1] ?? null, next: cat.articles[i + 1] ?? null },
    })),
  );
}

interface Props { cat: Category; article: Article; prev: Article | null; next: Article | null }
const { cat, article, prev, next } = Astro.props;
const { Content, headings } = await render(article.entry);
const toc = headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL;
---
<Base title={article.title} description={article.description}>
  <div class="crumb-row">
    <Breadcrumb items={[{ label: 'Central de ajuda', href: base }, { label: cat.title, href: cat.url }, { label: article.title }]} />
    <div class="art-actions" data-noprint>
      <span class="copied" hidden data-copied>Link copiado</span>
      <button type="button" class="icon-btn" aria-label="Copiar link" title="Copiar link" data-copy><Icon name="link" size={18} /></button>
      <button type="button" class="icon-btn" aria-label="Imprimir" title="Imprimir" data-print><Icon name="printer" size={18} /></button>
    </div>
  </div>

  <section class="art-section">
    <div class="art-main">
      <div class="card art-card">
        <article class="art" data-pagefind-body>
          <h1 class="art-title" data-pagefind-meta="title">{article.title}</h1>
          {article.description && <p class="art-ex">{article.description}</p>}
          <div class="art-meta">
            <span class="badge" data-pagefind-meta="cat">{cat.title}</span>
            <span class="art-meta-item" data-pagefind-ignore><Icon name="clock" size={14} />{article.minutes} min de leitura</span>
            <span class="art-meta-item" data-pagefind-ignore><Icon name="calendar" size={14} />Atualizado em {formatDate(article.updatedAt)}</span>
          </div>
          <div class="prose">
            <Content />
          </div>
          <div class="art-feedback" data-noprint data-pagefind-ignore data-feedback>
            <span class="art-feedback-q" data-fb-ask>Este artigo foi útil?</span>
            <div class="art-feedback-btns" data-fb-ask>
              <button type="button" class="btn btn-secondary btn-sm" data-fb="sim"><Icon name="thumbs-up" size={16} />Sim</button>
              <button type="button" class="btn btn-secondary btn-sm" data-fb="nao"><Icon name="thumbs-down" size={16} />Não</button>
            </div>
            <span class="art-feedback-done" hidden data-fb-done><Icon name="circle-check" size={18} /><span data-fb-text></span></span>
          </div>
        </article>
      </div>

      <nav class="pn" aria-label="Artigos da categoria" data-noprint>
        {prev ? (
          <a href={prev.url} class="pn-link">
            <span class="pn-dir"><Icon name="arrow-left" size={14} />Anterior</span>
            <span class="pn-title">{prev.title}</span>
          </a>
        ) : <span class="pn-spacer"></span>}
        {next ? (
          <a href={next.url} class="pn-link" data-next>
            <span class="pn-dir">Próximo<Icon name="arrow-right" size={14} /></span>
            <span class="pn-title">{next.title}</span>
          </a>
        ) : <span class="pn-spacer"></span>}
      </nav>
    </div>

    <aside class="art-aside" data-noprint>
      {toc.length > 1 && (
        <div class="aside-block toc-block">
          <span class="aside-title">Nesta página</span>
          <nav class="toc" aria-label="Nesta página" data-toc>
            {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </div>
      )}
      <div class="aside-block">
        <span class="aside-title">{cat.title}</span>
        <nav class="siblings" aria-label={cat.title}>
          {cat.articles.map((a) => (a.id === article.id ? <span aria-current="page">{a.title}</span> : <a href={a.url}>{a.title}</a>))}
        </nav>
      </div>
    </aside>
  </section>
</Base>

<script>
  // Copiar link e imprimir
  const copied = document.querySelector<HTMLElement>('[data-copied]');
  let timer: number | undefined;
  document.querySelector('[data-copy]')?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(window.location.href.split('#')[0]); } catch { /* sem permissão: ignora */ }
    if (copied) { copied.hidden = false; clearTimeout(timer); timer = window.setTimeout(() => (copied.hidden = true), 2000); }
  });
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // "Este artigo foi útil?" (só retorno visual, como no protótipo)
  const fb = document.querySelector<HTMLElement>('[data-feedback]');
  fb?.querySelectorAll<HTMLButtonElement>('[data-fb]').forEach((btn) =>
    btn.addEventListener('click', () => {
      fb.querySelectorAll<HTMLElement>('[data-fb-ask]').forEach((el) => (el.hidden = true));
      const done = fb.querySelector<HTMLElement>('[data-fb-done]')!;
      done.querySelector('[data-fb-text]')!.textContent = btn.dataset.fb === 'sim'
        ? 'Obrigado pelo retorno.'
        : 'Obrigado. Se ainda precisar de ajuda, fale com nossa equipe abaixo.';
      done.hidden = false;
    }),
  );

  // Sumário: rolagem suave e destaque da seção visível
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    links.forEach((a) => a.addEventListener('click', (e) => {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (!el) return;
      e.preventDefault();
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 24, behavior: 'smooth' });
      history.replaceState(null, '', a.hash);
    }));
    const mark = () => {
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top <= 80) current = t;
      links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === current?.id)));
    };
    window.addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>

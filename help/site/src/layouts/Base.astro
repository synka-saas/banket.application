---
// Moldura comum: cabeçalho terracota, busca, conteúdo, bloco de suporte e rodapé (protótipo).
import '../styles/tokens.css';
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Search from '../components/Search.astro';
import SupportCta from '../components/SupportCta.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  search?: boolean;
  support?: boolean;
}
const { title, description, home = false, search = true, support = true } = Astro.props;
const pageTitle = home ? 'Central de Ajuda · Banket' : `${title} · Central de Ajuda do Banket`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={`${base}fonts/GeneralSans-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/GeneralSans-Medium.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <Hero home={home} />
      {search && <Search home={home} />}
      <main class="container main" id="conteudo">
        <slot />
        {support && <SupportCta />}
      </main>
      <Footer />
    </div>
  </body>
</html>

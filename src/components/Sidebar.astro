---
// Navegação lateral (desktop). Em telas até 1024px encolhe para só ícones; no celular (≤768px) some
// e a navegação passa a ser a barra inferior (MobileNav.astro).
import Icon from './ui/Icon.astro';
import { isAdmin } from '../lib/auth';
import { NAV_PRINCIPAL, navAtiva } from '../lib/nav';

const { pathname } = Astro.url;
const user = Astro.locals.user;

const navItems = NAV_PRINCIPAL.filter((item) => !item.adminOnly || isAdmin(user));
---

<aside class="sidebar">
  <a href="/dashboard" class="sidebar-logo">
    <img src="/logo-dark.png" alt="Banket" class="brand-logo" />
    <img src="/logo-mark.png" alt="Banket" class="brand-icone" />
  </a>

  <nav class="sidebar-nav" aria-label="Navegação principal">
    {navItems.map((item) => (
      <a href={item.href} class:list={['nav-item', { active: navAtiva(pathname, item.match) }]} aria-current={navAtiva(pathname, item.match) ? 'page' : undefined}>
        <Icon name={item.icon} size={20} class="nav-icon" />
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<style>
  /* Sidebar do design system: 248px, tint quente, item ativo como pílula branca */
  .sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-sidebar);
    height: 100vh;
    height: 100dvh;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid #f1e2d9;
  }

  .sidebar-logo {
    height: 72px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-6);
    border-bottom: 1px solid #f1e2d9;
    flex: none;
  }

  .brand-logo {
    height: 30px;
    width: auto;
  }

  .brand-icone {
    display: none;
    height: 30px;
    width: auto;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-3);
    overflow-y: auto;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 40px;
    flex: none;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text-body);
    font-size: var(--fs-14);
    font-weight: var(--fw-regular);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .nav-item :global(.nav-icon) {
    color: var(--clay-600);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-item:hover {
    background-color: rgba(227, 83, 54, 0.06);
    color: var(--text-strong);
  }

  .nav-item:hover :global(.nav-icon) {
    color: var(--clay-800);
  }

  .nav-item.active {
    background: var(--bg-surface);
    color: var(--terracotta-700);
    font-weight: var(--fw-medium);
    box-shadow: var(--shadow-xs), 0 0 0 1px rgba(227, 83, 54, 0.08);
  }

  .nav-item.active :global(.nav-icon) {
    color: var(--terracotta-600);
  }

  .nav-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tablet: só ícones */
  @media (max-width: 1024px) {
    .sidebar {
      width: 72px;
    }

    .sidebar-logo {
      justify-content: center;
      padding: 0;
    }

    .brand-logo {
      display: none;
    }

    .brand-icone {
      display: block;
    }

    .nav-item {
      justify-content: center;
      padding: 0;
      height: 44px;
    }

    /* Rótulo escondido visualmente, mas mantido para leitores de tela */
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Celular: a navegação é a barra inferior */
  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }
</style>

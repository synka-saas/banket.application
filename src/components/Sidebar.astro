---
// Navegação lateral (desktop). Em telas até 1024px encolhe para só ícones; no celular (≤768px) some
// e a navegação passa a ser a barra inferior (MobileNav.astro).
import Icon from './ui/Icon.astro';
import { isAdmin } from '../lib/auth';
import { itensDoMenu, linkBloqueado, navAtiva, type BadgesNavegacao, type ItemNavegacao } from '../lib/nav';
import { podeUsarEm } from '../lib/planos/gating';
import { inicioDoPlano } from '../lib/planos/rotas';
import { urlArea } from '../lib/busca/url';
import { ofertaDeTrial } from '../server/planos';

interface Props {
  badges?: BadgesNavegacao;
  /** Lista alternativa de itens (a área do Banket Busca reaproveita a sidebar) */
  items?: ItemNavegacao[];
}

const { badges = {}, items } = Astro.props;
const { pathname } = Astro.url;
const user = Astro.locals.user;
const plano = Astro.locals.plano ?? null;

// Itens fora do plano continuam visíveis, com cadeado; o clique abre o painel de upsell (D6 do modelo Concierge)
const navItems = itensDoMenu(isAdmin(user), (r) => podeUsarEm(plano, r), items);
const inicio = inicioDoPlano(podeUsarEm(plano, 'propostas'));
const admin = isAdmin(user);
// Card do plano no rodapé (owner/admin): gratuito com a oferta de teste, ou teste em andamento
const oferta = ofertaDeTrial(plano);
const cardGratuito = admin && plano?.gratuito === true;
const cardTrial = admin && plano?.trial != null && !plano?.assinaturaViva;
---

<aside class="sidebar">
  <a href={inicio} class="sidebar-logo">
    <img src="/logo-dark.png" alt="Banket" class="brand-logo" />
    <img src="/logo-mark.png" alt="Banket" class="brand-icone" />
  </a>

  <nav class="sidebar-nav" aria-label="Navegação principal">
    {navItems.map((item) => (
      <a
        href={item.bloqueado ? linkBloqueado(item.bloqueado, inicio) : item.marca === 'busca' ? urlArea(item.href) : item.href}
        class:list={['nav-item', { active: navAtiva(pathname, item.match) && !item.bloqueado, 'nav-item--bloqueado': item.bloqueado }]}
        aria-current={navAtiva(pathname, item.match) && !item.bloqueado ? 'page' : undefined}
        data-bloqueado={item.bloqueado || undefined}
        title={item.bloqueado ? `${item.label} · não incluído no seu plano` : undefined}
      >
        <Icon name={item.icon} size={20} class="nav-icon" />
        <span class="nav-label">{item.label}</span>
        {badges[item.href] ? <span class="nav-badge tabular" aria-label={`${badges[item.href]} não lidas`}>{badges[item.href] > 99 ? '99+' : badges[item.href]}</span> : null}
        {item.bloqueado && <Icon name="lock" size={14} class="nav-cadeado" />}
        {item.bloqueado && <span class="sr-only">(não incluído no seu plano)</span>}
      </a>
    ))}
  </nav>

  {cardGratuito && (
    <div class="sidebar-plano" data-tour="plano-gratuito">
      <p class="sidebar-plano-titulo">Plano Busca · gratuito</p>
      <p class="sidebar-plano-texto">
        {oferta === 'disponivel' ? 'Teste o Banket completo por 30 dias, sem cartão.' : 'Propostas, Inbox, financeiro e muito mais nos planos pagos.'}
      </p>
      {oferta === 'disponivel' ? (
        <a href="/planos?teste=1" class="btn btn-primary btn-sm btn-block">Iniciar teste grátis</a>
      ) : (
        <a href="/planos" class="btn btn-outline btn-sm btn-block">Ver planos</a>
      )}
    </div>
  )}
  {cardTrial && plano?.trial && (
    <div class="sidebar-plano">
      <p class="sidebar-plano-titulo">Teste do {plano.planoNome}</p>
      <p class="sidebar-plano-texto tabular">
        {plano.trial.diasRestantes === 0 ? 'Último dia de acesso' : `Restam ${plano.trial.diasRestantes} ${plano.trial.diasRestantes === 1 ? 'dia' : 'dias'} de acesso`}
      </p>
      <a href="/configuracoes/financeiro" class="btn btn-outline btn-sm btn-block">Assinar</a>
    </div>
  )}
</aside>

<style>
  /* Sidebar do design system: 248px, tint quente, item ativo como pílula branca */
  .sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-sidebar);
    height: 100vh;
    height: 100dvh;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid #f1e2d9;
  }

  .sidebar-logo {
    height: 72px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-6);
    border-bottom: 1px solid #f1e2d9;
    flex: none;
  }

  .brand-logo {
    height: 30px;
    width: auto;
  }

  .brand-icone {
    display: none;
    height: 30px;
    width: auto;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-4) var(--space-3);
    overflow-y: auto;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 40px;
    flex: none;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text-body);
    font-size: var(--fs-14);
    font-weight: var(--fw-regular);
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .nav-item :global(.nav-icon) {
    color: var(--clay-600);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-item:hover {
    background-color: rgba(227, 83, 54, 0.06);
    color: var(--text-strong);
  }

  .nav-item:hover :global(.nav-icon) {
    color: var(--clay-800);
  }

  .nav-item.active {
    background: var(--bg-surface);
    color: var(--terracotta-700);
    font-weight: var(--fw-medium);
    box-shadow: var(--shadow-xs), 0 0 0 1px rgba(227, 83, 54, 0.08);
  }

  .nav-item.active :global(.nav-icon) {
    color: var(--terracotta-600);
  }

  /* Fora do plano: cor rebaixada, cadeado e clique que abre o painel de upsell */
  .nav-item--bloqueado {
    color: var(--text-muted);
  }

  .nav-item--bloqueado :global(.nav-icon) {
    opacity: 0.55;
  }

  .nav-item--bloqueado:hover {
    background-color: var(--clay-100);
    color: var(--text-secondary);
  }

  .nav-item :global(.nav-cadeado) {
    flex: none;
    color: var(--text-muted);
  }

  /* Card do plano no rodapé do menu */
  .sidebar-plano {
    margin: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    box-shadow: var(--shadow-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-plano-titulo {
    margin: 0;
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }

  .sidebar-plano-texto {
    margin: 0 0 var(--space-1);
    font-size: var(--fs-12);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .nav-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Contador (não lidas do Inbox): pílula terracota à direita do rótulo */
  .nav-badge {
    flex: none;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--action-primary);
    color: var(--text-on-accent);
    font-size: var(--fs-11);
    font-weight: var(--fw-medium);
    line-height: 1;
  }

  /* Tablet: só ícones */
  @media (max-width: 1024px) {
    .sidebar {
      width: 72px;
    }

    .sidebar-logo {
      justify-content: center;
      padding: 0;
    }

    .brand-logo {
      display: none;
    }

    .brand-icone {
      display: block;
    }

    .nav-item {
      justify-content: center;
      padding: 0;
      height: 44px;
    }

    .nav-item {
      position: relative;
    }

    /* Tablet (só ícones): o contador vai para o canto do ícone */
    .nav-badge {
      position: absolute;
      top: 6px;
      right: 8px;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      font-size: 10px;
    }

    .nav-item :global(.nav-cadeado),
    .sidebar-plano {
      display: none;
    }

    /* Rótulo escondido visualmente, mas mantido para leitores de tela */
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Celular: a navegação é a barra inferior */
  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }
</style>

---
// Navegação lateral (desktop). Em telas até 1024px encolhe para só ícones; no celular (≤768px) some
// e a navegação passa a ser a barra inferior (MobileNav.astro).
import Icon from './ui/Icon.astro';
import { isAdmin } from '../lib/auth';
import { NAV_PRINCIPAL, navAtiva } from '../lib/nav';

const { pathname } = Astro.url;
const user = Astro.locals.user;

const navItems = NAV_PRINCIPAL.filter((item) => !item.adminOnly || isAdmin(user));
---

<aside class="sidebar">
  <a href="/dashboard" class="sidebar-logo">
    <img src="/logo-dark.png" alt="Banket" class="brand-logo" />
    <img src="/favicon.svg" alt="Banket" class="brand-icone" />
  </a>

  <nav class="sidebar-nav">
    {navItems.map((item) => (
      <a href={item.href} class:list={['nav-item', { active: navAtiva(pathname, item.match) }]}>
        <Icon name={item.icon} size={20} class="nav-icon" />
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    width: 265px;
    background-color: var(--color-primary-10);
    height: 100vh;
    height: 100dvh;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-color);
  }

  .sidebar-logo {
    height: 128px;
    display: flex;
    align-items: center;
    padding: 0 45px;
    border-bottom: 1px solid var(--border-color);
  }

  .brand-logo {
    height: 44px;
    width: auto;
  }

  .brand-icone {
    display: none;
    height: 32px;
    width: auto;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    padding: 36px 0;
    gap: 12px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    padding: 12px 45px;
    gap: 10px;
    color: var(--color-neutral-80);
    transition: color 0.2s ease, background-color 0.2s ease;
    font-weight: 600;
    font-size: 14px;
  }

  .nav-item:hover {
    background-color: rgba(227, 83, 54, 0.06);
    color: var(--color-primary-text);
  }

  .nav-item.active {
    color: var(--color-primary-50);
  }

  /* Tablet: só ícones */
  @media (max-width: 1024px) {
    .sidebar {
      width: 76px;
    }

    .sidebar-logo {
      height: 80px;
      justify-content: center;
      padding: 0;
    }

    .brand-logo {
      display: none;
    }

    .brand-icone {
      display: block;
    }

    .nav-item {
      justify-content: center;
      padding: 14px 0;
    }

    .sidebar-nav {
      overflow-y: auto;
    }

    /* Rótulo escondido visualmente, mas mantido para leitores de tela */
    .nav-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Celular: a navegação é a barra inferior */
  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }
</style>

---
import Icon from './ui/Icon.astro';
import { isAdmin } from '../lib/auth';

const { pathname } = Astro.url;
const user = Astro.locals.user;

const navItems = [
  { label: 'Dashboard', icon: 'dashboard', href: '/dashboard', match: ['/dashboard'] },
  { label: 'Quadro de vendas', icon: 'view_kanban', href: '/eventos', match: ['/eventos'] },
  { label: 'Cardápios', icon: 'menu_book_2', href: '/cardapio/itens', match: ['/cardapio'] },
  { label: 'Clientes', icon: 'account_box', href: '/clientes', match: ['/clientes'] },
  { label: 'Agenda', icon: 'calendar_today', href: '/agenda', match: ['/agenda'] },
  { label: 'Formulários', icon: 'layers', href: '/formularios', match: ['/formularios'] },
  { label: 'Staff', icon: 'group', href: '/staff/profissionais', match: ['/staff'] },
  { label: 'Templates', icon: 'description', href: '/templates', match: ['/templates'] },
  { label: 'Configurações', icon: 'settings', href: '/configuracoes/usuarios', match: ['/configuracoes'], adminOnly: true },
].filter((item) => !item.adminOnly || isAdmin(user));

const isActive = (match: string[]) => match.some((m) => pathname === m || pathname.startsWith(`${m}/`));
---

<aside class="sidebar">
  <a href="/dashboard" class="sidebar-logo">
    <img src="/logo-dark.png" alt="Banket" class="brand-logo" />
  </a>

  <nav class="sidebar-nav">
    {navItems.map((item) => (
      <a href={item.href} class:list={['nav-item', { active: isActive(item.match) }]}>
        <Icon name={item.icon} size={20} class="nav-icon" />
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    width: 265px;
    background-color: var(--color-primary-10);
    height: 100vh;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-color);
  }

  .sidebar-logo {
    height: 128px;
    display: flex;
    align-items: center;
    padding: 0 45px;
    border-bottom: 1px solid var(--border-color);
  }

  .brand-logo {
    height: 44px;
    width: auto;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    padding: 36px 0;
    gap: 12px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    padding: 12px 45px;
    gap: 10px;
    color: var(--color-neutral-80);
    transition: color 0.2s ease, background-color 0.2s ease;
    font-weight: 600;
    font-size: 14px;
  }

  .nav-item:hover {
    background-color: rgba(227, 83, 54, 0.06);
    color: var(--color-primary);
  }

  .nav-item.active {
    color: var(--color-primary-50);
  }
</style>

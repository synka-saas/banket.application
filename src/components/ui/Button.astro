---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'success' | 'secondary' | 'outline' | 'text' | 'danger' | 'dark';

type Props = Omit<HTMLAttributes<'button'>, 'type'> & {
  variant?: Variant;
  size?: 'sm' | 'md' | 'large';
  icon?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Quando definido, renderiza um link com aparência de botão */
  href?: string;
  block?: boolean;
};

const {
  variant = 'primary',
  size = 'md',
  icon,
  type = 'button',
  href,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, `btn-${size}`, { 'btn-block': block }, className];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    {icon && <Icon name={icon} size={18} class="btn-icon" />}
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    {icon && <Icon name={icon} size={18} class="btn-icon" />}
    <slot />
  </button>
)}

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 20px;
    border-radius: var(--border-radius-sm);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    border: 1px solid transparent;
  }

  .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn-sm {
    min-height: 28px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 400;
  }

  .btn-large {
    min-height: 48px;
    width: 100%;
  }

  .btn-block {
    width: 100%;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-white);
  }
  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-primary-50);
  }

  .btn-success {
    background-color: var(--color-secondary);
    color: var(--color-white);
  }
  .btn-success:hover:not(:disabled) {
    background-color: var(--color-secondary-60);
  }

  .btn-secondary,
  .btn-outline {
    background-color: var(--color-white);
    border-color: var(--color-neutral-80);
    color: var(--color-neutral-80);
  }
  .btn-secondary:hover:not(:disabled),
  .btn-outline:hover:not(:disabled) {
    background-color: var(--color-neutral-20);
  }

  .btn-danger {
    background-color: var(--color-primary-10);
    color: var(--color-primary-60);
  }
  .btn-danger:hover:not(:disabled) {
    background-color: #ffdcd3;
  }

  .btn-dark {
    background-color: var(--color-neutral-50);
    color: var(--color-white);
  }
  .btn-dark:hover:not(:disabled) {
    background-color: var(--color-neutral-65);
  }

  .btn-text {
    background-color: transparent;
    color: var(--color-primary);
    padding: 9px 12px;
  }
  .btn-text:hover:not(:disabled) {
    background-color: rgba(227, 83, 54, 0.06);
  }

  .btn-icon {
    flex-shrink: 0;
  }
</style>

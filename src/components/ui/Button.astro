---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'success' | 'secondary' | 'outline' | 'ghost' | 'soft' | 'text' | 'danger' | 'dark';

type Props = Omit<HTMLAttributes<'button'>, 'type'> &
  Pick<HTMLAttributes<'a'>, 'target' | 'rel' | 'download'> & {
  variant?: Variant;
  size?: 'sm' | 'md' | 'large';
  icon?: string;
  /** Ícone depois do rótulo (ex.: "chevron-right" em links de apoio) */
  iconRight?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Quando definido, renderiza um link com aparência de botão */
  href?: string;
  block?: boolean;
};

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconRight,
  type = 'button',
  href,
  block = false,
  class: className,
  ...rest
} = Astro.props;

// Os estilos .btn* ficam em styles/global.css: HTML montado à mão e ilhas Preact também usam essas classes.
const classes = ['btn', `btn-${variant}`, `btn-${size}`, { 'btn-block': block }, className];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    {icon && <Icon name={icon} size={size === 'sm' ? 15 : 16} stroke={1.75} class="btn-icon" />}
    <slot />
    {iconRight && <Icon name={iconRight} size={size === 'sm' ? 15 : 16} stroke={1.75} class="btn-icon" />}
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    {icon && <Icon name={icon} size={size === 'sm' ? 15 : 16} stroke={1.75} class="btn-icon" />}
    <slot />
    {iconRight && <Icon name={iconRight} size={size === 'sm' ? 15 : 16} stroke={1.75} class="btn-icon" />}
  </button>
)}

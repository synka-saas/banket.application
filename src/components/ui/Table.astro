---
import Icon from './Icon.astro';
import { isRawHtml } from '../../lib/html';
import { lerOrdenacao } from '../../lib/ordenacao';
import { withQuery } from '../../lib/pagination';

interface Column {
  key: string;
  label: string;
  align?: 'left' | 'center' | 'right';
  width?: string;
  /** Nome da coluna em ?ordem= (o servidor da listagem precisa aceitá-lo) */
  ordenar?: string;
}

interface Props {
  columns: Column[];
  /** Valores comuns são renderizados como texto; use html`` (lib/html) para marcação confiável. */
  data: Record<string, unknown>[];
  /** Texto simples para lista vazia; para orientação com ação, use o slot "empty" com EstadoVazio */
  emptyMessage?: string;
}

const { columns, data, emptyMessage = 'Nenhum registro encontrado.' } = Astro.props;
const ord = lerOrdenacao(Astro.url);
// Clicar alterna crescente → decrescente → ordem padrão
const linkOrdem = (campo: string) =>
  ord.campo !== campo
    ? withQuery(Astro.url, { ordem: campo, dir: null, page: null })
    : ord.dir === 'asc'
      ? withQuery(Astro.url, { ordem: campo, dir: 'desc', page: null })
      : withQuery(Astro.url, { ordem: null, dir: null, page: null });
---

<div class="table-card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          {columns.map((col) => (
            <th
              class={`text-${col.align || 'left'}`}
              style={col.width ? `width:${col.width}` : undefined}
              aria-sort={col.ordenar && ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'ascending' : 'descending') : undefined}
            >
              {col.ordenar ? (
                <a class="th-ordenar" href={linkOrdem(col.ordenar)}>
                  {col.label}
                  <Icon
                    name={ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'arrow_upward' : 'arrow_downward') : 'unfold_more'}
                    size={16}
                    class:list={['th-ordem-icone', { ativo: ord.campo === col.ordenar }]}
                  />
                </a>
              ) : (
                col.label
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {data.length > 0 ? (
          data.map((row) => (
            <tr>
              {columns.map((col) => (
                <td class={`text-${col.align || 'left'}`}>
                  {isRawHtml(row[col.key])
                    ? <Fragment set:html={(row[col.key] as { __html: string }).__html} />
                    : String(row[col.key] ?? '')}
                </td>
              ))}
            </tr>
          ))
        ) : (
          <tr>
            <td colspan={columns.length} class="empty-state">
              {Astro.slots.has('empty') ? <slot name="empty" /> : emptyMessage}
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
  <slot name="footer" />
</div>

<style>
  .th-ordenar {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }

  .th-ordenar:hover {
    color: var(--color-primary-text);
  }

  .th-ordem-icone {
    opacity: 0.5;
  }

  .th-ordem-icone.ativo {
    opacity: 1;
    color: var(--color-primary-text);
  }

  .table-card {
    width: 100%;
    background: var(--color-white);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th,
  .data-table td {
    padding: 15px 30px;
    border-bottom: 1px solid var(--color-neutral-20);
    vertical-align: middle;
  }

  .data-table th {
    background-color: var(--color-neutral-20);
    font-weight: 600;
    color: var(--color-neutral-100);
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom: none;
  }

  .data-table td {
    color: var(--color-neutral-65);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover {
    background-color: #fcfcfc;
  }

  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .text-right { text-align: right; }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    padding: 40px;
  }
</style>

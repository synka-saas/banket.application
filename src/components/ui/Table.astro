---
import Icon from './Icon.astro';
import { isRawHtml } from '../../lib/html';
import { lerOrdenacao } from '../../lib/ordenacao';
import { withQuery } from '../../lib/pagination';

interface Column {
  key: string;
  label: string;
  align?: 'left' | 'center' | 'right';
  width?: string;
  /** Nome da coluna em ?ordem= (o servidor da listagem precisa aceitá-lo) */
  ordenar?: string;
}

interface Props {
  columns: Column[];
  /** Valores comuns são renderizados como texto; use html`` (lib/html) para marcação confiável. */
  data: Record<string, unknown>[];
  /** Texto simples para lista vazia; para orientação com ação, use o slot "empty" com EstadoVazio */
  emptyMessage?: string;
  /** URL do PATCH de ordem: adiciona a coluna para arrastar (linhas precisam de _id e, para o rótulo, _nome) */
  reordenar?: string;
}

const { columns, data, emptyMessage = 'Nenhum registro encontrado.', reordenar } = Astro.props;
const ord = lerOrdenacao(Astro.url);
// Clicar alterna crescente → decrescente → ordem padrão
const linkOrdem = (campo: string) =>
  ord.campo !== campo
    ? withQuery(Astro.url, { ordem: campo, dir: null, page: null })
    : ord.dir === 'asc'
      ? withQuery(Astro.url, { ordem: campo, dir: 'desc', page: null })
      : withQuery(Astro.url, { ordem: null, dir: null, page: null });
---

<div class="table-card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          {reordenar && <th class="col-ordem"><span class="sr-only">Ordem</span></th>}
          {columns.map((col) => (
            <th
              class={`text-${col.align || 'left'}`}
              style={col.width ? `width:${col.width}` : undefined}
              aria-sort={col.ordenar && ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'ascending' : 'descending') : undefined}
            >
              {col.ordenar ? (
                <a class="th-ordenar" href={linkOrdem(col.ordenar)}>
                  {col.label}
                  <Icon
                    name={ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'arrow_upward' : 'arrow_downward') : 'unfold_more'}
                    size={16}
                    class:list={['th-ordem-icone', { ativo: ord.campo === col.ordenar }]}
                  />
                </a>
              ) : (
                col.label
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody data-reordenar={reordenar && data.length > 1 ? reordenar : undefined}>
        {data.length > 0 ? (
          data.map((row) => (
            <tr data-id={reordenar ? String(row._id) : undefined}>
              {reordenar && (
                <td class="col-ordem">
                  <span class="alca-reordenar">
                    <span data-alca class="icon" aria-hidden="true" translate="no" title="Arraste para reordenar">drag_indicator</span>
                    <button type="button" data-mover="-1" aria-label={`Mover ${row._nome ?? 'item'} para cima`}>
                      <Icon name="keyboard_arrow_up" size={18} />
                    </button>
                    <button type="button" data-mover="1" aria-label={`Mover ${row._nome ?? 'item'} para baixo`}>
                      <Icon name="keyboard_arrow_down" size={18} />
                    </button>
                  </span>
                </td>
              )}
              {columns.map((col) => (
                <td class={`text-${col.align || 'left'}`} data-key={col.key} data-rotulo={col.key === 'acoes' ? undefined : col.label || undefined}>
                  {isRawHtml(row[col.key])
                    ? <Fragment set:html={(row[col.key] as { __html: string }).__html} />
                    : String(row[col.key] ?? '')}
                </td>
              ))}
            </tr>
          ))
        ) : (
          <tr>
            <td colspan={columns.length + (reordenar ? 1 : 0)} class="empty-state">
              {Astro.slots.has('empty') ? <slot name="empty" /> : emptyMessage}
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
  <slot name="footer" />
</div>

<style>
  .col-ordem {
    width: 108px;
    white-space: nowrap;
  }

  .th-ordenar {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
    text-decoration: none;
  }

  .th-ordenar:hover {
    color: var(--color-primary-text);
  }

  .th-ordem-icone {
    opacity: 0.5;
  }

  .th-ordem-icone.ativo {
    opacity: 1;
    color: var(--color-primary-text);
  }

  .table-card {
    width: 100%;
    background: var(--color-white);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .data-table th,
  .data-table td {
    padding: 15px 30px;
    border-bottom: 1px solid var(--color-neutral-20);
    vertical-align: middle;
  }

  .data-table th {
    background-color: var(--color-neutral-20);
    font-weight: 600;
    color: var(--color-neutral-100);
    padding-top: 18px;
    padding-bottom: 18px;
    border-bottom: none;
  }

  .data-table td {
    color: var(--color-neutral-65);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover {
    background-color: #fcfcfc;
  }

  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .text-right { text-align: right; }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    padding: 40px;
  }

  /* Celular: cada linha vira um cartão "rótulo: valor" */
  @media (max-width: 768px) {
    .data-table thead {
      display: none;
    }

    .data-table,
    .data-table tbody,
    .data-table tr,
    .data-table td {
      display: block;
      width: 100%;
    }

    .data-table tr {
      padding: 6px 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .data-table tr:last-child {
      border-bottom: 0;
    }

    .data-table td {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 7px 0;
      border-bottom: 0;
      text-align: right;
    }

    .data-table td[data-rotulo]::before {
      content: attr(data-rotulo);
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--color-text-muted);
      text-align: left;
    }

    /* Célula sem valor não ocupa linha */
    .data-table td[data-rotulo]:empty {
      display: none;
    }

    /* Ações no rodapé do cartão */
    .data-table td[data-key='acoes'] {
      justify-content: flex-end;
      padding-top: 10px;
      margin-top: 4px;
      border-top: 1px dashed var(--border-color);
    }

    .data-table td.col-ordem {
      justify-content: flex-end;
    }

    .data-table td.empty-state {
      display: block;
      text-align: center;
    }
  }
</style>

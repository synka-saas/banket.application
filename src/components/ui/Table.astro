---
import Icon from './Icon.astro';
import { isRawHtml } from '../../lib/html';
import { lerOrdenacao } from '../../lib/ordenacao';
import { withQuery } from '../../lib/pagination';

interface Column {
  key: string;
  label: string;
  align?: 'left' | 'center' | 'right';
  width?: string;
  /** Nome da coluna em ?ordem= (o servidor da listagem precisa aceitá-lo) */
  ordenar?: string;
}

interface Props {
  columns: Column[];
  /** Valores comuns são renderizados como texto; use html`` (lib/html) para marcação confiável. */
  data: Record<string, unknown>[];
  /** Texto simples para lista vazia; para orientação com ação, use o slot "empty" com EstadoVazio */
  emptyMessage?: string;
  /** URL do PATCH de ordem: adiciona a coluna para arrastar (linhas precisam de _id e, para o rótulo, _nome) */
  reordenar?: string;
}

const { columns, data, emptyMessage = 'Nenhum registro encontrado.', reordenar } = Astro.props;
const ord = lerOrdenacao(Astro.url);
// Clicar alterna crescente → decrescente → ordem padrão
const linkOrdem = (campo: string) =>
  ord.campo !== campo
    ? withQuery(Astro.url, { ordem: campo, dir: null, page: null })
    : ord.dir === 'asc'
      ? withQuery(Astro.url, { ordem: campo, dir: 'desc', page: null })
      : withQuery(Astro.url, { ordem: null, dir: null, page: null });
---

<div class="table-card">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          {reordenar && <th class="col-ordem"><span class="sr-only">Ordem</span></th>}
          {columns.map((col) => (
            <th
              class={`text-${col.align || 'left'}`}
              style={col.width ? `width:${col.width}` : undefined}
              aria-sort={col.ordenar && ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'ascending' : 'descending') : undefined}
            >
              {col.ordenar ? (
                <a class="th-ordenar" href={linkOrdem(col.ordenar)}>
                  {col.label}
                  <Icon
                    name={ord.campo === col.ordenar ? (ord.dir === 'asc' ? 'chevron-up' : 'chevron-down') : 'selector'}
                    size={14}
                    class:list={['th-ordem-icone', { ativo: ord.campo === col.ordenar }]}
                  />
                </a>
              ) : col.key === 'acoes' ? (
                <span class="sr-only">{col.label}</span>
              ) : (
                col.label
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody data-reordenar={reordenar && data.length > 1 ? reordenar : undefined}>
        {data.length > 0 ? (
          data.map((row) => (
            <tr data-id={reordenar ? String(row._id) : undefined}>
              {reordenar && (
                <td class="col-ordem">
                  <span class="alca-reordenar">
                    <span data-alca title="Arraste para reordenar"><Icon name="grip-vertical" size={16} /></span>
                    <button type="button" data-mover="-1" aria-label={`Mover ${row._nome ?? 'item'} para cima`}>
                      <Icon name="chevron-up" size={14} />
                    </button>
                    <button type="button" data-mover="1" aria-label={`Mover ${row._nome ?? 'item'} para baixo`}>
                      <Icon name="chevron-down" size={14} />
                    </button>
                  </span>
                </td>
              )}
              {columns.map((col) => {
                const valor = row[col.key];
                // Valor vazio: travessão cinza no desktop; no celular a célula some do cartão
                const vazio = col.key !== 'acoes' && (valor === null || valor === undefined || valor === '' || valor === '-');
                return (
                  <td class={`text-${col.align || 'left'}`} data-key={col.key} data-vazio={vazio || undefined} data-rotulo={col.key === 'acoes' ? undefined : col.label || undefined}>
                    {vazio
                      ? <span class="vazio">—</span>
                      : isRawHtml(valor)
                        ? <Fragment set:html={(valor as { __html: string }).__html} />
                        : String(valor ?? '')}
                  </td>
                );
              })}
            </tr>
          ))
        ) : (
          <tr>
            <td colspan={columns.length + (reordenar ? 1 : 0)} class="empty-state">
              {Astro.slots.has('empty') ? <slot name="empty" /> : emptyMessage}
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
  <slot name="footer" />
</div>

<style>
  .col-ordem {
    width: 96px;
    white-space: nowrap;
  }

  .th-ordenar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .th-ordenar:hover {
    color: var(--text-strong);
  }

  .th-ordem-icone {
    color: var(--clay-400);
  }

  .th-ordem-icone.ativo {
    color: var(--terracotta-600);
  }

  th[aria-sort] .th-ordenar {
    color: var(--text-strong);
  }

  /* Tabela em card: borda fina, raio 12 e sombra curta */
  .table-card {
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-14);
  }

  .data-table th {
    height: 44px;
    padding: 0 var(--space-4);
    background: var(--clay-25);
    border-bottom: 1px solid var(--border-default);
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
    white-space: nowrap;
    vertical-align: middle;
  }

  .data-table td {
    height: 52px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-body);
    line-height: 1.4;
    vertical-align: middle;
  }

  .data-table th:first-child,
  .data-table td:first-child {
    padding-left: var(--space-5);
  }

  .data-table th:last-child,
  .data-table td:last-child {
    padding-right: var(--space-5);
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr {
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .data-table tbody tr:hover {
    background-color: var(--clay-25);
  }

  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .text-right { text-align: right; font-variant-numeric: tabular-nums; }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: var(--space-10) var(--space-6);
    height: auto;
  }

  .data-table tbody tr:has(.empty-state):hover {
    background-color: transparent;
  }

  /* Celular: cada linha vira um cartão "rótulo: valor" */
  @media (max-width: 768px) {
    .data-table thead {
      display: none;
    }

    .data-table,
    .data-table tbody,
    .data-table tr,
    .data-table td {
      display: block;
      width: 100%;
    }

    .data-table tr {
      padding: 6px 16px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .data-table tr:last-child {
      border-bottom: 0;
    }

    .data-table td,
    .data-table td:first-child,
    .data-table td:last-child {
      height: auto;
      padding: 7px 0;
      border-bottom: 0;
      text-align: right;
      overflow-wrap: anywhere;
    }

    /* Rótulo flutuado: a célula pode ter vários nós (e-mail, <br>, telefone…) sem virar itens soltos */
    .data-table td[data-rotulo]::before {
      content: attr(data-rotulo);
      float: left;
      margin-right: 16px;
      font-size: 12px;
      font-weight: var(--fw-medium);
      line-height: 1.9;
      color: var(--text-muted);
      text-align: left;
    }

    /* Célula sem valor não ocupa linha */
    .data-table td:empty,
    .data-table td[data-vazio] {
      display: none;
    }

    /* Ações no rodapé do cartão */
    .data-table td[data-key='acoes'] {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      padding-top: 10px;
      margin-top: 4px;
      border-top: 1px dashed var(--border-default);
    }

    .data-table td.col-ordem {
      display: flex;
      justify-content: flex-end;
    }

    .data-table td.empty-state {
      display: block;
      text-align: center;
    }
  }
</style>

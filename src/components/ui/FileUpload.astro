---
// Campo de upload padrão do sistema: área de "arrastar e soltar ou procurar" e, com arquivo, um cartão com miniatura,
// nome e ações (trocar / remover). O <input type="file"> real continua no formulário (envio normal via multipart),
// então os scripts das páginas podem ouvir o "change" dele como antes.
//
// API para scripts: disparar `upload:externo` no elemento [data-upload] com { url, nome } mostra uma imagem vinda de
// outra origem (ex.: galeria de IA) e limpa o arquivo escolhido; o componente dispara `upload:limpo` quando o
// usuário descarta o arquivo novo.
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = Omit<HTMLAttributes<'input'>, 'type'> & {
  name: string;
  /** Tipos aceitos (atributo accept). Padrão: imagens PNG, JPG, WEBP e SVG. */
  accept?: string;
  /** Texto dos formatos aceitos exibido abaixo da chamada */
  formatos?: string;
  /** URL do arquivo já salvo (mostrado como "arquivo atual") */
  atualUrl?: string | null;
  atualNome?: string;
  /** Checkbox enviado ao salvar para remover o arquivo atual (ex.: remover_logo_path) */
  removerName?: string;
  /** Alternativa ao removerName: botão submit que remove na hora (valor de _action) */
  removerAcao?: string;
  removerConfirmacao?: string;
  /** Versão mais baixa, para colunas estreitas */
  compacto?: boolean;
  /** Tamanho máximo conferido no navegador antes de enviar (o servidor confere de novo). Padrão: 5 MB */
  maxBytes?: number;
  /** Imagens raster acima deste tamanho (KB) são redimensionadas no navegador antes de enviar (WebP) */
  comprimirKb?: number;
};

const {
  name,
  accept = 'image/png,image/jpeg,image/webp,image/svg+xml',
  formatos = 'PNG, JPG, WEBP ou SVG · até 5 MB',
  atualUrl = null,
  atualNome = 'Imagem atual',
  removerName,
  removerAcao,
  removerConfirmacao = 'Remover o arquivo atual?',
  compacto = false,
  maxBytes = 5 * 1024 * 1024,
  comprimirKb,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={['upload', { compacto }, className]}
  data-upload
  data-atual-url={atualUrl ?? undefined}
  data-atual-nome={atualNome}
  data-max-bytes={maxBytes}
  data-comprimir-kb={comprimirKb}
>
  <input type="file" name={name} accept={accept} class="upload-input" tabindex="-1" {...rest} />

  <div class="upload-zona" data-zona role="button" tabindex="0" hidden={Boolean(atualUrl)}>
    <span class="upload-icone"><Icon name="upload" size={22} /></span>
    <span class="upload-chamada">Arraste e solte ou <span class="upload-link">procure</span> para enviar</span>
    <span class="upload-formatos">{formatos}</span>
  </div>

  <div class="upload-cartao" data-cartao hidden={!atualUrl}>
    <span class="upload-miniatura">
      <img data-miniatura src={atualUrl ?? undefined} alt="" hidden={!atualUrl} />
      <Icon name="photo" size={20} class="upload-miniatura-icone" />
    </span>
    <span class="upload-info">
      <strong data-nome>{atualNome}</strong>
      <small data-detalhe>{atualUrl ? 'Salvo' : ''}</small>
    </span>
    <span class="upload-acoes">
      <button type="button" class="upload-acao" data-trocar><Icon name="arrows-exchange" size={15} /> Trocar</button>
      {removerName && atualUrl && (
        <label class="upload-acao perigo" data-remover-atual>
          <input type="checkbox" name={removerName} hidden />
          <Icon name="trash" size={15} /> <span data-remover-rotulo>Remover</span>
        </label>
      )}
      {removerAcao && atualUrl && (
        <button type="submit" name="_action" value={removerAcao} class="upload-acao perigo" formnovalidate data-confirm={removerConfirmacao} data-remover-agora>
          <Icon name="trash" size={15} /> Remover
        </button>
      )}
      <button type="button" class="upload-acao" data-descartar hidden title="Descartar o arquivo escolhido">
        <Icon name="x" size={15} /> Descartar
      </button>
    </span>
  </div>
  <slot />
</div>

<script>
  import { toast } from '../../lib/ui';
  const tamanho = (bytes: number) =>
    bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;

  const aceita = (arquivo: File, accept: string) =>
    !accept ||
    accept.split(',').some((tipo) => {
      const t = tipo.trim().toLowerCase();
      if (t.startsWith('.')) return arquivo.name.toLowerCase().endsWith(t);
      if (t.endsWith('/*')) return arquivo.type.startsWith(t.slice(0, -1));
      return arquivo.type === t;
    });

  function iniciar(raiz: HTMLElement) {
    if (raiz.dataset.pronto) return;
    raiz.dataset.pronto = '1';
    const input = raiz.querySelector<HTMLInputElement>('.upload-input')!;
    const zona = raiz.querySelector<HTMLElement>('[data-zona]')!;
    const cartao = raiz.querySelector<HTMLElement>('[data-cartao]')!;
    const miniatura = raiz.querySelector<HTMLImageElement>('[data-miniatura]')!;
    const nome = raiz.querySelector<HTMLElement>('[data-nome]')!;
    const detalhe = raiz.querySelector<HTMLElement>('[data-detalhe]')!;
    const descartar = raiz.querySelector<HTMLButtonElement>('[data-descartar]')!;
    const removerAtual = raiz.querySelector<HTMLLabelElement>('[data-remover-atual]');
    const removerCheckbox = removerAtual?.querySelector<HTMLInputElement>('input');
    const removerAgora = raiz.querySelector<HTMLElement>('[data-remover-agora]');
    const atualUrl = raiz.dataset.atualUrl ?? '';
    let urlTemporaria: string | null = null;

    const mostrar = (estado: { url?: string | null; nome: string; detalhe: string; novo: boolean } | null) => {
      if (urlTemporaria) URL.revokeObjectURL(urlTemporaria);
      urlTemporaria = null;
      zona.hidden = Boolean(estado);
      cartao.hidden = !estado;
      if (!estado) return;
      miniatura.hidden = !estado.url;
      if (estado.url) miniatura.src = estado.url;
      nome.textContent = estado.nome;
      detalhe.textContent = estado.detalhe;
      descartar.hidden = !estado.novo;
      if (removerAtual) removerAtual.hidden = estado.novo;
      if (removerAgora) removerAgora.hidden = estado.novo;
      raiz.classList.toggle('removendo', !estado.novo && Boolean(removerCheckbox?.checked));
    };

    const estadoAtual = () =>
      atualUrl ? { url: atualUrl, nome: raiz.dataset.atualNome ?? 'Arquivo atual', detalhe: 'Salvo', novo: false } : null;

    // Tipo e tamanho conferidos antes de enviar: o erro aparece na hora, sem perder o resto do formulário
    const maxBytes = Number(raiz.dataset.maxBytes) || Infinity;
    const recusar = (arquivo: File): string | null => {
      if (!aceita(arquivo, input.accept)) return 'Formato de arquivo não aceito.';
      if (arquivo.size > maxBytes) return `"${arquivo.name}" tem ${tamanho(arquivo.size)}; o limite é ${tamanho(maxBytes)}.`;
      return null;
    };

    // Miniatura no navegador (UX-074): imagens raster acima do limite viram WebP menores antes de enviar
    const comprimirKb = Number(raiz.dataset.comprimirKb) || 0;
    async function comprimir(arquivo: File): Promise<File> {
      if (!comprimirKb || arquivo.size <= comprimirKb * 1024 || !/^image\/(png|jpeg|webp)$/.test(arquivo.type)) return arquivo;
      try {
        const bitmap = await createImageBitmap(arquivo);
        for (const lado of [1024, 768, 512, 320]) {
          const escala = Math.min(1, lado / Math.max(bitmap.width, bitmap.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(bitmap.width * escala));
          canvas.height = Math.max(1, Math.round(bitmap.height * escala));
          canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/webp', 0.85));
          if (blob && blob.size <= comprimirKb * 1024) {
            toast('A imagem foi reduzida para carregar rápido em qualquer tela.', 'info');
            return new File([blob], arquivo.name.replace(/\.\w+$/, '.webp'), { type: 'image/webp' });
          }
        }
      } catch {
        // navegador sem suporte: segue com o arquivo original
      }
      return arquivo;
    }

    const atualizar = async () => {
      const original = input.files?.[0];
      if (!original) return mostrar(estadoAtual());
      const erroOriginal = recusar(original);
      if (erroOriginal) {
        input.value = '';
        toast(erroOriginal, 'error');
        return mostrar(estadoAtual());
      }
      const arquivo = await comprimir(original);
      if (arquivo !== original) {
        const transferencia = new DataTransfer();
        transferencia.items.add(arquivo);
        input.files = transferencia.files;
      }
      const url = arquivo.type.startsWith('image/') ? URL.createObjectURL(arquivo) : null;
      mostrar({ url, nome: arquivo.name, detalhe: `${tamanho(arquivo.size)} · será enviado ao salvar`, novo: true });
      urlTemporaria = url;
      if (removerCheckbox) removerCheckbox.checked = false;
    };

    const escolher = () => input.click();
    zona.addEventListener('click', escolher);
    zona.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        escolher();
      }
    });
    raiz.querySelector('[data-trocar]')!.addEventListener('click', escolher);
    input.addEventListener('change', atualizar);

    descartar.addEventListener('click', () => {
      input.value = '';
      atualizar();
      raiz.dispatchEvent(new CustomEvent('upload:limpo', { bubbles: true }));
    });

    removerCheckbox?.addEventListener('change', () => {
      raiz.classList.toggle('removendo', removerCheckbox.checked);
      raiz.querySelector('[data-remover-rotulo]')!.textContent = removerCheckbox.checked ? 'Desfazer' : 'Remover';
      detalhe.textContent = removerCheckbox.checked ? 'Será removido ao salvar' : 'Salvo';
    });

    // Imagem vinda de fora (ex.: galeria de IA): descarta o arquivo escolhido e mostra a escolhida
    raiz.addEventListener('upload:externo', (e) => {
      const { url, nome: rotulo } = (e as CustomEvent<{ url: string; nome: string }>).detail;
      input.value = '';
      if (removerCheckbox) removerCheckbox.checked = false;
      mostrar({ url, nome: rotulo, detalhe: 'Será aplicada ao salvar', novo: false });
      if (removerAtual) removerAtual.hidden = true;
    });

    // Arrastar e soltar em qualquer parte do campo
    let profundidade = 0;
    raiz.addEventListener('dragenter', (e) => {
      e.preventDefault();
      profundidade++;
      raiz.classList.add('arrastando');
    });
    raiz.addEventListener('dragover', (e) => e.preventDefault());
    raiz.addEventListener('dragleave', () => {
      if (--profundidade <= 0) {
        profundidade = 0;
        raiz.classList.remove('arrastando');
      }
    });
    raiz.addEventListener('drop', (e) => {
      e.preventDefault();
      profundidade = 0;
      raiz.classList.remove('arrastando');
      const arquivo = e.dataTransfer?.files?.[0];
      if (!arquivo) return;
      const erro = recusar(arquivo);
      if (erro) {
        toast(erro, 'error');
        return;
      }
      const transferencia = new DataTransfer();
      transferencia.items.add(arquivo);
      input.files = transferencia.files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-upload]').forEach(iniciar);
</script>

<style is:global>
  /* FileField do design system: zona tracejada quando vazio; com arquivo, cartão com miniatura, nome e ações */
  .upload {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* O input real fica acessível ao formulário, mas invisível */
  .upload-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .upload-zona {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-app);
    text-align: center;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .upload-zona[hidden],
  .upload-cartao[hidden] {
    display: none;
  }

  .upload-zona:hover,
  .upload-zona:focus-visible,
  .upload.arrastando .upload-zona {
    border-color: var(--border-accent);
    background: var(--bg-accent-subtle);
    outline: none;
  }

  .upload-zona:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .upload.arrastando .upload-cartao {
    outline: 2px dashed var(--border-accent);
    outline-offset: 2px;
  }

  .upload-icone {
    display: grid;
    place-items: center;
    color: var(--terracotta-600);
  }

  .upload-chamada {
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .upload-link {
    color: var(--text-link);
  }

  .upload-formatos {
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  .upload.compacto .upload-zona {
    padding: var(--space-4) var(--space-3);
    gap: var(--space-1);
  }

  .upload-cartao {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .upload.removendo .upload-cartao {
    border-color: var(--danger-border);
    background: var(--danger-bg);
  }

  .upload.removendo .upload-miniatura img {
    opacity: 0.4;
  }

  .upload-miniatura {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    color: var(--text-muted);
    overflow: hidden;
  }

  .upload-miniatura img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--bg-subtle);
  }

  .upload-miniatura img[hidden] {
    display: none;
  }

  .upload-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .upload-info strong {
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .upload-info small {
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  .upload-acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  /* Ações do cartão: botões de texto */
  .upload-acao {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-1);
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    font: inherit;
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .upload-acao:hover {
    color: var(--text-link);
  }

  .upload-acao.perigo {
    color: var(--danger);
  }

  .upload-acao.perigo:hover {
    color: var(--wine-700);
  }

  .upload-acao[hidden] {
    display: none;
  }
</style>

---
// Barra padrão das listagens: busca + filtros (select) à esquerda, ações à direita.
// Envia via GET, preservando os parâmetros da URL; a paginação volta para a página 1.
import Icon from './Icon.astro';

interface FilterOption {
  value: string;
  label: string;
}

interface Filter {
  name: string;
  placeholder: string;
  options: FilterOption[];
}

interface Props {
  searchPlaceholder?: string;
  searchParam?: string;
  filter?: Filter;
  /** Filtros adicionais, depois de `filter` */
  filters?: Filter[];
  showSearch?: boolean;
}

const { searchPlaceholder = 'Pesquisar', searchParam = 'q', filter, filters = [], showSearch = true } = Astro.props;
const todos = [filter, ...filters].filter((f): f is Filter => Boolean(f));
const params = Astro.url.searchParams;
const q = params.get(searchParam) ?? '';
const preserved = [...params.entries()].filter(
  ([key]) => key !== searchParam && key !== 'page' && !todos.some((f) => f.name === key)
);
---

<div class="toolbar">
  <form method="get" class="toolbar-filters" data-toolbar>
    {preserved.map(([key, value]) => <input type="hidden" name={key} value={value} />)}
    {showSearch && (
      <label class="search-box">
        <Icon name="search" size={20} class="search-icon" />
        <span class="sr-only">{searchPlaceholder}</span>
        <input type="search" name={searchParam} value={q} placeholder={searchPlaceholder} autocomplete="off" />
      </label>
    )}
    {todos.map((f) => (
      <label class="filter-box">
        <Icon name="expand_more" size={18} class="filter-icon" />
        <span class="sr-only">{f.placeholder}</span>
        <select name={f.name} data-autosubmit>
          <option value="">{f.placeholder}</option>
          {f.options.map((opt) => (
            <option value={opt.value} selected={opt.value === (params.get(f.name) ?? '')}>{opt.label}</option>
          ))}
        </select>
      </label>
    ))}
  </form>
  <div class="toolbar-actions">
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-toolbar]').forEach((form) => {
    form.querySelectorAll('[data-autosubmit]').forEach((el) => {
      el.addEventListener('change', () => form.requestSubmit());
    });
    const busca = form.querySelector<HTMLInputElement>('input[type="search"]');
    // Limpar a busca (botão "x" do input search) recarrega a lista
    busca?.addEventListener('search', (e) => {
      if (!(e.target as HTMLInputElement).value) form.requestSubmit();
    });
    // Busca aplicada sozinha depois de uma pausa na digitação (UX-105)
    let timer: number | undefined;
    busca?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => form.requestSubmit(), 600);
    });
  });

  // Painéis de filtro (details) fecham ao clicar fora
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.toolbar details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .toolbar-filters {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
  }

  .search-box,
  .filter-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 300px;
    height: 40px;
    background: var(--color-white);
    border: 1px solid var(--color-border-input);
    border-radius: var(--border-radius-sm);
  }

  .search-box input,
  .filter-box select {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    outline: none;
    font-size: 14px;
    color: var(--color-neutral-80);
    padding: 0 14px 0 48px;
  }

  .filter-box select {
    appearance: none;
    cursor: pointer;
  }

  .search-box:focus-within,
  .filter-box:focus-within {
    border-color: var(--color-primary-50);
    box-shadow: 0 0 0 1px var(--color-primary-50);
  }

  .search-box :global(.search-icon),
  .filter-box :global(.filter-icon) {
    position: absolute;
    left: 16px;
    color: var(--color-neutral-65);
    pointer-events: none;
  }

  .toolbar-actions {
    display: flex;
    gap: 12px;
  }

  @media (max-width: 768px) {
    .toolbar {
      gap: 12px;
      margin-bottom: 16px;
    }

    .toolbar-filters {
      width: 100%;
      gap: 10px;
    }

    .search-box,
    .filter-box {
      width: 100%;
    }

    .toolbar-actions {
      width: 100%;
      flex-wrap: wrap;
    }

    .toolbar-actions :global(.btn) {
      flex: 1;
    }

    .toolbar-actions > :global(details) {
      width: 100%;
    }

    .toolbar-actions > :global(details .btn) {
      width: 100%;
    }
  }
</style>

---
// Barra padrão das listagens: busca + filtros (select) à esquerda, ações à direita.
// Envia via GET, preservando os parâmetros da URL; a paginação volta para a página 1.
import Icon from './Icon.astro';

interface FilterOption {
  value: string;
  label: string;
}

interface Filter {
  name: string;
  placeholder: string;
  options: FilterOption[];
}

interface Props {
  searchPlaceholder?: string;
  searchParam?: string;
  filter?: Filter;
  /** Filtros adicionais, depois de `filter` */
  filters?: Filter[];
  showSearch?: boolean;
}

const { searchPlaceholder = 'Pesquisar', searchParam = 'q', filter, filters = [], showSearch = true } = Astro.props;
const todos = [filter, ...filters].filter((f): f is Filter => Boolean(f));
const params = Astro.url.searchParams;
const q = params.get(searchParam) ?? '';
const preserved = [...params.entries()].filter(
  ([key]) => key !== searchParam && key !== 'page' && !todos.some((f) => f.name === key)
);
---

<div class="toolbar">
  <form method="get" class="toolbar-filters" data-toolbar>
    {preserved.map(([key, value]) => <input type="hidden" name={key} value={value} />)}
    {showSearch && (
      <label class="search-box">
        <Icon name="search" size={16} class="search-icon" />
        <span class="sr-only">{searchPlaceholder}</span>
        <input type="search" name={searchParam} value={q} placeholder={searchPlaceholder} autocomplete="off" />
      </label>
    )}
    {todos.map((f) => (
      <label class="filter-box">
        <Icon name="chevron-down" size={16} class="filter-icon" />
        <span class="sr-only">{f.placeholder}</span>
        <select name={f.name} data-autosubmit>
          <option value="">{f.placeholder}</option>
          {f.options.map((opt) => (
            <option value={opt.value} selected={opt.value === (params.get(f.name) ?? '')}>{opt.label}</option>
          ))}
        </select>
      </label>
    ))}
  </form>
  <div class="toolbar-actions">
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-toolbar]').forEach((form) => {
    form.querySelectorAll('[data-autosubmit]').forEach((el) => {
      el.addEventListener('change', () => form.requestSubmit());
    });
    const busca = form.querySelector<HTMLInputElement>('input[type="search"]');
    // Limpar a busca (botão "x" do input search) recarrega a lista
    busca?.addEventListener('search', (e) => {
      if (!(e.target as HTMLInputElement).value) form.requestSubmit();
    });
    // Busca aplicada sozinha depois de uma pausa na digitação (UX-105)
    let timer: number | undefined;
    busca?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => form.requestSubmit(), 600);
    });
  });

  // Painéis de filtro (details) fecham ao clicar fora
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.toolbar details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>

<style>
  /* Toolbar do design system: busca + filtros à esquerda, ações à direita com o primário por último */
  .toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .toolbar-filters {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 auto;
    min-width: 0;
    flex-wrap: wrap;
  }

  .search-box,
  .filter-box {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--control-h-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .search-box {
    width: 300px;
  }

  .filter-box {
    width: 220px;
  }

  .search-box:hover,
  .filter-box:hover {
    border-color: var(--clay-400);
  }

  .search-box input,
  .filter-box select {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    outline: none;
    box-shadow: none;
    font-size: var(--fs-14);
    color: var(--text-strong);
  }

  .search-box input {
    padding: 0 var(--space-3) 0 36px;
  }

  .search-box input::placeholder {
    color: var(--text-placeholder);
  }

  .filter-box select {
    appearance: none;
    -webkit-appearance: none;
    padding: 0 36px 0 var(--space-3);
    cursor: pointer;
  }

  /* Filtro sem escolha mostra o rótulo como placeholder */
  .filter-box select:has(option[value='']:checked) {
    color: var(--text-placeholder);
  }

  .search-box:focus-within,
  .filter-box:focus-within {
    border-color: var(--border-focus);
    box-shadow: var(--focus-ring);
  }

  .search-box :global(.search-icon),
  .filter-box :global(.filter-icon) {
    position: absolute;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-box :global(.search-icon) {
    left: var(--space-3);
  }

  .filter-box :global(.filter-icon) {
    right: var(--space-3);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-left: auto;
  }

  .toolbar-actions:empty {
    display: none;
  }

  @media (max-width: 768px) {
    .toolbar {
      gap: 12px;
      margin-bottom: 16px;
    }

    .toolbar-filters {
      width: 100%;
      gap: 10px;
    }

    .search-box,
    .filter-box {
      width: 100%;
    }

    .toolbar-actions {
      width: 100%;
      margin-left: 0;
    }

    .toolbar-actions :global(.btn) {
      flex: 1;
    }

    .toolbar-actions > :global(details) {
      width: 100%;
    }

    .toolbar-actions > :global(details .btn) {
      width: 100%;
    }
  }
</style>

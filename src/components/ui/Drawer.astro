---
// Painel lateral de criação/edição, no padrão dos frames: título à esquerda, EXCLUIR/SALVAR à direita.
//
// Abrir:   <button data-drawer-open="drawer-x" data-values='{"id":"…","nome":"…"}'>Editar</button>
//          Sem data-values, o formulário abre limpo (modo criação).
// Os valores preenchem os campos do form pelo atributo name (checkbox múltiplo aceita array).
// O form deve ter o id informado em formId; SALVAR envia _action=save e EXCLUIR envia _action=delete.
// Evento "drawer:open" (detail: { values }) permite ajustes específicos da página.
import Icon from './Icon.astro';

interface Props {
  id: string;
  formId: string;
  title: string;
  editTitle?: string;
  deletable?: boolean;
  deleteConfirm?: string;
  width?: 'md' | 'lg';
  /** Rótulo e _action do botão principal (padrão: Salvar / save) */
  saveLabel?: string;
  saveAction?: string;
}

const {
  id,
  formId,
  title,
  editTitle = title,
  deletable = true,
  deleteConfirm = 'Tem certeza que deseja excluir este registro?',
  width = 'lg',
  saveLabel = 'Salvar',
  saveAction = 'save',
} = Astro.props;
---

<div id={id} class="drawer-backdrop" data-drawer hidden data-title={title} data-edit-title={editTitle} data-form={formId}>
  <aside class:list={['drawer', `drawer-${width}`]} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
    <header class="drawer-header">
      <h2 id={`${id}-title`} class="drawer-title">{title}</h2>
      <div class="drawer-actions">
        <slot name="actions" />
        {deletable && (
          <button
            type="submit"
            form={formId}
            name="_action"
            value="delete"
            formnovalidate
            class="btn btn-outline btn-md drawer-delete"
            data-confirm={deleteConfirm}
            data-edit-only
          >
            Excluir
          </button>
        )}
        <button type="submit" form={formId} name="_action" value={saveAction} class="btn btn-success btn-md" data-drawer-save>{saveLabel}</button>
        <button type="button" class="drawer-close" data-drawer-close aria-label="Fechar">
          <Icon name="close" size={22} />
        </button>
      </div>
    </header>
    <div class="drawer-body">
      <slot />
    </div>
  </aside>
</div>

<script>
  type Values = Record<string, unknown>;

  function fillForm(form: HTMLFormElement, values: Values) {
    form.reset();
    for (const [name, value] of Object.entries(values)) {
      const field = form.elements.namedItem(name);
      if (!field) continue;
      if (field instanceof RadioNodeList) {
        const list = Array.isArray(value) ? value.map(String) : [String(value)];
        field.forEach((node) => {
          if (node instanceof HTMLInputElement) node.checked = list.includes(node.value);
        });
      } else if (field instanceof HTMLInputElement && field.type === 'checkbox') {
        field.checked = Array.isArray(value) ? value.map(String).includes(field.value) : Boolean(value);
      } else if ('value' in field) {
        (field as HTMLInputElement).value = value === null || value === undefined ? '' : String(value);
      }
    }
  }

  function openDrawer(drawer: HTMLElement, values: Values | null) {
    const form = document.getElementById(drawer.dataset.form!) as HTMLFormElement | null;
    const isEdit = Boolean(values && values.id);
    if (form) {
      form.reset();
      form.querySelectorAll<HTMLInputElement>('input[type="hidden"][data-reset]').forEach((i) => (i.value = ''));
      if (values) fillForm(form, values);
      else {
        const idField = form.elements.namedItem('id');
        if (idField instanceof HTMLInputElement) idField.value = '';
      }
    }
    drawer.querySelector('.drawer-title')!.textContent = isEdit ? drawer.dataset.editTitle! : drawer.dataset.title!;
    drawer.classList.toggle('is-edit', isEdit);
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('open'));
    drawer.dispatchEvent(new CustomEvent('drawer:open', { detail: { values: values ?? {} }, bubbles: true }));
    const first = drawer.querySelector<HTMLElement>('.drawer-body input:not([type=hidden]), .drawer-body select, .drawer-body textarea');
    first?.focus({ preventScroll: true });
  }

  function closeDrawer(drawer: HTMLElement) {
    drawer.classList.remove('open');
    setTimeout(() => (drawer.hidden = true), 250);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-drawer-open]');
    if (opener) {
      const drawer = document.getElementById(opener.dataset.drawerOpen!);
      if (drawer) {
        e.preventDefault();
        const values = opener.dataset.values ? (JSON.parse(opener.dataset.values) as Values) : null;
        openDrawer(drawer, values);
      }
      return;
    }
    const closer = target.closest<HTMLElement>('[data-drawer-close]');
    if (closer) {
      const drawer = closer.closest<HTMLElement>('[data-drawer]');
      if (drawer) closeDrawer(drawer);
      return;
    }
    if (target.matches('[data-drawer]')) closeDrawer(target);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('[data-drawer].open').forEach(closeDrawer);
  });
</script>

<style>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    background: rgba(40, 20, 16, 0.45);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .drawer-backdrop[hidden] {
    display: none;
  }

  .drawer-backdrop.open {
    opacity: 1;
  }

  .drawer {
    height: 100%;
    max-width: 100%;
    background: var(--color-white);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .drawer-lg { width: 900px; }
  .drawer-md { width: 600px; }

  .drawer-backdrop.open .drawer {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 36px 20px 42px;
    border-bottom: 1px solid var(--border-color);
  }

  .drawer-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-neutral-80);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .drawer-backdrop:not(.is-edit) :global([data-edit-only]) {
    display: none;
  }

  .drawer-close {
    display: inline-flex;
    padding: 6px;
    margin-left: 4px;
    border: none;
    background: none;
    color: var(--color-neutral-50);
    cursor: pointer;
    border-radius: 50%;
  }

  .drawer-close:hover {
    background: var(--color-neutral-20);
    color: var(--color-neutral-80);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 36px 42px 48px;
  }
</style>

---
// Painel lateral de criação/edição (Drawer do design system): título à esquerda, Excluir/Salvar no cabeçalho.
//
// Abrir:   <button data-drawer-open="drawer-x" data-values='{"id":"…","nome":"…"}'>Editar</button>
//          Sem data-values, o formulário abre limpo (modo criação).
// Os valores preenchem os campos do form pelo atributo name (checkbox múltiplo aceita array).
// O form deve ter o id informado em formId; SALVAR envia _action=save e EXCLUIR envia _action=delete.
// Evento "drawer:open" (detail: { values }) permite ajustes específicos da página.
// O envio é feito por fetch (Accept: application/json, ver handleFormPost): em erro o painel continua aberto,
// com a mensagem no topo e junto de cada campo; em sucesso a página recarrega com o flash.
// Fechar com alterações não salvas pede confirmação. data-drawer-nativo no form mantém o POST tradicional.
import Icon from './Icon.astro';

interface Props {
  id: string;
  formId: string;
  title: string;
  editTitle?: string;
  deletable?: boolean;
  deleteConfirm?: string;
  width?: 'md' | 'lg';
  /** Rótulo e _action do botão principal (padrão: Salvar / save) */
  saveLabel?: string;
  saveAction?: string;
  /** Rótulo do botão principal enquanto envia (padrão: Salvando…) */
  saveLoadingLabel?: string;
}

const {
  id,
  formId,
  title,
  editTitle = title,
  deletable = true,
  deleteConfirm = 'Tem certeza que deseja excluir este registro?',
  width = 'lg',
  saveLabel = 'Salvar',
  saveAction = 'save',
  saveLoadingLabel = 'Salvando…',
} = Astro.props;
---

<div id={id} class="drawer-backdrop" data-drawer hidden data-title={title} data-edit-title={editTitle} data-form={formId}>
  <aside class:list={['drawer', `drawer-${width}`]} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
    <header class="drawer-header">
      <h2 id={`${id}-title`} class="drawer-title">{title}</h2>
      <div class="drawer-actions">
        <slot name="actions" />
        {deletable && (
          <button
            type="submit"
            form={formId}
            name="_action"
            value="delete"
            formnovalidate
            class="btn btn-danger btn-sm drawer-delete"
            data-confirm={deleteConfirm}
            data-carregando="Excluindo…"
            data-edit-only
          >
            Excluir
          </button>
        )}
        <button type="submit" form={formId} name="_action" value={saveAction} class="btn btn-primary btn-sm" data-drawer-save data-carregando={saveLoadingLabel}>{saveLabel}</button>
        <button type="button" class="drawer-close" data-drawer-close aria-label="Fechar">
          <Icon name="x" size={18} />
        </button>
      </div>
    </header>
    <div class="drawer-body">
      <slot />
    </div>
  </aside>
</div>

<script>
  import { confirmar, emCarregamento, limparErroDoCampo, limparErrosDosCampos, marcarErrosNosCampos } from '../../lib/ui';

  type Values = Record<string, unknown>;
  type RespostaForm = { ok: true; redirect: string } | { ok: false; error: string; fields?: Record<string, string> };

  const formDo = (drawer: HTMLElement) => document.getElementById(drawer.dataset.form!) as HTMLFormElement | null;

  // Instantâneo do formulário ao abrir: fechar com alterações pede confirmação
  const instantaneos = new WeakMap<HTMLElement, string>();
  function serializar(form: HTMLFormElement): string {
    return JSON.stringify([...new FormData(form)].map(([k, v]) => [k, typeof v === 'string' ? v : `${v.name}:${v.size}`]));
  }
  const alterado = (drawer: HTMLElement) => {
    const form = formDo(drawer);
    return Boolean(form && instantaneos.has(drawer) && instantaneos.get(drawer) !== serializar(form));
  };

  function fillForm(form: HTMLFormElement, values: Values) {
    form.reset();
    for (const [name, value] of Object.entries(values)) {
      const field = form.elements.namedItem(name);
      if (!field) continue;
      if (field instanceof RadioNodeList) {
        const list = Array.isArray(value) ? value.map(String) : [String(value)];
        field.forEach((node) => {
          if (node instanceof HTMLInputElement) node.checked = list.includes(node.value);
        });
      } else if (field instanceof HTMLInputElement && field.type === 'checkbox') {
        field.checked = Array.isArray(value) ? value.map(String).includes(field.value) : Boolean(value);
      } else if ('value' in field) {
        (field as HTMLInputElement).value = value === null || value === undefined ? '' : String(value);
      }
    }
  }

  // ---------- Erros vindos do servidor: no topo do painel e junto de cada campo ----------
  function limparErros(drawer: HTMLElement) {
    drawer.querySelector('.drawer-erro')?.remove();
    limparErrosDosCampos(drawer);
  }

  function mostrarErros(drawer: HTMLElement, form: HTMLFormElement, mensagem: string, campos: Record<string, string> = {}) {
    limparErros(drawer);
    const topo = document.createElement('div');
    topo.className = 'drawer-erro';
    topo.setAttribute('role', 'alert');
    topo.textContent = mensagem;
    drawer.querySelector('.drawer-body')!.prepend(topo);
    const primeiro = marcarErrosNosCampos(form, campos);
    // Um erro só de campo repete a mensagem no topo; basta o destaque no campo
    if (primeiro && Object.keys(campos).length === 1 && Object.values(campos)[0] === mensagem) topo.remove();
    if (primeiro) primeiro.focus();
    else topo.scrollIntoView({ block: 'nearest' });
  }

  // ---------- Abrir e fechar ----------
  // Com um painel aberto, o resto da página fica inerte (Tab não passeia por trás) e o foco volta a quem abriu.
  // O drawer pode estar em qualquer ponto da página: inertamos os irmãos de cada ancestral dele,
  // preservando toasts e o modal de confirmação (dialog).
  let focoAnterior: HTMLElement | null = null;
  let inertados: HTMLElement[] = [];
  function isolarFundo(drawer: HTMLElement | null) {
    inertados.forEach((el) => el.removeAttribute('inert'));
    inertados = [];
    let no: HTMLElement | null = drawer;
    while (no && no !== document.body) {
      const pai: HTMLElement | null = no.parentElement;
      if (!pai) break;
      for (const irmao of pai.children) {
        if (irmao === no || !(irmao instanceof HTMLElement)) continue;
        if (irmao.matches('dialog, .toast-root, script, style, link') || irmao.hasAttribute('inert')) continue;
        irmao.setAttribute('inert', '');
        inertados.push(irmao);
      }
      no = pai;
    }
  }

  function openDrawer(drawer: HTMLElement, values: Values | null) {
    focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    isolarFundo(drawer);
    const form = formDo(drawer);
    const isEdit = Boolean(values && values.id);
    limparErros(drawer);
    if (form) {
      form.reset();
      form.querySelectorAll<HTMLInputElement>('input[type="hidden"][data-reset]').forEach((i) => (i.value = ''));
      if (values) fillForm(form, values);
      else {
        const idField = form.elements.namedItem('id');
        if (idField instanceof HTMLInputElement) idField.value = '';
      }
    }
    drawer.querySelector('.drawer-title')!.textContent = isEdit ? drawer.dataset.editTitle! : drawer.dataset.title!;
    drawer.classList.toggle('is-edit', isEdit);
    drawer.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('open'));
    drawer.dispatchEvent(new CustomEvent('drawer:open', { detail: { values: values ?? {} }, bubbles: true }));
    // Depois dos ajustes da página (drawer:open), o estado atual é o "não alterado"
    setTimeout(() => form && instantaneos.set(drawer, serializar(form)));
    const first = drawer.querySelector<HTMLElement>('.drawer-body input:not([type=hidden]), .drawer-body select, .drawer-body textarea');
    first?.focus({ preventScroll: true });
  }

  function closeDrawer(drawer: HTMLElement) {
    drawer.classList.remove('open');
    instantaneos.delete(drawer);
    isolarFundo(null);
    focoAnterior?.focus({ preventScroll: true });
    focoAnterior = null;
    setTimeout(() => (drawer.hidden = true), 250);
  }

  async function pedirParaFechar(drawer: HTMLElement) {
    if (alterado(drawer)) {
      const sim = await confirmar({
        titulo: 'Descartar as alterações?',
        texto: 'O que foi digitado neste painel ainda não foi salvo.',
        confirmar: 'Descartar',
        cancelar: 'Continuar editando',
        perigo: true,
      });
      if (!sim) return;
    }
    closeDrawer(drawer);
  }

  // ---------- Envio por fetch: em erro o painel continua aberto com o que foi digitado ----------
  async function enviar(drawer: HTMLElement, form: HTMLFormElement, submitter: HTMLElement | null) {
    // Antes de desabilitar os botões: botão desabilitado não entra no FormData (perderia o _action)
    const corpo = new FormData(form, submitter);
    const botao = submitter instanceof HTMLButtonElement ? submitter : null;
    const rotulo = botao?.dataset.carregando || 'Salvando…';
    const restaurar = botao ? emCarregamento(botao, rotulo) : () => {};
    drawer.querySelectorAll<HTMLButtonElement>('.drawer-actions button[type=submit]').forEach((b) => (b.disabled = true));
    let concluido = false;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: corpo,
        headers: { Accept: 'application/json' },
        redirect: 'manual',
      });
      // Página que ainda não responde JSON: segue o fluxo antigo (recarrega e mostra o flash)
      if (res.type === 'opaqueredirect' || !(res.headers.get('Content-Type') ?? '').includes('application/json')) {
        concluido = true;
        window.location.reload();
        return;
      }
      const dados = (await res.json()) as RespostaForm;
      if (dados.ok) {
        concluido = true;
        instantaneos.delete(drawer);
        window.location.assign(dados.redirect);
        return;
      }
      mostrarErros(drawer, form, dados.error, dados.fields);
    } catch {
      mostrarErros(drawer, form, 'Não foi possível salvar. Verifique a conexão e tente novamente.');
    } finally {
      // Sucesso: mantém os botões travados até a página trocar
      if (!concluido) {
        restaurar();
        drawer.querySelectorAll<HTMLButtonElement>('.drawer-actions button[type=submit]').forEach((b) => (b.disabled = false));
      }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-drawer]').forEach((drawer) => {
    const form = formDo(drawer);
    if (!form || form.hasAttribute('data-drawer-nativo')) return;
    form.addEventListener('submit', (e) => {
      // Respeita validações da página que já cancelaram o envio
      if (e.defaultPrevented) return;
      e.preventDefault();
      enviar(drawer, form, (e as SubmitEvent).submitter);
    });
    form.addEventListener('input', (e) => limparErroDoCampo(e.target as HTMLElement));
    form.addEventListener('change', (e) => limparErroDoCampo(e.target as HTMLElement));
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-drawer-open]');
    if (opener) {
      const drawer = document.getElementById(opener.dataset.drawerOpen!);
      if (drawer) {
        e.preventDefault();
        const values = opener.dataset.values ? (JSON.parse(opener.dataset.values) as Values) : null;
        openDrawer(drawer, values);
      }
      return;
    }
    const closer = target.closest<HTMLElement>('[data-drawer-close]');
    if (closer) {
      const drawer = closer.closest<HTMLElement>('[data-drawer]');
      if (drawer) pedirParaFechar(drawer);
      return;
    }
    if (target.matches('[data-drawer]')) pedirParaFechar(target);
  });

  // Foco preso: Tab circula pelos controles do painel aberto
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const aberto = document.querySelector<HTMLElement>('[data-drawer].open');
    if (!aberto || document.querySelector('dialog[open]')) return;
    const focaveis = [
      ...aberto.querySelectorAll<HTMLElement>(
        'a[href], button:not(:disabled), input:not([type="hidden"]):not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex="-1"])'
      ),
    ].filter((el) => el.offsetParent !== null);
    if (!focaveis.length) return;
    const primeiro = focaveis[0];
    const ultimo = focaveis[focaveis.length - 1];
    const atual = document.activeElement;
    if (e.shiftKey && atual === primeiro) {
      e.preventDefault();
      ultimo.focus();
    } else if (!e.shiftKey && atual === ultimo) {
      e.preventDefault();
      primeiro.focus();
    } else if (!aberto.contains(atual)) {
      e.preventDefault();
      primeiro.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    // Esc com o modal de confirmação aberto fecha só o modal
    if (e.key !== 'Escape' || document.querySelector('dialog[open]')) return;
    const abertos = document.querySelectorAll<HTMLElement>('[data-drawer].open');
    if (!abertos.length) return;
    // Sem isso, o mesmo Esc fecharia na hora o modal de confirmação aberto a seguir
    e.preventDefault();
    abertos.forEach(pedirParaFechar);
  });
</script>

<style>
  /* Drawer do design system: scrim quente com blur, painel com sombra xl, cabeçalho de 64px com as ações */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    background: var(--bg-overlay);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .drawer-backdrop[hidden] {
    display: none;
  }

  .drawer-backdrop.open {
    opacity: 1;
  }

  .drawer {
    height: 100%;
    max-width: 100%;
    background: var(--bg-surface);
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    transform: translateX(24px);
    opacity: 0.4;
    transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out);
  }

  .drawer-lg { width: 720px; }
  .drawer-md { width: var(--drawer-width); }

  .drawer-backdrop.open .drawer {
    transform: none;
    opacity: 1;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--header-height);
    padding: 0 var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--border-default);
    flex: none;
  }

  .drawer-title {
    font-size: var(--fs-18);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drawer-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .drawer-backdrop:not(.is-edit) :global([data-edit-only]),
  .drawer-backdrop.is-edit :global([data-create-only]) {
    display: none;
  }

  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-md);
    height: var(--control-h-md);
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .drawer-close:hover {
    background: var(--action-ghost-hover);
    color: var(--text-strong);
  }

  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer {
      transition: none;
    }
  }

  /* Celular: painel em tela cheia */
  @media (max-width: 768px) {
    .drawer-lg,
    .drawer-md {
      width: 100%;
    }

    .drawer-header {
      flex-wrap: wrap;
      padding: 12px 16px;
    }

    .drawer-body {
      padding: 20px 16px calc(32px + env(safe-area-inset-bottom));
    }
  }
</style>

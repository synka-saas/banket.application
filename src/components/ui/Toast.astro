---
import type { Flash } from '../../lib/flash';

interface Props {
  flash: Flash | null;
}

const { flash } = Astro.props;
---

<div id="toast-root" class="toast-root" aria-live="polite" data-flash={flash ? JSON.stringify(flash) : undefined}></div>

<script>
  // API global: window.banketToast(mensagem, tipo, { acao }) — use toast() de lib/ui.ts.
  // Erros ficam até o usuário fechar (role="alert"); sucesso e informação somem sozinhos, pausando com o mouse em cima.
  import type { ToastOpcoes, ToastTipo } from '../../lib/ui';
  import { svgIcone } from '../../lib/icones';

  const DURACAO = 5000;
  const root = document.getElementById('toast-root')!;

  function dismiss(el: HTMLElement) {
    if (el.classList.contains('leaving')) return;
    el.classList.add('leaving');
    setTimeout(() => el.remove(), 300);
  }

  function show(message: string, type: ToastTipo = 'info', opcoes: ToastOpcoes = {}) {
    const el = document.createElement('div');
    el.className = `toast toast-${type}`;
    el.setAttribute('role', type === 'error' ? 'alert' : 'status');

    const texto = document.createElement('span');
    texto.className = 'toast-texto';
    texto.textContent = message;
    el.appendChild(texto);

    if (opcoes.acao) {
      const { rotulo, executar } = opcoes.acao;
      const acao = document.createElement('button');
      acao.type = 'button';
      acao.className = 'toast-acao';
      acao.textContent = rotulo;
      acao.addEventListener('click', () => {
        dismiss(el);
        executar();
      });
      el.appendChild(acao);
    }

    const fechar = document.createElement('button');
    fechar.type = 'button';
    fechar.className = 'toast-fechar';
    fechar.setAttribute('aria-label', 'Fechar aviso');
    fechar.innerHTML = svgIcone('x', 16);
    fechar.addEventListener('click', () => dismiss(el));
    el.appendChild(fechar);

    root.appendChild(el);

    // Erro fica até fechar; com ação (ex.: Desfazer) o prazo é maior
    if (type !== 'error') {
      let restante = opcoes.acao ? DURACAO * 2 : DURACAO;
      let inicio = Date.now();
      let timer = window.setTimeout(() => dismiss(el), restante);
      el.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        restante -= Date.now() - inicio;
      });
      el.addEventListener('mouseleave', () => {
        inicio = Date.now();
        timer = window.setTimeout(() => dismiss(el), Math.max(restante, 1500));
      });
    }
  }

  window.banketToast = show;

  // Mensagem do flash (POST → redirect)
  if (root.dataset.flash) {
    try {
      const flash = JSON.parse(root.dataset.flash) as { type: ToastTipo; message: string };
      show(flash.message, flash.type);
    } catch {
      // flash inválido: ignora
    }
  }
</script>

<style is:global>
  /* Embaixo à direita: não cobre os botões do cabeçalho dos drawers */
  .toast-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    pointer-events: none;
  }

  .toast {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 280px;
    max-width: 440px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    box-shadow: var(--shadow-lg);
    background: var(--bg-surface);
    color: var(--text-heading);
    animation: toast-in var(--dur-slow) var(--ease-out);
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }

  /* Marca de situação: ponto colorido antes do texto */
  .toast::before {
    content: '';
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--clay-400);
  }

  .toast-texto {
    flex: 1;
  }

  .toast-acao {
    height: var(--control-h-sm);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-700);
    font: inherit;
    font-size: var(--fs-13);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .toast-acao:hover {
    background: var(--bg-accent-soft);
    color: var(--terracotta-800);
  }

  .toast-fechar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    flex-shrink: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .toast-fechar:hover {
    background: var(--action-ghost-hover);
    color: var(--text-strong);
  }

  .toast.leaving {
    opacity: 0;
    transform: translateX(16px);
  }

  .toast-success::before { background: var(--sage-500); }
  .toast-info::before { background: var(--cobalt-500); }
  .toast-error {
    border-color: var(--danger-border);
    background: var(--danger-bg);
    color: var(--wine-700);
  }
  .toast-error::before { background: var(--wine-500); }

  @media (max-width: 640px) {
    /* Acima da barra de navegação inferior */
    .toast-root {
      left: 16px;
      right: 16px;
      bottom: calc(76px + env(safe-area-inset-bottom));
      align-items: stretch;
    }

    .toast {
      min-width: 0;
      max-width: none;
    }
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

---
import type { Flash } from '../../lib/flash';

interface Props {
  flash: Flash | null;
}

const { flash } = Astro.props;
---

<div id="toast-root" class="toast-root" aria-live="polite">
  {flash && <div class:list={['toast', `toast-${flash.type}`]} role="status">{flash.message}</div>}
</div>

<script>
  // API global para feedback em telas interativas: window.banketToast('Salvo!', 'success')
  type ToastType = 'success' | 'error' | 'info';
  const root = document.getElementById('toast-root')!;

  function dismiss(el: Element) {
    el.classList.add('leaving');
    setTimeout(() => el.remove(), 300);
  }

  function show(message: string, type: ToastType = 'info') {
    const el = document.createElement('div');
    el.className = `toast toast-${type}`;
    el.setAttribute('role', 'status');
    el.textContent = message;
    root.appendChild(el);
    setTimeout(() => dismiss(el), 4500);
  }

  (window as unknown as { banketToast: typeof show }).banketToast = show;
  root.querySelectorAll('.toast').forEach((el) => setTimeout(() => dismiss(el), 4500));
</script>

<style is:global>
  .toast-root {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  .toast {
    pointer-events: auto;
    min-width: 280px;
    max-width: 420px;
    padding: 14px 18px;
    border-radius: var(--border-radius);
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    background: var(--color-white);
    border-left: 4px solid var(--color-neutral-50);
    color: var(--color-neutral-80);
    animation: toast-in 0.25s ease;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .toast.leaving {
    opacity: 0;
    transform: translateX(16px);
  }

  .toast-success { border-left-color: var(--color-secondary); }
  .toast-error { border-left-color: var(--color-primary); color: var(--color-primary-60); }
  .toast-info { border-left-color: var(--color-neutral-65); }

  @keyframes toast-in {
    from { opacity: 0; transform: translateX(16px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>

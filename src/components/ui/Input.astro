---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = Omit<HTMLAttributes<'input'>, 'type'> & {
  id: string;
  name: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'date';
  label?: string;
  placeholder?: string;
  value?: string;
  icon?: string;
  error?: string;
  required?: boolean;
};

const { 
  id, 
  name, 
  type = 'text', 
  label, 
  placeholder, 
  value = '', 
  icon, 
  error,
  required = false,
  ...rest
} = Astro.props;
---

<div class="input-group">
  {label && (
    <label for={id} class="input-label">
      {label} {required && <span class="required">*</span>}
    </label>
  )}
  
  <div class={`input-wrapper ${error ? 'has-error' : ''}`}>
    {icon && <Icon name={icon} size={18} class="input-icon" />}
    <input
      type={type}
      id={id}
      name={name}
      class:list={['input-field', { 'with-icon': icon, 'with-toggle': type === 'password' }]}
      placeholder={placeholder}
      value={value}
      required={required}
      {...rest}
    />
    {type === 'password' && (
      <button type="button" class="toggle-senha" aria-label="Mostrar senha" aria-pressed="false" data-toggle-senha>
        <Icon name="visibility" size={20} />
      </button>
    )}
  </div>
  
  {error && <span class="input-error">{error}</span>}
</div>

<script>
  // Mostrar/ocultar senha (botão com ícone de olho dentro do campo)
  document.addEventListener('click', (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle-senha]');
    const campo = botao?.parentElement?.querySelector('input');
    if (!botao || !campo) return;
    const mostrar = campo.type === 'password';
    campo.type = mostrar ? 'text' : 'password';
    botao.setAttribute('aria-pressed', String(mostrar));
    botao.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
    const icone = botao.querySelector('.icon');
    if (icone) icone.textContent = mostrar ? 'visibility_off' : 'visibility';
  });
</script>

<style>
  .input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
    font-family: 'Open Sans', sans-serif;
  }

  .input-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-neutral-80);
    margin-bottom: 8px;
  }

  .required {
    color: #E35336;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-field {
    width: 100%;
    padding: 10px 12px;
    font-size: 14px;
    color: var(--color-neutral-80);
    background-color: var(--color-white);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-field:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(227, 83, 54, 0.1);
  }

  .input-field.with-icon {
    padding-left: 36px;
  }

  .input-field.with-toggle {
    padding-right: 44px;
  }

  .toggle-senha {
    position: absolute;
    right: 8px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-neutral-65);
    cursor: pointer;
  }

  .input-icon {
    position: absolute;
    left: 12px;
    color: var(--color-neutral-40);
    pointer-events: none;
  }

  .has-error .input-field {
    border-color: #E35336;
  }

  .input-error {
    font-size: 12px;
    color: #E35336;
    margin-top: 4px;
  }
</style>

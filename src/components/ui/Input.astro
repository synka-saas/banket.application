---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Props = Omit<HTMLAttributes<'input'>, 'type'> & {
  id: string;
  name: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'date';
  label?: string;
  placeholder?: string;
  value?: string;
  icon?: string;
  error?: string;
  required?: boolean;
};

const { 
  id, 
  name, 
  type = 'text', 
  label, 
  placeholder, 
  value = '', 
  icon, 
  error,
  required = false,
  ...rest
} = Astro.props;
---

<div class="input-group">
  {label && (
    <label for={id} class="input-label">
      {label} {required && <span class="required">*</span>}
    </label>
  )}
  
  <div class={`input-wrapper ${error ? 'has-error' : ''}`}>
    {icon && <Icon name={icon} size={16} class="input-icon" />}
    <input
      type={type}
      id={id}
      name={name}
      class:list={['input-field', { 'with-icon': icon, 'with-toggle': type === 'password' }]}
      placeholder={placeholder}
      value={value}
      required={required}
      {...rest}
    />
    {type === 'password' && (
      <button type="button" class="toggle-senha" aria-label="Mostrar senha" aria-pressed="false" data-toggle-senha>
        <Icon name="eye" size={18} />
      </button>
    )}
  </div>
  
  {error && <span class="input-error">{error}</span>}
</div>

<script>
  import { svgIcone } from '../../lib/icones';

  // Mostrar/ocultar senha (botão com ícone de olho dentro do campo)
  document.addEventListener('click', (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle-senha]');
    const campo = botao?.parentElement?.querySelector('input');
    if (!botao || !campo) return;
    const mostrar = campo.type === 'password';
    campo.type = mostrar ? 'text' : 'password';
    botao.setAttribute('aria-pressed', String(mostrar));
    botao.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
    botao.innerHTML = svgIcone(mostrar ? 'eye-off' : 'eye', 18);
  });
</script>

<style>
  .input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    margin-bottom: var(--space-4);
  }

  .input-label {
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    line-height: 1.3;
    color: var(--text-heading);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-field {
    width: 100%;
    height: var(--control-h-md);
    padding: 0 var(--space-3);
    font-size: var(--fs-14);
    color: var(--text-strong);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    outline: none;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .input-field::placeholder {
    color: var(--text-placeholder);
  }

  .input-field:hover {
    border-color: var(--clay-400);
  }

  .input-field:focus {
    border-color: var(--border-focus);
    box-shadow: var(--focus-ring);
  }

  .input-field.with-icon {
    padding-left: 36px;
  }

  .input-field.with-toggle {
    padding-right: 44px;
  }

  .toggle-senha {
    position: absolute;
    right: 4px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .toggle-senha:hover {
    background: var(--action-ghost-hover);
    color: var(--text-strong);
  }

  .input-icon {
    position: absolute;
    left: var(--space-3);
    color: var(--text-muted);
    pointer-events: none;
  }

  .has-error .input-field {
    border-color: var(--wine-500);
  }

  .has-error .input-field:focus {
    box-shadow: 0 0 0 3px rgba(178, 58, 58, 0.18);
  }

  .input-error {
    font-size: var(--fs-12);
    line-height: 1.4;
    color: var(--danger);
  }
</style>

---
// Card de catálogo (CatalogCard do design system): ícone + título, linhas rótulo/valor, tags e ação no rodapé.
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
  rows?: { label: string; value: string }[];
  tags?: string[];
  /** Texto de apoio sob o título (13px). Para marcação própria, use o slot "subtitle". */
  description?: string;
  muted?: boolean;
  class?: string;
}

const { title, icon = 'salad', rows = [], tags = [], description, muted = false, class: className } = Astro.props;
const ehVazio = (v: string) => v === '—' || v === '-' || v === '';
---

<article class:list={['info-card', { muted }, className]}>
  <header class="info-card-head">
    <Icon name={icon} size={20} class="info-card-icon" />
    <div class="info-card-titles">
      <h3 class="info-card-title"><span>{title}</span></h3>
      {description && <p class="info-card-desc">{description}</p>}
      <slot name="subtitle" />
    </div>
    {Astro.slots.has('status') && <div class="info-card-status"><slot name="status" /></div>}
  </header>
  {rows.length > 0 && (
    <dl class="info-card-rows">
      {rows.map((r) => (
        <div class="info-card-row">
          <dt>{r.label}</dt>
          <dd class:list={{ vazio: ehVazio(r.value) }}>{ehVazio(r.value) ? '—' : r.value}</dd>
        </div>
      ))}
    </dl>
  )}
  <slot />
  {tags.length > 0 && (
    <div class="tag-list info-card-tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
  <div class="info-card-footer">
    <slot name="footer" />
  </div>
</article>

<style>
  /* Card de catálogo do design system: ícone em quadro, título 17/500, linhas rótulo → valor, tags e ação no rodapé */
  .info-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    padding: var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .info-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .info-card.muted {
    opacity: 0.6;
  }

  .info-card-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .info-card-titles {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* Com uma linha só, o título fica centrado na altura do ícone (36px) */
    min-height: 36px;
    justify-content: center;
  }

  .info-card-title {
    font-size: var(--fs-17);
    line-height: 1.3;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .info-card-desc {
    font-size: var(--fs-13);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .info-card-status {
    flex: none;
    padding-top: 7px;
  }

  .info-card-icon {
    box-sizing: content-box;
    flex-shrink: 0;
    padding: 8px;
    border-radius: var(--radius-md);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .info-card-rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
  }

  .info-card-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--fs-13);
    line-height: 1.45;
  }

  .info-card-row dt {
    flex: none;
    color: var(--text-secondary);
  }

  .info-card-row dd.vazio {
    color: var(--clay-400);
  }

  .info-card-row dd {
    min-width: 0;
    color: var(--text-heading);
    text-align: right;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .info-card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
  }

  .info-card-footer:empty {
    display: none;
  }
</style>

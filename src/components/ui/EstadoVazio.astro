---
// Estado vazio com orientação: o que é esta lista, por que está vazia e o que fazer (slot = ações).
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  titulo: string;
  texto?: string;
}

const { icon = 'info-circle', titulo, texto } = Astro.props;
---

<div class="estado-vazio">
  <span class="estado-vazio-icone"><Icon name={icon} size={26} /></span>
  <p class="estado-vazio-titulo">{titulo}</p>
  {texto && <p class="estado-vazio-texto">{texto}</p>}
  {Astro.slots.has('default') && <div class="estado-vazio-acoes"><slot /></div>}
</div>

<style>
  .estado-vazio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    max-width: 440px;
    margin: 0 auto;
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }

  .estado-vazio-icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .estado-vazio-titulo {
    margin: 0;
    font-size: var(--fs-16);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .estado-vazio-texto {
    margin: 0;
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .estado-vazio-acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>

---
// Card de seção (Card do design system): ícone em quadro terracota + título 15/500; opcionalmente recolhível.
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** Texto de apoio sob o título (13px muted) */
  description?: string;
  icon?: string;
  collapsible?: boolean;
  open?: boolean;
  /** Estilo do cabeçalho: "accent" (com ícone, padrão) ou "plain" (só o título) */
  variant?: 'accent' | 'plain';
  class?: string;
  id?: string;
}

const {
  title,
  description,
  icon = 'file-text',
  collapsible = false,
  open = true,
  variant = 'accent',
  class: className,
  id,
} = Astro.props;
---

{collapsible ? (
  <details class:list={['section-card', `section-${variant}`, className]} open={open} id={id}>
    <summary class="section-header">
      <span class="section-title">
        {variant === 'accent' && <Icon name={icon} size={18} class="section-icon" />}
        <span class="section-titles">
          {title}
          {description && <span class="section-desc">{description}</span>}
        </span>
      </span>
      <span class="section-actions"><slot name="actions" /></span>
      <Icon name="chevron-down" size={18} class="section-toggle" />
    </summary>
    <div class="section-body"><slot /></div>
  </details>
) : (
  <section class:list={['section-card', `section-${variant}`, className]} id={id}>
    <header class="section-header">
      <span class="section-title">
        {variant === 'accent' && <Icon name={icon} size={18} class="section-icon" />}
        <span class="section-titles">
          {title}
          {description && <span class="section-desc">{description}</span>}
        </span>
      </span>
      <span class="section-actions"><slot name="actions" /></span>
    </header>
    <div class="section-body"><slot /></div>
  </section>
)}

<style>
  /* Card do design system: branco, borda fina, raio 12, sombra curta; ícone em quadro terracota claro */
  .section-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    min-width: 0;
  }

  .section-card + .section-card {
    margin-top: var(--space-5);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    list-style: none;
  }

  .section-header::-webkit-details-marker {
    display: none;
  }

  details > .section-header {
    cursor: pointer;
    user-select: none;
  }

  details:not([open]) > .section-header {
    padding-bottom: var(--space-5);
    border-bottom: 0;
  }

  .section-title {
    flex: 1;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-15);
    line-height: 1.35;
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  /* Com descrição, o ícone alinha pelo topo (como no Card do design system) */
  .section-title:has(.section-desc) {
    align-items: flex-start;
  }

  .section-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .section-desc {
    font-size: var(--fs-13);
    line-height: 1.45;
    font-weight: var(--fw-regular);
    color: var(--text-muted);
  }

  .section-icon {
    box-sizing: content-box;
    padding: 7px;
    border-radius: var(--radius-md);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .section-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }

  .section-actions:empty {
    display: none;
  }

  .section-toggle {
    color: var(--text-muted);
    transition: transform var(--dur-base) var(--ease-out);
  }

  details[open] .section-toggle {
    transform: rotate(180deg);
  }

  .section-body {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  @media (max-width: 768px) {
    .section-header {
      padding: var(--space-4);
    }

    .section-body {
      padding: var(--space-4);
    }
  }
</style>

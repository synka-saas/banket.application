---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div id={id} class="right-panel-backdrop hidden">
  <div class="right-panel">
    <div class="panel-header">
      <h2 class="panel-title">{title}</h2>
      <button class="close-btn" aria-label="Close panel" data-close-panel={id}>
        <Icon name="close" size={24} />
      </button>
    </div>
    <div class="panel-body">
      <slot />
    </div>
    <div class="panel-footer">
      <slot name="footer" />
    </div>
  </div>
</div>

<script>
  // Simple panel management script
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    
    // Open panel
    const openBtn = target.closest('[data-open-panel]');
    if (openBtn) {
      const panelId = openBtn.getAttribute('data-open-panel');
      const panel = document.getElementById(panelId!);
      if (panel) panel.classList.remove('hidden');
    }

    // Close panel
    const closeBtn = target.closest('[data-close-panel]');
    if (closeBtn) {
      const panelId = closeBtn.getAttribute('data-close-panel');
      const panel = document.getElementById(panelId!);
      if (panel) panel.classList.add('hidden');
    }

    // Close on backdrop click
    if (target.classList.contains('right-panel-backdrop')) {
      target.classList.add('hidden');
    }
  });
</script>

<style>
  .right-panel-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    transition: opacity 0.3s ease;
  }

  .right-panel-backdrop.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .right-panel-backdrop.hidden .right-panel {
    transform: translateX(100%);
  }

  .right-panel {
    width: 480px;
    max-width: 100%;
    height: 100%;
    background: var(--color-white);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
    transform: translateX(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--border-color);
  }

  .panel-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-neutral-80);
    margin: 0;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-neutral-40);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .close-btn:hover {
    background-color: var(--color-neutral-10);
    color: var(--color-neutral-80);
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .panel-footer {
    padding: 24px;
    border-top: 1px solid var(--border-color);
    background: var(--color-neutral-10);
    display: flex;
    justify-content: flex-end;
    gap: 16px;
  }
</style>

---
// Tela de importação por CSV (UX-053): modelo para baixar, envio do arquivo e relatório linha a linha.
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { ResultadoImportacao } from '../../server/importacao';

interface Props {
  /** Ex.: "clientes" (aparece nos textos) */
  coisa: string;
  voltarHref: string;
  modeloCsv: string;
  modeloNome: string;
  colunas: string;
  resultado: ResultadoImportacao | null;
  erro: string | null;
}

const { coisa, voltarHref, modeloCsv, modeloNome, colunas, resultado, erro } = Astro.props;
const modeloHref = `data:text/csv;charset=utf-8,${encodeURIComponent(`﻿${modeloCsv}`)}`;
---

<div class="importar">
  {erro && <div class="form-erro" role="alert">{erro}</div>}

  {resultado && (
    <section class="resultado">
      <h3>
        <Icon name={resultado.erros.length === 0 ? 'circle-check' : 'alert-circle'} size={22} />
        {resultado.importados} de {resultado.total} {resultado.total === 1 ? 'linha importada' : 'linhas importadas'}
      </h3>
      {resultado.erros.length > 0 && (
        <>
          <p class="muted">As linhas abaixo não foram importadas. Corrija-as no arquivo e envie de novo só com elas.</p>
          <ul class="erros">
            {resultado.erros.map((e) => (
              <li><strong>Linha {e.linha}:</strong> {e.motivo}</li>
            ))}
          </ul>
        </>
      )}
      <div class="resultado-acoes">
        <Button variant="primary" href={voltarHref}>Ver {coisa}</Button>
      </div>
    </section>
  )}

  <section class="passo">
    <h3><span class="passo-n">1</span> Baixe o modelo e preencha</h3>
    <p class="muted">Uma linha por registro, com o cabeçalho: <code>{colunas}</code>. Pode salvar direto do Excel (CSV separado por ponto e vírgula).</p>
    <a class="btn btn-outline btn-md" href={modeloHref} download={modeloNome}>
      <Icon name="download" size={16} /> Baixar modelo CSV
    </a>
  </section>

  <section class="passo">
    <h3><span class="passo-n">2</span> Envie o arquivo preenchido</h3>
    <form method="post" enctype="multipart/form-data" class="envio">
      <input type="file" name="arquivo" accept=".csv,text/csv" required aria-label="Arquivo CSV" />
      <Button type="submit" variant="primary" data-carregando="Importando…">Importar</Button>
    </form>
    <p class="field-hint">Até 500 linhas por arquivo. As linhas válidas entram na hora; as com erro voltam apontadas.</p>
  </section>
</div>

<style>
  .importar {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 760px;
  }

  .passo,
  .resultado {
    padding: var(--space-5) var(--space-6) var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .passo h3,
  .resultado h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    font-size: var(--fs-15);
  }

  .resultado h3 :global(.icon) {
    color: var(--terracotta-600);
  }

  .passo-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-md);
    background: var(--terracotta-500);
    color: var(--text-on-accent);
    font-size: var(--fs-13);
    font-variant-numeric: tabular-nums;
  }

  .passo code {
    background: var(--bg-subtle);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
  }

  .passo p {
    margin-bottom: var(--space-4);
  }

  .envio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-2);
  }

  /* Seletor de arquivo nativo com o botão no padrão secundário */
  .envio input[type='file'] {
    flex: 1;
    min-width: 0;
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .envio input[type='file']::file-selector-button {
    height: var(--control-h-md);
    margin-right: var(--space-3);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--action-secondary-bg);
    box-shadow: var(--shadow-xs);
    font: inherit;
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .envio input[type='file']::file-selector-button:hover {
    background: var(--action-secondary-hover);
    border-color: var(--clay-400);
  }

  .resultado .erros {
    margin: var(--space-3) 0 var(--space-4);
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--fs-14);
    max-height: 300px;
    overflow-y: auto;
    list-style: disc;
  }

  .resultado-acoes {
    display: flex;
    justify-content: flex-end;
  }
</style>

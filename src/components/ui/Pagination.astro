---
import Icon from './Icon.astro';
import { TAMANHOS_PAGINA, paginasVisiveis, withQuery, type PageInfo } from '../../lib/pagination';

interface Props {
  info: PageInfo;
}

const { info } = Astro.props;
const prev = info.page > 1 ? withQuery(Astro.url, { page: info.page - 1 }) : null;
const next = info.page < info.totalPages ? withQuery(Astro.url, { page: info.page + 1 }) : null;
const inicio = (info.page - 1) * info.pageSize + 1;
const fim = Math.min(info.page * info.pageSize, info.total);
---

{info.total > 0 && (
<nav class="pagination" aria-label="Paginação">
  <span class="pagination-status">
    {info.total <= info.pageSize
      ? <Fragment><strong>{info.total}</strong> {info.total === 1 ? 'registro' : 'registros'}</Fragment>
      : <Fragment><strong>{inicio}–{fim}</strong> de {info.total} registros</Fragment>}
  </span>

  <div class="pagination-controls">
    {info.totalPages > 1 && (
      <>
        {prev ? (
          <a href={prev} class="page-btn" aria-label="Página anterior"><Icon name="chevron-left" size={16} /></a>
        ) : (
          <span class="page-btn disabled" aria-hidden="true"><Icon name="chevron-left" size={16} /></span>
        )}
        {paginasVisiveis(info.page, info.totalPages).map((p) =>
          p === null ? (
            <span class="page-salto" aria-hidden="true">…</span>
          ) : p === info.page ? (
            <span class="page-btn atual" aria-current="page">{p}</span>
          ) : (
            <a href={withQuery(Astro.url, { page: p })} class="page-btn" aria-label={`Página ${p}`}>{p}</a>
          )
        )}
        {next ? (
          <a href={next} class="page-btn" aria-label="Próxima página"><Icon name="chevron-right" size={16} /></a>
        ) : (
          <span class="page-btn disabled" aria-hidden="true"><Icon name="chevron-right" size={16} /></span>
        )}
      </>
    )}

    {info.total > TAMANHOS_PAGINA[0] && (
      <span class="page-tamanhos">
        Por página:
        {TAMANHOS_PAGINA.map((t) =>
          t === info.pageSize ? (
            <span class="page-tamanho atual" aria-current="true">{t}</span>
          ) : (
            <a class="page-tamanho" href={withQuery(Astro.url, { por: t === TAMANHOS_PAGINA[0] ? null : t, page: null })}>{t}</a>
          )
        )}
      </span>
    )}
  </div>
</nav>
)}

<style>
  /* Rodapé da tabela: contagem à esquerda, páginas e tamanho à direita */
  .pagination-status :global(strong) {
    color: var(--text-heading);
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 52px;
    padding: var(--space-2) var(--space-5);
    background: var(--clay-25);
    border-top: 1px solid var(--border-default);
    font-size: var(--fs-13);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .pagination-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    font-weight: var(--fw-medium);
    color: var(--text-body);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  /* Setas: botão de ícone secundário */
  .page-btn:has(.icon) {
    border-color: var(--border-strong);
    background: var(--bg-surface);
    color: var(--text-heading);
    box-shadow: var(--shadow-xs);
  }

  .page-btn:hover:not(.disabled):not(.atual) {
    background: var(--bg-subtle);
  }

  .page-btn:has(.icon):hover:not(.disabled) {
    background: var(--action-secondary-hover);
    border-color: var(--clay-400);
  }

  .page-btn.atual {
    border-color: var(--action-primary);
    background: var(--action-primary);
    color: var(--text-on-accent);
  }

  .page-btn.disabled {
    opacity: 0.35;
  }

  .page-salto {
    min-width: 20px;
    text-align: center;
    color: var(--text-muted);
  }

  .page-tamanhos {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: var(--space-4);
    color: var(--text-muted);
  }

  .page-tamanho {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 26px;
    padding: 0 var(--space-1-5);
    border-radius: var(--radius-xs);
    color: var(--text-link);
  }

  a.page-tamanho:hover {
    background: var(--bg-accent-subtle);
  }

  .page-tamanho.atual {
    font-weight: var(--fw-medium);
    color: var(--text-strong);
    background: var(--bg-subtle);
  }

  @media (max-width: 768px) {
    .pagination {
      padding: 12px 16px;
      justify-content: center;
    }
  }
</style>

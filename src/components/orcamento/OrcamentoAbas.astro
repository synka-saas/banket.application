---
// Sub-abas do orçamento (tudo o que muda com a versão fica dentro de Orçamento), com a versão sempre à vista.
// Preserva ?versao= ao trocar de sub-aba.
interface Props {
  eventoId: string;
  ativa: 'itens' | 'informacoes' | 'condicoes' | 'previa' | 'compras';
  versao: { numero: number; congelada: boolean } | null;
}

const { eventoId, ativa, versao } = Astro.props;
const base = `/eventos/${eventoId}`;
const sufixo = Astro.url.searchParams.get('versao') ? `?versao=${encodeURIComponent(Astro.url.searchParams.get('versao')!)}` : '';
const abas = [
  { id: 'itens', label: 'Itens e valores', href: `${base}/orcamento${sufixo}` },
  { id: 'informacoes', label: 'Informações complementares', href: `${base}/informacoes-complementares${sufixo}` },
  { id: 'condicoes', label: 'Condições gerais e textos', href: `${base}/condicoes-gerais${sufixo}` },
  { id: 'previa', label: 'Pré-visualização', href: `${base}/orcamento/previa${sufixo}` },
  // Uso interno (não entra na proposta): quantidades por item e compras do evento
  { id: 'compras', label: 'Lista de compras', href: `${base}/lista-compras${sufixo}` },
];
---

<nav class="orc-abas" aria-label="Partes do orçamento">
  <div class="orc-abas-lista">
    {abas.map((a) => (
      <a href={a.href} class:list={{ ativa: a.id === ativa }} aria-current={a.id === ativa ? 'page' : undefined}>{a.label}</a>
    ))}
  </div>
  {versao && (
    <span class:list={['orc-abas-versao', 'badge', { 'badge-success': !versao.congelada, congelada: versao.congelada }]}>
      Versão {String(versao.numero).padStart(2, '0')} · {versao.congelada ? 'congelada' : 'em edição'}
    </span>
  )}
</nav>

<style>
  /* Tabs em linha do design system: sublinhado terracota de 2px na aba ativa */
  .orc-abas {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-default);
  }

  .orc-abas-lista {
    display: flex;
    align-items: stretch;
    gap: var(--space-7);
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .orc-abas-lista::-webkit-scrollbar {
    display: none;
  }

  .orc-abas-lista a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 44px;
    font-size: var(--fs-14);
    font-weight: var(--fw-regular);
    color: var(--text-secondary);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .orc-abas-lista a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: transparent;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .orc-abas-lista a:hover {
    color: var(--text-strong);
  }

  .orc-abas-lista a.ativa {
    color: var(--terracotta-700);
    font-weight: var(--fw-medium);
  }

  .orc-abas-lista a.ativa::after {
    background: var(--terracotta-500);
  }

  .orc-abas-versao {
    flex: none;
  }

  @media (max-width: 768px) {
    .orc-abas {
      align-items: stretch;
      flex-direction: column-reverse;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }

    .orc-abas-lista {
      gap: var(--space-5);
      -webkit-overflow-scrolling: touch;
    }

    .orc-abas-versao {
      align-self: flex-start;
    }
  }
</style>

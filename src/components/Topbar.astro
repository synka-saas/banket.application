---
import Icon from './ui/Icon.astro';
import { ROLE_LABELS } from '../lib/auth';
import { empresasDoUsuario } from '../server/autoatendimento';

interface Props {
  title: string;
  /** Link de volta antes do título (ex.: Propostas / Casamento Ana) */
  voltar?: { href: string; label: string };
}

const { title, voltar } = Astro.props;

const user = Astro.locals.user;
const userName = user?.nome || 'Usuário';
const userRole = user ? ROLE_LABELS[user.role] : '';
const names = userName.trim().split(/\s+/);
// Seletor de empresa: só aparece para quem pertence a mais de uma
const empresas = user ? await empresasDoUsuario(user.id) : [];
const empresaAtual = empresas.find((e) => e.id === user?.tenantId);
// "Módulo / Página" vira trilha: os níveis anteriores ficam em cinza (com `voltar`, o título é um nome livre)
const trilha = voltar ? [title] : title.split(' / ');
const initials = (names.length > 1 ? names[0][0] + names[names.length - 1][0] : names[0][0] ?? 'U').toUpperCase();
---

<header class="topbar">
  <div class="topbar-left">
    {voltar && (
      <>
        <a href={voltar.href} class="topbar-voltar">{voltar.label}</a>
        <span class="topbar-sep" aria-hidden="true">/</span>
      </>
    )}
    <h1 class="topbar-title">
      {trilha.map((parte, i) =>
        i < trilha.length - 1 ? (
          <Fragment><span class="topbar-crumb">{parte}</span><span class="topbar-sep" aria-hidden="true"> / </span></Fragment>
        ) : (
          parte
        )
      )}
    </h1>
  </div>
  
  <div class="topbar-right">
    <div class="user-profile-area">
      <button type="button" class="user-profile" id="user-profile-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="user-dropdown">
        <div class="avatar">{initials}</div>
        <div class="user-info">
          <span class="user-name">{userName}</span>
          <span class="user-role">{userRole}{empresas.length > 1 && empresaAtual && ` · ${empresaAtual.nome}`}</span>
        </div>
        <Icon name="chevron-down" size={16} class="dropdown-icon" />
      </button>

      <!-- Menu Dropdown -->
      <div class="dropdown-menu" id="user-dropdown" role="menu" aria-label={`Conta de ${userName}`}>
        {empresas.length > 1 && (
          <>
            <span class="dropdown-rotulo">Trocar de empresa</span>
            {empresas.map((e) => (
              <form method="post" action="/api/sessao/empresa">
                <input type="hidden" name="tenant_id" value={e.id} />
                <button type="submit" role="menuitem" class:list={['dropdown-item', 'empresa-item', { atual: e.id === user?.tenantId }]} disabled={e.id === user?.tenantId}>
                  <Icon name={e.id === user?.tenantId ? 'check' : 'building'} size={16} /> {e.nome}
                </button>
              </form>
            ))}
            <div class="dropdown-divider"></div>
          </>
        )}
        <a href="/conta" class="dropdown-item" role="menuitem">
          <Icon name="user" size={16} /> Minha conta
        </a>
        <a href="/auth/logout" class="dropdown-item logout-item" role="menuitem">
          <Icon name="logout" size={16} /> Sair
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Menu do usuário acessível: botão com aria-expanded, Esc fecha e devolve o foco, setas percorrem os itens
  const btn = document.getElementById('user-profile-btn');
  const dropdown = document.getElementById('user-dropdown');

  if (btn && dropdown) {
    const itens = () => [...dropdown.querySelectorAll<HTMLElement>('.dropdown-item:not(:disabled)')];
    const alternar = (abrir: boolean) => {
      dropdown.classList.toggle('active', abrir);
      btn.setAttribute('aria-expanded', String(abrir));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      alternar(!dropdown.classList.contains('active'));
    });
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) alternar(false);
    });
    document.addEventListener('keydown', (e) => {
      if (!dropdown.classList.contains('active')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        alternar(false);
        btn.focus();
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const lista = itens();
        const atual = lista.indexOf(document.activeElement as HTMLElement);
        const proximo = e.key === 'ArrowDown' ? Math.min(atual + 1, lista.length - 1) : Math.max(atual - 1, 0);
        (atual === -1 ? lista[0] : lista[proximo])?.focus();
      }
    });
  }
</script>

<style>
  /* Cabeçalho do design system: 64px, título 20/500, trilha "Módulo / Página" e menu do usuário */
  .topbar {
    min-height: var(--header-height);
    height: var(--header-height);
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--content-pad-x);
    flex-shrink: 0;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-lh);
    letter-spacing: var(--ls-snug);
    white-space: nowrap;
  }

  .topbar-title {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    font-weight: var(--fw-medium);
    color: var(--text-strong);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-crumb {
    color: var(--text-muted);
    font-weight: var(--fw-regular);
  }

  .topbar-voltar {
    color: var(--text-muted);
    font-weight: var(--fw-regular);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .topbar-voltar:hover {
    color: var(--text-heading);
  }

  .topbar-sep {
    color: var(--clay-300);
    font-weight: var(--fw-light);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }

  .user-profile-area {
    position: relative;
  }

  .user-profile {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    height: 48px;
    padding: 0 var(--space-2) 0 var(--space-1-5);
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .user-profile:hover {
    background-color: var(--bg-app);
  }

  .dropdown-icon {
    color: var(--text-muted);
  }

  /* Menu (popover) do design system */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 220px;
    padding: var(--space-1-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.98);
    transform-origin: top;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility var(--dur-base);
  }

  .dropdown-menu.active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    width: 100%;
    min-height: 36px;
    padding: 0 var(--space-2-5);
    border-radius: var(--radius-md);
    color: var(--text-body);
    text-decoration: none;
    font-size: var(--fs-14);
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .dropdown-item :global(.icon) {
    color: var(--text-muted);
  }

  .dropdown-item:hover:not(:disabled) {
    background-color: var(--bg-app);
    color: var(--text-strong);
  }

  .dropdown-rotulo {
    display: block;
    padding: var(--space-2) var(--space-2-5) var(--space-1);
    font-size: var(--fs-11);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .empresa-item {
    border: none;
    background: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }

  .empresa-item.atual {
    color: var(--terracotta-700);
    cursor: default;
  }

  .empresa-item.atual :global(.icon) {
    color: var(--terracotta-600);
  }

  .logout-item,
  .logout-item :global(.icon) {
    color: var(--danger);
  }

  .logout-item:hover:not(:disabled) {
    background-color: var(--danger-bg);
    color: var(--danger);
  }

  .dropdown-divider {
    height: 1px;
    margin: var(--space-1-5) var(--space-1);
    background-color: var(--border-subtle);
  }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--terracotta-100);
    color: var(--terracotta-800);
    font-weight: var(--fw-medium);
    font-size: var(--fs-14);
  }

  .user-info {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .user-name {
    font-weight: var(--fw-medium);
    font-size: var(--fs-14);
    color: var(--text-strong);
  }

  .user-role {
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .topbar {
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .topbar {
      height: 56px;
      min-height: 56px;
      padding: 0 16px;
      gap: 8px;
    }

    .topbar-left {
      font-size: var(--fs-17);
    }

    /* Só o avatar; nome e papel ficam no menu */
    .user-info,
    .dropdown-icon {
      display: none;
    }
  }
</style>

---
import Icon from './ui/Icon.astro';

interface Props {
  /** bloqueado = recurso fora do plano: cadeado + data-bloqueado (o Upsell intercepta o clique e não navega) */
  items: { id: string; label: string; href?: string; bloqueado?: string }[];
  activeId?: string;
}

const { items = [], activeId } = Astro.props;
---

<div class="submenu-container">
  <nav class="submenu-nav">
    {items.map((item) => (
      <a
        href={item.href || `?tab=${item.id}`}
        class:list={['submenu-item', { active: activeId === item.id, 'submenu-item--bloqueado': item.bloqueado }]}
        aria-current={activeId === item.id ? 'page' : undefined}
        data-bloqueado={item.bloqueado || undefined}
        title={item.bloqueado ? `${item.label} · não incluído no seu plano` : undefined}
      >
        {item.label}
        {item.bloqueado && <Icon name="lock" size={14} class="submenu-cadeado" />}
      </a>
    ))}
  </nav>
  <div class="submenu-actions">
    <slot />
  </div>
</div>

<style>
  /* Tabs do design system: 48px, sublinhado terracota na aba ativa */
  .submenu-container {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-default);
    padding: 0 var(--content-pad-x);
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--subnav-height);
    flex-shrink: 0;
  }

  .submenu-nav {
    display: flex;
    align-items: stretch;
    gap: var(--space-7);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .submenu-nav::-webkit-scrollbar {
    display: none;
  }

  .submenu-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-14);
    font-weight: var(--fw-regular);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .submenu-item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: transparent;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .submenu-item:hover {
    color: var(--text-strong);
  }

  .submenu-item--bloqueado {
    gap: var(--space-1);
    color: var(--text-muted);
  }

  .submenu-item :global(.submenu-cadeado) {
    color: var(--text-muted);
  }

  .submenu-item.active {
    color: var(--terracotta-700);
    font-weight: var(--fw-medium);
  }

  .submenu-item.active::after {
    background: var(--terracotta-500);
  }

  .submenu-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .submenu-actions:empty {
    display: none;
  }

  @media (max-width: 1024px) {
    .submenu-container {
      padding: 0 24px;
    }
  }

  @media (max-width: 768px) {
    .submenu-container {
      padding: 0 16px;
      gap: 12px;
    }

    .submenu-nav {
      gap: 20px;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>

---
// Documento formal para impressão (A4, fundo branco, sem imagem de fundo): logotipo no cabeçalho ou no rodapé,
// rodapé opcional com texto, título do documento, corpo em marcação simples e bloco de assinaturas opcional.
import { renderTexto } from '../../lib/texto';
import type { DocumentoView } from '../../server/documentos';

interface Props {
  view: DocumentoView;
}

const { view } = Astro.props;
const v = view.visual;

const fontes = [...new Set([v.fonte_titulo, v.fonte_corpo])]
  .map((f) => `family=${encodeURIComponent(f).replace(/%20/g, '+')}:wght@400;600;700`)
  .join('&');
const cssVars = [
  `--primaria:${v.cor_primaria}`,
  `--secundaria:${v.cor_secundaria}`,
  `--texto:${v.cor_texto}`,
  `--fonte-titulo:'${v.fonte_titulo}', Arial, sans-serif`,
  `--fonte-corpo:'${v.fonte_corpo}', Arial, sans-serif`,
].join(';');
const logoNoTopo = Boolean(view.logo && v.logo_local === 'cabecalho');
const logoNoRodape = Boolean(view.logo && v.logo_local === 'rodape');
const temRodape = v.rodape_ativo && (logoNoRodape || Boolean(v.rodape_texto));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>{view.titulo}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontes}&display=block`} />
  </head>
  <body style={cssVars}>
    {logoNoTopo && (
      <header class:list={['topo', `alinha-${v.logo_alinhamento}`]}>
        <img src={view.logo} alt="" />
      </header>
    )}
    {temRodape && (
      <footer class:list={['rodape', `alinha-${v.logo_alinhamento}`, { 'com-logo': logoNoRodape }]}>
        {logoNoRodape && v.logo_alinhamento === 'esquerda' && <img src={view.logo} alt="" />}
        {v.rodape_texto && <span class="rodape-texto">{v.rodape_texto}</span>}
        {logoNoRodape && v.logo_alinhamento !== 'esquerda' && <img src={view.logo} alt="" />}
      </footer>
    )}

    <table class="fluxo">
      <thead><tr><td><div class:list={['espaco-topo', { 'com-logo': logoNoTopo }]}></div></td></tr></thead>
      <tfoot><tr><td><div class:list={['espaco-rodape', { com: temRodape }]}></div></td></tr></tfoot>
      <tbody><tr><td class="conteudo">
        <h1 class="titulo-doc">{view.titulo}</h1>
        <p class="numero-doc">Documento nº {view.numero}</p>
        <div class="corpo" set:html={renderTexto(view.corpo)} />

        {view.incluir_assinaturas && (
          <section class="assinaturas">
            <p class="local-data">______________________________, {view.data}</p>
            <div class="linhas">
              <div class="assinante">
                <div class="traco"></div>
                <strong>{view.empresa.razao_social}</strong>
                {view.empresa.documento && <span>{view.empresa.documento}</span>}
                <span>{view.empresa.assinante}{view.empresa.cargo ? ` · ${view.empresa.cargo}` : ''}</span>
                <em>Contratada</em>
              </div>
              <div class="assinante">
                <div class="traco"></div>
                <strong>{view.cliente.nome || ' '}</strong>
                {view.cliente.documento && <span>{view.cliente.documento}</span>}
                <em>Contratante</em>
              </div>
            </div>
            {view.testemunhas && (
              <div class="linhas testemunhas">
                <div class="assinante">
                  <div class="traco"></div>
                  <strong>Testemunha</strong>
                  <span>Nome: ______________________________</span>
                  <span>CPF: ______________________________</span>
                </div>
                <div class="assinante">
                  <div class="traco"></div>
                  <strong>Testemunha</strong>
                  <span>Nome: ______________________________</span>
                  <span>CPF: ______________________________</span>
                </div>
              </div>
            )}
          </section>
        )}
      </td></tr></tbody>
    </table>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  body {
    font-family: var(--fonte-corpo);
    color: var(--texto);
    background: #ffffff;
    font-size: 10.5pt;
    line-height: 1.5;
  }

  /* Cabeçalho repetido em todas as páginas: só o logotipo, alinhado conforme o modelo */
  .topo {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 30mm;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20mm;
  }

  .topo.alinha-esquerda {
    justify-content: flex-start;
  }

  .topo.alinha-direita {
    justify-content: flex-end;
  }

  .topo img {
    max-height: 18mm;
    max-width: 50mm;
    object-fit: contain;
  }

  .rodape {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 16mm;
    padding: 0 20mm 5mm;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6mm;
    font-size: 8pt;
    color: var(--secundaria);
  }

  .rodape.com-logo.alinha-direita {
    justify-content: space-between;
  }

  .rodape.com-logo.alinha-esquerda {
    justify-content: space-between;
  }

  .rodape.com-logo.alinha-centro {
    flex-direction: column;
    align-items: center;
    gap: 1.5mm;
    height: 22mm;
  }

  .rodape img {
    max-height: 10mm;
    max-width: 35mm;
    object-fit: contain;
  }

  .rodape-texto {
    text-align: center;
  }

  .fluxo {
    width: 100%;
    border-collapse: collapse;
  }

  .espaco-topo {
    height: 20mm;
  }

  .espaco-topo.com-logo {
    height: 32mm;
  }

  .espaco-rodape {
    height: 14mm;
  }

  .espaco-rodape.com {
    height: 24mm;
  }

  .conteudo {
    padding: 0 20mm;
    vertical-align: top;
  }

  .titulo-doc {
    font-family: var(--fonte-titulo);
    color: var(--primaria);
    font-size: 16pt;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 1.5mm;
  }

  .numero-doc {
    text-align: center;
    font-size: 9pt;
    color: var(--secundaria);
    margin-bottom: 8mm;
  }

  .corpo {
    text-align: justify;
  }

  .corpo h3 {
    font-family: var(--fonte-titulo);
    color: var(--primaria);
    font-size: 11.5pt;
    text-transform: uppercase;
    margin: 6mm 0 2mm;
    break-after: avoid;
  }

  .corpo h4 {
    font-family: var(--fonte-titulo);
    color: var(--primaria);
    font-size: 10.5pt;
    margin: 4mm 0 1.5mm;
    break-after: avoid;
  }

  .corpo p {
    margin: 0 0 2.5mm;
  }

  .corpo p.centro {
    text-align: center;
  }

  .corpo ul,
  .corpo ol {
    margin: 0 0 2.5mm;
    padding-left: 6mm;
  }

  .corpo li {
    margin-bottom: 1mm;
  }

  .corpo .quebra-pagina {
    break-after: page;
    height: 0;
  }

  .assinaturas {
    margin-top: 14mm;
    break-inside: avoid;
  }

  .local-data {
    text-align: center;
    margin-bottom: 16mm;
  }

  .linhas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14mm;
  }

  .linhas.testemunhas {
    margin-top: 14mm;
  }

  .assinante {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-size: 9pt;
    line-height: 1.4;
  }

  .assinante .traco {
    width: 100%;
    border-top: 1px solid var(--texto);
    margin-bottom: 1.5mm;
  }

  .assinante strong {
    font-family: var(--fonte-titulo);
    color: var(--primaria);
    font-size: 10pt;
  }

  .assinante em {
    margin-top: 1mm;
    text-transform: uppercase;
    font-style: normal;
    font-size: 8pt;
    letter-spacing: 0.5pt;
    color: var(--secundaria);
  }
</style>

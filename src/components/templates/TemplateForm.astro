---
// Editor de template da proposta (frame "Templates / Novo Template"), com pré-visualização ao vivo.
import SectionCard from '../ui/SectionCard.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import FileUpload from '../ui/FileUpload.astro';
import Galeria from './GaleriaFundos.astro';
import { fileUrl } from '../../lib/storage';
import { FONTES, type CampoImagem, type Template } from '../../server/templates';

interface Props {
  template: Partial<Template>;
  tenantId: string;
}

const { template: t, tenantId } = Astro.props;
const valor = (campo: keyof Template, padrao = '') => {
  const v = t[campo];
  return v === null || v === undefined ? padrao : Array.isArray(v) ? v.join(', ') : String(v);
};
const imagem = (campo: CampoImagem) => (t[campo] ? fileUrl(tenantId, t[campo] as string) : null);

const posicoesLogo = [
  { valor: 'esquerda', rotulo: 'Esquerda', icone: 'align_horizontal_left' },
  { valor: 'centro', rotulo: 'Centro', icone: 'align_horizontal_center' },
  { valor: 'direita', rotulo: 'Direita', icone: 'align_horizontal_right' },
] as const;
const camposImagem: Record<CampoImagem, string> = {
  capa_imagem_path: 'Imagem de fundo',
  logo_path: 'Logotipo',
  miolo_imagem_path: 'Imagem de fundo das páginas',
  rodape_logo_path: 'Logotipo do rodapé',
  contracapa_imagem_path: 'Imagem de fundo',
};
const fontes = [
  { id: 'tp-ft', campo: 'fonte_titulo', rotulo: 'Títulos', dica: 'Capa, cabeçalhos e títulos de seção.', padrao: 'Archivo Black', var: '--p-fonte-titulo' },
  { id: 'tp-fc', campo: 'fonte_corpo', rotulo: 'Parágrafos', dica: 'Texto corrido, itens e valores.', padrao: 'Open Sans', var: '--p-fonte-corpo' },
] as const;
const cores = [
  { id: 'tp-bg', campo: 'cor_fundo', rotulo: 'Cor de fundo', dica: 'Fundo das páginas.', padrao: '#FFF9F2', var: '--p-fundo' },
  { id: 'tp-c1', campo: 'cor_texto_primaria', rotulo: 'Cor primária (texto)', dica: 'Texto corrido.', padrao: '#4A1A0E', var: '--p-texto' },
  { id: 'tp-c2', campo: 'cor_texto_secundaria', rotulo: 'Cor secundária (títulos)', dica: 'Títulos e destaques.', padrao: '#A61E00', var: '--p-destaque' },
] as const;
const fontesGoogle = FONTES.map((f) => `family=${f.replace(/ /g, '+')}:wght@400;700`).join('&');
---

<link href={`https://fonts.googleapis.com/css2?${fontesGoogle}&display=swap`} rel="stylesheet" />

<form method="post" enctype="multipart/form-data" class="template-form" data-template-form>
  <section class="cabecalho">
    <div class="nome">
      <label for="tp-nome">Nome do template</label>
      <input id="tp-nome" name="nome" required maxlength="100" value={valor('nome')} placeholder="Nome Template" />
    </div>
    <div class="acoes">
      {t.id && (
        <>
          <a class="btn btn-outline btn-md" href={`/templates/${t.id}/exemplo`} target="_blank" rel="noopener">PDF de exemplo</a>
          <button type="submit" name="_action" value="duplicar" class="btn btn-outline btn-md" formnovalidate>Duplicar</button>
          <button type="submit" name="_action" value="excluir" class="btn btn-outline btn-md" formnovalidate data-confirm="Excluir este template?">Excluir</button>
        </>
      )}
      <Button type="submit" variant="primary" data-carregando="Salvando…">Salvar</Button>
    </div>
    <div class="form-grid gerais">
      <div class="field">
        <label for="tp-desc">Descrição</label>
        <input id="tp-desc" name="descricao" maxlength="1000" value={valor('descricao')} />
      </div>
      <div class="field">
        <label for="tp-tags">Tags</label>
        <input id="tp-tags" name="tags" value={valor('tags')} placeholder="Separadas por vírgula" />
      </div>
      <label class="switch"><input type="checkbox" name="padrao" checked={Boolean(t.padrao)} />Template padrão das novas propostas</label>
    </div>
  </section>

  <SectionCard title="Identidade visual" variant="plain" collapsible>
    <div class="identidade" data-identidade>
      <div class="field">
        <span class="field-label">{camposImagem.logo_path}</span>
        <FileUpload name="logo_path" data-preview="logo_path" atualUrl={imagem('logo_path')} atualNome="Logotipo atual" removerName="remover_logo_path" />
        <span class="field-hint">Usado na capa, no cabeçalho das páginas, no rodapé e na contracapa. Também é a base das sugestões por IA.</span>
        <img data-img="logo_path" data-logo src={imagem('logo_path') ?? undefined} alt="" hidden={!imagem('logo_path')} class="logo-fonte-ia" />
      </div>

      <div class="subgrupo">
        <div class="subgrupo-topo">
          <h4>Fontes</h4>
          <button type="button" class="btn btn-outline btn-sm btn-ia" data-sugerir-fontes title="Sugerir as fontes de títulos e parágrafos a partir do logotipo">
            <Icon name="auto_awesome" size={16} /> Sugerir fontes com IA
          </button>
        </div>
        {fontes.map((f) => (
          <div class="linha">
            <div class="linha-texto">
              <label for={f.id}>{f.rotulo}</label>
              <span class="field-hint">{f.dica}</span>
            </div>
            <select id={f.id} name={f.campo} data-var={f.var}>
              {FONTES.map((nome) => <option value={nome} selected={nome === valor(f.campo, f.padrao)} style={`font-family:'${nome}'`}>{nome}</option>)}
            </select>
          </div>
        ))}
      </div>

      <div class="subgrupo">
        <div class="subgrupo-topo">
          <h4>Cores</h4>
          <button type="button" class="btn btn-outline btn-sm btn-ia" data-capturar-cores title="Preencher as três cores com a paleta do logotipo">
            <Icon name="colorize" size={16} /> Capturar cores do logo
          </button>
        </div>
        {cores.map((c) => (
          <div class="linha">
            <div class="linha-texto">
              <label for={c.id}>{c.rotulo}</label>
              <span class="field-hint">{c.dica}</span>
            </div>
            <div class="cor">
              <input id={c.id} type="color" name={c.campo} value={valor(c.campo, c.padrao)} data-var={c.var} />
              <input class="hex" value={valor(c.campo, c.padrao).toUpperCase()} data-hex={c.campo} maxlength="7" aria-label={`${c.rotulo} (hexadecimal)`} spellcheck="false" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </SectionCard>

  <SectionCard title="Página capa" variant="plain" collapsible>
    <div class="pagina-grid">
      <div class="campos">
        <label class="switch"><input type="checkbox" name="capa_ativa" checked={t.capa_ativa ?? true} />Incluir capa na proposta</label>
        <div class="field">
          <span class="field-label">{camposImagem.capa_imagem_path}</span>
          <FileUpload name="capa_imagem_path" data-preview="capa_imagem_path" atualUrl={imagem('capa_imagem_path')} atualNome="Imagem de fundo atual" removerName="remover_capa_imagem_path" compacto />
          <Galeria pagina="capa" campo="capa_imagem_path" />
        </div>
        <div class="field">
          <label for="tp-ct">Título capa</label>
          <input id="tp-ct" name="capa_titulo" required maxlength="120" value={valor('capa_titulo', 'Proposta de orçamento')} data-texto="capa_titulo" />
        </div>
        <div class="field">
          <label for="tp-cc">Conteúdo capa</label>
          <textarea id="tp-cc" name="capa_conteudo" maxlength="500" data-texto="capa_conteudo">{valor('capa_conteudo')}</textarea>
        </div>
      </div>
      <div class="preview pagina capa" data-bg="capa_imagem_path" style={imagem('capa_imagem_path') ? `background-image:url('${imagem('capa_imagem_path')}')` : undefined}>
        <span class="preview-rotulo">Capa</span>
        <img data-img="logo_path" src={imagem('logo_path') ?? undefined} alt="" hidden={!imagem('logo_path')} />
        <strong data-alvo="capa_titulo">{valor('capa_titulo', 'Proposta de orçamento')}</strong>
        <small data-alvo="capa_conteudo">{valor('capa_conteudo')}</small>
      </div>
    </div>
  </SectionCard>

  <SectionCard title="Página conteúdo" variant="plain" collapsible>
    <div class="pagina-grid">
      <div class="campos">
        <div class="field">
          <span class="field-label">{camposImagem.miolo_imagem_path}</span>
          <FileUpload name="miolo_imagem_path" data-preview="miolo_imagem_path" atualUrl={imagem('miolo_imagem_path')} atualNome="Imagem de fundo atual" removerName="remover_miolo_imagem_path" compacto />
          <Galeria pagina="miolo" campo="miolo_imagem_path" />
        </div>
        <div class="field">
          <label for="tp-mt">Título do cabeçalho</label>
          <input id="tp-mt" name="miolo_titulo" required maxlength="120" value={valor('miolo_titulo', 'Proposta de orçamento')} data-texto="miolo_titulo" />
        </div>
        <div class="field">
          <label for="tp-mi">Texto de introdução</label>
          <textarea id="tp-mi" name="miolo_introducao" maxlength="2000">{valor('miolo_introducao')}</textarea>
          <span class="field-hint">Use **texto** para negrito.</span>
        </div>
        <div class="field logo-rodape" data-logo-rodape>
          <label class="switch"><input type="checkbox" name="rodape_logo_ativo" checked={t.rodape_logo_ativo ?? true} />Exibir o logotipo no rodapé</label>
          <div class="segmentos" role="radiogroup" aria-label="Posição do logotipo no rodapé">
            {posicoesLogo.map((p) => (
              <label>
                <input type="radio" name="rodape_logo_posicao" value={p.valor} checked={(t.rodape_logo_posicao ?? 'direita') === p.valor} />
                <span><Icon name={p.icone} size={18} /> {p.rotulo}</span>
              </label>
            ))}
          </div>
          <span class="field-hint">Usa o logotipo de Identidade visual.</span>
        </div>
        <div class="field">
          <label for="tp-rt">Título rodapé</label>
          <input id="tp-rt" name="rodape_titulo" maxlength="120" value={valor('rodape_titulo')} data-texto="rodape_titulo" />
        </div>
        <div class="field">
          <label for="tp-rc">Conteúdo rodapé</label>
          <textarea id="tp-rc" name="rodape_conteudo" maxlength="500" data-texto="rodape_conteudo">{valor('rodape_conteudo')}</textarea>
        </div>
      </div>
      <div class="preview pagina miolo" data-bg="miolo_imagem_path" style={imagem('miolo_imagem_path') ? `background-image:url('${imagem('miolo_imagem_path')}')` : undefined}>
        <div class="miolo-topo">
          <img data-img="logo_path" src={imagem('logo_path') ?? undefined} alt="" hidden={!imagem('logo_path')} />
          <strong data-alvo="miolo_titulo">{valor('miolo_titulo', 'Proposta de orçamento')}</strong>
        </div>
        <b class="t1">Título</b>
        <b class="t2">Subtítulo 1</b>
        <b class="t2">Subtítulo 2</b>
        <p>Parágrafo 01</p>
        <p class="pequeno">Parágrafo 02</p>
        <div class:list={['miolo-rodape', `logo-${t.rodape_logo_posicao ?? 'direita'}`]} data-preview-rodape>
          <span class="rodape-texto"><b data-alvo="rodape_titulo">{valor('rodape_titulo', 'Texto rodapé')}</b> <span data-alvo="rodape_conteudo">{valor('rodape_conteudo')}</span></span>
          <img data-img="logo_path" data-rodape-img src={imagem('logo_path') ?? undefined} alt="" hidden={!imagem('logo_path')} />
        </div>
      </div>
    </div>
  </SectionCard>

  <SectionCard title="Página contracapa" variant="plain" collapsible>
    <div class="pagina-grid">
      <div class="campos">
        <label class="switch"><input type="checkbox" name="contracapa_ativa" checked={Boolean(t.contracapa_ativa)} />Incluir contracapa na proposta</label>
        <div class="field">
          <span class="field-label">{camposImagem.contracapa_imagem_path}</span>
          <FileUpload name="contracapa_imagem_path" data-preview="contracapa_imagem_path" atualUrl={imagem('contracapa_imagem_path')} atualNome="Imagem de fundo atual" removerName="remover_contracapa_imagem_path" compacto />
          <Galeria pagina="contracapa" campo="contracapa_imagem_path" />
        </div>
        <div class="field">
          <label for="tp-cct">Título contracapa</label>
          <input id="tp-cct" name="contracapa_titulo" maxlength="120" value={valor('contracapa_titulo')} data-texto="contracapa_titulo" />
        </div>
        <div class="field">
          <label for="tp-ccc">Conteúdo contracapa</label>
          <textarea id="tp-ccc" name="contracapa_conteudo" maxlength="1000" data-texto="contracapa_conteudo">{valor('contracapa_conteudo')}</textarea>
        </div>
      </div>
      <div class="preview pagina capa" data-bg="contracapa_imagem_path" style={imagem('contracapa_imagem_path') ? `background-image:url('${imagem('contracapa_imagem_path')}')` : undefined}>
        <span class="preview-rotulo">Contracapa</span>
        <img data-img="logo_path" src={imagem('logo_path') ?? undefined} alt="" hidden={!imagem('logo_path')} />
        <strong data-alvo="contracapa_titulo">{valor('contracapa_titulo')}</strong>
        <small data-alvo="contracapa_conteudo">{valor('contracapa_conteudo')}</small>
      </div>
    </div>
  </SectionCard>
</form>

<script>
  import { toast } from '../../lib/ui';
  const form = document.querySelector<HTMLFormElement>('[data-template-form]');
  if (form) {
    const aplicarVars = () => {
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-var]').forEach((el) => {
        const v = el.tagName === 'SELECT' ? `'${el.value}', sans-serif` : el.value;
        form.style.setProperty(el.dataset.var!, v);
      });
    };
    // Textos refletidos na pré-visualização
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-texto]').forEach((el) => {
      el.addEventListener('input', () => {
        form.querySelectorAll<HTMLElement>(`[data-alvo="${el.dataset.texto}"]`).forEach((alvo) => (alvo.textContent = el.value));
      });
    });
    // Imagens escolhidas aparecem na pré-visualização antes de salvar
    form.querySelectorAll<HTMLInputElement>('[data-preview]').forEach((input) => {
      input.addEventListener('change', () => {
        const arquivo = input.files?.[0];
        if (!arquivo) return;
        const url = URL.createObjectURL(arquivo);
        const campo = input.dataset.preview!;
        form.querySelectorAll<HTMLElement>(`[data-bg="${campo}"]`).forEach((el) => (el.style.backgroundImage = `url('${url}')`));
        form.querySelectorAll<HTMLImageElement>(`[data-img="${campo}"]`).forEach((img) => {
          img.src = url;
          img.hidden = false;
        });
      });
    });

    // Cor: seletor nativo e campo hexadecimal andam juntos
    const definirCor = (campo: string, hex: string) => {
      const seletor = form.querySelector<HTMLInputElement>(`input[type="color"][name="${campo}"]`)!;
      seletor.value = hex.toLowerCase();
      form.querySelector<HTMLInputElement>(`[data-hex="${campo}"]`)!.value = hex.toUpperCase();
      seletor.dispatchEvent(new Event('input', { bubbles: true }));
    };
    form.querySelectorAll<HTMLInputElement>('[data-hex]').forEach((hex) => {
      const seletor = form.querySelector<HTMLInputElement>(`input[type="color"][name="${hex.dataset.hex}"]`)!;
      seletor.addEventListener('input', () => (hex.value = seletor.value.toUpperCase()));
      hex.addEventListener('input', () => {
        const v = hex.value.trim().replace(/^([^#])/, '#$1');
        if (/^#[0-9a-f]{6}$/i.test(v)) definirCor(hex.dataset.hex!, v);
      });
      hex.addEventListener('blur', () => (hex.value = seletor.value.toUpperCase()));
    });

    // Sugestões por IA: o logo (salvo ou recém-escolhido, inclusive SVG) vira um PNG reduzido no navegador
    const logoComoPng = async (): Promise<string | null> => {
      const img = form.querySelector<HTMLImageElement>('[data-logo]')!;
      const removido = form.querySelector<HTMLInputElement>('[name="remover_logo_path"]')?.checked;
      const novo = form.querySelector<HTMLInputElement>('input[name="logo_path"]')?.files?.length;
      if (img.hidden || !img.getAttribute('src') || (removido && !novo)) return null;
      await img.decode().catch(() => undefined);
      const max = 512;
      const w0 = img.naturalWidth || max;
      const h0 = img.naturalHeight || max;
      const escala = Math.min(1, max / Math.max(w0, h0));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(w0 * escala));
      canvas.height = Math.max(1, Math.round(h0 * escala));
      const ctx = canvas.getContext('2d')!;
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/png');
    };


    const valoresAtuais = () =>
      Object.fromEntries(
        ['fonte_titulo', 'fonte_corpo', 'cor_fundo', 'cor_texto_primaria', 'cor_texto_secundaria'].map((c) => [
          c,
          form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${c}"]`)!.value,
        ])
      );

    const pedirSugestao = async (botao: HTMLButtonElement, campos: string[], modo: 'sugerir' | 'capturar') => {
      const logo = await logoComoPng().catch(() => null);
      if (!logo) return toast('Envie o logotipo para usar as sugestões por IA.', 'info');
      botao.disabled = true;
      botao.classList.add('carregando');
      try {
        const res = await fetch('/api/templates/sugestao', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ logo, campos, modo, atuais: valoresAtuais() }),
        });
        const dados = await res.json().catch(() => ({ error: 'Falha na sugestão.' }));
        if (!res.ok) throw new Error(dados.error ?? 'Falha na sugestão.');
        let aplicados = 0;
        for (const campo of campos) {
          const v = dados[campo];
          if (typeof v !== 'string') continue;
          aplicados++;
          if (campo.startsWith('cor_')) definirCor(campo, v);
          else {
            const select = form.querySelector<HTMLSelectElement>(`select[name="${campo}"]`)!;
            select.value = v;
            select.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        if (!aplicados) throw new Error('A IA não trouxe uma sugestão válida. Tente de novo.');
        toast(dados.motivo || 'Sugestão aplicada. Salve para manter.', 'success');
      } catch (err) {
        toast(err instanceof Error ? err.message : 'Falha na sugestão.', 'error');
      } finally {
        botao.disabled = false;
        botao.classList.remove('carregando');
      }
    };

    form.querySelector<HTMLButtonElement>('[data-sugerir-fontes]')?.addEventListener('click', (e) =>
      pedirSugestao(e.currentTarget as HTMLButtonElement, ['fonte_titulo', 'fonte_corpo'], 'sugerir')
    );
    form.querySelector<HTMLButtonElement>('[data-capturar-cores]')?.addEventListener('click', (e) =>
      pedirSugestao(e.currentTarget as HTMLButtonElement, ['cor_fundo', 'cor_texto_primaria', 'cor_texto_secundaria'], 'capturar')
    );

    // Logo no rodapé: liga/desliga e posição refletidos na pré-visualização
    const rodapePreview = form.querySelector<HTMLElement>('[data-preview-rodape]')!;
    const blocoLogoRodape = form.querySelector<HTMLElement>('[data-logo-rodape]')!;
    const aplicarRodape = () => {
      const ativo = form.querySelector<HTMLInputElement>('[name="rodape_logo_ativo"]')!.checked;
      const posicao = form.querySelector<HTMLInputElement>('[name="rodape_logo_posicao"]:checked')?.value ?? 'direita';
      rodapePreview.className = `miolo-rodape logo-${posicao}${ativo ? '' : ' sem-logo'}`;
      blocoLogoRodape.classList.toggle('desligado', !ativo);
    };
    blocoLogoRodape.addEventListener('change', aplicarRodape);
    aplicarRodape();


    form.addEventListener('input', aplicarVars);
    form.addEventListener('change', aplicarVars);
    aplicarVars();
  }
</script>

<style>
  .template-form {
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cabecalho {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px 24px;
    padding: 28px 36px;
    background: var(--color-white);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
  }

  .nome {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nome label {
    font-size: 12px;
    text-transform: uppercase;
    color: var(--color-primary-text);
  }

  .nome input {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 6px;
    margin-left: -6px;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-neutral-80);
  }

  .nome input:hover,
  .nome input:focus {
    border-color: var(--color-neutral-30);
    outline: none;
  }

  .nome input:focus-visible {
    border-color: var(--color-primary-50);
    box-shadow: 0 0 0 1px var(--color-primary-50);
  }

  .acoes {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .gerais {
    grid-column: 1 / -1;
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
  }

  /* Identidade visual: logo, fontes e cores */
  .identidade {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Imagem usada só como fonte para as sugestões por IA (a miniatura visível fica no campo de upload) */
  .logo-fonte-ia {
    display: none !important;
  }

  .subgrupo {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }

  .subgrupo h4 {
    margin: 16px 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-neutral-80);
  }

  .subgrupo-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .subgrupo-topo h4 {
    margin-bottom: 4px;
  }

  .linha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: center;
    gap: 16px;
    padding: 10px 0;
  }

  .linha + .linha {
    border-top: 1px solid var(--color-neutral-20);
  }

  .linha-texto {
    display: flex;
    flex-direction: column;

---
// Etapa 1: o perfil público da empresa. Os dados da empresa (nome, CNPJ/CPF, e-mail, telefone/WhatsApp, logotipo)
// são os de Configurações › Empresa, mostrados aqui só para leitura e copiados para o perfil
// (server/busca/onboarding → sincronizarPerfisComEmpresa); aqui ficam redes, tempo de resposta, descrição e o
// link do perfil: o código do perfil no plano gratuito; nos planos pagos (recurso busca_slug), gerado do nome do buffet
// e atualizado quando o nome muda (server/busca/perfil → atualizarEnderecosPeloNome), ou escolhido pela empresa no campo
// "Endereço do perfil" (digitado ou uma das até 3 sugestões da varinha de IA, /api/busca/endereco-sugestoes).
import Icon from '../../ui/Icon.astro';
import Acoes from './Acoes.astro';
import { formatarDocumento } from '../../../lib/documento';
import { mascararTelefone } from '../../../lib/mascaras';
import { urlMidia, type PerfilBusca } from '../../../server/busca/perfil';
import type { DadosEmpresa } from '../../../server/busca/onboarding';
import { buscaUrl } from '../../../lib/busca/url';
import { ehUuid } from '../../../lib/busca/onboarding';
interface Props {
  perfil: PerfilBusca;
  editor: boolean;
  /** Cadastro da empresa (Configurações › Empresa) */
  empresa: DadosEmpresa | null;
  /** O que falta no cadastro da empresa para concluir a etapa */
  faltas: string[];
  /** Plano dá o link com o nome do buffet (recurso busca_slug) */
  endereco?: boolean;
}
const { perfil: p, editor, empresa, faltas, endereco = false } = Astro.props;
const linkPerfil = buscaUrl(`/buffet/${p.slug}`);
const linkVisivel = linkPerfil.replace(/^https?:\/\//, '');
const baseEndereco = buscaUrl('/buffet/').replace(/^https?:\/\//, '');
const enderecoAtual = ehUuid(p.slug) ? '' : p.slug;
const logo = urlMidia(p.tenant_id, p.logo_path);
const fone = empresa?.telefone ? mascararTelefone(empresa.telefone) : null;
---

<section class="onb-cartao onb-empresa">
  <div class="onb-empresa-topo">
    {logo ? <img class="onb-empresa-logo" src={logo} alt="" width="56" height="56" /> : <span class="onb-empresa-logo onb-empresa-logo--vazio"><Icon name="building" size={22} /></span>}
    <div class="onb-empresa-texto">
      <strong>{empresa?.nome ?? p.nome}</strong>
      <span>Dados da empresa, como estão em Configurações › Empresa. Eles aparecem no perfil e não precisam ser digitados aqui.</span>
    </div>
    {editor && <a href="/configuracoes/empresa" class="btn btn-secondary btn-md"><Icon name="pencil" size={16} /> Editar dados da empresa</a>}
  </div>
  <dl class="onb-empresa-dados">
    <div><dt>CNPJ ou CPF</dt><dd>{empresa?.documento ? formatarDocumento(empresa.documento) : '—'} <span class="field-hint">Não aparece no perfil</span></dd></div>
    <div><dt>E-mail comercial</dt><dd>{empresa?.email || '—'}</dd></div>
    <div><dt>{empresa?.telefone && empresa.telefone.replace(/\D/g, '').length === 11 ? 'WhatsApp para pedidos' : 'Telefone'}</dt><dd>{fone || '—'}</dd></div>
    <div><dt>Logotipo</dt><dd>{logo ? 'Do cadastro da empresa' : 'Sem logotipo (PNG, JPG ou WebP)'}</dd></div>
  </dl>
  {faltas.length > 0 && (
    <p class="onb-empresa-falta">
      <Icon name="alert-circle" size={16} />
      <span>Para concluir esta etapa, complete no cadastro da empresa: {faltas.join(', ')}. <a href="/configuracoes/empresa">Ir para Configurações › Empresa</a></span>
    </p>
  )}
</section>

<form method="post" data-form-sujo>
  <input type="hidden" name="_etapa" value="1" />
  <fieldset disabled={!editor} style="border:0;margin:0;padding:0;display:contents">
    <section class="onb-cartao">
      <div class="form-grid">
        <div class="field"><label for="e-insta">Instagram</label><input id="e-insta" name="instagram" placeholder="@seubuffet" value={p.instagram ?? ''} /></div>
        <div class="field"><label for="e-site">Site</label><input id="e-site" name="site" placeholder="www.seubuffet.com.br" value={p.site ?? ''} /></div>
        <div class="field"><label for="e-tempo">Tempo de resposta</label>
          <input id="e-tempo" value={p.tempo_resposta_texto ?? 'Responde em até 48 horas'} readonly />
          <span class="field-hint">Definido em <a class="link" href="/configuracoes/empresa#tempo-resposta">Configurações › Empresa</a>. O cumprimento desse prazo pesa no ranking.</span>
        </div>
        {endereco ? (
          <div class="field span-2" data-endereco>
            <label for="e-endereco">Endereço do perfil</label>
            <div class="onb-endereco">
              <span class="onb-endereco-base">{baseEndereco}</span>
              <input id="e-endereco" name="endereco" maxlength="60" autocomplete="off" spellcheck="false" placeholder="nome-do-seu-buffet" value={enderecoAtual} />
              {editor && (
                <button type="button" class="onb-endereco-ia" data-sugerir-endereco aria-label="Sugerir endereços com IA" title="Sugerir endereços com IA">
                  <Icon name="wand" size={18} />
                </button>
              )}
            </div>
            <div class="onb-endereco-sugestoes" data-sugestoes hidden>
              <span class="field-hint">Escolha uma sugestão:</span>
              <div class="onb-endereco-opcoes" role="radiogroup" aria-label="Sugestões de endereço" data-opcoes></div>
            </div>
            <span class="field-hint">
              {p.slug_escolhido ? 'Endereço escolhido por você. Apague para voltar a acompanhar o nome do buffet.' : 'Gerado a partir do nome do buffet. Troque se quiser: digite ou use a varinha para sugestões.'}
              {' '}O endereço anterior continua levando ao perfil.
              <button type="button" class="btn btn-text btn-sm onb-endereco-copiar" data-copiar-link={linkPerfil}><Icon name="copy" size={14} /> Copiar link</button>
            </span>
          </div>
        ) : (
          <div class="field span-2">
            <span class="field-label">Link do perfil</span>
            <div class="onb-link">
              <span class="onb-link-url" title={linkPerfil}>{linkVisivel}</span>
              <button type="button" class="btn btn-secondary btn-sm" data-copiar-link={linkPerfil}><Icon name="copy" size={16} /> Copiar link</button>
            </div>
            <a class="field-hint" href="/busca?etapa=1&bloqueado=busca_slug" data-bloqueado="busca_slug"><Icon name="lock" size={12} /> Link com o nome do buffet: exclusivo Banket</a>
          </div>
        )}
        <div class="field span-2">
          <label for="e-desc">Descrição<span class="obrigatorio">*</span></label>
          <textarea id="e-desc" name="descricao" rows="6" minlength="80" maxlength="1200" required placeholder="Há quantos anos atende, o espaço, a cozinha, o que torna o seu buffet especial.">{p.descricao ?? ''}</textarea>
          <span class="field-hint" data-contador>De 80 a 1.200 caracteres. Descrições com mais de 300 caracteres ajudam no ranking.</span>
        </div>
      </div>
    </section>
  </fieldset>
  <Acoes etapa={1} editor={editor} />
</form>

<script>
  import { emCarregamento, toast } from '../../../lib/ui';

  // Varinha: até 3 sugestões de endereço pela IA; escolher uma preenche o campo (salva com o botão Salvar da etapa)
  const caixa = document.querySelector<HTMLElement>('[data-endereco]');
  const campo = caixa?.querySelector<HTMLInputElement>('#e-endereco');
  const botaoIa = caixa?.querySelector<HTMLButtonElement>('[data-sugerir-endereco]');
  const painel = caixa?.querySelector<HTMLElement>('[data-sugestoes]');
  const opcoes = caixa?.querySelector<HTMLElement>('[data-opcoes]');
  botaoIa?.addEventListener('click', async () => {
    const fim = emCarregamento(botaoIa, '');
    botaoIa.classList.add('onb-endereco-ia--gerando');
    try {
      const res = await fetch('/api/busca/endereco-sugestoes', { method: 'POST', headers: { Accept: 'application/json' } });
      const corpo = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(corpo.error || 'Não foi possível sugerir agora.');
      const lista: string[] = corpo.sugestoes ?? [];
      opcoes!.replaceChildren(
        ...lista.map((s) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'onb-endereco-opcao';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', String(campo!.value === s));
          b.textContent = s;
          b.addEventListener('click', () => {
            campo!.value = s;
            campo!.dispatchEvent(new Event('input', { bubbles: true }));
            opcoes!.querySelectorAll('[role="radio"]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
          });
          return b;
        })
      );
      painel!.hidden = lista.length === 0;
      opcoes!.querySelector<HTMLButtonElement>('button')?.focus();
    } catch (err) {
      toast((err as Error).message, 'error');
    } finally {
      botaoIa.classList.remove('onb-endereco-ia--gerando');
      fim();
    }
  });

  document.addEventListener('click', (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLElement>('[data-copiar-link]');
    if (!botao) return;
    navigator.clipboard
      .writeText(botao.dataset.copiarLink!)
      .then(() => toast('Link do perfil copiado.', 'success'))
      .catch(() => toast('Não foi possível copiar o link.', 'error'));
  });
</script>

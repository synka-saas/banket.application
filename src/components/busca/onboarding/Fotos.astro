---
// Etapa 5: fotos (JPG, PNG ou WebP; comprimidas no navegador). A capa é a primeira. Plano gratuito: até 5 fotos gerais,
// sem grupos; o que passa do limite volta com o painel de upsell. Perfil Personalizado: mais fotos (limite do plano) e em grupos (tags),
// para mostrar eventos diferentes ("Casamento Ana e Pedro"). Fotos bloqueadas pelo plano (rebaixamento) aparecem
// esmaecidas e não vão para o perfil público.
import Icon from '../../ui/Icon.astro';
import Acoes from './Acoes.astro';
import { ETAPA_FOTOS } from '../../../lib/busca/onboarding';
import { urlMidia } from '../../../server/busca/perfil';
import type { Foto } from '../../../server/busca/onboarding';
interface Props {
  fotos: Foto[];
  tenantId: string;
  editor: boolean;
  maxFotos: number;
  /** Grupos de fotos (tags) liberados pelo plano */
  tags: boolean;
}
const { fotos, tenantId, editor, maxFotos, tags } = Astro.props;
const visiveis = fotos.filter((f) => !f.bloqueado_plano_em);
const limitado = Number.isFinite(maxFotos);
const restam = limitado ? Math.max(0, maxFotos - visiveis.length) : 20;
// Galeria por grupo (o primeiro grupo da foto); sem grupos no plano, uma lista só
const nomesGrupos = [...new Set(fotos.flatMap((f) => f.tags))];
const grupos: { nome: string | null; fotos: Foto[] }[] = tags && nomesGrupos.length
  ? [...nomesGrupos.map((g) => ({ nome: g, fotos: fotos.filter((f) => f.tags[0] === g) })), { nome: null, fotos: fotos.filter((f) => !f.tags.length) }].filter((g) => g.fotos.length)
  : [{ nome: null, fotos }];
---

{editor && (
  <form method="post" enctype="multipart/form-data" class="onb-cartao" data-fotos-form data-restam={restam}>
    <input type="hidden" name="_etapa" value={ETAPA_FOTOS} />
    <h2>Enviar fotos</h2>
    <p class="onb-limite">
      {limitado ? <><span class="tabular">{visiveis.length} de {maxFotos} fotos</span> no seu plano.{!tags && <> <a href={`/busca?etapa=${ETAPA_FOTOS}&bloqueado=busca_fotos`} data-bloqueado="busca_fotos">Mais fotos e grupos por evento</a></>}</> : <span class="tabular">{visiveis.length} fotos</span>}
    </p>
    {restam > 0 ? (
      <>
        {/* Área de envio: clicar abre o seletor; arrastar e soltar também funciona (script abaixo) */}
        <div class="onb-drop" data-drop>
          <input id="f-arquivos" name="fotos" type="file" accept="image/jpeg,image/png,image/webp" multiple required data-fotos-input class="onb-drop-input" />
          <label for="f-arquivos" class="onb-drop-alvo">
            <span class="onb-drop-ico"><Icon name="photo-up" size={26} /></span>
            <span class="onb-drop-texto"><span class="onb-drop-link">Clique para escolher</span> ou arraste e solte as fotos aqui</span>
            <span class="onb-drop-hint" data-fotos-status>JPG, PNG ou WebP · até 8 MB cada{limitado ? ` · você pode enviar mais ${restam}` : ''}</span>
          </label>
          <ul class="onb-drop-lista" data-fotos-lista hidden></ul>
        </div>
        {tags && (
          <div class="field">
            <label for="f-grupo">Grupo</label>
            <input id="f-grupo" name="grupo" maxlength="40" list="f-grupos" placeholder="Ex.: Casamento Ana e Pedro" />
            <datalist id="f-grupos">{nomesGrupos.map((g) => <option value={g} />)}</datalist>
            <span class="field-hint">Opcional. Junte as fotos de um mesmo evento; no perfil, cada grupo aparece separado.</span>
          </div>
        )}
        <div class="onb-drop-acoes">
          <button type="button" class="btn btn-ghost btn-md" data-fotos-limpar hidden>Limpar seleção</button>
          <button type="submit" name="_acao" value="enviar" class="btn btn-primary btn-md" data-carregando="Enviando…" data-fotos-enviar><Icon name="upload" size={16} /> Enviar fotos</button>
        </div>
      </>
    ) : (
      <div class="onb-aviso">{`Você atingiu o limite de ${maxFotos} fotos do seu plano. Exclua uma foto para enviar outra ou conheça os planos Banket, com mais fotos e grupos por evento.`}</div>
    )}
  </form>
)}

{fotos.length > 0 ? (
  <section class="onb-cartao">
    <h2>Galeria</h2>
    <p>A capa aparece primeiro nos resultados. Use as setas para mudar a ordem.</p>
    {grupos.map((g) => (
    <>
    {g.nome !== null || grupos.length > 1 ? <h3 class="onb-grupo-titulo">{g.nome ?? 'Sem grupo'} <span class="tabular">{String(g.fotos.length).padStart(2, '0')}</span></h3> : null}
    <ul class="onb-fotos">
      {g.fotos.map((f, i) => (
        <li class:list={['onb-foto', { 'onb-foto--bloqueada': f.bloqueado_plano_em }]}>
          <div class="onb-foto-img">
            <img src={urlMidia(tenantId, f.path)!} alt={f.legenda ?? `Foto ${i + 1}`} loading="lazy" width="360" height="270" />
            {f.capa && <span class="badge badge-accent">Capa</span>}
            {f.bloqueado_plano_em && <span class="badge">Fora do plano</span>}
          </div>
          {editor && !f.bloqueado_plano_em && (
            <>
              <form method="post" class="onb-foto-acoes">
                <input type="hidden" name="_etapa" value={ETAPA_FOTOS} /><input type="hidden" name="id" value={f.id} />
                {!f.capa && <button type="submit" name="_acao" value="capa" class="btn btn-ghost btn-sm">Usar como capa</button>}
                {!f.capa && <button type="submit" name="_acao" value="antes" class="btn btn-ghost btn-sm" aria-label="Mover para antes"><Icon name="arrow-left" size={15} /></button>}
                {!f.capa && <button type="submit" name="_acao" value="depois" class="btn btn-ghost btn-sm" aria-label="Mover para depois"><Icon name="arrow-right" size={15} /></button>}
                <button type="submit" name="_acao" value="excluir" class="btn btn-ghost btn-sm" aria-label="Excluir foto" data-confirm="Excluir esta foto?"><Icon name="trash" size={15} /></button>
              </form>
              <form method="post" style="display:flex;flex-direction:column;gap:6px">
                <input type="hidden" name="_etapa" value={ETAPA_FOTOS} /><input type="hidden" name="id" value={f.id} />
                <div class="field"><label class="sr-only" for={`f-leg-${f.id}`}>Legenda</label><input id={`f-leg-${f.id}`} name="legenda" maxlength="160" placeholder="Legenda" value={f.legenda ?? ''} /></div>
                {tags ? (
                  <div class="field"><label class="sr-only" for={`f-tags-${f.id}`}>Grupo</label><input id={`f-tags-${f.id}`} name="tags" list="f-grupos" maxlength="120" placeholder="Grupo do evento" value={f.tags.join(', ')} /></div>
                ) : (
                  <a class="field-hint" href={`/busca?etapa=${ETAPA_FOTOS}&bloqueado=busca_fotos_tags`} data-bloqueado="busca_fotos_tags"><Icon name="lock" size={12} /> Grupos de fotos por evento: exclusivo Banket</a>
                )}
                <button type="submit" name="_acao" value="foto" class="btn btn-outline btn-sm">{tags ? 'Salvar legenda e grupo' : 'Salvar legenda'}</button>
              </form>
            </>
          )}
        </li>
      ))}
    </ul>
    </>
    ))}
  </section>
) : (
  <div class="onb-aviso">Envie ao menos 3 fotos para publicar o perfil. Comece pelo salão montado, depois a comida de perto.</div>
)}

<form method="post">
  <input type="hidden" name="_etapa" value={ETAPA_FOTOS} />
  <Acoes etapa={ETAPA_FOTOS} editor={editor} soContinuar />
</form>

<script>
  // Envio de fotos: clicar ou arrastar e soltar na área; miniaturas das escolhidas antes de enviar. Fotos grandes são
  // reduzidas no navegador (lado maior 1920 px, JPEG 85%) e a seleção respeita o limite do plano (o servidor confere).
  const form = document.querySelector<HTMLFormElement>('[data-fotos-form]');
  const input = form?.querySelector<HTMLInputElement>('[data-fotos-input]');
  const drop = form?.querySelector<HTMLElement>('[data-drop]');
  const status = form?.querySelector<HTMLElement>('[data-fotos-status]');
  const lista = form?.querySelector<HTMLUListElement>('[data-fotos-lista]');
  const enviar = form?.querySelector<HTMLButtonElement>('[data-fotos-enviar]');
  const limpar = form?.querySelector<HTMLButtonElement>('[data-fotos-limpar]');
  const TIPOS = ['image/jpeg', 'image/png', 'image/webp'];
  const MAX = 8 * 1024 * 1024;
  const textoPadrao = status?.textContent ?? '';
  let urls: string[] = [];

  async function reduzir(f: File): Promise<File> {
    if (f.size < 1_500_000) return f;
    const img = await createImageBitmap(f).catch(() => null);
    if (!img) return f;
    const escala = Math.min(1, 1920 / Math.max(img.width, img.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.width * escala);
    canvas.height = Math.round(img.height * escala);
    canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, 'image/jpeg', 0.85));
    return blob ? new File([blob], f.name.replace(/\.\w+$/, '.jpg'), { type: 'image/jpeg' }) : f;
  }

  function mostrar(arquivos: File[], aviso: string | null) {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = arquivos.map((f) => URL.createObjectURL(f));
    lista!.replaceChildren(
      ...arquivos.map((f, i) => {
        const li = document.createElement('li');
        const img = document.createElement('img');
        img.src = urls[i];
        img.alt = f.name;
        li.append(img);
        return li;
      })
    );
    lista!.hidden = arquivos.length === 0;
    drop!.classList.toggle('onb-drop--com-fotos', arquivos.length > 0);
    enviar!.disabled = arquivos.length === 0;
    limpar!.hidden = arquivos.length === 0;
    const qtd = arquivos.length === 1 ? '1 foto escolhida' : `${arquivos.length} fotos escolhidas`;
    status!.textContent = arquivos.length ? [qtd, aviso].filter(Boolean).join(' · ') : aviso ?? textoPadrao;
  }

  async function escolher(recebidos: File[]) {
    const restam = Number(form!.dataset.restam ?? 20);
    const avisos: string[] = [];
    let arquivos = recebidos.filter((f) => TIPOS.includes(f.type));
    const fora = recebidos.length - arquivos.length;
    if (fora) avisos.push(`${fora === 1 ? '1 arquivo ignorado' : `${fora} arquivos ignorados`} (só JPG, PNG ou WebP)`);
    if (arquivos.length > restam) {
      arquivos = arquivos.slice(0, restam);
      avisos.push(`só ${restam} cabem no seu plano`);
    }
    const prontos = (await Promise.all(arquivos.map(reduzir))).filter((f) => f.size <= MAX);
    const grandes = arquivos.length - prontos.length;
    if (grandes) avisos.push(`${grandes === 1 ? '1 foto acima' : `${grandes} fotos acima`} de 8 MB ficou de fora`.replace('fotos acima de 8 MB ficou', 'fotos acima de 8 MB ficaram'));
    const dt = new DataTransfer();
    prontos.forEach((f) => dt.items.add(f));
    input!.files = dt.files;
    mostrar(prontos, avisos.length ? avisos.join(' · ').replace(/^./, (c) => c.toUpperCase()) : null);
  }

  if (form && input && drop && lista && enviar && limpar) {
    enviar.disabled = true; // sem JavaScript o botão fica habilitado e o navegador exige a escolha (required)
    input.addEventListener('change', () => escolher([...(input.files ?? [])]));
    const parar = (e: Event) => { e.preventDefault(); e.stopPropagation(); };
    ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { parar(e); drop.classList.add('onb-drop--sobre'); }));
    ['dragleave', 'dragend'].forEach((t) => drop.addEventListener(t, (e) => {
      parar(e);
      if (!drop.contains((e as DragEvent).relatedTarget as Node | null)) drop.classList.remove('onb-drop--sobre');
    }));
    drop.addEventListener('drop', (e) => {
      parar(e);
      drop.classList.remove('onb-drop--sobre');
      escolher([...((e as DragEvent).dataTransfer?.files ?? [])]);
    });
    limpar.addEventListener('click', () => {
      input.value = '';
      mostrar([], null);
    });
  }
</script>

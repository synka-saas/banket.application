---
// Etapa 4: capacidade mínima e máxima (eliminatória na busca) e eventos menores com valor mínimo de contrato.
import Acoes from './Acoes.astro';
import type { PerfilBusca } from '../../../server/busca/perfil';
interface Props {
  perfil: PerfilBusca;
  editor: boolean;
}
const { perfil: p, editor } = Astro.props;
---

<form method="post" data-form-sujo data-capacidade>
  <input type="hidden" name="_etapa" value="4" />
  <fieldset disabled={!editor} style="border:0;margin:0;padding:0;display:contents">
    <section class="onb-cartao">
      <div class="form-grid">
        <div class="field"><label for="c-min">Mínimo de convidados<span class="obrigatorio">*</span></label><input id="c-min" name="capacidade_min" type="number" min="1" max="5000" required inputmode="numeric" value={p.capacidade_min ?? ''} /><span class="field-hint">Abaixo disso, o pedido não chega até você.</span></div>
        <div class="field"><label for="c-max">Máximo de convidados<span class="obrigatorio">*</span></label><input id="c-max" name="capacidade_max" type="number" min="1" max="5000" required inputmode="numeric" value={p.capacidade_max ?? ''} /><span class="field-hint">Considere o espaço e a sua equipe.</span></div>
      </div>
      <p class="onb-limite" data-faixa aria-live="polite">{p.capacidade_min && p.capacidade_max ? `Seu buffet aparece em buscas de ${p.capacidade_min} a ${p.capacidade_max} convidados.` : 'Informe a faixa de convidados.'}</p>
      <label class="switch"><input type="checkbox" name="aceita_menor" checked={p.aceita_menor} data-menor /><span>Aceito eventos menores com valor mínimo de contrato</span></label>
      <div class="field" data-valor-minimo style="max-width:280px">
        <label for="c-valor">Valor mínimo do contrato (R$)</label>
        <input id="c-valor" name="valor_minimo" data-mascara="dinheiro" inputmode="decimal" value={p.valor_minimo != null ? p.valor_minimo.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : ''} />
      </div>
    </section>
  </fieldset>
  <Acoes etapa={4} editor={editor} />
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-capacidade]');
  if (form) {
    const min = form.querySelector<HTMLInputElement>('#c-min')!;
    const max = form.querySelector<HTMLInputElement>('#c-max')!;
    const faixa = form.querySelector<HTMLElement>('[data-faixa]')!;
    const menor = form.querySelector<HTMLInputElement>('[data-menor]')!;
    const valor = form.querySelector<HTMLElement>('[data-valor-minimo]')!;
    const atualizar = () => {
      faixa.textContent = min.value && max.value ? `Seu buffet aparece em buscas de ${min.value} a ${max.value} convidados.` : 'Informe a faixa de convidados.';
      valor.hidden = !menor.checked;
    };
    form.addEventListener('input', atualizar);
    atualizar();
  }
</script>

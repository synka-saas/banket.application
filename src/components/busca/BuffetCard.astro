---
// Card de buffet nos resultados e nos destaques (layout-busca/BuffetCard): foto, selo "Cliente Banket", nota, região,
// distância, tags, capacidade e as ações (selecionar para pedir a vários + pedir orçamento). O Busca não divulga preço.
import Icon from '../ui/Icon.astro';
import { formatarDistancia } from '../../lib/busca/geo';
import { rotuloEvento, rotuloServico } from '../../lib/busca/catalogos';
import { FOTO_PADRAO, caminhoVitrine } from '../../lib/busca/url';
import { queryDaBusca, type Criterios } from '../../lib/busca/filtros';
import type { ItemResultado } from '../../server/busca/publico';

interface Props {
  item: ItemResultado;
  criterios?: Partial<Criterios>;
  /** Destaques da home: sem seleção múltipla */
  compacto?: boolean;
  /** Prioridade de carregamento da foto (primeiros cards) */
  primeiro?: boolean;
}

const { item, criterios = {}, compacto = false, primeiro = false } = Astro.props;
const query = queryDaBusca({ tipo: criterios.tipo, cidade: criterios.cidade, data: criterios.data, convidados: criterios.convidados });
const perfilUrl = caminhoVitrine(`/buffet/${item.slug}`) + query;
const pedirUrl = caminhoVitrine('/orcamento') + (query ? `${query}&` : '?') + `buffets=${item.slug}`;
const regiao = [item.bairro, item.cidade].filter(Boolean).join(', ') || null;
const distancia = formatarDistancia(item.distanciaKm);
const tags = [
  ...(criterios.tipo ? [rotuloEvento(criterios.tipo)] : item.tiposEvento.slice(0, 1).map(rotuloEvento)),
  ...item.tiposServico.slice(0, 1).map(rotuloServico),
  ...(item.espacoProprio ? ['Espaço próprio'] : []),
  ...(item.atendeDomicilio ? ['Em domicílio'] : []),
].slice(0, 3);
const capacidade =
  item.capacidadeMin && item.capacidadeMax ? `${item.capacidadeMin} a ${item.capacidadeMax} convidados`
  : item.capacidadeMax ? `Até ${item.capacidadeMax} convidados` : item.capacidadeMin ? `A partir de ${item.capacidadeMin} convidados` : null;
const nota = item.notaMedia?.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<article class:list={['bcard', { 'bcard--compacto': compacto }]} data-buffet={item.slug} data-nome={item.nome}>
  <a href={perfilUrl} class="bcard-foto" tabindex="-1" aria-hidden="true">
    <img src={item.foto ?? FOTO_PADRAO} alt="" loading={primeiro ? 'eager' : 'lazy'} decoding="async" width="560" height="420" />
    {item.disponibilidade === 'disponivel' && <span class="bcard-disponivel"><span class="bcard-ponto" aria-hidden="true"></span>Disponível na data</span>}
  </a>
  <div class="bcard-corpo">
    <div class="bcard-cabeca">
      <h3 class="bcard-nome"><a href={perfilUrl}>{item.nome}</a></h3>
      {item.selo && (
        <span class="bcard-selo" title="Usa o Banket para gerenciar eventos e orçamentos">
          <img src="/logo-mark.png" alt="" width="14" height="14" />Cliente Banket
        </span>
      )}
    </div>
    <p class="bcard-meta">
      {nota ? (
        <span class="bcard-nota"><Icon name="star" size={14} class="bcard-estrela" />{nota} <span class="bcard-qtd">({item.totalAvaliacoes})</span></span>
      ) : (
        <span class="bcard-qtd">Sem avaliações</span>
      )}
      {regiao && <><span class="bcard-sep" aria-hidden="true">·</span><span>{regiao}</span></>}
      {distancia && <><span class="bcard-sep" aria-hidden="true">·</span><span class="tabular">{distancia}</span></>}
    </p>
    {tags.length > 0 && <ul class="bcard-tags">{tags.map((t) => <li class="tag tag-sm">{t}</li>)}</ul>}
    {item.disponibilidade === 'consultar' && <p class="bcard-consultar"><Icon name="calendar" size={14} /> Consultar disponibilidade</p>}
    <div class="bcard-rodape">
      {capacidade && (
        <div class="bcard-info">
          <span class="bcard-cap"><Icon name="users" size={14} />{capacidade}</span>
        </div>
      )}
      <div class="bcard-acoes">
        {!compacto && (
          <label class="bcard-selecionar">
            <input type="checkbox" data-selecionar={item.slug} aria-label={`Selecionar ${item.nome} para pedir orçamento`} />
            <span>Selecionar</span>
          </label>
        )}
        <a href={pedirUrl} class="btn btn-primary btn-md" data-pedir={item.slug}>Pedir orçamento</a>
      </div>
    </div>
  </div>
</article>

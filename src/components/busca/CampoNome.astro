---
// Nome do buffet na barra de busca, com instant search (/api/vitrine/buffets): enquanto digita, mostra os buffets
// publicados com esse nome; escolher um abre o perfil. Enter sem escolher envia a busca filtrando pelo nome (?q=).
// Combobox acessível (setas, Enter, Esc). Sem JavaScript, o campo só filtra a busca.
import Icon from '../ui/Icon.astro';
import { caminhoVitrine } from '../../lib/busca/url';

interface Props {
  id: string;
  valor?: string | null;
}
const { id, valor = null } = Astro.props;
---

<div class="field fbusca-cidade" data-nome-buffet data-perfil={caminhoVitrine('/buffet/')}>
  <label for={id}>Nome do buffet</label>
  <div class="campo-icone">
    <Icon name="search" size={18} class="campo-icone-ico" />
    <input
      id={id} name="q" type="search" autocomplete="off" maxlength="80" placeholder="Ex.: Bisutti" value={valor ?? ''}
      role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-lista`} data-nome-texto
    />
  </div>
  <ul id={`${id}-lista`} class="fbusca-sugestoes" role="listbox" aria-label="Buffets com esse nome" hidden data-nome-lista></ul>
</div>

<script>
  interface Sugestao {
    slug: string;
    nome: string;
    bairro: string | null;
    cidade: string | null;
    uf: string | null;
  }

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-nome-buffet]')) {
    if (raiz.dataset.pronto) continue;
    raiz.dataset.pronto = '1';
    const texto = raiz.querySelector<HTMLInputElement>('[data-nome-texto]')!;
    const lista = raiz.querySelector<HTMLUListElement>('[data-nome-lista]')!;
    const base = raiz.dataset.perfil!;
    let itens: Sugestao[] = [];
    let ativo = -1;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let pedido = 0;

    const fechar = () => {
      lista.hidden = true;
      texto.setAttribute('aria-expanded', 'false');
      texto.removeAttribute('aria-activedescendant');
      ativo = -1;
    };
    const abrir = (i: number) => {
      const s = itens[i];
      if (s) window.location.href = base + encodeURIComponent(s.slug);
    };
    const desenhar = () => {
      lista.replaceChildren(
        ...itens.map((s, i) => {
          const li = document.createElement('li');
          li.id = `${lista.id}-${i}`;
          li.setAttribute('role', 'option');
          li.className = 'fbusca-sugestao' + (i === ativo ? ' ativa' : '');
          li.setAttribute('aria-selected', String(i === ativo));
          const nome = document.createElement('span');
          nome.className = 'fbusca-sugestao-nome';
          nome.textContent = s.nome;
          const onde = document.createElement('span');
          onde.className = 'fbusca-sugestao-sub';
          onde.textContent = [s.bairro, s.cidade && s.uf ? `${s.cidade} · ${s.uf}` : s.cidade].filter(Boolean).join(', ');
          li.append(nome, onde);
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            abrir(i);
          });
          return li;
        })
      );
      lista.hidden = itens.length === 0;
      texto.setAttribute('aria-expanded', String(itens.length > 0));
      if (ativo >= 0) texto.setAttribute('aria-activedescendant', `${lista.id}-${ativo}`);
      else texto.removeAttribute('aria-activedescendant');
    };
    texto.addEventListener('input', () => {
      clearTimeout(timer);
      const q = texto.value.trim();
      if (q.length < 2) {
        itens = [];
        return desenhar();
      }
      timer = setTimeout(async () => {
        const n = ++pedido;
        let novos: Sugestao[] = [];
        try {
          const r = await fetch(`/api/vitrine/buffets?q=${encodeURIComponent(q)}`);
          novos = r.ok ? await r.json() : [];
        } catch {
          novos = [];
        }
        if (n !== pedido) return; // resposta de uma digitação anterior
        itens = novos;
        ativo = -1; // Enter sem escolher envia a busca pelo nome
        desenhar();
      }, 150);
    });
    texto.addEventListener('keydown', (e) => {
      if (lista.hidden) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        ativo = ativo < 0 ? (e.key === 'ArrowDown' ? 0 : itens.length - 1) : (ativo + (e.key === 'ArrowDown' ? 1 : -1) + itens.length) % itens.length;
        desenhar();
      } else if (e.key === 'Enter' && ativo >= 0) {
        e.preventDefault();
        abrir(ativo);
      } else if (e.key === 'Escape') {
        fechar();
      }
    });
    texto.addEventListener('blur', () => setTimeout(fechar, 120));
  }
</script>

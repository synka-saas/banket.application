---
// Casca do cadastro do perfil no Banket Busca (layout-busca/BuffetOnboarding): cabeçalho próprio com a marca e
// "Salvar e sair", barra de progresso, lista das etapas (concluída / atual / a fazer) e os recursos "Exclusivo
// Banket" (Cardápios, Disponibilidade) com cadeado no plano gratuito. Sessão obrigatória (rota /busca/*).
import Layout from './Layout.astro';
import MarcaBusca from '../components/busca/MarcaBusca.astro';
import Icon from '../components/ui/Icon.astro';
import Toast from '../components/ui/Toast.astro';
import Confirmar from '../components/ui/Confirmar.astro';
import Mascaras from '../components/ui/Mascaras.astro';
import Upsell from '../components/planos/Upsell.astro';
import { ETAPAS, EXCLUSIVOS } from '../lib/busca/onboarding';
import '../styles/busca.css';
import '../styles/onboarding.css';

interface Props {
  title: string;
  etapa: number;
  concluidas: number[];
  /** Recursos exclusivos liberados pelo plano (busca_cardapios, busca_disponibilidade) */
  liberados: string[];
}
const { title, etapa, concluidas, liberados } = Astro.props;
const feitas = new Set(concluidas);
const progresso = Math.round((Math.min(concluidas.filter((n) => n <= 6).length, 6) / 6) * 100);
---

<Layout title={title}>
  <div class="onb">
    <header class="onb-topo">
      <MarcaBusca href="/busca" altura={22} />
      <span class="onb-topo-titulo">Cadastro do buffet</span>
      <span class="onb-topo-etapa tabular">Etapa {etapa} de {ETAPAS.length}</span>
      <a class="btn btn-ghost btn-sm onb-sair" href="/busca"><Icon name="logout" size={16} /> Salvar e sair</a>
    </header>
    <div class="onb-progresso" role="progressbar" aria-label="Etapas concluídas" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progresso}>
      <span style={`width:${progresso}%`}></span>
    </div>

    <div class="onb-corpo">
      <nav class="onb-etapas" aria-label="Etapas do cadastro">
        <span class="eyebrow">Etapa {etapa} de {ETAPAS.length}</span>
        <ol>
          {ETAPAS.map((e) => {
            const estado = e.n === etapa ? 'atual' : feitas.has(e.n) ? 'feita' : 'afazer';
            return (
              <li>
                <a href={`/busca/cadastro?etapa=${e.n}`} class:list={['onb-etapa', `onb-etapa--${estado}`]} aria-current={estado === 'atual' ? 'step' : undefined}>
                  <span class="onb-etapa-n">{estado === 'feita' ? <Icon name="check" size={16} /> : e.n}</span>
                  <span class="onb-etapa-texto"><span>{e.titulo}</span><small>{e.sub}</small></span>
                </a>
              </li>
            );
          })}
        </ol>
        <p class="eyebrow onb-exclusivos-titulo">Exclusivo Banket</p>
        <ul>
          {EXCLUSIVOS.map((x) => {
            const livre = liberados.includes(x.recurso);
            return (
              <li>
                {livre ? (
                  <span class="onb-etapa onb-etapa--livre">
                    <span class="onb-etapa-n"><Icon name="circle-check" size={16} /></span>
                    <span class="onb-etapa-texto"><span>{x.titulo}</span><small>Incluído no seu plano · vem do Banket</small></span>
                  </span>
                ) : (
                  <a href={`/busca?bloqueado=${x.recurso}`} class="onb-etapa onb-etapa--bloqueada" data-bloqueado={x.recurso}>
                    <span class="onb-etapa-n"><Icon name="lock" size={15} /></span>
                    <span class="onb-etapa-texto"><span>{x.titulo}</span><small>{x.sub}</small></span>
                    <span class="sr-only">(exclusivo para clientes Banket)</span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </nav>

      <main class="onb-principal">
        <slot />
      </main>
    </div>
  </div>
  <Toast flash={Astro.locals.flash} />
  <Confirmar />
  <Upsell />
  <Mascaras />
</Layout>

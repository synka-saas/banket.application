---
// Casca das páginas de um evento: "Propostas / título do evento" (com link de volta) e as abas do evento.
import AppLayout from './AppLayout.astro';
import { ROTULOS } from '../lib/rotulos';
import { isAdmin } from '../lib/auth';
import { podeUsarEm } from '../lib/planos/gating';
import { recursoDaRota } from '../lib/planos/rotas';

interface Props {
  eventoId: string;
  titulo: string;
  aba: 'resumo' | 'orcamento' | 'informacoes' | 'condicoes' | 'compras' | 'margem' | 'negociacao' | 'mensagens' | 'reunioes' | 'documentos' | 'financas' | 'timeline';
}

const { eventoId, titulo, aba } = Astro.props;
const base = `/eventos/${eventoId}`;

// Informações complementares e condições gerais pertencem à versão do orçamento: ficam como sub-abas dele
const abas = [
  { id: 'resumo', label: 'Resumo do evento', href: base },
  { id: 'orcamento', label: 'Orçamento', href: `${base}/orcamento` },
  { id: 'negociacao', label: 'Assistente de Negociação IA', href: `${base}/negociacao` },
  { id: 'mensagens', label: 'Mensagens', href: `${base}/mensagens` },
  { id: 'reunioes', label: 'Reuniões', href: `${base}/reunioes` },
  { id: 'documentos', label: 'Documentos', href: `${base}/documentos` },
  // Finanças: só owner/admin (o middleware também bloqueia a rota)
  ...(isAdmin(Astro.locals.user) ? [{ id: 'financas', label: 'Finanças', href: `${base}/financas` }] : []),
  { id: 'timeline', label: 'Linha do tempo', href: `${base}/linha-do-tempo` },
];
// Abas cujo módulo está fora do plano ficam com cadeado: o clique abre o upsell aqui mesmo, sem sair do evento
const plano = Astro.locals.plano ?? null;
const abasComPlano = abas.map((a) => {
  const recurso = recursoDaRota(a.href);
  return recurso && !podeUsarEm(plano, recurso) ? { ...a, bloqueado: recurso } : a;
});
const abaAtiva = aba === 'informacoes' || aba === 'condicoes' || aba === 'compras' || aba === 'margem' ? 'orcamento' : aba;
---

<AppLayout title={titulo} heading={titulo} voltar={{ href: '/eventos', label: ROTULOS.funil }} submenu={abasComPlano} submenuActive={abaAtiva}>
  <slot />
  <slot name="overlays" slot="overlays" />
</AppLayout>

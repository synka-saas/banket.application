---
// Casca das páginas de um evento: "Funil de vendas / título do evento" (com link de volta) e as abas do evento.
import AppLayout from './AppLayout.astro';
import { ROTULOS } from '../lib/rotulos';

interface Props {
  eventoId: string;
  titulo: string;
  aba: 'resumo' | 'orcamento' | 'informacoes' | 'condicoes' | 'timeline';
}

const { eventoId, titulo, aba } = Astro.props;
const base = `/eventos/${eventoId}`;

// Informações complementares e condições gerais pertencem à versão do orçamento: ficam como sub-abas dele
const abas = [
  { id: 'resumo', label: 'Resumo do evento', href: base },
  { id: 'orcamento', label: 'Orçamento', href: `${base}/orcamento` },
  { id: 'timeline', label: 'Linha do tempo', href: `${base}/linha-do-tempo` },
];
const abaAtiva = aba === 'informacoes' || aba === 'condicoes' ? 'orcamento' : aba;
---

<AppLayout title={titulo} heading={titulo} voltar={{ href: '/eventos', label: ROTULOS.funil }} submenu={abas} submenuActive={abaAtiva}>
  <slot />
  <slot name="overlays" slot="overlays" />
</AppLayout>

---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Gestor de Relacionamento Banket" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Banket CRM</title>
  </head>
  <body>
    <div class="app-container">
      <slot />
    </div>
  </body>
</html>

<style>
  .app-container {
    display: flex;
    min-height: 100vh;
  }
</style>

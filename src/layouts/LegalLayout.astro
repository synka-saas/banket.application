---
// Páginas públicas de texto corrido (Termos de uso, Política de privacidade).
import '../styles/global.css';

interface Props {
  title: string;
  atualizadoEm: string;
}

const { title, atualizadoEm } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{`${title} · Banket`}</title>
  </head>
  <body class="legal-body">
    <main class="legal">
      <a href="/auth/cadastro" class="legal-logo"><img src="/logo-dark.png" alt="Banket" /></a>
      <article class="legal-card">
        <h1>{title}</h1>
        <p class="legal-data">Última atualização: {atualizadoEm}</p>
        <slot />
      </article>
      <footer class="legal-rodape">
        <a href="/termos">Termos de uso</a> · <a href="/privacidade">Política de privacidade</a> ·{' '}
        <a href="/auth/cadastro">Voltar ao cadastro</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  /* Texto corrido sobre o fundo do app, em um card branco (padrão de card do design system) */
  .legal-body {
    background: var(--bg-app);
  }

  .legal {
    max-width: 784px;
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-16);
  }

  .legal-logo {
    display: inline-flex;
    margin: 0 0 var(--space-6) var(--space-1);
    border-radius: var(--radius-xs);
  }

  .legal-logo img {
    display: block;
    height: 36px;
  }

  .legal-card {
    padding: var(--space-10) var(--space-12) var(--space-12);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    font-size: var(--fs-15);
    line-height: 1.7;
    color: var(--text-body);
  }

  .legal-card h1 {
    margin-bottom: var(--space-1);
    color: var(--text-strong);
  }

  .legal-card .legal-data {
    margin-bottom: var(--space-8);
    color: var(--text-muted);
    font-size: var(--fs-13);
  }

  .legal-card h2 {
    font-size: var(--fs-17);
    line-height: 1.35;
    margin: var(--space-7) 0 var(--space-2);
  }

  .legal-card p,
  .legal-card ul {
    margin-bottom: var(--space-3);
    font-size: inherit;
  }

  .legal-card ul {
    padding-left: 22px;
    list-style: disc;
  }

  .legal-card li + li {
    margin-top: var(--space-1);
  }

  .legal-card li::marker {
    color: var(--clay-400);
  }

  .legal-card strong {
    color: var(--text-heading);
  }

  .legal-card a,
  .legal-rodape a {
    color: var(--text-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .legal-card a:hover,
  .legal-rodape a:hover {
    color: var(--text-link-hover);
  }

  .legal-rodape {
    margin-top: var(--space-6);
    padding: 0 var(--space-1);
    font-size: var(--fs-13);
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .legal {
      padding: var(--space-6) var(--space-4) var(--space-10);
    }

    .legal-card {
      padding: var(--space-6) var(--space-5) var(--space-8);
    }
  }
</style>

---
// Casca da página pública do formulário (sem sidebar): cartão central com cabeçalho da empresa.
import '../styles/global.css';
import Toast from '../components/ui/Toast.astro';
import Mascaras from '../components/ui/Mascaras.astro';

interface Props {
  title: string;
  empresa: string;
  logo?: string | null;
  subtitulo?: string;
}

const { title, empresa, logo, subtitulo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | {empresa}</title>
  </head>
  <body class="fp-body">
    <main class="fp-app">
      <header class="fp-header">
        {logo ? <img src={logo} alt={empresa} class="fp-logo" /> : <span class="fp-empresa">{empresa}</span>}
        {subtitulo && <p class="fp-subtitulo">{subtitulo}</p>}
      </header>
      <slot />
    </main>
    <Toast flash={null} />
    <Mascaras />
  </body>
</html>

<style is:global>
  /* Página pública: cartão branco sobre o fundo quente do app, sem a casca do sistema */
  .fp-body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6) var(--space-4);
    background: var(--bg-app);
  }

  .fp-app {
    width: 100%;
    max-width: 680px;
    min-height: 620px;
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .fp-header {
    flex-shrink: 0;
    padding: var(--space-6) var(--space-8) var(--space-5);
    text-align: center;
    /* Fundo claro: o logo da empresa costuma ser pensado para fundo branco */
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .fp-logo {
    display: block;
    max-height: 48px;
    max-width: 200px;
    margin: 0 auto;
    object-fit: contain;
  }

  .fp-empresa {
    font-size: var(--fs-20);
    line-height: 1.3;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
  }

  /* Nome do formulário: eyebrow (a exceção ao sentence case) */
  .fp-subtitulo {
    margin-top: var(--space-2);
    font-size: var(--type-eyebrow-size);
    line-height: var(--type-eyebrow-lh);
    font-weight: var(--type-eyebrow-weight);
    letter-spacing: var(--type-eyebrow-ls);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .fp-body {
      padding: 0;
      align-items: stretch;
    }

    .fp-app {
      max-height: none;
      min-height: 100vh;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .fp-header {
      padding: var(--space-5) var(--space-4) var(--space-4);
    }
  }
</style>

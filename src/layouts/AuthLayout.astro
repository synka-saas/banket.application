---
import Icon from '../components/ui/Icon.astro';
import Mascaras from '../components/ui/Mascaras.astro';

interface Props {
  title: string;
  showOverlay?: boolean;
  /** Erro de um POST renderizado na própria resposta (sem redirect): mesmo visual do flash */
  erro?: string | null;
}

const { title, showOverlay = true, erro = null } = Astro.props;
// Mensagem de retorno (PRG) das telas de autenticação
const flash = Astro.locals.flash;
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} · Banket`}</title>
  </head>
  <body>
    <div class="auth-layout">
      <div class={`auth-left ${showOverlay ? 'has-overlay' : ''}`}>
        <div class="bg-image"></div>
        {showOverlay && (
          <div class="overlay-content">
            <div class="brand">
              <img src="/logo-light.png" alt="Banket" class="logo" />
            </div>
            
            <h2 class="hero-text">
              Assuma o controle da sua operação: qualifique leads na entrada, acompanhe cada etapa e converta mais eventos.
            </h2>
            
            <div class="info-card">
              <div class="card-header">
                <Icon name="chart-bar" size={24} />
                <h3>Gestão comercial para buffets</h3>
              </div>
              <p>
                Automatize a qualificação de contatos e gerencie com eficiência desde os longos ciclos corporativos até as
                vendas ágeis do setor social. Com uma gestão visual inteligente, o Banket otimiza o seu fluxo comercial para
                garantir a saúde financeira e a previsibilidade do seu negócio.
              </p>
            </div>
          </div>
        )}
      </div>
      <div class="auth-right">
        <div class="form-container">
          {erro && <div class="auth-alert auth-alert-error" role="alert">{erro}</div>}
          {flash && !erro && <div class:list={['auth-alert', `auth-alert-${flash.type}`]} role={flash.type === 'error' ? 'alert' : 'status'}>{flash.message}</div>}
          <slot />
        </div>
      </div>
    </div>
    <Mascaras />
  </body>
</html>

<style>
  /* Telas de autenticação: painel de marca (imagem + véu terracota) à esquerda e formulário em superfície branca */
  .auth-layout {
    display: flex;
    min-height: 100vh;
    background: var(--bg-surface);
  }

  .auth-left {
    flex: 1;
    position: relative;
    display: none;
    overflow: hidden;
    background: var(--terracotta-800);
  }

  .bg-image {
    position: absolute;
    inset: 0;
    background-image: url('/bg-login.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Véu terracota sobre a foto: único gradiente do sistema, por ser a arte de marca do login */
  .has-overlay .bg-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--terracotta-600) 86%, transparent) 0%,
      color-mix(in srgb, var(--terracotta-800) 95%, transparent) 100%
    );
  }

  .overlay-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-10);
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-12);
    color: var(--text-on-accent);
  }

  .logo {
    display: block;
    height: 40px;
  }

  .hero-text {
    font-size: var(--fs-28);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    letter-spacing: var(--ls-tight);
    color: var(--text-on-accent);
    text-wrap: balance;
  }

  /* Cartão translúcido sobre o véu (branco em baixa opacidade) */
  .info-card {
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--clay-0) 32%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--clay-0) 10%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-header h3 {
    margin: 0;
    font-size: var(--type-h3-size);
    line-height: var(--type-h3-lh);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-snug);
    color: var(--text-on-accent);
  }

  .info-card p {
    margin: 0;
    font-size: var(--fs-14);
    line-height: 1.6;
    color: color-mix(in srgb, var(--clay-0) 90%, transparent);
  }

  .auth-right {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-10);
    background: var(--bg-surface);
  }

  .form-container {
    width: 100%;
    max-width: 440px;
  }

  @media (min-width: 900px) {
    .auth-left {
      display: flex;
      flex-direction: column;
    }
  }

  @media (max-width: 768px) {
    .auth-right {
      align-items: flex-start;
      padding: var(--space-8) var(--space-4);
    }
  }

  /* ---------- Classes compartilhadas pelas páginas de autenticação ---------- */
  :global(.auth-alert) {
    margin-bottom: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    color: var(--text-body);
    font-size: var(--fs-14);
    line-height: 1.5;
    text-align: left;
  }

  /* Erro em vinho, sucesso em sálvia, aviso em ocre */
  :global(.auth-alert-error) {
    background: var(--danger-bg);
    border-color: var(--danger-border);
    color: var(--wine-700);
  }

  :global(.auth-alert-success) {
    background: var(--success-bg);
    border-color: var(--success-border);
    color: var(--sage-700);
  }

  :global(.auth-alert-info),
  :global(.auth-alert-warning) {
    background: var(--warning-bg);
    border-color: var(--warning-border);
    color: var(--ochre-700);
  }

  :global(.auth-logo-center) {
    display: block;
    height: 40px;
    margin: 0 auto var(--space-8);
  }

  :global(.auth-title) {
    margin-bottom: var(--space-8);
    font-size: var(--type-h1-size);
    line-height: var(--type-h1-lh);
    font-weight: var(--type-h1-weight);
    letter-spacing: var(--type-h1-ls);
    color: var(--text-strong);
    text-align: center;
  }

  /* Vem logo abaixo do título: sobe para ficar a 8px dele */
  :global(.auth-subtitle) {
    margin: calc(var(--space-6) * -1) 0 var(--space-8);
    font-size: var(--fs-14);
    line-height: 1.55;
    color: var(--text-secondary);
    text-align: center;
  }

  :global(.auth-subtitle strong) {
    color: var(--text-heading);
  }

  /* Os campos (Input) já trazem 16px de margem inferior */
  :global(.auth-form) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :global(.auth-form > .btn),
  :global(.auth-form > form > .btn) {
    margin-top: var(--space-2);
  }

  :global(.auth-hint) {
    margin: calc(var(--space-3) * -1) 0 var(--space-3);
    font-size: var(--fs-12);
    line-height: 1.4;
    color: var(--text-muted);
  }

  :global(.auth-links) {
    margin-top: var(--space-6);
    font-size: var(--fs-14);
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: center;
  }

  :global(.auth-links a) {
    color: var(--text-link);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  :global(.auth-links a:hover) {
    color: var(--text-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* Legenda "*Dados obrigatórios" */
  :global(.auth-nota) {
    font-size: var(--fs-12);
    color: var(--text-muted);
  }
</style>

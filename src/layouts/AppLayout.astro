---
// Casca das telas autenticadas: sidebar, topbar, submenu opcional, toast, modal de confirmação e área de conteúdo.
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import Submenu from '../components/Submenu.astro';
import Toast from '../components/ui/Toast.astro';
import Confirmar from '../components/ui/Confirmar.astro';
import Mascaras from '../components/ui/Mascaras.astro';

interface SubmenuItem {
  id: string;
  label: string;
  href: string;
}

interface Props {
  /** Título da aba do navegador */
  title: string;
  /** Texto do topo (ex.: "Cardápios / Itens do cardápio"); padrão = title */
  heading?: string;
  submenu?: SubmenuItem[];
  submenuActive?: string;
  /** Link de volta mostrado antes do título no topo */
  voltar?: { href: string; label: string };
}

const { title, heading = title, submenu, submenuActive, voltar } = Astro.props;
---

<Layout title={title}>
  <Sidebar />
  <main class="main-content">
    <Topbar title={heading} voltar={voltar} />
    {submenu && (
      <Submenu items={submenu} activeId={submenuActive}>
        <slot name="submenu-actions" />
      </Submenu>
    )}
    <div class="page-content">
      <slot />
    </div>
  </main>
  <slot name="overlays" />
  <Toast flash={Astro.locals.flash} />
  <Confirmar />
  <Mascaras />
</Layout>

<script>
  import { confirmar, emCarregamento } from '../lib/ui';

  // Botão de envio com data-carregando="Enviando…": fica desabilitado, com spinner, até a página trocar.
  // Roda depois dos outros handlers (setTimeout) para respeitar quem cancelou o envio.
  const restaurar: (() => void)[] = [];
  document.addEventListener('submit', (e) => {
    const botao = (e as SubmitEvent).submitter;
    if (!(botao instanceof HTMLButtonElement) || botao.dataset.carregando === undefined) return;
    setTimeout(() => {
      if (!e.defaultPrevented) restaurar.push(emCarregamento(botao, botao.dataset.carregando || undefined));
    });
  });
  // Voltar pelo histórico (bfcache) não pode deixar botões presos em carregamento
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) restaurar.splice(0).forEach((fn) => fn());
  });

  // Formulários com data-form-sujo: sair da página com alterações não salvas pede confirmação
  const formsSujos = [...document.querySelectorAll<HTMLFormElement>('form[data-form-sujo]')];
  const serializar = (f: HTMLFormElement) =>
    JSON.stringify([...new FormData(f)].map(([k, v]) => [k, typeof v === 'string' ? v : `${v.name}:${v.size}`]));
  const iniciais = new Map(formsSujos.map((f) => [f, serializar(f)]));
  let enviando = false;
  const haAlteracoes = () => !enviando && formsSujos.some((f) => iniciais.get(f) !== serializar(f));
  // Máscaras e ajustes feitos por script ao carregar não contam como alteração
  window.addEventListener('load', () => formsSujos.forEach((f) => iniciais.set(f, serializar(f))));
  formsSujos.forEach((f) => f.addEventListener('submit', () => (enviando = true)));
  window.addEventListener('beforeunload', (e) => {
    if (haAlteracoes()) e.preventDefault();
  });
  document.addEventListener('click', async (e) => {
    if (!formsSujos.length || e.defaultPrevented) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.target === '_blank' || link.hasAttribute('download') || e.ctrlKey || e.metaKey) return;
    if (!haAlteracoes()) return;
    e.preventDefault();
    const sair = await confirmar({
      titulo: 'Sair sem salvar?',
      texto: 'As alterações feitas nesta página ainda não foram salvas.',
      confirmar: 'Sair sem salvar',
      cancelar: 'Continuar editando',
      perigo: true,
    });
    if (sair) {
      enviando = true;
      window.location.assign(link.href);
    }
  });

  // Selects editáveis dentro de tabelas (papel, categoria, especialidade) enviam o formulário ao mudar.
  document.addEventListener('change', (e) => {
    const el = e.target as HTMLElement;
    if (el.matches('[data-autosubmit-row]')) (el as HTMLSelectElement).form?.requestSubmit();
  });
</script>

<style>
  .main-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background-color: var(--color-bg-body);
  }

  .page-content {
    flex: 1;
    overflow-y: auto;
    padding: 32px 45px 48px;
  }
</style>

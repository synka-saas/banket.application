---
import AppLayout from '../../../layouts/AppLayout.astro';
import ModeloForm from '../../../components/documentos/ModeloForm.astro';
import { withTenant } from '../../../lib/db';
import { isAdmin } from '../../../lib/auth';
import { handleFormPost } from '../../../lib/actions';
import { setFlash } from '../../../lib/flash';
import { removeFile, saveUpload } from '../../../lib/storage';
import { carregarModelo, duplicarModelo, excluirModelo, salvarModeloDoFormulario } from '../../../server/documentos';

const user = Astro.locals.user;
const id = Astro.params.id!;
if (!isAdmin(user)) {
  setFlash(Astro.cookies, 'error', 'Só proprietários e administradores editam modelos de documento.');
  return Astro.redirect('/documentos');
}

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data, raw) =>
    withTenant(user.tenantId, async (db) => {
      if (data._action === 'duplicar') {
        const novo = await duplicarModelo(db, user.tenantId, id);
        return { message: 'Modelo duplicado (inativo até você revisar).', redirect: `/documentos/${novo}` };
      }
      if (data._action === 'excluir') {
        const logoOrfao = await excluirModelo(db, id);
        if (logoOrfao) await removeFile(user.tenantId, logoOrfao);
        return { message: 'Modelo excluído.', redirect: '/documentos' };
      }
      await salvarModeloDoFormulario(db, user.tenantId, id, data, raw, { saveUpload, removeFile });
      return 'Modelo salvo.';
    })
  );
}

const modelo = await withTenant(user.tenantId, async (db) => {
  try {
    return await carregarModelo(db, id);
  } catch {
    return null;
  }
});
if (!modelo) return new Response(null, { status: 404 });
---

<AppLayout title={modelo.nome} heading={`Documentos / ${modelo.nome}`} voltar={{ href: '/documentos', label: 'Documentos' }}>
  <ModeloForm modelo={modelo} tenantId={user.tenantId} />
</AppLayout>

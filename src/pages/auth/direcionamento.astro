---
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="Direcionando... - Banket CRM" showOverlay={true}>
  <div class="processing-container">
    <h2 class="auth-title" style="font-size: 20px; margin-bottom: 12px;">Obrigado por completar o cadastro.</h2>
    <h3 class="auth-title" style="font-size: 20px; margin-bottom: 24px;">Preparando ambiente</h3>
    
    <div class="progress-bar">
      <div class="progress-fill"></div>
    </div>
  </div>
</AuthLayout>

<script>
  setTimeout(() => {
    window.location.href = '/dashboard';
  }, 3000);
</script>

<style>
  .processing-container {
    text-align: center;
    padding: 40px 0;
  }
  
  .progress-bar {
    width: 100%;
    height: 8px;
    background-color: #fce8e6;
    border-radius: 4px;
    overflow: hidden;
    max-width: 300px;
    margin: 0 auto;
  }
  
  .progress-fill {
    width: 0%;
    height: 100%;
    background-color: var(--color-primary);
    animation: load 3s ease forwards;
  }
  
  @keyframes load {
    0% { width: 0%; }
    50% { width: 70%; }
    100% { width: 100%; }
  }
</style>

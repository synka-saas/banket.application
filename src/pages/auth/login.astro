---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Checkbox from '../../components/ui/Checkbox.astro';
import { setOnboardingCookie, setSessionCookie, signOnboarding, signSession } from '../../lib/auth';
import { setFlash } from '../../lib/flash';
import { excedeu, ipDaRequisicao, permitir, zerar } from '../../lib/rateLimit';
import { autenticar } from '../../server/autoatendimento';

// Só aceita redirecionamentos internos (evita open redirect)
const nextParam = Astro.url.searchParams.get('next') ?? '';
const destino = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/dashboard';
let email = Astro.url.searchParams.get('email') ?? '';
// Em erro, a página é renderizada de novo com o e-mail preenchido (nada de dados pessoais na URL)
let erro: string | null = null;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  email = data.get('email')?.toString().trim().toLowerCase() ?? '';
  const senha = data.get('senha')?.toString() ?? '';
  const manter = data.get('manter') !== null;
  const falhar = (mensagem: string) => {
    erro = mensagem;
    Astro.response.status = 400;
    return null;
  };

  if (!email || !senha) {
    falhar('Por favor, preencha todos os campos.');
  } else {
  // Força bruta: bloqueia após 10 senhas erradas em 15 minutos (por IP + e-mail); logins certos não contam
  // e 30 senhas erradas por IP em qualquer e-mail (tentativa em massa)
  const ip = ipDaRequisicao(Astro.request, Astro.clientAddress);
  const chave = `login:${ip}:${email}`;
  const chaveIp = `login-ip:${ip}`;
  const JANELA = 15 * 60_000;
  if (excedeu(chave, 10, JANELA) || excedeu(chaveIp, 30, JANELA)) {
    falhar('Muitas tentativas de login. Aguarde alguns minutos ou redefina sua senha.');
  } else {
    try {
      const r = await autenticar(email, senha);
      switch (r.tipo) {
        case 'sessao':
          zerar(chave);
          setSessionCookie(Astro.cookies, await signSession(r.usuario), manter);
          return Astro.redirect(destino);
        case 'onboarding':
          setOnboardingCookie(Astro.cookies, await signOnboarding(r.usuario));
          return Astro.redirect('/auth/cadastro-complemento');
        case 'nao_verificado':
          setFlash(Astro.cookies, 'error', 'Confirme seu e-mail para entrar. Use o botão abaixo para receber um novo link.');
          return Astro.redirect(`/auth/validacao?email=${encodeURIComponent(r.email)}`);
        default:
          permitir(chave, 10, JANELA);
          permitir(chaveIp, 30, JANELA);
          falhar('E-mail ou senha incorretos.');
      }
    } catch (err) {
      console.error('Erro no login:', err);
      falhar('Ocorreu um erro ao processar o login.');
    }
  }
  }
}
---

<AuthLayout title="Login" showOverlay={false} erro={erro}>
  <img src="/logo-dark.png" alt="Banket" class="auth-logo-center" />
  <h1 class="auth-title">Faça login para continuar</h1>

  <form class="auth-form" method="post">
    <Input id="email" name="email" type="email" label="E-mail" placeholder="seu@email.com.br" value={email} autocomplete="email" required />

    <div class="campo-senha">
      <Input id="senha" name="senha" type="password" label="Senha" autocomplete="current-password" required />
      <a href="/auth/recuperacao" class="forgot-password">Esqueceu a senha?</a>
    </div>

    <div class="manter">
      <Checkbox id="manter" name="manter" checked label="Manter conectado neste dispositivo" />
    </div>

    <Button variant="primary" size="large" type="submit">Entrar</Button>
    <Button variant="secondary" size="large" href={`/auth/link-acesso${email ? `?email=${encodeURIComponent(email)}` : ''}`} class="link-acesso">
      Entrar com link de acesso por e-mail
    </Button>
  </form>

  <div class="auth-links">
    Ainda não tem conta? <a href="/auth/cadastro">Crie sua conta</a>
  </div>
</AuthLayout>

<style>
  .campo-senha {
    position: relative;
    margin-bottom: var(--space-3);
  }

  .campo-senha :global(.input-group) {
    margin-bottom: 0;
  }

  /* Abaixo do campo, sem sobrepor o rótulo (UX-046) */
  .forgot-password {
    display: block;
    width: fit-content;
    margin: var(--space-1-5) 0 0 auto;
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-link);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .forgot-password:hover {
    color: var(--text-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
</style>

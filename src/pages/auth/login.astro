---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import { setOnboardingCookie, setSessionCookie, signOnboarding, signSession } from '../../lib/auth';
import { setFlash } from '../../lib/flash';
import { excedeu, ipDaRequisicao, permitir, zerar } from '../../lib/rateLimit';
import { autenticar } from '../../server/autoatendimento';

// Só aceita redirecionamentos internos (evita open redirect)
const nextParam = Astro.url.searchParams.get('next') ?? '';
const destino = nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/dashboard';
let email = Astro.url.searchParams.get('email') ?? '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  email = data.get('email')?.toString().trim().toLowerCase() ?? '';
  const senha = data.get('senha')?.toString() ?? '';
  const voltar = () => Astro.redirect(`/auth/login?email=${encodeURIComponent(email)}${nextParam ? `&next=${encodeURIComponent(nextParam)}` : ''}`);

  if (!email || !senha) {
    setFlash(Astro.cookies, 'error', 'Por favor, preencha todos os campos.');
    return voltar();
  }
  // Força bruta: bloqueia após 10 senhas erradas em 15 minutos (por IP + e-mail); logins certos não contam
  const chave = `login:${ipDaRequisicao(Astro.request, Astro.clientAddress)}:${email}`;
  const JANELA = 15 * 60_000;
  if (excedeu(chave, 10, JANELA)) {
    setFlash(Astro.cookies, 'error', 'Muitas tentativas de login. Aguarde alguns minutos ou redefina sua senha.');
    return voltar();
  }

  try {
    const r = await autenticar(email, senha);
    switch (r.tipo) {
      case 'sessao':
        zerar(chave);
        setSessionCookie(Astro.cookies, await signSession(r.usuario));
        return Astro.redirect(destino);
      case 'onboarding':
        setOnboardingCookie(Astro.cookies, await signOnboarding(r.usuario));
        return Astro.redirect('/auth/cadastro-complemento');
      case 'nao_verificado':
        setFlash(Astro.cookies, 'error', 'Confirme seu e-mail para entrar. Use o botão abaixo para receber um novo link.');
        return Astro.redirect(`/auth/validacao?email=${encodeURIComponent(r.email)}`);
      default:
        permitir(chave, 10, JANELA);
        setFlash(Astro.cookies, 'error', 'E-mail ou senha incorretos.');
        return voltar();
    }
  } catch (err) {
    console.error('Erro no login:', err);
    setFlash(Astro.cookies, 'error', 'Ocorreu um erro ao processar o login.');
    return voltar();
  }
}
---

<AuthLayout title="Login - Banket" showOverlay={false}>
  <img src="/logo-dark.png" alt="Banket" class="auth-logo-center" />
  <h1 class="auth-title">Faça login para continuar</h1>

  <form class="auth-form" method="post">
    <Input id="email" name="email" type="email" label="E-MAIL" placeholder="xxxx@xxxx.com.br" value={email} autocomplete="email" required />

    <div class="campo-senha">
      <Input id="senha" name="senha" type="password" label="SENHA" placeholder="XXXXXXXX" autocomplete="current-password" required />
      <a href="/auth/recuperacao" class="forgot-password">Esqueceu a senha?</a>
    </div>

    <Button variant="primary" size="large" type="submit">ENTRAR</Button>
    <Button variant="secondary" size="large" href={`/auth/link-acesso${email ? `?email=${encodeURIComponent(email)}` : ''}`} class="link-acesso">
      ENTRAR COM LINK DE ACESSO POR E-MAIL
    </Button>
  </form>

  <div class="auth-links">
    Ainda não tem conta? <a href="/auth/cadastro">Teste grátis por 30 dias</a>
  </div>
</AuthLayout>

<style>
  .campo-senha {
    position: relative;
  }

  .forgot-password {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 12px;
    color: #666;
    text-decoration: underline;
  }

  .auth-form :global(.link-acesso) {
    background-color: #fce8e6;
    color: #333;
    border: none;
  }
</style>

---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Button from '../../components/ui/Button.astro';
import { setFlash } from '../../lib/flash';
import { ipDaRequisicao, permitir } from '../../lib/rateLimit';
import { reenviarVerificacao } from '../../server/autoatendimento';

// Aviso "enviamos o link de confirmação" + reenvio (resposta genérica: não revela se o e-mail existe).
const email = (Astro.url.searchParams.get('email') ?? '').trim().slice(0, 255);

if (Astro.request.method === 'POST' && email) {
  const ip = ipDaRequisicao(Astro.request, Astro.clientAddress);
  if (permitir(`reenvio:${ip}:${email.toLowerCase()}`, 3, 15 * 60_000)) {
    await reenviarVerificacao(email).catch((err) => console.error('Falha ao reenviar verificação:', err));
    setFlash(Astro.cookies, 'success', 'Se houver um cadastro pendente para este e-mail, enviamos um novo link de confirmação.');
  } else {
    setFlash(Astro.cookies, 'error', 'Muitos reenvios em pouco tempo. Aguarde alguns minutos.');
  }
  return Astro.redirect(Astro.url.pathname + Astro.url.search);
}

const modoLog = !process.env.RESEND_API_KEY;
const ehGmail = /@(gmail|googlemail)\.com$/i.test(email);
---

<AuthLayout title="Confirme seu e-mail - Banket" showOverlay={true}>
  <h1 class="auth-title">Acabamos de enviar um link de<br />confirmação para o seu e-mail.</h1>
  <p class="auth-subtitle">
    {email ? <>Acesse a caixa de entrada de <strong>{email}</strong> e clique no link</> : 'Acesse a sua caixa de entrada e clique no link'}
    {' '}para validar e ativar a sua conta. O link vale por 24 horas.
  </p>

  {modoLog && (
    <div class="auth-alert auth-alert-info">Ambiente sem envio de e-mail configurado: o link de confirmação foi registrado no log do servidor.</div>
  )}

  <div class="auth-form">
    {ehGmail && (
      <a class="btn btn-secondary btn-large google-btn" href="https://mail.google.com/mail/u/0/#search/from%3Abanket" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
        </svg>
        ABRIR O GMAIL
      </a>
    )}

    {email && (
      <form method="post">
        <Button variant="outline" size="large" type="submit" block>REENVIAR E-MAIL DE CONFIRMAÇÃO</Button>
      </form>
    )}
  </div>

  <div class="auth-links">
    E-mail errado? <a href="/auth/cadastro">Refazer o cadastro</a><br />
    Já confirmou? <a href="/auth/login">Entrar</a>
  </div>
</AuthLayout>

<style>
  .google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: white;
    border: 1px solid #ccc;
    color: #333;
  }
</style>

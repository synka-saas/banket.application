---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { ONBOARDING_COOKIE, clearOnboardingCookie, setSessionCookie, signSession, verifyOnboarding } from '../../lib/auth';
import { setFlash } from '../../lib/flash';
import { formToObject, userMessage } from '../../lib/forms';
import { criarEmpresa, empresaNovaSchema } from '../../server/autoatendimento';

// Cadastro complementar (frame "Login - Cadastro Complemento"): dados da empresa → cria o tenant com os padrões.
const usuario = await verifyOnboarding(Astro.cookies.get(ONBOARDING_COOKIE)?.value);
if (!usuario) {
  setFlash(Astro.cookies, 'info', 'Entre com seu e-mail e senha para concluir o cadastro da sua empresa.');
  return Astro.redirect('/auth/login');
}

const RASCUNHO = 'banket_onboarding_rascunho';

if (Astro.request.method === 'POST') {
  const data = formToObject(await Astro.request.formData());
  try {
    const sessao = await criarEmpresa(usuario, empresaNovaSchema.parse(data));
    clearOnboardingCookie(Astro.cookies);
    Astro.cookies.delete(RASCUNHO, { path: '/auth' });
    setSessionCookie(Astro.cookies, await signSession(sessao));
    return Astro.redirect('/auth/direcionamento');
  } catch (err) {
    setFlash(Astro.cookies, 'error', userMessage(err, 'Não foi possível cadastrar a empresa. Tente novamente.'));
    // Guarda o que foi digitado (sem dados sensíveis além dos da própria empresa) por alguns minutos
    const { tipo_pessoa, celular, cpf, cnpj, razao_social, nome_empresa, endereco } = data;
    Astro.cookies.set(RASCUNHO, JSON.stringify({ tipo_pessoa, celular, cpf, cnpj, razao_social, nome_empresa, endereco }), {
      path: '/auth',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 600,
    });
    return Astro.redirect('/auth/cadastro-complemento');
  }
}

let rascunho: Record<string, string> = {};
try {
  rascunho = JSON.parse(Astro.cookies.get(RASCUNHO)?.value ?? '{}');
} catch {
  rascunho = {};
}
const v = (campo: string) => (typeof rascunho[campo] === 'string' ? rascunho[campo] : '');
const tipo = v('tipo_pessoa') === 'PF' ? 'PF' : 'PJ';
const validado = Astro.url.searchParams.has('validado');
---

<AuthLayout title="Cadastro da empresa - Banket" showOverlay={true}>
  <div class="cabecalho">
    {validado && <Icon name="check_circle" size={32} class="icone-ok" />}
    <h1 class="auth-title">{validado ? 'E-mail Validado' : 'Complete seu cadastro'}</h1>
  </div>
  <p class="auth-subtitle">
    Para finalizar, selecione o seu tipo de conta (PF ou PJ) e preencha as informações abaixo para começarmos a preparar o
    seu ambiente de gestão.
  </p>

  <form class:list={['auth-form', { 'is-pj': tipo === 'PJ' }]} method="post" data-complemento>
    <fieldset class="tipo-conta">
      <legend class="sr-only">Tipo de conta</legend>
      <label class="tipo-btn">
        <input type="radio" name="tipo_pessoa" value="PF" checked={tipo === 'PF'} />
        <Icon name="account_circle" size={20} /> PESSOA FÍSICA
      </label>
      <label class="tipo-btn">
        <input type="radio" name="tipo_pessoa" value="PJ" checked={tipo === 'PJ'} />
        <Icon name="apartment" size={20} /> PESSOA JURÍDICA
      </label>
    </fieldset>

    <div class="campos">
      <Input id="nome" name="nome_usuario" label="NOME E SOBRENOME" value={usuario.nome} readonly />
      <Input id="email" name="email_usuario" type="email" label="E-MAIL" value={usuario.email} readonly />
      <Input id="celular" name="celular" label="CELULAR" placeholder="DDD + 00000 0000" value={v('celular')} inputmode="tel" autocomplete="tel" data-mascara="celular" required />

      <div class="so-pf">
        <Input id="cpf" name="cpf" label="CPF" placeholder="000.000.000-00" value={v('cpf')} inputmode="numeric" data-mascara="cpf" />
      </div>
      <div class="so-pj">
        <Input id="razao_social" name="razao_social" label="RAZÃO SOCIAL" placeholder="Nome da empresa" value={v('razao_social')} maxlength="255" />
        <Input id="cnpj" name="cnpj" label="CNPJ" placeholder="00.000.000/0000-00" value={v('cnpj')} inputmode="numeric" data-mascara="cnpj" />
      </div>

      <Input id="nome_empresa" name="nome_empresa" label="NOME DO BUFFET (OPCIONAL)" placeholder="Como aparece nas suas propostas" value={v('nome_empresa')} maxlength="255" />
      <Input id="endereco" name="endereco" label="ENDEREÇO COMERCIAL" placeholder="Endereço" value={v('endereco')} maxlength="500" autocomplete="street-address" required />
    </div>

    <Button variant="primary" size="large" type="submit">FINALIZAR E ACESSAR A PLATAFORMA</Button>
  </form>

  <div class="auth-links">
    <span style="font-size: 12px; color: #888;">*Dados obrigatórios</span><br />
    <a href="/auth/logout">Sair</a>
  </div>
</AuthLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-complemento]');

  // Alterna PF/PJ: campos obrigatórios de cada tipo
  function atualizarTipo() {
    if (!form) return;
    const pj = form.querySelector<HTMLInputElement>('input[name=tipo_pessoa]:checked')?.value !== 'PF';
    form.classList.toggle('is-pj', pj);
    for (const id of ['razao_social', 'cnpj']) (document.getElementById(id) as HTMLInputElement).required = pj;
    (document.getElementById('cpf') as HTMLInputElement).required = !pj;
  }
  form?.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'tipo_pessoa') atualizarTipo();
  });
  atualizarTipo();

  // Máscaras simples (o servidor aceita com ou sem pontuação)
  const mascaras: Record<string, (d: string) => string> = {
    cpf: (d) => d.slice(0, 11).replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2'),
    cnpj: (d) =>
      d
        .slice(0, 14)
        .replace(/^(\d{2})(\d)/, '$1.$2')
        .replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3')
        .replace(/\.(\d{3})(\d)/, '.$1/$2')
        .replace(/(\d{4})(\d)/, '$1-$2'),
    celular: (d) =>
      d
        .slice(0, 11)
        .replace(/^(\d{2})(\d)/, '($1) $2')
        .replace(/(\d)(\d{4})$/, '$1-$2'),
  };
  document.querySelectorAll<HTMLInputElement>('[data-mascara]').forEach((campo) => {
    const aplicar = mascaras[campo.dataset.mascara!];
    const formatar = () => (campo.value = aplicar(campo.value.replace(/\D/g, '')));
    campo.addEventListener('input', formatar);
    if (campo.value) formatar();
  });
</script>

<style>
  .cabecalho {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .cabecalho :global(.icone-ok) {
    color: var(--color-primary);
    margin-bottom: 40px;
  }

  .tipo-conta {
    display: flex;
    gap: 16px;
    border: none;
    padding: 0;
    margin: 0 0 8px;
  }

  .tipo-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 12px;
    background: #efefef;
    border-radius: 4px;
    font-weight: 600;
    font-size: 14px;
    color: #444;
    cursor: pointer;
  }

  .tipo-btn input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tipo-btn:has(input:checked) {
    background: var(--color-primary);
    color: #fff;
  }

  .tipo-btn:has(input:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .campos,
  .so-pf,
  .so-pj {
    display: flex;
    flex-direction: column;
  }

  .is-pj .so-pf,
  .auth-form:not(.is-pj) .so-pj {
    display: none;
  }

  .campos :global(input[readonly]) {
    background: #efefef;
    color: #666;
  }
</style>

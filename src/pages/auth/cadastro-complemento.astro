---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { ONBOARDING_COOKIE, clearOnboardingCookie, setSessionCookie, signSession, verifyOnboarding } from '../../lib/auth';
import { setFlash } from '../../lib/flash';
import { formToObject, userMessage } from '../../lib/forms';
import { criarEmpresa, empresaNovaSchema } from '../../server/autoatendimento';

// Cadastro complementar (frame "Login - Cadastro Complemento"): dados da empresa → cria o tenant com os padrões.
const usuario = await verifyOnboarding(Astro.cookies.get(ONBOARDING_COOKIE)?.value);
if (!usuario) {
  setFlash(Astro.cookies, 'info', 'Entre com seu e-mail e senha para concluir o cadastro da sua empresa.');
  return Astro.redirect('/auth/login');
}

const RASCUNHO = 'banket_onboarding_rascunho';

if (Astro.request.method === 'POST') {
  const data = formToObject(await Astro.request.formData());
  try {
    const sessao = await criarEmpresa(usuario, empresaNovaSchema.parse(data));
    clearOnboardingCookie(Astro.cookies);
    Astro.cookies.delete(RASCUNHO, { path: '/auth' });
    setSessionCookie(Astro.cookies, await signSession(sessao));
    return Astro.redirect('/dashboard');
  } catch (err) {
    setFlash(Astro.cookies, 'error', userMessage(err, 'Não foi possível cadastrar a empresa. Tente novamente.'));
    // Guarda o que foi digitado (sem dados sensíveis além dos da própria empresa) por alguns minutos
    const { tipo_pessoa, celular, cpf, cnpj, razao_social, nome_empresa, cep, endereco } = data;
    Astro.cookies.set(RASCUNHO, JSON.stringify({ tipo_pessoa, celular, cpf, cnpj, razao_social, nome_empresa, cep, endereco }), {
      path: '/auth',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 600,
    });
    return Astro.redirect('/auth/cadastro-complemento');
  }
}

let rascunho: Record<string, string> = {};
try {
  rascunho = JSON.parse(Astro.cookies.get(RASCUNHO)?.value ?? '{}');
} catch {
  rascunho = {};
}
const v = (campo: string) => (typeof rascunho[campo] === 'string' ? rascunho[campo] : '');
// Nenhum tipo vem pré-selecionado: a escolha é do usuário (UX-042)
const tipo = v('tipo_pessoa') === 'PF' ? 'PF' : v('tipo_pessoa') === 'PJ' ? 'PJ' : '';
const validado = Astro.url.searchParams.has('validado');
---

<AuthLayout title="Cadastro da empresa" showOverlay={true}>
  <div class="cabecalho">
    {validado && <Icon name="circle-check" size={32} class="icone-ok" />}
    <h1 class="auth-title">{validado ? 'E-mail validado' : 'Complete seu cadastro'}</h1>
  </div>
  <p class="auth-subtitle">
    Para finalizar, selecione o seu tipo de conta (PF ou PJ) e preencha as informações abaixo para começarmos a preparar o
    seu ambiente de gestão.
  </p>

  <form class:list={['auth-form', { 'is-pj': tipo === 'PJ', 'sem-tipo': tipo === '' }]} method="post" data-complemento>
    <fieldset class="tipo-conta">
      <legend class="sr-only">Tipo de conta</legend>
      <label class="tipo-btn">
        <input type="radio" name="tipo_pessoa" value="PF" checked={tipo === 'PF'} required />
        <Icon name="user-square" size={20} /> <span>Pessoa física</span>
      </label>
      <label class="tipo-btn">
        <input type="radio" name="tipo_pessoa" value="PJ" checked={tipo === 'PJ'} required />
        <Icon name="building" size={20} /> <span>Pessoa jurídica</span>
      </label>
    </fieldset>

    <div class="campos">
      <Input id="nome" name="nome_usuario" label="Nome e sobrenome" value={usuario.nome} readonly />
      <Input id="email" name="email_usuario" type="email" label="E-mail" value={usuario.email} readonly />
      <Input id="celular" name="celular" label="Celular" placeholder="DDD + 00000 0000" value={v('celular')} inputmode="tel" autocomplete="tel" data-mascara="telefone" required />

      <div class="so-pf">
        <Input id="cpf" name="cpf" label="CPF" placeholder="000.000.000-00" value={v('cpf')} inputmode="numeric" data-mascara="cpf" />
      </div>
      <div class="so-pj">
        <Input id="razao_social" name="razao_social" label="Razão social" placeholder="Nome da empresa" value={v('razao_social')} maxlength="255" />
        <Input id="cnpj" name="cnpj" label="CNPJ" placeholder="00.000.000/0000-00" value={v('cnpj')} inputmode="numeric" data-mascara="cnpj" />
      </div>

      <Input id="nome_empresa" name="nome_empresa" label="Nome do buffet" placeholder="Como aparece nas suas propostas" value={v('nome_empresa')} maxlength="255" required />
      <Input id="cep" name="cep" label="CEP" placeholder="00000-000" value={v('cep')} inputmode="numeric" data-mascara="cep" autocomplete="postal-code" />
      <Input id="endereco" name="endereco" label="Endereço comercial" placeholder="Rua, número, bairro, cidade - UF" value={v('endereco')} maxlength="500" autocomplete="street-address" required />
    </div>

    <Button variant="primary" size="large" type="submit">Finalizar e acessar a plataforma</Button>
  </form>

  <div class="auth-links">
    <span class="auth-nota">*Dados obrigatórios</span><br />
    <a href="/auth/logout">Sair</a>
  </div>
</AuthLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-complemento]');

  // Alterna PF/PJ: campos obrigatórios de cada tipo
  function atualizarTipo() {
    if (!form) return;
    const escolhido = form.querySelector<HTMLInputElement>('input[name=tipo_pessoa]:checked')?.value;
    form.classList.toggle('sem-tipo', !escolhido);
    if (!escolhido) return;
    const pj = escolhido !== 'PF';
    form.classList.toggle('is-pj', pj);
    for (const id of ['razao_social', 'cnpj']) (document.getElementById(id) as HTMLInputElement).required = pj;
    (document.getElementById('cpf') as HTMLInputElement).required = !pj;
  }
  form?.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).name === 'tipo_pessoa') atualizarTipo();
  });
  atualizarTipo();

  // CEP → endereço pela ViaCEP; só preenche se o usuário ainda não escreveu o próprio texto
  const cep = document.getElementById('cep') as HTMLInputElement | null;
  const endereco = document.getElementById('endereco') as HTMLInputElement | null;
  let preenchidoPeloCep = '';
  cep?.addEventListener('change', async () => {
    const digitos = cep.value.replace(/\D/g, '');
    if (digitos.length !== 8 || !endereco) return;
    try {
      const r = await fetch(`https://viacep.com.br/ws/${digitos}/json/`);
      const d = (await r.json()) as { erro?: boolean; logradouro?: string; bairro?: string; localidade?: string; uf?: string };
      if (d.erro) return;
      const texto = [d.logradouro, d.bairro, d.localidade && `${d.localidade} - ${d.uf}`].filter(Boolean).join(', ');
      if (texto && (!endereco.value.trim() || endereco.value === preenchidoPeloCep)) {
        endereco.value = `${texto}`;
        preenchidoPeloCep = endereco.value;
        endereco.focus();
      }
    } catch {
      // sem rede/CEP não encontrado: o campo segue manual
    }
  });
</script>

<style>
  .cabecalho {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  /* Confirmação do e-mail: ícone em sálvia (sucesso), alinhado ao título */
  .cabecalho :global(.icone-ok) {
    flex: none;
    margin-bottom: var(--space-8);
    color: var(--success);
  }

  /* PF ou PJ: dois cartões selecionáveis (rádios por baixo) */
  .tipo-conta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    border: none;
    padding: 0;
    margin: 0 0 var(--space-5);
  }

  .tipo-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-h-lg);
    padding: var(--space-2) var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
    cursor: pointer;
    user-select: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }

  .tipo-btn :global(.icon) {
    color: var(--text-secondary);
  }

  .tipo-btn:hover {
    border-color: var(--clay-400);
  }

  .tipo-btn input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tipo-btn:has(input:checked) {
    border-color: var(--border-accent);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-800);
  }

  .tipo-btn:has(input:checked) :global(.icon) {
    color: var(--terracotta-600);
  }

  .tipo-btn:has(input:focus-visible) {
    border-color: var(--border-focus);
    box-shadow: var(--focus-ring);
  }

  .campos,
  .so-pf,
  .so-pj {
    display: flex;
    flex-direction: column;
  }

  .is-pj .so-pf,
  .sem-tipo .so-pf,
  .auth-form:not(.is-pj) .so-pj {
    display: none;
  }

  /* Nome e e-mail vêm da conta e não são editáveis aqui */
  .campos :global(input[readonly]) {
    background: var(--bg-subtle);
    color: var(--text-muted);
    box-shadow: none;
  }
</style>

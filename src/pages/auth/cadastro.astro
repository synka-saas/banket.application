---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
import Checkbox from '../../components/ui/Checkbox.astro';
import { formToObject, userMessage } from '../../lib/forms';
import { REGRA_SENHA } from '../../lib/senha';
import { ipDaRequisicao, permitir } from '../../lib/rateLimit';
import { cadastrarConta, cadastroSchema } from '../../server/autoatendimento';

// Cadastro self-service: cria a conta (e-mail ainda não confirmado) e envia o link de confirmação.
// Em erro, a página é renderizada de novo com os valores (nada de dados pessoais na URL).
let nome = '';
let email = '';
let erro: string | null = null;

if (Astro.request.method === 'POST') {
  const data = formToObject(await Astro.request.formData());
  nome = String(data.nome ?? '');
  email = String(data.email ?? '');
  try {
    if (!permitir(`cadastro:${ipDaRequisicao(Astro.request, Astro.clientAddress)}`, 20, 60 * 60_000)) {
      throw new Error('limite');
    }
    const input = cadastroSchema.parse(data);
    await cadastrarConta(input);
    return Astro.redirect(`/auth/validacao?email=${encodeURIComponent(input.email)}`);
  } catch (err) {
    // Mantém nome e e-mail digitados (a senha nunca volta para a página)
    erro = err instanceof Error && err.message === 'limite' ? 'Muitas tentativas. Tente novamente mais tarde.' : userMessage(err);
    Astro.response.status = 400;
  }
}
---

<AuthLayout title="Cadastro" showOverlay={true} erro={erro}>
  <h1 class="auth-title">Crie sua conta.</h1>

  <form class="auth-form" method="post">
    <Input id="nome" name="nome" label="Nome e sobrenome" placeholder="Ex.: Maria Souza" value={nome} autocomplete="name" maxlength="255" required />
    <Input id="email" name="email" type="email" label="E-mail" placeholder="seu@email.com.br" value={email} autocomplete="email" required />
    <Input id="senha" name="senha" type="password" label="Senha" autocomplete="new-password" minlength="8" required />
    <Input id="confirma_senha" name="confirma_senha" type="password" label="Confirme sua senha" autocomplete="new-password" required />
    <p class="auth-hint">{REGRA_SENHA}</p>
    <Checkbox id="termos" name="termos" required>
      Li e aceito os <a href="/termos" target="_blank" rel="noopener" class="link">Termos de uso</a> e a{' '}
      <a href="/privacidade" target="_blank" rel="noopener" class="link">Política de privacidade</a>
    </Checkbox>

    <Button variant="primary" size="large" type="submit">Criar conta</Button>
  </form>

  <div class="auth-links">
    Já tem uma conta? <a href="/auth/login">Entre agora</a><br />
    <span class="auth-nota">*Dados obrigatórios</span>
  </div>
</AuthLayout>

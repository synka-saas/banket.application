---
import Icon from '../../../components/ui/Icon.astro';
import EventoLayout from '../../../layouts/EventoLayout.astro';
import SectionCard from '../../../components/ui/SectionCard.astro';
import Button from '../../../components/ui/Button.astro';
import EventoInfoLateral from '../../../components/eventos/EventoInfoLateral.astro';
import { isAdmin } from '../../../lib/auth';
import EtapaDialogo from '../../../components/eventos/EtapaDialogo.astro';
import { withTenant } from '../../../lib/db';
import { handleFormPost } from '../../../lib/actions';
import { removeDir } from '../../../lib/storage';
import { formatarDocumento } from '../../../lib/documento';
import { formatMoney } from '../../../lib/money';
import { dataCurta, dataHora, faixaHorario, hojeSaoPaulo } from '../../../lib/datas';
import { listarStatus } from '../../../server/configuracoes';
import { respostasDoEvento } from '../../../server/formularios';
import {
  COMPLIANCE,
  QUALIFICACOES,
  STATUS_CHECKLIST,
  carregarEvento,
  checklistSchema,
  eventoExiste,
  excluirChecklist,
  excluirEvento,
  listarChecklist,
  moverEvento,
  salvarChecklist,
} from '../../../server/eventos';
import { ROTULOS } from '../../../lib/rotulos';

const user = Astro.locals.user;
const id = Astro.params.id!;

if (!(await withTenant(user.tenantId, (db) => eventoExiste(db, id)))) {
  return new Response(null, { status: 404 });
}

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) =>
    withTenant(user.tenantId, async (db) => {
      switch (data._action) {
        case 'status':
          await moverEvento(db, user, id, String(data.status_id));
          return 'Etapa atualizada.';
        case 'excluir':
          await excluirEvento(db, id);
          await removeDir(user.tenantId, `orcamentos/${id}`);
          await removeDir(user.tenantId, `mensagens/${id}`);
          return { message: 'Evento excluído.', redirect: '/eventos' };
        case 'checklist_salvar': {
          const itemId = typeof data.checklist_id === 'string' && data.checklist_id ? data.checklist_id : null;
          await salvarChecklist(db, user, id, itemId, checklistSchema.parse(data));
          return itemId ? '' : 'Item adicionado ao checklist.';
        }
        case 'checklist_excluir':
          await excluirChecklist(db, id, String(data.checklist_id));
          return 'Item removido do checklist.';
        default:
          return '';
      }
    })
  );
}

const { evento, checklist, status, respostas } = await withTenant(user.tenantId, async (db) => ({
  evento: await carregarEvento(db, id),
  checklist: await listarChecklist(db, id),
  status: await listarStatus(db),
  respostas: await respostasDoEvento(db, id),
}));

const e = evento;
const hoje = hojeSaoPaulo();
// Link wa.me: DDI 55 quando o número tem só DDD + número
const linkWhatsApp = (tel: string) => {
  const d = tel.replace(/\D/g, '');
  return `https://wa.me/${d.length <= 11 ? `55${d}` : d}`;
};
const compliance = e.compliance.map((c) => COMPLIANCE[c as keyof typeof COMPLIANCE] ?? c);
---

<EventoLayout eventoId={id} titulo={e.titulo ?? e.cliente_nome ?? 'Evento'} aba="resumo">
  <section class="banner">
    <div>
      <span class="banner-label">{e.cliente_tipo === 'PJ' ? 'Empresa' : 'Cliente'}</span>
      <strong>{e.cliente_nome ?? <span class="vazio">—</span>}</strong>
      {e.cliente_documento && <span class="banner-apoio tabular">{e.cliente_tipo === 'PJ' ? 'CNPJ' : 'CPF'} {formatarDocumento(e.cliente_documento)}</span>}
    </div>
    <div>
      <span class="banner-label">Data e horário</span>
      <strong class="tabular">{e.data_evento ? dataCurta(e.data_evento) : <span class="vazio">—</span>}</strong>
      {e.hora_inicio && <span class="banner-apoio tabular">{faixaHorario(e.hora_inicio, e.hora_fim)}</span>}
    </div>
    <div>
      <span class="banner-label">Local do evento</span>
      <strong>{e.espaco_id ? <a class="link" href={`/espacos/${e.espaco_id}`}>{e.espaco_nome}</a> : (e.local_nome ?? (e.local_tipo === 'casa' ? 'Nosso espaço' : 'Local externo'))}</strong>
      {e.endereco && <span class="banner-apoio banner-endereco">{e.endereco}</span>}
    </div>
    <form method="post" class="banner-status" data-form-etapa>
      <input type="hidden" name="_action" value="status" />
      <label class="banner-label" for="status-evento">{ROTULOS.etapa}</label>
      <select id="status-evento" name="status_id" class="inline-select" data-autosubmit-row>
        {status.map((s) => <option value={s.id} data-variante={s.variante} selected={s.id === e.status_id}>{s.nome}</option>)}
      </select>
      {e.status_variante === 'recusado' && e.motivo_perda && <span class="banner-apoio banner-endereco" title={`Motivo: ${e.motivo_perda}`}>Motivo: {e.motivo_perda}</span>}
      {e.status_variante === 'aprovado' && e.fechado_em && <span class="banner-apoio banner-endereco">Fechado em {dataCurta(e.fechado_em)}</span>}
    </form>
  </section>

  <div class="resumo-grid">
    <div class="coluna-principal">
      <section class="cabecalho-card">
        <div>
          <span class="rotulo">Cliente</span>
          {e.cliente_email ? <a class="link" href={`mailto:${e.cliente_email}`}>{e.cliente_email}</a> : <strong>{e.cliente_nome ?? <span class="vazio">—</span>}</strong>}
          {e.cliente_telefone && (
            <a class="link" href={linkWhatsApp(e.cliente_telefone)} target="_blank" rel="noopener">{e.cliente_telefone} · chamar</a>
          )}
          {e.cliente_documento && <span class="muted tabular">{formatarDocumento(e.cliente_documento)}</span>}
        </div>
        <div>
          <span class="rotulo">Orçamento</span>
          {e.tem_orcamento ? <strong class="valor">{formatMoney(e.valor_orcamento)}</strong> : <span class="sem-orcamento">Sem orçamento</span>}
        </div>
        {e.tem_orcamento ? (
          <Button variant="primary" href={`/eventos/${id}/orcamento`}>Abrir orçamento</Button>
        ) : (
          <form method="post" action={`/eventos/${id}/orcamento`}>
            <input type="hidden" name="_action" value="criar" />
            <Button type="submit" variant="primary" data-carregando="Criando…">Criar orçamento</Button>
          </form>
        )}
      </section>

      <SectionCard title="Contato" icon="user-circle" variant="plain" collapsible>
        <dl class="kv kv-2">
          <div><dt>Responsável</dt><dd>{e.responsavel_nome ?? <span class="vazio">—</span>}</dd></div>
          <div><dt>E-mail</dt><dd>{e.responsavel_email ? <a class="link" href={`mailto:${e.responsavel_email}`}>{e.responsavel_email}</a> : <span class="vazio">—</span>}</dd></div>
          <div>
            <dt>WhatsApp</dt>
            <dd>
              {e.responsavel_whatsapp ? (
                <a class="link" href={linkWhatsApp(e.responsavel_whatsapp)} target="_blank" rel="noopener">
                  {e.responsavel_whatsapp} · chamar
                </a>
              ) : (
                <span class="vazio">—</span>
              )}
            </dd>
          </div>
        </dl>
        {e.convite_experiencia && (
          <dl class="kv"><div><dt>Convite para experiência</dt><dd><span class="chip-leitura">{e.convite_experiencia}</span></dd></div></dl>
        )}
      </SectionCard>

      <SectionCard title="Comercial" icon="heart-handshake" variant="plain" collapsible>
        <dl class="kv kv-2">
          <div><dt>{ROTULOS.tipoEvento}</dt><dd>{e.tipo_nome ?? <span class="vazio">—</span>}</dd></div>
          <div><dt>Qualificação do cliente</dt><dd>{e.qualificacao ? QUALIFICACOES[e.qualificacao] : <span class="vazio">—</span>}</dd></div>
          <div><dt>Forma de pagamento</dt><dd>{e.forma_pagamento ?? <span class="vazio">—</span>}</dd></div>
        </dl>
      </SectionCard>

      <SectionCard title="Logística e infraestrutura" variant="plain" collapsible>
        <dl class="kv">
          <div><dt>Local</dt><dd>{e.espaco_id ? <><a class="link" href={`/espacos/${e.espaco_id}`}>{e.espaco_nome}</a> <span class="tag tag-sm">{e.espaco_tipo === 'proprio' ? 'Nosso espaço' : 'Espaço de terceiro'}</span></> : <>{e.local_nome ?? 'Outro local'} <span class="tag tag-sm">{e.local_tipo === 'casa' ? 'Nosso espaço' : 'Outro local'}</span></>}</dd></div>
          <div><dt>Endereço</dt><dd>{e.endereco ?? <span class="vazio">—</span>}</dd></div>
          <div><dt>Infraestrutura</dt><dd>{e.infraestrutura ?? <span class="vazio">—</span>}</dd></div>
        </dl>
      </SectionCard>

      <SectionCard title="Requisitos de compliance" variant="plain" collapsible>
        {compliance.length ? (
          <div class="chips-leitura">{compliance.map((c) => <span class="chip-leitura">{c}</span>)}</div>
        ) : (
          <p class="muted">Nenhum requisito informado.</p>
        )}
      </SectionCard>

      <SectionCard title="Staff de terceiros" variant="plain" collapsible>
        {e.staff_terceiros ? <span class="chip-leitura">{e.staff_terceiros}</span> : <p class="muted">Não informado.</p>}
      </SectionCard>

      {respostas && (
        <SectionCard title="Respostas do formulário" variant="plain" collapsible open={false}>
          <p class="muted respostas-origem">
            {respostas.formulario ?? 'Formulário removido'} · recebido em {dataHora(respostas.created_at)}
          </p>
          <dl class="kv">
            {respostas.dados.map((r) => (
              <div><dt>{r.rotulo}</dt><dd>{r.valor}</dd></div>
            ))}
          </dl>
        </SectionCard>
      )}

      <SectionCard title="Comentário do cliente" variant="plain" collapsible>
        <p class="comentario">{e.comentario_cliente ?? 'Sem comentários.'}</p>
      </SectionCard>

      <div class="acoes-evento">
        <Button variant="secondary" icon="pencil" href={`/eventos/${id}/editar`}>Editar evento</Button>
        <form method="post">
          <input type="hidden" name="_action" value="excluir" />
          <Button type="submit" variant="danger" icon="trash" data-confirm="Excluir este evento? O orçamento e o histórico também serão removidos.">
            Excluir evento
          </Button>
        </form>
      </div>
    </div>

    <div class="coluna-lateral">
      <EventoInfoLateral evento={e} />

      <section class="checklist">
        <h3 class="bloco-titulo"><Icon name="list-check" size={18} /> Checklist operacional</h3>
        {checklist.length === 0 && <p class="muted sem-itens">Nenhum item. Adicione o que precisa acontecer antes do evento.</p>}
        <ul class="checklist-lista">
          {checklist.map((c) => {
            const vencido = c.prazo !== null && c.prazo < hoje && c.status !== 'concluido';
            return (
              <li class:list={{ 'checklist-vencido': vencido }}>
                <form method="post" class="checklist-campos">
                  <input type="hidden" name="_action" value="checklist_salvar" />
                  <input type="hidden" name="checklist_id" value={c.id} />
                  <div class="checklist-campo item">
                    <span class="rotulo">Item</span>
                    <input name="item" value={c.item} required maxlength="255" class="inline-select" aria-label={`Texto de ${c.item}`} data-autosubmit-row />
                  </div>
                  <div class="checklist-campo">
                    <span class="rotulo">Prazo{vencido && <span class="prazo-alerta"> · vencido</span>}</span>
                    <input name="prazo" type="date" value={c.prazo ?? ''} class="inline-select" aria-label={`Prazo de ${c.item}`} data-autosubmit-row />
                  </div>
                  <div class="checklist-campo">
                    <span class="rotulo">Status</span>
                    <select name="status" class="inline-select" aria-label={`Status de ${c.item}`} data-autosubmit-row>
                      {Object.entries(STATUS_CHECKLIST).map(([k, l]) => <option value={k} selected={k === c.status}>{l}</option>)}
                    </select>
                  </div>
                </form>
                <form method="post">
                  <input type="hidden" name="_action" value="checklist_excluir" />
                  <input type="hidden" name="checklist_id" value={c.id} />
                  <button type="submit" class="remover" aria-label={`Remover ${c.item}`} data-confirm={`Remover "${c.item}" do checklist?`}><Icon name="x" size={16} /></button>
                </form>
              </li>
            );
          })}
        </ul>
        <form method="post" class="checklist-novo">
          <input type="hidden" name="_action" value="checklist_salvar" />
          <input name="item" class="control" placeholder="Novo item (ex.: Degustação presencial)" required maxlength="255" aria-label="Novo item do checklist" />
          <input name="prazo" type="date" class="control checklist-novo-prazo" aria-label="Prazo do novo item" />
          <button type="submit" class="btn btn-secondary btn-md">Adicionar</button>
        </form>
      </section>
    </div>
  </div>
  <EtapaDialogo slot="overlays" planoPagamento={isAdmin(user)} />
</EventoLayout>

<script>
  import { toast } from '../../../lib/ui';

  // Etapa pela faixa do resumo: sem recarregar, com complemento (aprovado/recusado) e Desfazer (UX-104/117)
  const formEtapa = document.querySelector<HTMLFormElement>('[data-form-etapa]');
  const selectEtapa = formEtapa?.querySelector<HTMLSelectElement>('#status-evento');
  if (formEtapa && selectEtapa) {
    const eventoId = window.location.pathname.split('/')[2];
    let anterior = selectEtapa.value;

    const aplicar = async (statusId: string, extras: Record<string, string>) => {
      const res = await fetch(`/api/eventos/${eventoId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status_id: statusId, ...extras }),
      });
      if (!res.ok) throw new Error(((await res.json()) as { error?: string }).error ?? 'Não foi possível mudar a etapa.');
    };

    formEtapa.addEventListener('submit', (e) => {
      e.preventDefault();
      void (async () => {
        const opcao = selectEtapa.selectedOptions[0];
        const extras = await window.banketEtapaExtras?.(opcao?.dataset.variante ?? '');
        if (extras === null || extras === undefined) {
          selectEtapa.value = anterior;
          return;
        }
        const de = anterior;
        try {
          await aplicar(selectEtapa.value, extras);
          anterior = selectEtapa.value;
          // Fechamento com "cadastrar o plano de pagamento em seguida" (owner/admin)
          if (extras._plano) {
            window.location.href = `/eventos/${eventoId}/financas?plano=1`;
            return;
          }
          toast(`Etapa alterada para "${opcao.textContent?.trim()}".`, 'success', {
            acao: {
              rotulo: 'Desfazer',
              executar: () => {
                selectEtapa.value = de;
                aplicar(de, {})
                  .then(() => {
                    anterior = de;
                    toast('Etapa restaurada.', 'info');
                  })
                  .catch((err) => toast(err instanceof Error ? err.message : 'Não foi possível restaurar.', 'error'));
              },
            },
          });
        } catch (err) {
          selectEtapa.value = anterior;
          toast(err instanceof Error ? err.message : 'Não foi possível mudar a etapa.', 'error');
        }
      })();
    });
  }
</script>

<style>
  /* Faixa do resumo = Card do design system com quatro blocos rótulo → valor */
  .banner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 1fr 1fr;
    padding: var(--space-5) 0;
    margin-bottom: var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    font-size: var(--fs-14);
    color: var(--text-body);
  }

  .banner > div,
  .banner-status {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 0 var(--space-6);
  }

  .banner > * + * {
    border-left: 1px solid var(--border-subtle);
  }

  .banner strong {
    font-size: var(--fs-15);
    line-height: 1.4;
    font-weight: var(--fw-medium);
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .banner-label {
    font-size: var(--fs-12);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .banner-apoio {
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .banner-endereco {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .banner-status select {
    align-self: flex-start;
    max-width: 100%;
    margin: var(--space-1) 0 2px;
    font-weight: var(--fw-medium);
  }

  .resumo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .coluna-principal,
  .coluna-lateral {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  /* O espaçamento entre os cards vem do gap da coluna, não da margem padrão do SectionCard */
  .resumo-grid .coluna-principal > :global(.section-card + .section-card) {
    margin-top: 0;
  }

  .cabecalho-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .cabecalho-card > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    min-width: 0;
    font-size: var(--fs-14);
  }

  .cabecalho-card strong {
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .cabecalho-card :global(.link) {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .rotulo {
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  .cabecalho-card .valor {
    font-size: var(--fs-20);
    line-height: 1.25;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-tight);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
  }

  .sem-orcamento {
    font-size: var(--fs-15);
    color: var(--text-secondary);
  }

  .comentario {
    white-space: pre-line;
    line-height: 1.6;
    color: var(--text-heading);
  }

  .respostas-origem {
    margin-bottom: var(--space-3);
    font-size: var(--fs-13);
  }

  .acoes-evento {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  /* Checklist = Card do design system */
  .checklist {
    padding: var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .checklist-lista li {
    display: flex;
    align-items: end;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .checklist-lista li:first-child {
    padding-top: 0;
  }

  .checklist-campos {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2);
    align-items: end;
  }

  /* A coluna lateral é estreita: o texto do item ocupa a linha inteira; prazo e status ficam abaixo */
  .checklist-campo.item {
    grid-column: 1 / -1;
  }

  .checklist-campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--fs-14);
    color: var(--text-strong);
    min-width: 0;
  }

  .checklist-campo input,
  .checklist-campo select {
    width: 100%;
    max-width: none;
  }

  .checklist-campo input.inline-select {
    background-image: none;
    padding-right: var(--space-1-5);
    cursor: text;
  }

  /* Prazo vencido é alerta: vinho, nunca terracota */
  .checklist-vencido .checklist-campo input[type='date'] {
    border-color: var(--wine-300);
    color: var(--danger);
  }

  .prazo-alerta {
    color: var(--danger);
    font-weight: var(--fw-medium);
  }

  .remover {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: var(--control-h-sm);
    border: none;
    border-radius: var(--radius-xs);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .remover:hover {
    background: var(--danger-bg);
    color: var(--danger);
  }

  /* Novo item: o texto ocupa a linha inteira; prazo e botão ficam na linha de baixo */
  .checklist-novo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .checklist-novo input[name='item'] {
    flex: 1 1 100%;
  }

  .checklist-novo-prazo {
    flex: 1 1 0;
    min-width: 0;
  }

  .sem-itens {
    font-size: var(--fs-13);
  }

  @media (max-width: 1024px) {
    .resumo-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cabecalho-card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .banner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) 0;
      padding: var(--space-4) 0;
    }

    .banner > div,
    .banner-status {
      padding: 0 var(--space-4);
    }

    .banner > :nth-child(odd) {
      border-left: 0;
    }

    .checklist {
      padding: var(--space-4);
    }

    .checklist-campos {
      grid-template-columns: minmax(0, 1fr);
    }

    .acoes-evento {
      flex-wrap: wrap;
    }
  }
</style>

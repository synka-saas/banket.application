---
import EventoLayout from '../../../layouts/EventoLayout.astro';
import EventoInfoLateral from '../../../components/eventos/EventoInfoLateral.astro';
import VersoesLateral from '../../../components/orcamento/VersoesLateral.astro';
import BlocosEditor from '../../../components/orcamento/BlocosEditor';
import Button from '../../../components/ui/Button.astro';
import { withTenant } from '../../../lib/db';
import { handleFormPost } from '../../../lib/actions';
import { formatarDocumento } from '../../../lib/documento';
import { formatMoney } from '../../../lib/money';
import { eventoExiste } from '../../../server/eventos';
import { contextoOrcamento, criarNovaVersao } from '../../../server/orcamento';
import OrcamentoAbas from '../../../components/orcamento/OrcamentoAbas.astro';

// Informações complementares da versão do orçamento (frame "Orçamento | Informações complementares")
const user = Astro.locals.user;
const id = Astro.params.id!;
const base = `/eventos/${id}/informacoes-complementares`;

if (!(await withTenant(user.tenantId, (db) => eventoExiste(db, id)))) {
  return new Response(null, { status: 404 });
}

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) =>
    withTenant(user.tenantId, async (db) => {
      if (data._action === 'restaurar') {
        const numero = await criarNovaVersao(db, user, id, Number(data.numero));
        return { message: `Versão restaurada como versão ${String(numero).padStart(2, '0')}.`, redirect: base };
      }
      return '';
    })
  );
}

const { evento, orcamento, versao, faixas } = await withTenant(user.tenantId, (db) =>
  contextoOrcamento(db, id, Astro.url.searchParams.get('versao'))
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<EventoLayout eventoId={id} titulo={evento.titulo ?? evento.cliente_nome ?? 'Evento'} aba="informacoes">
  {orcamento && <OrcamentoAbas eventoId={id} ativa="informacoes" versao={versao ? { numero: versao.numero, congelada: versao.congelada } : null} />}
  <div class="grid-evento">
    <div class="coluna-principal">
      {orcamento && versao ? (
        <>
          <section class="orc-cabecalho-simples">
            <div>
              <span class="rotulo">Cliente</span>
              <strong>{evento.cliente_nome ?? '—'}</strong>
              {evento.cliente_documento && <span class="muted">{formatarDocumento(evento.cliente_documento)}</span>}
            </div>
            <div>
              <span class="rotulo">Versão: {pad(versao.numero)}</span>
              <strong class="total">{formatMoney(versao.conteudo.totais?.total ?? versao.valor_total)}</strong>
            </div>
            {versao.congelada && <span class="selo-congelada">Versão congelada · somente leitura</span>}
          </section>
          <BlocosEditor
            client:load
            eventoId={id}
            numero={versao.numero}
            congelada={versao.congelada}
            campo="informacoes_complementares"
            conteudo={versao.conteudo}
            faixas={faixas}
          />
        </>
      ) : (
        <section class="sem-orcamento">
          <h3>Este evento ainda não tem orçamento</h3>
          <p>As informações complementares fazem parte de cada versão do orçamento.</p>
          <Button variant="primary" href={`/eventos/${id}/orcamento`}>Ir para o orçamento</Button>
        </section>
      )}
    </div>
    <div class="coluna-lateral">
      {orcamento && versao && <VersoesLateral orcamento={orcamento} visualizando={versao.numero} basePath={base} />}
      <EventoInfoLateral evento={evento} />
    </div>
  </div>
</EventoLayout>

<style>
  .grid-evento {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .coluna-principal,
  .coluna-lateral {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  /* Cabeçalho da versão: cliente à esquerda, total à direita (mesmo desenho do construtor) */
  .orc-cabecalho-simples {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-5) var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .orc-cabecalho-simples > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-size: var(--fs-14);
  }

  .orc-cabecalho-simples > div:nth-child(2) {
    align-items: flex-end;
    text-align: right;
  }

  .orc-cabecalho-simples strong {
    font-size: var(--fs-15);
    line-height: 1.35;
    color: var(--text-heading);
  }

  .orc-cabecalho-simples .muted {
    font-size: var(--fs-13);
    font-variant-numeric: tabular-nums;
  }

  .orc-cabecalho-simples :global(.selo-congelada) {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .rotulo {
    font-size: var(--fs-12);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .orc-cabecalho-simples .total {
    font-size: var(--fs-24);
    line-height: 1.15;
    letter-spacing: var(--ls-tight);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .sem-orcamento {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-8);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .sem-orcamento h3 {
    font-size: var(--fs-17);
  }

  .sem-orcamento p {
    color: var(--text-secondary);
    max-width: 620px;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .grid-evento {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 768px) {
    .orc-cabecalho-simples {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      padding: var(--space-4);
    }

    .orc-cabecalho-simples > div:nth-child(2) {
      align-items: flex-start;
      text-align: left;
    }

    .sem-orcamento {
      padding: var(--space-4);
    }
  }
</style>

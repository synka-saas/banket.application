---
import EventoLayout from '../../../layouts/EventoLayout.astro';
import EventoInfoLateral from '../../../components/eventos/EventoInfoLateral.astro';
import VersoesLateral from '../../../components/orcamento/VersoesLateral.astro';
import OrcamentoBuilder from '../../../components/orcamento/OrcamentoBuilder';
import Button from '../../../components/ui/Button.astro';
import Drawer from '../../../components/ui/Drawer.astro';
import { withTenant } from '../../../lib/db';
import { handleFormPost } from '../../../lib/actions';
import { optionalUuid } from '../../../lib/forms';
import { formatarDocumento } from '../../../lib/documento';
import { eventoExiste } from '../../../server/eventos';
import { catalogoConstrutor, contextoOrcamento, criarNovaVersao, criarOrcamento, definirTemplate } from '../../../server/orcamento';
import { listarTemplates } from '../../../server/templates';
import { envioSchema, enviarProposta, rascunhoEnvio } from '../../../server/envio';
import { formatMoney } from '../../../lib/money';
import { dataHora } from '../../../lib/datas';
import OrcamentoAbas from '../../../components/orcamento/OrcamentoAbas.astro';

const user = Astro.locals.user;
const id = Astro.params.id!;
const base = `/eventos/${id}/orcamento`;

if (!(await withTenant(user.tenantId, (db) => eventoExiste(db, id)))) {
  return new Response(null, { status: 404 });
}

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) =>
    withTenant(user.tenantId, async (db) => {
      if (data._action === 'criar') {
        const { statusAlterado } = await criarOrcamento(db, user, id);
        return {
          message: statusAlterado ? 'Orçamento iniciado. O evento passou para "Em negociação".' : 'Orçamento iniciado.',
          redirect: base,
        };
      }
      if (data._action === 'nova_versao') {
        const numero = await criarNovaVersao(db, user, id);
        return { message: `Versão ${String(numero).padStart(2, '0')} criada.`, redirect: base };
      }
      if (data._action === 'restaurar') {
        const numero = await criarNovaVersao(db, user, id, Number(data.numero));
        return { message: `Versão restaurada como versão ${String(numero).padStart(2, '0')}.`, redirect: base };
      }
      if (data._action === 'enviar') {
        const input = envioSchema.parse(data);
        const r = await enviarProposta(db, user, id, input);
        const pad = (n: number) => String(n).padStart(2, '0');
        const enviado = r.delivered
          ? `Proposta enviada para ${input.para.join(', ')}.`
          : 'E-mail registrado no log do servidor (sem envio real: domínio de teste ou e-mail não configurado). O envio foi anotado na linha do tempo.';
        return {
          message: r.novaVersao
            ? `${enviado} A versão ${pad(input.numero)} foi congelada como enviada; você está editando a versão ${pad(r.novaVersao)}.`
            : enviado,
          redirect: base,
        };
      }
      if (data._action === 'template') {
        await definirTemplate(db, id, optionalUuid().parse(data.template_id) ?? null);
        return 'Template da proposta atualizado.';
      }
      return '';
    })
  );
}

const ctx = await withTenant(user.tenantId, async (db) => {
  const c = await contextoOrcamento(db, id, Astro.url.searchParams.get('versao'));
  const catalogo = c.orcamento ? await catalogoConstrutor(db) : null;
  const { rows } = await db.query<{ criancas_isentas_ate: number; criancas_meia_ate: number }>(
    'SELECT criancas_isentas_ate, criancas_meia_ate FROM configuracoes_tenant'
  );
  const templates = c.orcamento ? await listarTemplates(db) : [];
  const envio = c.versao ? await rascunhoEnvio(db, id, c.versao.numero) : null;
  return { ...c, catalogo, templates, envio, idades: { isentas: rows[0]?.criancas_isentas_ate ?? 5, meia: rows[0]?.criancas_meia_ate ?? 11 } };
});
const { evento, orcamento, versao } = ctx;
---

<EventoLayout eventoId={id} titulo={evento.titulo ?? evento.cliente_nome ?? 'Evento'} aba="orcamento">
  {orcamento && <OrcamentoAbas eventoId={id} ativa="itens" versao={versao ? { numero: versao.numero, congelada: versao.congelada } : null} />}
  <div class="grid-evento">
    <div>
      {orcamento && versao && ctx.catalogo ? (
        <OrcamentoBuilder
          client:load
          eventoId={id}
          numero={versao.numero}
          congelada={versao.congelada}
          cliente={{ nome: evento.cliente_nome ?? '-', documento: evento.cliente_documento ? formatarDocumento(evento.cliente_documento) : null }}
          conteudo={versao.conteudo}
          catalogo={ctx.catalogo}
          faixas={ctx.faixas}
          idades={ctx.idades}
          pdfUrl={`${base}/pdf?versao=${versao.numero}`}
        />
      ) : (
        <section class="sem-orcamento">
          <h3>Este evento ainda não tem orçamento</h3>
          <p>
            O orçamento começa com o staff padrão calculado para {evento.numero_convidados ?? 0} convidados, a locação
            pela faixa de convidados e as condições gerais da empresa. Depois é só adicionar cardápios e bebidas.
          </p>
          <form method="post">
            <input type="hidden" name="_action" value="criar" />
            <Button type="submit" variant="primary" data-carregando="Criando…">Criar orçamento</Button>
          </form>
        </section>
      )}
    </div>
    <div class="coluna-lateral">
      {orcamento && versao && (
        <form method="post" class="template-proposta">
          <input type="hidden" name="_action" value="template" />
          <label for="orc-template" class="bloco-titulo">Template da proposta</label>
          <select id="orc-template" name="template_id" class="control" data-autosubmit-row>
            {ctx.templates.map((t) => (
              <option value={t.padrao ? '' : t.id} selected={orcamento.template_id ? orcamento.template_id === t.id : t.padrao}>
                {t.nome}{t.padrao ? ' (padrão)' : ''}
              </option>
            ))}
          </select>
          <span class="field-hint">Versões congeladas mantêm o PDF já gerado.</span>
        </form>
      )}
      {orcamento && versao && <VersoesLateral orcamento={orcamento} visualizando={versao.numero} basePath={base} />}
      <EventoInfoLateral evento={evento} />
    </div>
  </div>
  {ctx.envio && (
    <Drawer id="drawer-enviar" formId="form-enviar" title={`Enviar proposta · versão ${String(ctx.envio.numero).padStart(2, '0')}`} deletable={false} width="md" saveLabel="Enviar" saveAction="enviar" saveLoadingLabel="Enviando…">
      <form
        id="form-enviar"
        method="post"
        class="form-envio"
        data-envio-versao={String(ctx.envio.numero).padStart(2, '0')}
        data-envio-valor={formatMoney(ctx.envio.valorTotal)}
      >
        <input type="hidden" name="numero" value={ctx.envio.numero} />
        {ctx.envio.ultimoEnvio && (
          <p class="aviso-envio">Esta versão já foi enviada em {dataHora(ctx.envio.ultimoEnvio.em)} para {ctx.envio.ultimoEnvio.para}.</p>
        )}
        {ctx.envio.aberta && (
          <p class="aviso-envio">
            Depois do envio, a versão {String(ctx.envio.numero).padStart(2, '0')} fica congelada exatamente como o cliente recebeu e
            os próximos ajustes seguem numa nova versão.
          </p>
        )}
        <div class="field">
          <label for="env-para">Para<span class="obrigatorio">*</span></label>
          <div class="chips-email" data-chips-email>
            <input type="hidden" name="para" value={ctx.envio.para} data-chips-valor />
            <input
              id="env-para"
              type="email"
              placeholder="email@cliente.com.br"
              data-chips-entrada
              aria-describedby="env-para-dica"
            />
          </div>
          <span class="field-hint" id="env-para-dica">
            Enter ou vírgula adiciona; até 5 destinatários. As respostas chegam no seu e-mail ({user.email}).
          </span>
        </div>
        <div class="field">
          <label for="env-assunto">Assunto<span class="obrigatorio">*</span></label>
          <input id="env-assunto" name="assunto" required maxlength="255" value={ctx.envio.assunto} />
        </div>
        <div class="field">
          <label for="env-mensagem">Mensagem<span class="obrigatorio">*</span></label>
          <textarea id="env-mensagem" name="mensagem" required rows="12" maxlength="10000">{ctx.envio.mensagem}</textarea>
          <span class="field-hint">O modelo da mensagem fica em Configurações › Empresa.</span>
        </div>
        <div class="field">
          <span class="field-label">Prévia do e-mail</span>
          <div class="envio-previa">
            <p class="envio-previa-anexo"><strong>Anexo:</strong> PDF da proposta (versão {String(ctx.envio.numero).padStart(2, '0')})</p>
            <p class="envio-previa-assunto" data-previa-envio-assunto></p>
            <p class="envio-previa-corpo" data-previa-envio-corpo></p>
          </div>
        </div>
      </form>
    </Drawer>
  )}
</EventoLayout>

<script>
  import { toast } from '../../../lib/ui';

  // Envio da proposta: destinatários em chips (UX-123) e confirmação com o resumo do que vai ao cliente
  const form = document.querySelector<HTMLFormElement>('#form-enviar');
  const botao = document.querySelector<HTMLButtonElement>('#drawer-enviar [data-drawer-save]');
  if (form && botao) {
    const caixa = form.querySelector<HTMLElement>('[data-chips-email]')!;
    const valorOculto = form.querySelector<HTMLInputElement>('[data-chips-valor]')!;
    const entrada = form.querySelector<HTMLInputElement>('[data-chips-entrada]')!;
    const EMAIL_OK = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    let emails = valorOculto.value.split(/[,;\s]+/).map((e) => e.trim().toLowerCase()).filter(Boolean);

    const render = () => {
      caixa.querySelectorAll('.chip-email').forEach((c) => c.remove());
      for (const [i, email] of emails.entries()) {
        const chip = document.createElement('span');
        chip.className = 'chip-email';
        chip.textContent = email;
        const x = document.createElement('button');
        x.type = 'button';
        x.setAttribute('aria-label', `Remover ${email}`);
        x.textContent = '×';
        x.addEventListener('click', () => {
          emails.splice(i, 1);
          sincronizar();
        });
        chip.appendChild(x);
        caixa.insertBefore(chip, entrada);
      }
      valorOculto.value = emails.join(', ');
      entrada.placeholder = emails.length ? '' : 'email@cliente.com.br';
      atualizarConfirmacao();
      valorOculto.dispatchEvent(new Event('input', { bubbles: true }));
    };
    const sincronizar = render;

    const adicionar = () => {
      const texto = entrada.value.trim().toLowerCase().replace(/[,;]+$/, '');
      if (!texto) return;
      if (!EMAIL_OK.test(texto)) {
        toast(`"${texto}" não parece um e-mail válido.`, 'error');
        return;
      }
      if (emails.includes(texto)) {
        entrada.value = '';
        return;
      }
      if (emails.length >= 5) {
        toast('Máximo de 5 destinatários.', 'error');
        return;
      }
      emails.push(texto);
      entrada.value = '';
      sincronizar();
    };
    entrada.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        adicionar();
      } else if (e.key === 'Backspace' && !entrada.value && emails.length) {
        emails.pop();
        sincronizar();
      }
    });
    entrada.addEventListener('blur', adicionar);
    caixa.addEventListener('click', () => entrada.focus());

    // Prévia do e-mail com o que está nos campos (UX-123)
    const assunto = form.querySelector<HTMLInputElement>('[name="assunto"]')!;
    const corpo = form.querySelector<HTMLTextAreaElement>('[name="mensagem"]')!;
    const previaAssunto = form.querySelector<HTMLElement>('[data-previa-envio-assunto]')!;
    const previaCorpo = form.querySelector<HTMLElement>('[data-previa-envio-corpo]')!;
    const atualizarPrevia = () => {
      previaAssunto.textContent = assunto.value;
      previaCorpo.textContent = corpo.value;
    };
    assunto.addEventListener('input', atualizarPrevia);
    corpo.addEventListener('input', atualizarPrevia);

    const atualizarConfirmacao = () => {
      const destinatarios = emails.join(', ') || 'o cliente';
      botao.dataset.confirm = `Enviar a proposta para ${destinatarios}?`;
      botao.dataset.confirmTexto = `Versão ${form.dataset.envioVersao} · total ${form.dataset.envioValor}. O PDF vai em anexo.`;
      botao.dataset.confirmRotulo = 'Enviar';
    };

    render();
    atualizarPrevia();
  }
</script>

<style>
  .grid-evento {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(320px, 1fr);
    gap: 30px;
    align-items: start;
  }

  .coluna-lateral {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .form-envio {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .aviso-envio {
    padding: 12px 16px;
    border-radius: var(--border-radius);
    background: var(--color-neutral-10);
    font-size: 14px;
    color: var(--color-neutral-80);
  }

  .template-proposta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 28px;
    background: var(--color-white);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
  }

  .sem-orcamento {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 36px;
    background: var(--color-white);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
  }

  .sem-orcamento h3 {
    font-size: 18px;
  }

  .sem-orcamento p {
    color: var(--color-neutral-65);
    max-width: 620px;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .grid-evento {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .chips-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 5px 10px;
    background: var(--color-white);
    border: 1px solid var(--color-border-input);
    border-radius: var(--border-radius-sm);
    cursor: text;
  }

  .chips-email:focus-within {
    border-color: var(--color-primary-50);
    box-shadow: 0 0 0 1px var(--color-primary-50);
  }

  .chips-email input[type='email'] {
    flex: 1;
    min-width: 160px;
    border: 0;
    outline: none;
    font-size: 14px;
    padding: 4px 0;
  }

  :global(.chip-email) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px 3px 10px;
    background: var(--color-primary-10);
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary-60);
  }

  :global(.chip-email button) {
    border: 0;
    background: none;
    font-size: 16px;
    line-height: 1;
    color: inherit;
    cursor: pointer;
    padding: 0 2px;
  }

  .envio-previa {
    padding: 12px 14px;
    background: var(--color-neutral-10);
    border: 1px dashed var(--color-neutral-30);
    border-radius: var(--border-radius);
    font-size: 13px;
    line-height: 1.6;
  }

  .envio-previa-anexo {
    margin-bottom: 8px;
    color: var(--color-text-muted);
  }

  .envio-previa-assunto {
    font-weight: 700;
    margin-bottom: 6px;
  }

  .envio-previa-corpo {
    white-space: pre-wrap;
    max-height: 180px;
    overflow-y: auto;
  }
</style>

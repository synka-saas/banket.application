---
import EventoLayout from '../../../layouts/EventoLayout.astro';
import EventoForm from '../../../components/eventos/EventoForm.astro';
import { withTenant } from '../../../lib/db';
import { setFlash } from '../../../lib/flash';
import { formToObject, userMessage } from '../../../lib/forms';
import {
  atualizarEvento,
  carregarEvento,
  errosDoFormularioEvento,
  eventoExiste,
  opcoesFormularioEvento,
  validarFormularioEvento,
} from '../../../server/eventos';

const user = Astro.locals.user;
const id = Astro.params.id!;

if (!(await withTenant(user.tenantId, (db) => eventoExiste(db, id)))) {
  return new Response(null, { status: 404 });
}

let erro = '';
let erros: Record<string, string> = {};
let valores: Record<string, unknown> | null = null;

if (Astro.request.method === 'POST') {
  valores = formToObject(await Astro.request.formData(), ['restricoes', 'compliance']);
  try {
    const { input, cliente } = validarFormularioEvento(valores);
    await withTenant(user.tenantId, (db) => atualizarEvento(db, user, id, input, cliente));
    setFlash(Astro.cookies, 'success', 'Evento atualizado.');
    return Astro.redirect(`/eventos/${id}`);
  } catch (err) {
    erro = userMessage(err);
    erros = errosDoFormularioEvento(err);
    Astro.response.status = 400;
  }
}

const { evento, opcoes } = await withTenant(user.tenantId, async (db) => {
  const evento = await carregarEvento(db, id);
  return { evento, opcoes: await opcoesFormularioEvento(db, evento.espaco_id) };
});
---

<EventoLayout eventoId={id} titulo={evento.titulo ?? evento.cliente_nome ?? 'Evento'} aba="resumo">
  <EventoForm valores={valores ?? { ...evento }} {...opcoes} erro={erro} erros={erros} cancelarHref={`/eventos/${id}`} modo="editar" />
</EventoLayout>

---
import Icon from '../../../components/ui/Icon.astro';
import EventoLayout from '../../../layouts/EventoLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { withTenant } from '../../../lib/db';
import { dataHora } from '../../../lib/datas';
import { carregarEvento, eventoExiste } from '../../../server/eventos';
import { ICONES_TIMELINE, TIPOS_ANOTACAO, anotacaoSchema, listarTimeline, registrarAnotacao } from '../../../server/timeline';
import { handleFormPost } from '../../../lib/actions';
import { dataCurta, hojeSaoPaulo } from '../../../lib/datas';

const user = Astro.locals.user;
const id = Astro.params.id!;

if (!(await withTenant(user.tenantId, (db) => eventoExiste(db, id)))) {
  return new Response(null, { status: 404 });
}

// Anotação manual (ligação, visita, degustação…), o básico de um CRM (UX-090)
if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    const input = anotacaoSchema.parse(data);
    await withTenant(user.tenantId, (db) => registrarAnotacao(db, user, id, input));
    return input.retorno_em ? `Anotação registrada, com retorno em ${dataCurta(input.retorno_em)}.` : 'Anotação registrada.';
  });
}

const hoje = hojeSaoPaulo();

const { evento, registros } = await withTenant(user.tenantId, async (db) => ({
  evento: await carregarEvento(db, id),
  registros: await listarTimeline(db, id),
}));
---

<EventoLayout eventoId={id} titulo={evento.titulo ?? evento.cliente_nome ?? 'Evento'} aba="timeline">
  <section class="timeline-card anotacao-card">
    <h3 class="bloco-titulo"><Icon name="edit" size={18} /> Nova anotação</h3>
    <form method="post" class="anotacao-form">
      <div class="anotacao-linha">
        <div class="field">
          <label for="an-tipo">Tipo</label>
          <select id="an-tipo" name="tipo_contato">
            {Object.entries(TIPOS_ANOTACAO).map(([valor, rotulo]) => <option value={valor}>{rotulo}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="an-retorno">Retornar em (opcional)</label>
          <input id="an-retorno" name="retorno_em" type="date" min={hoje} />
          <span class="field-hint">Aparece como lembrete no dashboard.</span>
        </div>
      </div>
      <div class="field">
        <label for="an-texto">Anotação<span class="obrigatorio">*</span></label>
        <textarea id="an-texto" name="texto" rows="3" required maxlength="2000" placeholder="Ex.: Liguei para a cliente; prefere degustação no sábado de manhã."></textarea>
      </div>
      <div class="anotacao-acoes">
        <Button type="submit" variant="primary" data-carregando="Registrando…">Registrar anotação</Button>
      </div>
    </form>
  </section>

  <section class="timeline-card">
    <h3 class="bloco-titulo"><Icon name="timeline" size={18} /> Linha do tempo</h3>
    {registros.length === 0 ? (
      <p class="muted">Nenhum registro ainda.</p>
    ) : (
      <ol class="timeline">
        {registros.map((r) => (
          <li class={`tl-${r.tipo}`}>
            <span class="tl-icone"><Icon name={ICONES_TIMELINE[r.tipo] ?? 'info-circle'} size={16} /></span>
            <div class="tl-conteudo">
              <p class="tl-descricao">{r.descricao}</p>
              <p class="tl-meta">
                {dataHora(r.created_at)}
                {r.usuario_nome ? ` · ${r.usuario_nome}` : r.tipo === 'formulario' ? ' · Formulário público' : ''}
                {r.retorno_em && (
                  <span class:list={['tl-retorno', { vencido: r.retorno_em < hoje }]}>
                    Retorno: {dataCurta(r.retorno_em)}
                  </span>
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </section>
</EventoLayout>

<style>
  /* Cards do design system */
  .timeline-card {
    max-width: 900px;
    padding: var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .anotacao-card {
    margin-bottom: var(--space-5);
  }

  .anotacao-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .anotacao-linha {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
  }

  .anotacao-acoes {
    display: flex;
    justify-content: flex-end;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timeline li {
    position: relative;
    display: flex;
    gap: var(--space-4);
  }

  /* Linha que liga cada registro ao seguinte, do pé do ícone até o próximo */
  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 36px;
    bottom: calc(var(--space-5) * -1 + var(--space-1));
    width: 1px;
    background: var(--border-default);
  }

  .tl-icone {
    z-index: 1;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .tl-status .tl-icone {
    background: var(--success-bg);
    color: var(--success);
  }

  .tl-conteudo {
    flex: 1;
    min-width: 0;
    padding-top: 5px;
  }

  .tl-descricao {
    font-size: var(--fs-14);
    color: var(--text-heading);
    overflow-wrap: anywhere;
  }

  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin-top: 2px;
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  /* Anotações manuais ganham um card próprio */
  .tl-anotacao .tl-conteudo {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--clay-25);
  }

  .tl-anotacao .tl-descricao {
    white-space: pre-line;
  }

  .tl-retorno {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--success-bg);
    color: var(--sage-700);
    font-size: var(--fs-12);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  /* Retorno vencido é alerta: vinho, nunca terracota */
  .tl-retorno.vencido {
    background: var(--danger-bg);
    color: var(--danger);
  }

  @media (max-width: 768px) {
    .timeline-card {
      padding: var(--space-4);
    }

    .anotacao-linha {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

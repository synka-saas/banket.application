---
import Icon from '../../components/ui/Icon.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';
import Pagination from '../../components/ui/Pagination.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import { withTenant } from '../../lib/db';
import { html } from '../../lib/html';
import { formatMoney } from '../../lib/money';
import { dataCurta, hojeSaoPaulo, somarMeses } from '../../lib/datas';
import { estaFiltrando, pageInfo, pageParams, searchTerm, withQuery } from '../../lib/pagination';
import { listarEventosKanban, listarEventosPaginado, filtrosDaUrl } from '../../server/eventos';
import { INTERVALOS_KANBAN, intervaloKanbanDoForm, salvarIntervaloKanban } from '../../server/configuracoes';
import { handleFormPost } from '../../lib/actions';
import { isAdmin } from '../../lib/auth';
import { UserError } from '../../lib/forms';
import { carregarIntervaloKanban, listarFormatosServico, listarStatus, listarTiposEvento } from '../../server/configuracoes';
import { ROTULOS } from '../../lib/rotulos';
import EstadoVazio from '../../components/ui/EstadoVazio.astro';
import EtapaDialogo from '../../components/eventos/EtapaDialogo.astro';
import { lerOrdenacao } from '../../lib/ordenacao';

const { tenantId } = Astro.locals.user;
const url = Astro.url;

// Intervalo de trabalho alterável no próprio funil (UX-052); vale para a empresa toda, só admin
if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    if (data._action !== 'intervalo') return '';
    if (!isAdmin(Astro.locals.user)) throw new UserError('Só administradores alteram o intervalo de trabalho.');
    const meses = intervaloKanbanDoForm(data.kanban_intervalo_meses);
    await withTenant(Astro.locals.user.tenantId, (db) => salvarIntervaloKanban(db, meses));
    return 'Intervalo de trabalho salvo.';
  });
}
const visao = url.searchParams.get('view') === 'lista' ? 'lista' : 'kanban';
const filtros = filtrosDaUrl(url, searchTerm(url));
const page = pageParams(url);

const dados = await withTenant(tenantId, async (db) => {
  const [status, tipos, formatos] = [await listarStatus(db), await listarTiposEvento(db, null), await listarFormatosServico(db)];
  if (visao === 'kanban') {
    const intervaloMeses = await carregarIntervaloKanban(db);
    const cards = await listarEventosKanban(db, { ...filtros, intervaloMeses });
    return { status, tipos, formatos, cards, lista: null, intervaloMeses };
  }
  return { status, tipos, formatos, cards: [], lista: await listarEventosPaginado(db, filtros, page, lerOrdenacao(url)), intervaloMeses: null };
});

const filtrosAtivos = [filtros.de || filtros.ate, filtros.tipoId, filtros.formatoId, filtros.statusId].filter(Boolean).length;
const recorteManual = Boolean(filtros.de || filtros.ate);
const recorteTexto = recorteManual
  ? `Filtro de datas: ${filtros.de ? dataCurta(filtros.de) : 'início'} a ${filtros.ate ? dataCurta(filtros.ate) : 'sem fim'}`
  : dados.intervaloMeses
    ? `Intervalo de trabalho: ${dados.intervaloMeses} ${dados.intervaloMeses === 1 ? 'mês' : 'meses'}, de hoje até ${dataCurta(somarMeses(hojeSaoPaulo(), dados.intervaloMeses))} (eventos sem data também aparecem)`
    : 'Intervalo de trabalho: sem limite de datas';
const podeConfigurar = Astro.locals.user.role === 'owner' || Astro.locals.user.role === 'admin';
const exportarHref = withQuery(new URL(`${url.origin}/eventos/exportar${url.search}`), { view: null, page: null });
const pad = (n: number) => String(n).padStart(2, '0');
// Etapa sem cor cadastrada usa a cor de entrada do design system
const COR_ETAPA_PADRAO = 'var(--stage-new)';
// Tom da etiqueta do tipo de evento (EventCard do design system)
const tomDoTipo = (nome: string) => (nome === 'Corporativo' ? 'tag-cobalt' : nome === 'Religioso' ? 'tag-ochre' : null);
// Chips dos filtros ativos, cada um com o seu × (UX-105)
const chipsFiltros = [
  filtros.busca && { rotulo: `Busca: ${url.searchParams.get('q')}`, href: withQuery(url, { q: null, page: null }) },
  (filtros.de || filtros.ate) && {
    rotulo: `Período: ${filtros.de ? dataCurta(filtros.de) : 'início'} → ${filtros.ate ? dataCurta(filtros.ate) : 'sem fim'}`,
    href: withQuery(url, { de: null, ate: null, page: null }),
  },
  filtros.tipoId && {
    rotulo: `${ROTULOS.tipoEvento}: ${dados.tipos.find((t) => t.id === filtros.tipoId)?.nome ?? ''}`,
    href: withQuery(url, { tipo: null, page: null }),
  },
  filtros.formatoId && {
    rotulo: `${ROTULOS.formatoServico}: ${dados.formatos.find((f) => f.id === filtros.formatoId)?.nome ?? ''}`,
    href: withQuery(url, { formato: null, page: null }),
  },
  filtros.statusId && {
    rotulo: `${ROTULOS.etapa}: ${dados.status.find((s) => s.id === filtros.statusId)?.nome ?? ''}`,
    href: withQuery(url, { status: null, page: null }),
  },
].filter((c): c is { rotulo: string; href: string } => Boolean(c));
const diasNaEtapa = (c: Card) => Math.floor((Date.now() - new Date(c.etapa_desde).getTime()) / 86_400_000);
type Card = (typeof dados.cards)[number];
// Verba estimada só conta quando o evento ainda não tem orçamento; os dois totais nunca se misturam
const verbaSemOrcamento = (c: Card) => (c.valor_orcamento === null ? (c.verba_total ?? 0) : 0);
// Posição de cada card na ordem do servidor (data do evento): ao mover, o card entra no mesmo lugar em que estará após recarregar
const ordem = new Map(dados.cards.map((c, i) => [c.id, i]));

// Filtro de etapa no funil: mostra só a coluna escolhida (UX-105)
const statusVisiveis = filtros.statusId ? dados.status.filter((s) => s.id === filtros.statusId) : dados.status;
const colunas = statusVisiveis.map((s) => {
  const cards = dados.cards.filter((c) => c.status_id === s.id);
  return {
    ...s,
    cards,
    total: cards.reduce((acc, c) => acc + (c.valor_orcamento ?? 0), 0),
    verba: cards.reduce((acc, c) => acc + verbaSemOrcamento(c), 0),
  };
});

const listaData =
  dados.lista?.rows.map((e) => ({
    data: dataCurta(e.data_evento),
    evento: html`<a class="link" href="/eventos/${e.id}">${e.titulo ?? 'Evento'}</a>`,
    cliente: e.cliente_nome ?? '-',
    convidados: e.numero_convidados ?? '-',
    status: html`<span class="status-name"><span class="dot" style="background:${e.status_cor ?? COR_ETAPA_PADRAO}"></span>${e.status_nome}</span>`,
    valor:
      e.valor_orcamento !== null
        ? formatMoney(e.valor_orcamento)
        : e.verba_total !== null
          ? html`<span class="verba" title="Verba estimada pelo cliente (ainda sem orçamento)">${formatMoney(e.verba_total)}</span>`
          : '-',
    acoes: html`<a class="row-action" href="/eventos/${e.id}">Abrir</a>`,
  })) ?? [];
const filtrando = estaFiltrando(Astro.url);
---

<AppLayout title={ROTULOS.funil} heading={ROTULOS.funil}>
  <div class="funil-toolbar">
    <PageToolbar searchPlaceholder="Pesquisar">
      <nav class="segmented funil-visao" aria-label="Visualização">
        <a href={withQuery(url, { view: 'lista', page: null })} class:list={{ active: visao === 'lista' }} aria-current={visao === 'lista' ? 'page' : undefined}>
          <Icon name="list" size={16} /> Lista
        </a>
        <a href={withQuery(url, { view: null, page: null })} class:list={{ active: visao === 'kanban' }} aria-current={visao === 'kanban' ? 'page' : undefined}>
          <Icon name="layout-kanban" size={16} /> Kanban
        </a>
      </nav>
      <details class="filtros">
        <summary class="btn btn-secondary btn-md"><Icon name="filter" size={16} /> Filtros{filtrosAtivos > 0 && ` (${filtrosAtivos})`}</summary>
        <form method="get" class="filtros-painel">
          {visao === 'lista' && <input type="hidden" name="view" value="lista" />}
          {filtros.busca && <input type="hidden" name="q" value={url.searchParams.get('q') ?? ''} />}
          <div class="datas-linha">
            <div class="field">
              <label for="f-de">Data de</label>
              <input id="f-de" type="date" name="de" value={filtros.de ?? ''} />
            </div>
            <div class="field">
              <label for="f-ate">Até</label>
              <input id="f-ate" type="date" name="ate" value={filtros.ate ?? ''} />
            </div>
          </div>
          <div class="field">
            <label for="f-tipo">Tipo de evento</label>
            <select id="f-tipo" name="tipo">
              <option value="">Todos</option>
              {dados.tipos.map((t) => <option value={t.id} selected={t.id === filtros.tipoId}>{t.nome}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-formato">Formato de serviço</label>
            <select id="f-formato" name="formato">
              <option value="">Todos</option>
              {dados.formatos.map((f) => <option value={f.id} selected={f.id === filtros.formatoId}>{f.nome}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-status">{ROTULOS.etapa}</label>
            <select id="f-status" name="status">
              <option value="">Todas</option>
              {dados.status.map((s) => <option value={s.id} selected={s.id === filtros.statusId}>{s.nome}</option>)}
            </select>
          </div>
          <div class="filtros-acoes">
            <a href={visao === 'lista' ? '/eventos?view=lista' : '/eventos'} class="btn btn-secondary btn-md">Limpar</a>
            <button type="submit" class="btn btn-primary btn-md">Aplicar</button>
          </div>
        </form>
      </details>
      <Button variant="secondary" icon="download" href={exportarHref}>Exportar CSV</Button>
      <Button variant="primary" icon="circle-plus" href="/eventos/novo">Novo evento</Button>
    </PageToolbar>
  </div>

  {chipsFiltros.length > 0 && (
    <div class="chips-filtros" aria-label="Filtros ativos">
      {chipsFiltros.map((c) => (
        <a class="chip-filtro" href={c.href} title="Remover este filtro">
          {c.rotulo}
          <Icon name="x" size={14} />
        </a>
      ))}
      <a class="chip-filtro limpar" href={visao === 'lista' ? '/eventos?view=lista' : '/eventos'}>Limpar tudo</a>
    </div>
  )}

  {visao === 'kanban' ? (
    <>
    <div class="recorte" data-recorte>
      <Icon name="calendar" size={15} />
      <span>{recorteTexto}</span>
      {recorteManual ? (
        <a href="/eventos" class="link recorte-link">Voltar ao intervalo de trabalho</a>
      ) : podeConfigurar ? (
        <form method="post" class="recorte-form">
          <input type="hidden" name="_action" value="intervalo" />
          <label class="sr-only" for="kanban-intervalo">Intervalo de trabalho</label>
          <select id="kanban-intervalo" name="kanban_intervalo_meses" class="inline-select" data-autosubmit-row>
            {INTERVALOS_KANBAN.map((m) => (
              <option value={String(m)} selected={dados.intervaloMeses === m}>{m === 1 ? '1 mês' : `${m} meses`}</option>
            ))}
            <option value="" selected={dados.intervaloMeses === null}>Sem limite</option>
          </select>
        </form>
      ) : null}
    </div>
    <div class="kanban-etapas" data-kanban-etapas role="tablist" aria-label="Etapas do funil">
      {colunas.map((col, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          class:list={['kanban-etapa-chip', { ativa: i === 0 }]}
          data-etapa-chip={col.id}
        >
          <span class="dot" style={`background:${col.cor ?? COR_ETAPA_PADRAO}`}></span>
          {col.nome}
          <span class="kanban-etapa-qtd" data-chip-contagem>{col.cards.length}</span>
        </button>
      ))}
    </div>
    <div class="kanban" data-kanban>
      {colunas.map((col, i) => (
        <section class:list={['kanban-col', { 'mobile-ativa': i === 0 }]} data-coluna={col.id} data-status-nome={col.nome} data-variante={col.variante}>
          {/* Cabeçalho = KanbanColumn do design system: faixa de 3px no topo na cor da etapa */}
          <header class="kanban-col-header" style={`--etapa:${col.cor ?? COR_ETAPA_PADRAO}`}>
            <h2 class="kanban-col-titulo">
              <span class="dot" style={`background:${col.cor ?? COR_ETAPA_PADRAO}`}></span>
              <span class="kanban-col-nome">{col.nome}</span>
            </h2>
            <span class="kanban-col-meta">
              <span data-contagem>{pad(col.cards.length)} {col.cards.length === 1 ? 'evento' : 'eventos'}</span>
              <span data-soma title="Soma dos orçamentos">{formatMoney(col.total)}</span>
            </span>
            <span class="kanban-col-verba" data-verba-total hidden={col.verba === 0}>+ {formatMoney(col.verba)} em verba estimada</span>
          </header>
          <div class="kanban-cards" data-dropzone>
            {col.cards.map((c) => (
              <article class="evento-card" draggable="true" data-evento={c.id} data-ordem={ordem.get(c.id)} data-valor={c.valor_orcamento ?? 0} data-verba={verbaSemOrcamento(c)}>
                <div class="evento-card-topo">
                  <span class="evento-card-icone"><Icon name={c.cliente_tipo === 'PJ' ? 'building' : 'user-square'} size={16} /></span>
                  <div class="evento-card-titulos">
                    <h3 class="evento-card-title">
                      {/* O link cobre o card inteiro (::after): clicar em qualquer ponto abre o resumo */}
                      <a href={`/eventos/${c.id}`} class="evento-card-link" draggable="false">{c.categoria_nome ?? c.titulo ?? 'Evento'}</a>
                    </h3>
                    <p class="evento-card-sub">{c.cliente_nome ?? 'Sem cliente'}</p>
                  </div>
                </div>
                <details class="card-menu" data-card-menu>
                  <summary aria-label={`Ações do evento ${c.titulo ?? ''}`}><Icon name="dots" size={16} /></summary>
                  <div class="card-menu-lista">
                    <a href={`/eventos/${c.id}/editar`}><Icon name="pencil" size={16} /> Editar</a>
                    <a href={`/eventos/${c.id}/orcamento`}><Icon name="file-dollar" size={16} /> {c.valor_orcamento !== null ? 'Abrir orçamento' : 'Orçamento'}</a>
                    <span class="card-menu-grupo">Mover para</span>
                    {dados.status.filter((st) => st.id !== c.status_id).map((st) => (
                      <button type="button" data-mover-para={st.id}>
                        <span class="dot" style={`background:${st.cor ?? COR_ETAPA_PADRAO}`}></span>{st.nome}
                      </button>
                    ))}
                  </div>
                </details>
                <dl class="evento-card-rows">
                  <div><dt>Pessoas</dt><dd class:list={{ vazio: c.numero_convidados === null }}>{c.numero_convidados ?? '—'}</dd></div>
                  <div><dt>{ROTULOS.formatoServico}</dt><dd class:list={{ vazio: !c.formato_nome }}>{c.formato_nome ?? '—'}</dd></div>
                  {c.valor_orcamento !== null ? (
                    <div><dt>Orçamento</dt><dd>{formatMoney(c.valor_orcamento)}</dd></div>
                  ) : (
                    <div class="verba"><dt>{ROTULOS.verbaEstimada}</dt><dd class:list={{ vazio: c.verba_total === null }}>{c.verba_total !== null ? formatMoney(c.verba_total) : '—'}</dd></div>
                  )}
                  <div><dt>Data</dt><dd class:list={{ vazio: !c.data_evento }}>{c.data_evento ? dataCurta(c.data_evento) : '—'}</dd></div>
                </dl>
                <div class="tag-list">
                  {[c.tipo_nome].filter(Boolean).map((t) => <span class:list={['tag', 'tag-sm', tomDoTipo(t!)]}>{t}</span>)}
                  {diasNaEtapa(c) >= 3 && (
                    <span class:list={['tag', 'tag-sm', 'selo-etapa', { 'tag-accent': diasNaEtapa(c) >= 7, alerta: diasNaEtapa(c) >= 7 }]}>
                      <Icon name="clock" size={12} /> há {diasNaEtapa(c)} dias nesta etapa
                    </span>
                  )}
                </div>
              </article>
            ))}
            <p class="kanban-vazio">Nenhum evento</p>
          </div>
        </section>
      ))}
    </div>
    </>
  ) : (
    <Table
      columns={[
        { key: 'data', label: 'Data', ordenar: 'data' },
        { key: 'evento', label: 'Evento', ordenar: 'evento' },
        { key: 'cliente', label: 'Cliente', ordenar: 'cliente' },
        { key: 'convidados', label: 'Convidados', align: 'center', ordenar: 'convidados' },
        { key: 'status', label: ROTULOS.etapa, ordenar: 'etapa' },
        { key: 'valor', label: 'Orçamento', align: 'right', ordenar: 'valor' },
        { key: 'acoes', label: 'Ações', align: 'right' },
      ]}
      data={listaData}
    >
      <EstadoVazio slot="empty" icon="calendar-off" titulo={filtrando ? 'Nenhum evento para estes filtros' : 'Nenhum evento ainda'} texto={filtrando ? undefined : 'Os pedidos chegam pelo formulário de captação ou pelo cadastro manual.'}>
        {filtrando ? <a class="btn btn-secondary btn-md" href="/eventos?view=lista">Limpar filtros</a> : <a class="btn btn-primary btn-md" href="/eventos/novo">Novo evento</a>}
      </EstadoVazio>
      {dados.lista && <Pagination slot="footer" info={pageInfo(page, dados.lista.total)} />}
    </Table>
  )}
  <EtapaDialogo slot="overlays" />
</AppLayout>

<script>
  import { formatMoney } from '../../lib/money';
  import { toast } from '../../lib/ui';

  const kanban = document.querySelector<HTMLElement>('[data-kanban]');
  if (kanban) {
    // Celular: os chips mostram uma etapa por vez (no desktop ficam escondidos e todas as colunas aparecem)
    document.querySelectorAll<HTMLButtonElement>('[data-etapa-chip]').forEach((chip) =>
      chip.addEventListener('click', () => {
        document.querySelectorAll<HTMLElement>('[data-etapa-chip]').forEach((c) => {
          c.classList.toggle('ativa', c === chip);
          c.setAttribute('aria-selected', String(c === chip));
        });
        kanban.querySelectorAll<HTMLElement>('.kanban-col').forEach((col) =>
          col.classList.toggle('mobile-ativa', col.dataset.coluna === chip.dataset.etapaChip)
        );
      })
    );

    const atualizarTotais = () => {
      kanban.querySelectorAll<HTMLElement>('.kanban-col').forEach((col) => {
        const cards = [...col.querySelectorAll<HTMLElement>('[data-evento]')];
        col.querySelector('[data-contagem]')!.textContent = `${String(cards.length).padStart(2, '0')} ${cards.length === 1 ? 'evento' : 'eventos'}`;
        const chipQtd = document.querySelector(`[data-etapa-chip="${col.dataset.coluna}"] [data-chip-contagem]`);
        if (chipQtd) chipQtd.textContent = String(cards.length);
        col.querySelector('[data-soma]')!.textContent = formatMoney(cards.reduce((a, c) => a + Number(c.dataset.valor || 0), 0));
        const verba = cards.reduce((a, c) => a + Number(c.dataset.verba || 0), 0);
        const verbaEl = col.querySelector<HTMLElement>('[data-verba-total]')!;
        verbaEl.hidden = verba === 0;
        verbaEl.textContent = `+ ${formatMoney(verba)} em verba estimada`;
      });
    };

    // Insere o card na posição da ordem do servidor (por data), não onde o mouse soltou
    const inserirNaOrdem = (zona: HTMLElement, card: HTMLElement) => {
      const pos = Number(card.dataset.ordem);
      const depois = [...zona.querySelectorAll<HTMLElement>('[data-evento]')].find((c) => c !== card && Number(c.dataset.ordem) > pos);
      zona.insertBefore(card, depois ?? zona.querySelector('.kanban-vazio'));
    };

    // Move o card (arrastando ou pelo menu "Mover para"); desfaz se o servidor recusar.
    // Etapas de fechamento pedem complemento (motivo da perda / data) antes de mover.
    async function mover(card: HTMLElement, coluna: HTMLElement) {
      const deOrigem = card.parentElement!;
      const zona = coluna.querySelector<HTMLElement>('[data-dropzone]')!;
      if (zona === deOrigem) return;
      const extras = await window.banketEtapaExtras?.(coluna.dataset.variante ?? '');
      if (extras === null) return;
      inserirNaOrdem(zona, card);
      atualizarTotais();
      atualizarMenu(card, coluna);
      try {
        const res = await fetch(`/api/eventos/${card.dataset.evento}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status_id: coluna.dataset.coluna, ...extras }),
        });
        if (!res.ok) throw new Error((await res.json()).error ?? 'Erro ao mover');
        toast(`Evento movido para "${coluna.dataset.statusNome}".`, 'success');
      } catch (err) {
        inserirNaOrdem(deOrigem, card);
        atualizarTotais();
        atualizarMenu(card, deOrigem.closest<HTMLElement>('[data-coluna]')!);
        toast(err instanceof Error ? err.message : 'Erro ao mover o evento.', 'error');
      }
    }

    // O menu lista as outras etapas: depois de mover, a etapa atual sai da lista e a anterior volta
    const etapas = [...kanban.querySelectorAll<HTMLElement>('[data-coluna]')].map((col) => ({
      id: col.dataset.coluna!,
      nome: col.dataset.statusNome!,
      cor: col.querySelector<HTMLElement>('.kanban-col-titulo .dot')?.style.background ?? '',
    }));
    function atualizarMenu(card: HTMLElement, coluna: HTMLElement) {
      const lista = card.querySelector('.card-menu-lista')!;
      lista.querySelectorAll('[data-mover-para]').forEach((b) => b.remove());
      for (const etapa of etapas.filter((e) => e.id !== coluna.dataset.coluna)) {
        const botao = document.createElement('button');
        botao.type = 'button';
        botao.dataset.moverPara = etapa.id;
        const dot = document.createElement('span');
        dot.className = 'dot';
        dot.style.background = etapa.cor;
        botao.append(dot, etapa.nome);
        lista.appendChild(botao);
      }
    }

    kanban.addEventListener('click', (e) => {
      const botao = (e.target as HTMLElement).closest<HTMLElement>('[data-mover-para]');
      if (!botao) return;
      const card = botao.closest<HTMLElement>('[data-evento]')!;
      card.querySelector('details')!.open = false;
      mover(card, kanban.querySelector<HTMLElement>(`[data-coluna="${botao.dataset.moverPara}"]`)!);
    });
    // Um menu aberto por vez; fecha ao clicar fora ou com Esc
    document.addEventListener('click', (e) => {
      kanban.querySelectorAll<HTMLDetailsElement>('[data-card-menu][open]').forEach((d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      kanban.querySelectorAll<HTMLDetailsElement>('[data-card-menu][open]').forEach((d) => {
        d.open = false;
        d.querySelector('summary')?.focus();
      });
    });

    let arrastando: HTMLElement | null = null;
    let origem: HTMLElement | null = null;

    kanban.addEventListener('dragstart', (e) => {
      arrastando = (e.target as HTMLElement).closest<HTMLElement>('[data-evento]');
      if (!arrastando) return;
      origem = arrastando.parentElement;
      arrastando.classList.add('arrastando');
      e.dataTransfer?.setData('text/plain', arrastando.dataset.evento!);
    });
    kanban.addEventListener('dragend', () => {
      arrastando?.classList.remove('arrastando');
      kanban.querySelectorAll('.drop-alvo').forEach((el) => el.classList.remove('drop-alvo'));
    });
    kanban.addEventListener('dragover', (e) => {
      const zona = (e.target as HTMLElement).closest<HTMLElement>('[data-dropzone]');
      if (!zona || !arrastando) return;
      e.preventDefault();
      kanban.querySelectorAll('.drop-alvo').forEach((el) => el !== zona && el.classList.remove('drop-alvo'));
      zona.classList.add('drop-alvo');
    });
    kanban.addEventListener('drop', async (e) => {
      const zona = (e.target as HTMLElement).closest<HTMLElement>('[data-dropzone]');
      if (!zona || !arrastando || zona === origem) return;
      e.preventDefault();
      mover(arrastando, zona.closest<HTMLElement>('[data-coluna]')!);
    });
  }
</script>


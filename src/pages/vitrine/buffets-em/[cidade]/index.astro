---
// Página do local (/buffets-em/sao-paulo-sp/): todos os buffets da cidade, com links para categorias e bairros.
import PaginaLocal from '../../../../components/busca/PaginaLocal.astro';
import { resolverPagina } from '../../../../server/busca/locais';
import { caminhoVitrine } from '../../../../lib/busca/url';

const r = await resolverPagina(Astro.url, { cidade: Astro.params.cidade });
if (r.acao === 'nao-existe') return new Response(null, { status: 404 });
if (r.acao === 'redirecionar') return Astro.redirect(caminhoVitrine(r.caminho), 301);
---

<PaginaLocal dados={r} />

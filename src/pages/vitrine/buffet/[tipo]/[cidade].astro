---
// Landing antiga /buffet/[tipo-de-evento]/[cidade] (até 10/11/2026): 301 para a página de categoria × cidade
// (/buffet-para-casamento/campinas-sp/) ou, para tipos sem categoria, para a página do local (/buffets-em/campinas-sp/).
import { caminhoVitrine } from '../../../../lib/busca/url';
import { tipoDaUrl } from '../../../../lib/busca/filtros';
import { caminhoCategoria, caminhoLocal, categoriaDoTipo } from '../../../../lib/busca/categorias';
import { resolverCidade } from '../../../../server/busca/publico';

const tipo = tipoDaUrl(Astro.params.tipo ?? '');
const cidade = tipo ? await resolverCidade(Astro.params.cidade ?? null) : null;
if (!tipo || !cidade) return new Response(null, { status: 404 });
const cat = categoriaDoTipo(tipo);
return Astro.redirect(caminhoVitrine(cat ? caminhoCategoria(cat, cidade.slug) : caminhoLocal(cidade.slug)), 301);
---

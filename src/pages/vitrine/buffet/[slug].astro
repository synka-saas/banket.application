---
// Perfil público do buffet (layout-busca/BuscaPerfil). Sem preço em lugar nenhum (decisão de 16/10/2026). Cliente
// Banket: selo, cardápios (opções de cardápio do catálogo do app) e disponibilidade pela agenda. Gratuito: até 5 fotos
// e "Consultar disponibilidade". Fotos em grupos (tags, planos pagos) aparecem separadas por evento.
import VitrineLayout from '../../../layouts/VitrineLayout.astro';
import Estrelas from '../../../components/busca/Estrelas.astro';
import Icon from '../../../components/ui/Icon.astro';
import { rotuloEvento, rotuloRestricao, rotuloServico } from '../../../lib/busca/catalogos';
import { FOTO_PADRAO, buscaUrl, caminhoVitrine } from '../../../lib/busca/url';
import { queryDaBusca } from '../../../lib/busca/filtros';
import { jsonLdPerfil } from '../../../lib/busca/seo';
import { perfilCompleto, registrarMetrica } from '../../../server/busca/publico';
import { cachePublico, criteriosDaUrl } from '../../../server/busca/vitrine';
import { lerTokenSessao, verifySession } from '../../../lib/auth';
import { getMembership } from '../../../lib/membership';
import { appUrl } from '../../../lib/mail';
import { mascararTelefone } from '../../../lib/mascaras';

const criterios = criteriosDaUrl(Astro.url);
// Prévia (?previa=1): só para quem está logado na empresa dona do perfil; sem cache e fora do índice
let previaDoTenant: string | null = null;
if (Astro.url.searchParams.get('previa') === '1') {
  const sessao = await verifySession(lerTokenSessao(Astro.cookies));
  if (sessao && (await getMembership(sessao.id, sessao.tenantId))) previaDoTenant = sessao.tenantId;
}
const p = await perfilCompleto(Astro.params.slug ?? '', criterios.data, previaDoTenant);
if (!p) return new Response(null, { status: 404 });
// Endereço antigo ou o id do perfil com endereço próprio: 301 para o endereço atual (mantém a busca e a prévia)
if (p.slug !== Astro.params.slug) {
  // A prévia fica no app (/vitrine/…); o perfil público, no endereço da vitrine
  const destino = previaDoTenant ? `/vitrine/buffet/${p.slug}` : buscaUrl(`/buffet/${p.slug}`);
  return Astro.redirect(`${destino}${Astro.url.search}`, 301);
}
const emPrevia = previaDoTenant != null && p.tenantId === previaDoTenant;
if (emPrevia) Astro.response.headers.set('Cache-Control', 'private, no-store');
else cachePublico(Astro.response.headers);
if (!emPrevia) await registrarMetrica([p.id], 'visualizacoes', Astro.request.headers.get('user-agent'));

const v = caminhoVitrine;
const busca = queryDaBusca({ tipo: criterios.tipo, cidade: criterios.cidade, data: criterios.data, convidados: criterios.convidados });
const nota = p.nota_media?.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const local = [p.bairro, p.cidade].filter(Boolean).join(', ');
const atendimento = p.espaco_proprio && p.atende_domicilio ? 'Espaço próprio e em domicílio' : p.espaco_proprio ? 'Espaço próprio' : p.atende_domicilio ? 'Em domicílio' : null;
const capacidade = p.capacidade_min && p.capacidade_max ? `${p.capacidade_min} a ${p.capacidade_max} convidados` : p.capacidade_max ? `Até ${p.capacidade_max} convidados` : null;
const dataBR = criterios.data?.split('-').reverse().join('/');
// Só fotos reais: a imagem padrão (fotos de demonstração) não conta como foto do buffet
const fotos = p.fotos.filter((f) => f.url !== FOTO_PADRAO);
// Galeria do topo: sem foto → imagem padrão sozinha; 1 foto → ela sozinha; da 2ª em diante, miniaturas (até 4)
const extras = fotos.slice(1, 5);
// Grupos de fotos (o primeiro grupo de cada foto); fotos sem grupo ficam em "Mais fotos"
const nomesGrupos = [...new Set(fotos.flatMap((f) => f.tags.slice(0, 1)))];
const gruposFotos = nomesGrupos.length
  ? [...nomesGrupos.map((g) => ({ nome: g, fotos: fotos.filter((f) => f.tags[0] === g) })), { nome: 'Mais fotos', fotos: fotos.filter((f) => !f.tags.length).slice(5) }].filter((g) => g.fotos.length)
  : fotos.length > 5 ? [{ nome: null as string | null, fotos: fotos.slice(5) }] : [];
const totalAv = Object.values(p.distribuicao).reduce((a, b) => a + b, 0);
const fatos = [
  capacidade && { icone: 'users', rotulo: 'Capacidade', valor: capacidade },
  atendimento && { icone: p.espaco_proprio ? 'building' : 'home', rotulo: 'Atendimento', valor: atendimento },
  p.tempo_resposta_texto && { icone: 'clock', rotulo: 'Resposta', valor: p.tempo_resposta_texto },
  // Serviços numa linha própria: a lista costuma ser longa e espremia a coluna
  p.tipos_servico.length > 0 && { icone: 'tools-kitchen-2', rotulo: 'Serviços', valor: p.tipos_servico.map(rotuloServico).join(', '), largo: true },
].filter(Boolean) as { icone: string; rotulo: string; valor: string; largo?: boolean }[];
const ld = jsonLdPerfil({
  nome: p.nome, slug: p.slug, descricao: p.descricao, url: buscaUrl(`/buffet/${p.slug}`), logo: p.logo ? buscaUrl(p.logo) : null,
  fotos: fotos.map((f) => buscaUrl(f.url)), cidade: p.cidade, uf: p.uf, bairro: p.bairro, notaMedia: p.nota_media,
  totalAvaliacoes: p.total_avaliacoes, avaliacoes: p.avaliacoes,
});
const descricaoSeo = (p.descricao ?? `Buffet em ${local}.`).slice(0, 155);
// Pedido de orçamento: buffet pagante (plano pago ou teste) com formulário abre o formulário dele num modal (o pedido cai
// no kanban do buffet); os demais mostram os contatos. O formulário fica no host do app e já recebe o que veio da busca.
const urlFormulario = p.formularioSlug
  ? appUrl(`/f/${p.formularioSlug}`) + '?' + new URLSearchParams(Object.entries({
      busca: p.id, tipo: criterios.tipo ?? '', data: criterios.data ?? '', convidados: criterios.convidados ? String(criterios.convidados) : '',
    }).filter(([, valor]) => valor)).toString()
  : null;
const digitos = (v: string | null | undefined) => (v ?? '').replace(/\D/g, '');
const contatos = p.contatos
  ? [
      digitos(p.contatos.whatsapp).length >= 10 && { icone: 'brand-whatsapp', rotulo: 'WhatsApp', valor: mascararTelefone(p.contatos.whatsapp!), href: `https://wa.me/55${digitos(p.contatos.whatsapp)}`, externo: true },
      digitos(p.contatos.telefone).length >= 10 && { icone: 'phone', rotulo: 'Telefone', valor: mascararTelefone(p.contatos.telefone!), href: `tel:+55${digitos(p.contatos.telefone)}`, externo: false },
      p.contatos.email && { icone: 'mail', rotulo: 'E-mail', valor: p.contatos.email, href: `mailto:${p.contatos.email}`, externo: false },
      p.contatos.instagram && {
        icone: 'brand-instagram', rotulo: 'Instagram', valor: p.contatos.instagram.startsWith('http') ? p.contatos.instagram.replace(/^https?:\/\/(www\.)?/, '') : p.contatos.instagram,
        href: p.contatos.instagram.startsWith('http') ? p.contatos.instagram : `https://instagram.com/${p.contatos.instagram.replace(/^@/, '')}`, externo: true,
      },
      p.contatos.site && { icone: 'world', rotulo: 'Site', valor: p.contatos.site.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: /^https?:\/\//.test(p.contatos.site) ? p.contatos.site : `https://${p.contatos.site}`, externo: true },
    ].filter(Boolean) as { icone: string; rotulo: string; valor: string; href: string; externo: boolean }[]
  : [];
const fmtData = (d: Date | string) => new Date(d).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric', timeZone: 'America/Sao_Paulo' });
---

<VitrineLayout title={`${p.nome}${p.cidade ? ` · Buffet em ${p.cidade}` : ''}`} description={descricaoSeo} canonical={`/buffet/${p.slug}`} imagem={fotos[0]?.url ?? FOTO_PADRAO} jsonLd={emPrevia ? [] : [ld]} noindex={emPrevia}>
  {emPrevia && (
    <div class="vp-previa" role="status">
      <Icon name="eye" size={16} /> <span>Prévia do seu perfil{p.publicado ? '' : ' · ainda não publicado, só você vê esta página'}.</span>
      <a href="/busca?etapa=6">Voltar ao cadastro</a>
    </div>
  )}
  <div class="vitrine-secao" style="padding-top:16px">
    <a class="voltar" href={v('/buscar') + busca} data-voltar-busca><Icon name="arrow-left" size={16} /> Voltar aos resultados</a>

    {fotos.length > 0 ? (
      <div class={`vp-galeria vp-galeria--${Math.min(fotos.length, 5)}`}>
        <div class="vp-galeria-principal"><img src={fotos[0].url} alt={fotos[0].legenda ?? `Foto de ${p.nome}`} width="900" height="675" /></div>
        {extras.map((f) => <div class="vp-galeria-extra"><img src={f.url} alt={f.legenda ?? ''} loading="lazy" width="450" height="200" /></div>)}
      </div>
    ) : (
      <div class="vp-galeria vp-galeria--1">
        <div class="vp-galeria-principal"><img src={FOTO_PADRAO} alt="" width="1200" height="900" /></div>
      </div>
    )}

    <header class="vp-cabeca">
      <h1 class="vp-nome">
        {p.nome}
        {p.selo && <span class="bcard-selo" title="Usa o Banket para gerenciar eventos e orçamentos"><img src="/logo-mark.png" alt="" width="14" height="14" />Cliente Banket</span>}
      </h1>
      <p class="vp-meta">
        {nota ? <span class="bcard-nota"><Icon name="star" size={16} class="bcard-estrela" />{nota}</span> : null}
        {p.total_avaliacoes > 0 ? <a href="#avaliacoes">{p.total_avaliacoes} {p.total_avaliacoes === 1 ? 'avaliação' : 'avaliações'}</a> : <span>Sem avaliações</span>}
        {local && <><span class="bcard-sep" aria-hidden="true">·</span><span>{local}</span></>}
        {atendimento && <><span class="bcard-sep" aria-hidden="true">·</span><span>{atendimento}</span></>}
      </p>
    </header>

    <div class="vp-layout">
      <div style="display:flex;flex-direction:column;gap:16px;min-width:0">
        <section class="vp-secao" aria-labelledby="h-sobre">
          <h2 id="h-sobre">Sobre o buffet</h2>
          {p.descricao && <p>{p.descricao}</p>}
          {fatos.length > 0 && (
            <ul class="vp-fatos">
              {fatos.map((f) => <li class:list={['vp-fato', { 'vp-fato--largo': f.largo }]}><span class="vp-fato-ico"><Icon name={f.icone} size={18} /></span><span><small>{f.rotulo}</small>{f.valor}</span></li>)}
            </ul>
          )}
        </section>

        <section class="vp-secao" aria-labelledby="h-eventos">
          <h2 id="h-eventos">Tipos de evento atendidos</h2>
          <ul class="vp-tags">{p.tipos_evento.map((t) => <li class="tag">{rotuloEvento(t)}</li>)}</ul>
          {p.restricoes.length > 0 && (
            <>
              <h2 style="margin-top:16px;font-size:var(--fs-15)">Opções de cardápio</h2>
              <ul class="vp-tags">{p.restricoes.map((r) => <li class="tag tag-sage">{rotuloRestricao(r)}</li>)}</ul>
            </>
          )}
        </section>

        {p.cardapios.length > 0 && (
          <section class="vp-secao" aria-labelledby="h-cardapios">
            <h2 id="h-cardapios">Cardápios</h2>
            <p style="margin-bottom:12px;color:var(--text-secondary)">Opções de cardápio do buffet. Peça um orçamento para montar o seu.</p>
            <ul class="vp-pacotes">
              {p.cardapios.map((k) => (
                <li class="vp-pacote">
                  <div class="vp-pacote-cabeca"><h3>{k.nome}</h3></div>
                  {k.descricao && <p>{k.descricao}</p>}
                  <details class="vp-cardapio">
                    <summary>Ver cardápio</summary>
                    {k.secoes.map((sec) => (
                      <>
                        <h4>{sec.titulo}{sec.escolha ? ` · escolha ${sec.escolha}` : ''}</h4>
                        <ul>{sec.itens.map((i) => <li>{i.nome}{i.restricoes.length ? ` (${i.restricoes.map(rotuloRestricao).join(', ').toLowerCase()})` : ''}</li>)}</ul>
                      </>
                    ))}
                  </details>
                  {urlFormulario && <button type="button" class="btn btn-outline btn-sm" style="align-self:flex-start" data-abrir-orcamento>Obter orçamento</button>}
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="vp-secao" aria-labelledby="h-area">
          <h2 id="h-area">Área de atendimento</h2>
          <ul class="vp-fatos" style="margin-top:0">
            {p.espaco_proprio && (
              <li class="vp-fato"><span class="vp-fato-ico"><Icon name="building" size={18} /></span><span>Espaço próprio<small>{[p.logradouro && `${p.logradouro}${p.numero ? `, ${p.numero}` : ''}`, local].filter(Boolean).join(' · ')}</small></span></li>
            )}
            {p.atende_domicilio && (
              <li class="vp-fato"><span class="vp-fato-ico"><Icon name="home" size={18} /></span><span>Em domicílio{p.raio_km ? ` · até ${p.raio_km} km` : ''}<small>{p.capacidade_min ? `A partir de ${p.capacidade_min} convidados` : `A partir de ${p.cidade ?? 'sua cidade'}`}</small></span></li>
            )}
          </ul>
          {p.cidadesAtendidas.length > 0 && <ul class="vp-tags" style="margin-top:12px">{p.cidadesAtendidas.map((c) => <li class="tag"><Icon name="map-pin" size={13} />{c}</li>)}</ul>}
        </section>

        {gruposFotos.length > 0 && (
          <section class="vp-secao" aria-labelledby="h-fotos" id="fotos">
            <h2 id="h-fotos">Fotos</h2>
            {gruposFotos.map((g) => (
              <>
                {g.nome && <h3 class="vp-fotos-grupo">{g.nome}</h3>}
                <ul class="vh-grade-cards vp-fotos-grade">
                  {g.fotos.map((f) => <li><img src={f.url} alt={f.legenda ?? g.nome ?? ''} loading="lazy" width="320" height="240" /></li>)}
                </ul>
              </>
            ))}
          </section>
        )}

        <section class="vp-secao" id="avaliacoes" aria-labelledby="h-avaliacoes">
          <h2 id="h-avaliacoes">Avaliações</h2>
          {totalAv === 0 ? (
            <p style="color:var(--text-secondary)">Este buffet ainda não recebeu avaliações. Só quem pediu orçamento pelo Banket Busca pode avaliar.</p>
          ) : (
            <div class="vp-avaliacoes">
              <div class="vp-resumo-nota">
                <span class="vp-nota-grande tabular">{nota}</span>
                <Estrelas nota={p.nota_media} tamanho={16} />
                <span class="vr-meta">de 5 · {p.total_avaliacoes} {p.total_avaliacoes === 1 ? 'avaliação' : 'avaliações'}</span>
                {([5, 4, 3, 2, 1] as const).map((n) => (
                  <div class="vp-barra" aria-label={`${p.distribuicao[n]} avaliações com nota ${n}`}>
                    <span>{n}</span><span class="vp-barra-trilho"><span style={`width:${totalAv ? (p.distribuicao[n] / totalAv) * 100 : 0}%`}></span></span><span class="tabular">{p.distribuicao[n]}</span>
                  </div>
                ))}
              </div>
              <ul class="vp-lista-av">
                {p.avaliacoes.map((a) => (
                  <li class="vp-av">
                    <div class="vp-av-cabeca"><span><strong>{a.nome}</strong> · {rotuloEvento(a.tipoEvento)} · {fmtData(a.data)}</span><Estrelas nota={a.nota} tamanho={13} /></div>
                    {a.texto && <p>{a.texto}</p>}
                    {a.resposta && <div class="vp-av-resposta"><strong>Resposta do buffet · </strong>{a.resposta}</div>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        {p.reivindicavel && (
          <section class="vp-reivindicar" aria-label="Para o dono deste buffet">
            <span class="vp-reivindicar-ico"><Icon name="building-store" size={20} /></span>
            <div>
              <strong>É o proprietário deste buffet?</strong>
              <p>Este perfil foi criado com informações públicas. Reivindique a propriedade para completar fotos, serviços e capacidade e receber pedidos de orçamento — ou peça a remoção.</p>
            </div>
            <a class="btn btn-secondary btn-md" href={caminhoVitrine(`/para-buffets/reivindicar/${encodeURIComponent(p.slug)}`)}>Reivindicar perfil</a>
          </section>
        )}
      </div>

      <aside class="vp-aside" aria-label={urlFormulario ? 'Pedir orçamento' : 'Contatos do buffet'}>
        <h2 class="vp-aside-titulo">{urlFormulario ? 'Peça um orçamento' : 'Fale com o buffet'}</h2>
        {p.disponibilidade === 'disponivel' && <span class="badge badge-success vp-disp"><span class="bcard-ponto" aria-hidden="true"></span>Disponível em {dataBR}</span>}
        {p.disponibilidade === 'indisponivel' && <span class="badge badge-warning vp-disp">Data ocupada na agenda em {dataBR}</span>}
        {p.disponibilidade === 'consultar' && <span class="badge vp-disp">Consultar disponibilidade</span>}
        {urlFormulario ? (
          <>
            <p class="vp-aside-texto">Conte como será o seu evento. O pedido vai direto para a equipe do buffet.</p>
            <button type="button" class="btn btn-primary btn-large btn-block" data-abrir-orcamento>Obter orçamento</button>
            <span class="vp-aside-nota">Grátis e sem compromisso{p.tempo_resposta_texto ? ` · ${p.tempo_resposta_texto.toLowerCase()}` : ''}</span>
          </>
        ) : (
          <>
            <p class="vp-aside-texto">Combine data, cardápio e valores direto com o buffet.</p>
            <button type="button" class="btn btn-primary btn-large btn-block" data-abrir-contatos>Ver contatos</button>
          </>
        )}
      </aside>
    </div>
  </div>

  <div class="vp-movel">
    <span class="vp-movel-nome">{p.nome}</span>
    {urlFormulario
      ? <button type="button" class="btn btn-primary btn-large" data-abrir-orcamento>Obter orçamento</button>
      : <button type="button" class="btn btn-primary btn-large" data-abrir-contatos>Ver contatos</button>}
  </div>

  {urlFormulario && (
    <dialog class="vp-modal vp-modal--form" aria-labelledby="vp-modal-orc" data-modal-orcamento data-src={urlFormulario}>
      <div class="vp-modal-cabeca">
        <span id="vp-modal-orc">Orçamento · {p.nome}</span>
        <button type="button" class="btn btn-ghost btn-sm" data-fechar-modal aria-label="Fechar"><Icon name="x" size={18} /></button>
      </div>
      <iframe class="vp-modal-frame" title={`Formulário de orçamento de ${p.nome}`} data-frame-orcamento></iframe>
    </dialog>
  )}
  {!urlFormulario && (
    <dialog class="vp-modal" aria-labelledby="vp-modal-contatos" data-modal-contatos>
      <div class="vp-modal-cabeca">
        <span id="vp-modal-contatos">Contatos · {p.nome}</span>
        <button type="button" class="btn btn-ghost btn-sm" data-fechar-modal aria-label="Fechar"><Icon name="x" size={18} /></button>
      </div>
      <div class="vp-modal-corpo">
        {contatos.length > 0 ? (
          <>
            <ul class="vp-contatos">
              {contatos.map((c) => (
                <li>
                  <a class="vp-contato" href={c.href} target={c.externo ? '_blank' : undefined} rel={c.externo ? 'noopener nofollow' : undefined}>
                    <span class="vp-fato-ico"><Icon name={c.icone} size={18} /></span>
                    <span><small>{c.rotulo}</small>{c.valor}</span>
                    <Icon name="external-link" size={16} class="vp-contato-seta" />
                  </a>
                </li>
              ))}
            </ul>
            <p class="vp-modal-nota">Diga que encontrou o buffet no Banket Busca.</p>
          </>
        ) : (
          <p class="vp-modal-nota">Este buffet ainda não informou contatos no Banket Busca.</p>
        )}
      </div>
    </dialog>
  )}
</VitrineLayout>

<script>
  // Voltar aos resultados com a busca completa (filtros, ordem e página guardados na sessão pela página de busca)
  const voltar = document.querySelector<HTMLAnchorElement>('[data-voltar-busca]');
  try {
    const ultima = sessionStorage.getItem('banket-busca-ultima');
    if (voltar && ultima) voltar.href = ultima;
  } catch {
    // sem armazenamento: fica o link com os critérios principais
  }

  // Modais: formulário de orçamento (carregado só ao abrir) e contatos
  const orcamento = document.querySelector<HTMLDialogElement>('[data-modal-orcamento]');
  const contatos = document.querySelector<HTMLDialogElement>('[data-modal-contatos]');
  document.addEventListener('click', (e) => {
    const alvo = e.target as HTMLElement;
    if (alvo.closest('[data-abrir-orcamento]') && orcamento) {
      const frame = orcamento.querySelector<HTMLIFrameElement>('[data-frame-orcamento]')!;
      if (!frame.src) frame.src = orcamento.dataset.src!;
      orcamento.showModal();
    } else if (alvo.closest('[data-abrir-contatos]') && contatos) {
      contatos.showModal();
    } else if (alvo.closest('[data-fechar-modal]')) {
      alvo.closest('dialog')?.close();
    } else if (alvo instanceof HTMLDialogElement) {
      alvo.close(); // clique no fundo
    }
  });
</script>

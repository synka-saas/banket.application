---
// Minha conta (UX-154): nome, telefone, troca de senha e as empresas a que a conta pertence.
import AppLayout from '../layouts/AppLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionCard from '../components/ui/SectionCard.astro';
import Icon from '../components/ui/Icon.astro';
import { handleFormPost } from '../lib/actions';
import { ROLE_LABELS } from '../lib/auth';
import { REGRA_SENHA } from '../lib/senha';
import { empresasDoUsuario } from '../server/autoatendimento';
import { atualizarPerfil, carregarPerfil, perfilSchema, trocarSenha } from '../server/conta';
import { contaGoogleDoUsuario, desvincularGoogle } from '../server/googleConta';
import { googleConfigurado } from '../lib/google';

const user = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    if (data._action === 'google_desvincular') {
      await desvincularGoogle(user.id);
      return 'Conta Google desvinculada. Para entrar, use e-mail e senha ou o link de acesso.';
    }
    if (data._action === 'senha') {
      await trocarSenha(user.id, String(data.senha_atual ?? ''), String(data.senha ?? ''), String(data.confirma_senha ?? ''));
      return 'Senha alterada.';
    }
    await atualizarPerfil(user.id, user.tenantId, perfilSchema.parse(data));
    return 'Dados da conta atualizados.';
  });
}

const [perfil, empresas, google] = await Promise.all([carregarPerfil(user.id), empresasDoUsuario(user.id), contaGoogleDoUsuario(user.id)]);
const googleDisponivel = googleConfigurado();
---

<AppLayout title="Minha conta" heading="Minha conta">
  <div class="conta">
    <SectionCard title="Meus dados" icon="user-circle">
      <form method="post" class="form-grid">
        <div class="field span-2">
          <label for="ct-nome">Nome e sobrenome<span class="obrigatorio">*</span></label>
          <input id="ct-nome" name="nome" required maxlength="255" value={perfil.nome} />
        </div>
        <div class="field">
          <label for="ct-email">E-mail</label>
          <input id="ct-email" value={perfil.email} readonly />
          <span class="field-hint">O e-mail de acesso não pode ser alterado por aqui.</span>
        </div>
        <div class="field">
          <label for="ct-telefone">Telefone</label>
          <input id="ct-telefone" name="telefone" inputmode="tel" placeholder="(00) 00000-0000" data-mascara="telefone" value={perfil.telefone ?? ''} />
        </div>
        <div class="span-2 acoes">
          <Button type="submit" variant="primary" data-carregando="Salvando…">Salvar</Button>
        </div>
      </form>
    </SectionCard>

    <SectionCard title="Trocar senha" icon="lock">
      <form method="post" class="form-grid">
        <input type="hidden" name="_action" value="senha" />
        <div class="field span-2">
          <label for="ct-senha-atual">Senha atual<span class="obrigatorio">*</span></label>
          <input id="ct-senha-atual" name="senha_atual" type="password" required autocomplete="current-password" />
        </div>
        <div class="field">
          <label for="ct-senha">Nova senha<span class="obrigatorio">*</span></label>
          <input id="ct-senha" name="senha" type="password" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="field">
          <label for="ct-confirma">Confirme a nova senha<span class="obrigatorio">*</span></label>
          <input id="ct-confirma" name="confirma_senha" type="password" required autocomplete="new-password" />
        </div>
        <p class="span-2 field-hint">{REGRA_SENHA}</p>
        <div class="span-2 acoes">
          <Button type="submit" variant="primary" data-carregando="Alterando…">Alterar senha</Button>
        </div>
      </form>
    </SectionCard>

    <SectionCard title="Conta Google" icon="brand-google" description="Login com o Google e reuniões com Google Meet na sua agenda">
      {!googleDisponivel ? (
        <p class="field-hint">A integração com o Google não está configurada neste servidor.</p>
      ) : google ? (
        <div class="google">
          <dl class="kv kv-2">
            <div><dt>Conta vinculada</dt><dd>{google.email}</dd></div>
            <div>
              <dt>Agenda (Google Calendar)</dt>
              <dd>{google.agenda_ativa ? <span class="badge badge-success">Ativa</span> : <span class="badge badge-warning">Sem acesso</span>}</dd>
            </div>
          </dl>
          <p class="field-hint">
            {google.agenda_ativa
              ? 'As reuniões agendadas no Banket são criadas na sua agenda Google, com a sala do Google Meet e os convites aos participantes.'
              : 'Para agendar reuniões com Google Meet, ative a agenda e aceite a permissão "Ver e editar eventos" do Google Agenda.'}
          </p>
          <div class="acoes google-acoes">
            <form method="post">
              <input type="hidden" name="_action" value="google_desvincular" />
              <Button type="submit" variant="danger" data-confirm="Desvincular a conta Google?" data-confirm-texto="Você deixa de entrar com o Google e de agendar reuniões com o Meet. Reuniões já agendadas continuam na sua agenda Google." data-confirm-rotulo="Desvincular">Desvincular</Button>
            </form>
            {!google.agenda_ativa && <Button variant="primary" href="/api/google/vincular?agenda=1" icon="calendar-plus">Ativar agenda</Button>}
          </div>
        </div>
      ) : (
        <div class="google">
          <p class="field-hint">
            Vincule sua conta Google para entrar com um clique e agendar reuniões com Google Meet direto no Banket (o evento e a
            sala do Meet ficam na sua agenda Google).
          </p>
          <div class="acoes">
            <Button variant="primary" href="/api/google/vincular" icon="brand-google">Vincular conta Google</Button>
          </div>
        </div>
      )}
    </SectionCard>

    <SectionCard title="Minhas empresas" icon="building">
      <ul class="empresas">
        {empresas.map((e) => (
          <li>
            <span class="empresa-icone"><Icon name="building" size={18} /></span>
            <span class="empresa-nome">{e.nome}</span>
            <span class="tag">{ROLE_LABELS[e.role]}</span>
            {e.id === user.tenantId && <span class="badge badge-success">Empresa atual</span>}
          </li>
        ))}
      </ul>
      <p class="field-hint">Para entrar em outra empresa, peça um convite ao administrador dela.</p>
    </SectionCard>
  </div>
</AppLayout>

<style>
  /* O espaço entre os cards vem do próprio SectionCard (margem entre irmãos) */
  .conta {
    display: flex;
    flex-direction: column;
    max-width: 760px;
  }

  .acoes {
    display: flex;
    justify-content: flex-end;
  }

  .google {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .google-acoes {
    gap: var(--space-2);
  }

  /* E-mail de acesso: campo somente leitura */
  .field input[readonly] {
    background-color: var(--bg-subtle);
    color: var(--text-muted);
    box-shadow: none;
  }

  .field input[readonly]:hover {
    border-color: var(--border-strong);
  }

  .empresas {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .empresas li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--fs-14);
  }

  .empresas li:first-child {
    padding-top: 0;
  }

  .empresa-icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    color: var(--text-secondary);
  }

  .empresa-nome {
    flex: 1;
    min-width: 0;
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }
</style>

---
import AppLayout from '../../../layouts/AppLayout.astro';
import Button from '../../../components/ui/Button.astro';
import EstadoVazio from '../../../components/ui/EstadoVazio.astro';
import Table from '../../../components/ui/Table.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { withTenant } from '../../../lib/db';
import { dataHora } from '../../../lib/datas';
import { html } from '../../../lib/html';
import { pageInfo, pageParams } from '../../../lib/pagination';
import { carregarFormulario, listarRespostas } from '../../../server/formularios';
import { NATUREZA_PEDIDO, ROTULOS } from '../../../lib/rotulos';

const { tenantId } = Astro.locals.user;
const id = Astro.params.id!;
const page = pageParams(Astro.url);

const de = Astro.url.searchParams.get('de') || null;
const ate = Astro.url.searchParams.get('ate') || null;
const dados = await withTenant(tenantId, async (db) => {
  const formulario = await carregarFormulario(db, id).catch(() => null);
  if (!formulario) return null;
  return { formulario, ...(await listarRespostas(db, id, page, { de, ate })) };
});
if (!dados) return new Response(null, { status: 404 });

const { formulario, rows, total } = dados;
const tableData = rows.map((r) => ({
  _detalhe: r,
  data: dataHora(r.created_at),
  // Valor vazio: a Table mostra o travessão
  nome: r.nome ?? null,
  email: r.email ?? null,
  natureza: (r.natureza && NATUREZA_PEDIDO[r.natureza]) ?? r.natureza ?? null,
  evento: r.evento_id
    ? html`<a class="link" href="/eventos/${r.evento_id}">${r.evento_titulo ?? 'Abrir evento'}</a>`
    : html`<span class="muted">Evento removido</span>`,
  acoes: html`<button type="button" class="row-action" data-ver-resposta="${JSON.stringify({
    quando: dataHora(r.created_at),
    linhas: r.dados,
  })}">Ver resposta</button>`,
}));
const exportarHref = `/formularios/${id}/respostas-exportar${de || ate ? `?${new URLSearchParams({ ...(de ? { de } : {}), ...(ate ? { ate } : {}) })}` : ''}`;
---

<AppLayout title={`Respostas · ${formulario.nome}`} heading={`Formulários / ${formulario.nome} / Respostas`}>
  <div class="topo">
    <p class="intro">{total} {total === 1 ? 'resposta recebida' : 'respostas recebidas'}. Cada resposta cria um evento na coluna de entrada do funil.</p>
    <div class="topo-acoes">
      <Button variant="secondary" icon="download" href={exportarHref}>Exportar CSV</Button>
      <Button variant="secondary" icon="pencil" href={`/formularios/${id}`}>Editar formulário</Button>
    </div>
  </div>

  <form method="get" class="filtro-periodo">
    <div class="field">
      <label for="fr-de">De</label>
      <input id="fr-de" type="date" name="de" value={de ?? ''} />
    </div>
    <div class="field">
      <label for="fr-ate">Até</label>
      <input id="fr-ate" type="date" name="ate" value={ate ?? ''} />
    </div>
    <button type="submit" class="btn btn-secondary btn-md">Aplicar</button>
    {(de || ate) && <a class="btn btn-text btn-md" href={`/formularios/${id}/respostas`}>Limpar</a>}
  </form>

  <Table
    columns={[
      { key: 'data', label: 'Recebida em' },
      { key: 'nome', label: 'Nome' },
      { key: 'email', label: 'E-mail' },
      { key: 'natureza', label: ROTULOS.tipoEvento },
      { key: 'evento', label: 'Evento' },
      { key: 'acoes', label: 'Ações', align: 'right' },
    ]}
    data={tableData}
  >
    <EstadoVazio slot="empty" icon="forms" titulo="Nenhuma resposta recebida ainda" texto="Compartilhe o link público do formulário." />
    <Pagination slot="footer" info={pageInfo(page, total)} />
  </Table>

  <dialog class="dialogo-form dialogo-resposta" data-dialogo-resposta aria-labelledby="resp-titulo">
    <div class="dialogo-caixa">
      <div class="resp-topo">
        <h2 id="resp-titulo">Resposta completa</h2>
        <p class="resp-quando" data-resp-quando></p>
      </div>
      <div class="resp-linhas" data-resp-linhas></div>
      <div class="dialogo-acoes">
        <button type="button" class="btn btn-primary btn-md" data-fechar-resposta>Fechar</button>
      </div>
    </div>
  </dialog>
</AppLayout>

<script>
  // Detalhe da resposta sem sair da lista (UX-078)
  interface Linha {
    secao: string;
    rotulo: string;
    valor: string;
  }
  const dialogo = document.querySelector<HTMLDialogElement>('[data-dialogo-resposta]')!;
  const quando = dialogo.querySelector<HTMLElement>('[data-resp-quando]')!;
  const corpo = dialogo.querySelector<HTMLElement>('[data-resp-linhas]')!;

  document.addEventListener('click', (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLElement>('[data-ver-resposta]');
    if (alvo) {
      const dados = JSON.parse(alvo.dataset.verResposta!) as { quando: string; linhas: Linha[] };
      quando.textContent = `Recebida em ${dados.quando}`;
      corpo.replaceChildren();
      let secaoAnterior = '';
      for (const linha of dados.linhas) {
        if (linha.secao !== secaoAnterior) {
          const h = document.createElement('h3');
          h.textContent = linha.secao;
          corpo.appendChild(h);
          secaoAnterior = linha.secao;
        }
        const dt = document.createElement('dt');
        dt.textContent = linha.rotulo;
        const dd = document.createElement('dd');
        dd.textContent = linha.valor || '—';
        const par = document.createElement('div');
        par.append(dt, dd);
        corpo.appendChild(par);
      }
      dialogo.showModal();
      return;
    }
    if ((e.target as HTMLElement).closest('[data-fechar-resposta]')) dialogo.close();
  });
  dialogo.addEventListener('click', (e) => e.target === dialogo && dialogo.close());
</script>

<style>
  .topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .topo-acoes {
    display: flex;
    flex: none;
    gap: var(--space-2);
  }

  .filtro-periodo {
    display: flex;
    align-items: end;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .filtro-periodo .field {
    width: 170px;
  }

  .filtro-periodo input {
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Detalhe da resposta: grupos (eyebrow) e linhas rótulo → valor ---------- */
  .dialogo-resposta {
    width: min(640px, calc(100vw - 32px));
  }

  .resp-topo {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .resp-quando {
    font-size: var(--fs-13);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .resp-linhas {
    max-height: 55vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    /* a rolagem não encosta no texto */
    margin-right: calc(var(--space-2) * -1);
    padding-right: var(--space-2);
  }

  /* As linhas são criadas pelo script, por isso os seletores globais */
  .resp-linhas :global(h3) {
    margin: var(--space-5) 0 var(--space-1);
    font-size: var(--type-eyebrow-size);
    line-height: var(--type-eyebrow-lh);
    font-weight: var(--type-eyebrow-weight);
    letter-spacing: var(--type-eyebrow-ls);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .resp-linhas :global(h3:first-child) {
    margin-top: 0;
  }

  .resp-linhas :global(div) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-4);
    padding: var(--space-2-5) 0;
    border-bottom: 1px solid var(--border-subtle);
    line-height: 1.45;
  }

  .resp-linhas :global(dt) {
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .resp-linhas :global(dd) {
    font-size: var(--fs-14);
    color: var(--text-heading);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  @media (max-width: 768px) {
    .topo {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
    }

    .topo-acoes :global(.btn) {
      flex: 1;
    }

    .filtro-periodo {
      flex-wrap: wrap;
      margin-bottom: var(--space-4);
    }

    .filtro-periodo .field {
      flex: 1 1 120px;
      width: auto;
    }

    /* Rótulo em cima, valor embaixo */
    .resp-linhas :global(div) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-0-5);
    }
  }
</style>

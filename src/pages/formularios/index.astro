---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import EstadoVazio from '../../components/ui/EstadoVazio.astro';
import Icon from '../../components/ui/Icon.astro';
import InfoCard from '../../components/ui/InfoCard.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import { withTenant } from '../../lib/db';
import { handleFormPost } from '../../lib/actions';
import { dataBR } from '../../lib/forms';
import { estaFiltrando, searchTerm } from '../../lib/pagination';
import { criarFormulario, listarFormularios } from '../../server/formularios';

const { tenantId } = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    // O nome vem antes de criar: quem desiste não deixa "Novo formulário" na lista (UX-075)
    const nome = String(data.nome ?? '').trim().slice(0, 120) || 'Formulário de contato';
    const id = await withTenant(tenantId, (db) => criarFormulario(db, tenantId, nome));
    return { message: `Formulário "${nome}" criado a partir do modelo padrão.`, redirect: `/formularios/${id}` };
  });
}

const formularios = await withTenant(tenantId, (db) => listarFormularios(db, searchTerm(Astro.url)));
const pad = (n: number) => String(n).padStart(2, '0');
---

<AppLayout title="Formulários" heading="Formulários">
  <PageToolbar searchPlaceholder="Pesquisar por nome ou endereço">
    <Button icon="circle-plus" data-abrir-novo>Novo formulário</Button>
  </PageToolbar>

  <dialog class="dialogo-form" data-dialogo-novo aria-labelledby="novo-form-titulo">
    <form method="post" class="dialogo-caixa">
      <h2 id="novo-form-titulo">Novo formulário</h2>
      <div class="field">
        <label for="nf-nome">Nome do formulário<span class="obrigatorio">*</span></label>
        <input id="nf-nome" name="nome" required maxlength="120" placeholder="Ex.: Casamentos 2027" />
        <span class="field-hint">Ele nasce com o modelo padrão de captação; ajuste as perguntas em seguida.</span>
      </div>
      <div class="dialogo-acoes">
        <button type="button" class="btn btn-secondary btn-md" data-fechar-novo>Voltar</button>
        <button type="submit" class="btn btn-primary btn-md" data-carregando="Criando…">Criar formulário</button>
      </div>
    </form>
  </dialog>

  {formularios.length === 0 ? (
    <div class="vazio-card">
      <EstadoVazio icon="stack-2" titulo="Nenhum formulário encontrado" texto="Crie um a partir do modelo padrão de captação.">
        {estaFiltrando(Astro.url) && <a class="btn btn-secondary btn-md" href={Astro.url.pathname}>Limpar filtros</a>}
      </EstadoVazio>
    </div>
  ) : (
    <div class="cards-grid formularios-grid">
      {formularios.map((f) => {
        const url = `${Astro.url.origin}/f/${f.slug}`;
        return (
          <InfoCard
            title={f.nome}
            icon="stack-2"
            description={f.descricao ?? 'Sem descrição.'}
            muted={!f.ativo}
            rows={[
              { label: 'Seções ativas', value: pad(f.secoes_ativas) },
              { label: 'Perguntas ativas', value: pad(f.perguntas_ativas) },
              { label: 'Respostas', value: pad(f.respostas) },
              { label: 'Última resposta', value: f.ultima_resposta ? dataBR(f.ultima_resposta) : '—' },
            ]}
          >
            <span slot="status" class:list={['badge', { 'badge-success': f.ativo }]}>{f.ativo ? 'Ativo' : 'Inativo'}</span>
            <div class="link-publico">
              <span class="link-icone"><Icon name="link" size={16} stroke={1.75} /></span>
              <span class="link-url" title={url}>{url}</span>
              <span class="link-acoes">
                <Button variant="text" size="sm" icon="copy" data-copiar={url}>Copiar link</Button>
                <Button variant="text" size="sm" icon="share" data-compartilhar={url} data-nome={f.nome}>Compartilhar</Button>
              </span>
            </div>
            <Fragment slot="footer">
              <Button variant="secondary" block href={`/formularios/${f.id}`}>Editar</Button>
              <div class="acoes-secundarias">
                <Button variant="text" size="sm" href={`/formularios/${f.id}/respostas`}>Respostas</Button>
                <a class="btn btn-text btn-sm" href={`/f/${f.slug}?previa=1`} target="_blank" rel="noopener">
                  <Icon name="eye" size={15} stroke={1.75} class="btn-icon" />Pré-visualizar
                </a>
                {f.ativo && (
                  <a class="btn btn-text btn-sm" href={`/f/${f.slug}`} target="_blank" rel="noopener">
                    <Icon name="external-link" size={15} stroke={1.75} class="btn-icon" />Abrir formulário
                  </a>
                )}
              </div>
            </Fragment>
          </InfoCard>
        );
      })}
    </div>
  )}
  <dialog class="dialogo-form dialogo-compartilhar" data-dialogo-compartilhar aria-labelledby="comp-titulo">
    <div class="dialogo-caixa">
      <h2 id="comp-titulo">Compartilhar formulário</h2>
      <div class="field">
        <label for="comp-url">Link público</label>
        <div class="linha-copiar">
          <input id="comp-url" readonly data-comp-url />
          <button type="button" class="btn btn-secondary btn-md" data-copiar-de="comp-url"><Icon name="copy" size={16} stroke={1.75} class="btn-icon" />Copiar</button>
        </div>
      </div>
      <div class="comp-qr">
        <canvas data-comp-qr width="180" height="180" aria-label="QR code do formulário"></canvas>
        <div class="comp-qr-acoes">
          <a class="btn btn-secondary btn-md" data-comp-whatsapp target="_blank" rel="noopener"><Icon name="brand-whatsapp" size={16} stroke={1.75} class="btn-icon" />Enviar no WhatsApp</a>
          <a class="btn btn-secondary btn-md" data-comp-baixar-qr download="qr-formulario.png"><Icon name="download" size={16} stroke={1.75} class="btn-icon" />Baixar QR code</a>
        </div>
      </div>
      <div class="field">
        <label for="comp-iframe">Incorporar no seu site</label>
        <div class="linha-copiar">
          <textarea id="comp-iframe" readonly rows="5" data-comp-iframe></textarea>
          <button type="button" class="btn btn-secondary btn-md" data-copiar-de="comp-iframe"><Icon name="copy" size={16} stroke={1.75} class="btn-icon" />Copiar</button>
        </div>
      </div>
      <div class="dialogo-acoes">
        <button type="button" class="btn btn-primary btn-md" data-fechar-compartilhar>Fechar</button>
      </div>
    </div>
  </dialog>
</AppLayout>

<script>
  import { toDataURL } from 'qrcode';
  import { toast } from '../../lib/ui';

  // Novo formulário: pede o nome num diálogo antes de criar (UX-075)
  const dialogoNovo = document.querySelector<HTMLDialogElement>('[data-dialogo-novo]')!;
  document.querySelector('[data-abrir-novo]')?.addEventListener('click', () => {
    dialogoNovo.showModal();
    dialogoNovo.querySelector<HTMLInputElement>('#nf-nome')?.focus();
  });
  dialogoNovo.querySelector('[data-fechar-novo]')?.addEventListener('click', () => dialogoNovo.close());
  dialogoNovo.addEventListener('click', (e) => e.target === dialogoNovo && dialogoNovo.close());

  // Compartilhar: link, WhatsApp, QR e código de incorporação (UX-077)
  const dialogoComp = document.querySelector<HTMLDialogElement>('[data-dialogo-compartilhar]')!;
  const compUrl = dialogoComp.querySelector<HTMLInputElement>('[data-comp-url]')!;
  const compIframe = dialogoComp.querySelector<HTMLTextAreaElement>('[data-comp-iframe]')!;
  const compWhats = dialogoComp.querySelector<HTMLAnchorElement>('[data-comp-whatsapp]')!;
  const compQr = dialogoComp.querySelector<HTMLCanvasElement>('[data-comp-qr]')!;
  const compBaixar = dialogoComp.querySelector<HTMLAnchorElement>('[data-comp-baixar-qr]')!;

  document.addEventListener('click', async (e) => {
    const alvo = e.target as HTMLElement;
    const abrir = alvo.closest<HTMLElement>('[data-compartilhar]');
    if (abrir) {
      const url = abrir.dataset.compartilhar!;
      const nome = abrir.dataset.nome ?? 'formulário';
      compUrl.value = url;
      compIframe.value = `<iframe src="${url}" style="width:100%;min-height:900px;border:0" title="${nome}"></iframe>`;
      compWhats.href = `https://wa.me/?text=${encodeURIComponent(`Conte o que você imagina para o seu evento: ${url}`)}`;
      try {
        const dataUrl = await toDataURL(url, { width: 180, margin: 1 });
        const img = new Image();
        img.onload = () => compQr.getContext('2d')?.drawImage(img, 0, 0, 180, 180);
        img.src = dataUrl;
        compBaixar.href = dataUrl;
      } catch {
        // sem QR: os demais atalhos seguem funcionando
      }
      dialogoComp.showModal();
      return;
    }
    if (alvo.closest('[data-fechar-compartilhar]')) dialogoComp.close();
    const copiarDe = alvo.closest<HTMLElement>('[data-copiar-de]');
    if (copiarDe) {
      const campo = document.getElementById(copiarDe.dataset.copiarDe!) as HTMLInputElement | HTMLTextAreaElement;
      try {
        await navigator.clipboard.writeText(campo.value);
        toast('Copiado.', 'success');
      } catch {
        campo.select();
        toast('Não foi possível copiar automaticamente. O texto está selecionado.', 'info');
      }
    }
  });
  dialogoComp.addEventListener('click', (e) => e.target === dialogoComp && dialogoComp.close());

  // Copia o link público do formulário
  document.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-copiar]');
    if (!el) return;
    try {
      await navigator.clipboard.writeText(el.dataset.copiar!);
      toast('Link copiado.', 'success');
    } catch {
      toast('Não foi possível copiar. Copie o endereço manualmente.', 'error');
    }
  });
</script>

<style>
  /* Estado vazio dentro de um card, como nas demais listas em cartões */
  .vazio-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  /* Grade do design system para os cartões de formulário */
  .formularios-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    max-width: 1100px;
  }


  /* Link público (CopyField): caixa de 40px com ícone, endereço truncado e ações de texto */
  .link-publico {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    min-height: var(--control-h-md);
    padding: 0 var(--space-2) 0 var(--space-3);
    background: var(--clay-25);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }

  .link-icone {
    display: flex;
    flex: none;
    color: var(--text-muted);
  }

  .link-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .link-acoes {
    display: flex;
    align-items: center;
    flex: none;
    gap: var(--space-3);
    padding-right: var(--space-1);
  }

  .acoes-secundarias {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  /* Compartilhar: código de incorporação em fonte mono e QR em quadro */
  .dialogo-compartilhar textarea {
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    line-height: 1.5;
    resize: none;
  }

  .dialogo-compartilhar .linha-copiar {
    align-items: flex-start;
  }

  .comp-qr canvas {
    flex: none;
    padding: var(--space-1);
    background: var(--bg-surface);
  }

  .comp-qr-acoes {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .formularios-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* QR em cima e atalhos embaixo: os botões não cabem ao lado do código */
    .comp-qr {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }

    .comp-qr canvas {
      align-self: center;
      width: 148px;
      height: 148px;
    }
  }
</style>

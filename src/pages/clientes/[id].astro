---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import Table from '../../components/ui/Table.astro';
import SectionCard from '../../components/ui/SectionCard.astro';
import { withTenant } from '../../lib/db';
import { formatarDocumento } from '../../lib/documento';
import { html } from '../../lib/html';
import { formatMoney } from '../../lib/money';
import { dataCurta } from '../../lib/datas';
import { ROTULOS } from '../../lib/rotulos';
import ClienteDrawer from '../../components/clientes/ClienteDrawer.astro';
import { formId, handleFormPost } from '../../lib/actions';
import { clienteSchema, excluirCliente, salvarCliente } from '../../server/clientes';

const { tenantId } = Astro.locals.user;
const id = Astro.params.id!;

// Editar e excluir direto do detalhe (UX-142)
if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    const alvo = formId(data) ?? id;
    if (data._action === 'delete') {
      await withTenant(tenantId, (db) => excluirCliente(db, alvo));
      return { message: 'Cliente removido.', redirect: '/clientes' };
    }
    await withTenant(tenantId, (db) => salvarCliente(db, tenantId, alvo, clienteSchema.parse(data)));
    return 'Cliente atualizado.';
  });
}

const dados = await withTenant(tenantId, async (db) => {
  if (!/^[0-9a-f-]{36}$/i.test(id)) return null;
  const { rows } = await db.query('SELECT * FROM clientes WHERE id = $1', [id]);
  if (!rows[0]) return null;
  const eventos = await db.query(
    `SELECT e.id, e.titulo, to_char(e.data_evento, 'YYYY-MM-DD') AS data_evento, e.numero_convidados,
            s.nome AS status_nome, s.cor AS status_cor, o.valor_total, e.verba_total
       FROM eventos e JOIN status_orcamento s ON s.id = e.status_id
       LEFT JOIN orcamentos o ON o.evento_id = e.id
      WHERE e.cliente_id = $1 ORDER BY e.data_evento DESC NULLS LAST`,
    [id]
  );
  // Resumo comercial do cliente (UX-142)
  const resumo = await db.query<{ aprovado: number; aberto: number; ultimo_contato: Date | null }>(
    `SELECT COALESCE(SUM(o.valor_total) FILTER (WHERE s.variante = 'aprovado'), 0) AS aprovado,
            COALESCE(SUM(o.valor_total) FILTER (WHERE s.variante IN ('novo', 'negociacao')), 0) AS aberto,
            (SELECT max(t.created_at) FROM evento_timeline t JOIN eventos e2 ON e2.id = t.evento_id
              WHERE e2.cliente_id = $1) AS ultimo_contato
       FROM eventos e
       JOIN status_orcamento s ON s.id = e.status_id
       LEFT JOIN orcamentos o ON o.evento_id = e.id
      WHERE e.cliente_id = $1`,
    [id]
  );
  return { cliente: rows[0], eventos: eventos.rows, resumo: resumo.rows[0] };
});

if (!dados) return new Response(null, { status: 404 });
const { cliente, eventos, resumo } = dados;
const valoresDrawer = JSON.stringify({
  id: cliente.id,
  tipo_pessoa: cliente.tipo_pessoa,
  nome: cliente.nome,
  documento: formatarDocumento(cliente.documento),
  email: cliente.email,
  telefone: cliente.telefone,
  endereco: cliente.endereco,
  observacoes: cliente.observacoes,
});

const tabela = eventos.map((e) => ({
  data: e.data_evento ? html`<span class="tabular">${dataCurta(e.data_evento)}</span>` : '-',
  evento: html`<a class="link" href="/eventos/${e.id}">${e.titulo ?? 'Evento'}</a>`,
  convidados: e.numero_convidados !== null ? html`<span class="tabular">${e.numero_convidados}</span>` : '-',
  status: html`<span class="status-name"><span class="dot" style="background:${e.status_cor ?? 'var(--stage-new)'}"></span>${e.status_nome}</span>`,
  valor: e.valor_total !== null
      ? formatMoney(e.valor_total)
      : e.verba_total !== null
        ? html`<span class="verba" title="Verba estimada pelo cliente (ainda sem orçamento)">${formatMoney(e.verba_total)}</span>`
        : '-',
}));
---

<AppLayout title={cliente.nome} heading={`Clientes / ${cliente.nome}`}>
  <div class="topo">
    <a class="voltar" href="/clientes"><Icon name="arrow-left" size={16} /> Voltar</a>
    <div class="topo-acoes">
      <Button variant="secondary" icon="pencil" data-drawer-open="drawer-cliente" data-values={valoresDrawer}>Editar</Button>
      <Button variant="primary" icon="circle-plus" href={`/eventos/novo?cliente=${cliente.id}`}>Novo evento para este cliente</Button>
    </div>
  </div>

  <div class="resumo-cliente">
    <div class="kpi-mini">
      <span class="rotulo eyebrow">Eventos</span>
      <strong>{eventos.length}</strong>
    </div>
    <div class="kpi-mini">
      <span class="rotulo eyebrow">Valor aprovado</span>
      <strong class="positivo" title={formatMoney(resumo.aprovado)}>{formatMoney(resumo.aprovado)}</strong>
    </div>
    <div class="kpi-mini">
      <span class="rotulo eyebrow">Em aberto</span>
      <strong title={formatMoney(resumo.aberto)}>{formatMoney(resumo.aberto)}</strong>
    </div>
    <div class="kpi-mini">
      <span class="rotulo eyebrow">Último contato</span>
      <strong class:list={{ vazio: !resumo.ultimo_contato }}>{resumo.ultimo_contato ? dataCurta(resumo.ultimo_contato.toISOString().slice(0, 10)) : '—'}</strong>
    </div>
  </div>

  <SectionCard title="Dados do cliente" icon={cliente.tipo_pessoa === 'PJ' ? 'building' : 'user-square'}>
    <dl class="kv kv-3">
      <div><dt>Nome / razão social</dt><dd>{cliente.nome}</dd></div>
      <div><dt>Tipo</dt><dd>{cliente.tipo_pessoa === 'PJ' ? 'Pessoa jurídica' : 'Pessoa física'}</dd></div>
      <div><dt>{cliente.tipo_pessoa === 'PJ' ? 'CNPJ' : 'CPF'}</dt><dd class="tabular">{formatarDocumento(cliente.documento) || <span class="vazio">—</span>}</dd></div>
      <div><dt>E-mail</dt><dd>{cliente.email ?? <span class="vazio">—</span>}</dd></div>
      <div><dt>Telefone</dt><dd class="tabular">{cliente.telefone ?? <span class="vazio">—</span>}</dd></div>
      <div><dt>Endereço</dt><dd>{cliente.endereco ?? <span class="vazio">—</span>}</dd></div>
    </dl>
    {cliente.observacoes && <dl class="kv"><div><dt>Observações</dt><dd>{cliente.observacoes}</dd></div></dl>}
  </SectionCard>

  <h3 class="secao">Eventos <span class="secao-total">({eventos.length})</span></h3>
  <Table
    columns={[
      { key: 'data', label: 'Data' },
      { key: 'evento', label: 'Evento' },
      { key: 'convidados', label: 'Convidados', align: 'center' },
      { key: 'status', label: ROTULOS.etapa },
      { key: 'valor', label: 'Orçamento', align: 'right' },
    ]}
    data={tabela}
    emptyMessage="Este cliente ainda não tem eventos."
  />
  <ClienteDrawer slot="overlays" />
</AppLayout>

<style>
  .topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .topo-acoes {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Resumo comercial (StatCard do design system) */
  .resumo-cliente {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .kpi-mini {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .kpi-mini strong {
    font-size: var(--fs-28);
    line-height: 1.1;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-tight);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kpi-mini .positivo {
    color: var(--sage-700);
  }

  .kpi-mini strong.vazio {
    color: var(--clay-400);
  }

  .kv-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
  }

  .kv dd {
    overflow-wrap: anywhere;
  }

  .secao {
    margin: var(--space-8) 0 var(--space-3);
    font-size: var(--fs-15);
    line-height: 1.35;
    font-weight: var(--fw-medium);
    letter-spacing: 0;
    color: var(--text-heading);
  }

  .secao-total {
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .topo-acoes {
      width: 100%;
    }

    .topo-acoes :global(.btn) {
      flex: 1 1 auto;
    }

    .resumo-cliente {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .kpi-mini {
      padding: var(--space-4);
    }

    .kpi-mini strong {
      font-size: var(--fs-18);
    }

    .kv-3 {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>

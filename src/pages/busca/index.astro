---
// Banket Busca — área do buffet no app (menu Banket Busca): o próprio cadastro do perfil em 6 etapas (sem pacotes nem
// preço), com a situação do perfil no topo. Cada etapa grava ao salvar (o progresso fica no banco) e funciona sem JavaScript. POST: _etapa +
// _acao. Limites do plano (tipos, fotos, grupos de fotos) abrem o painel de upsell. Decisão de 16/10/2026: tudo fica em
// app.banket.com.br, dentro do layout do app (o subdomínio do Busca é só a vitrine).
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Etapas from '../../components/busca/onboarding/Etapas.astro';
import Empresa from '../../components/busca/onboarding/Empresa.astro';
import Eventos from '../../components/busca/onboarding/Eventos.astro';
import Regiao from '../../components/busca/onboarding/Regiao.astro';
import Capacidade from '../../components/busca/onboarding/Capacidade.astro';
import Fotos from '../../components/busca/onboarding/Fotos.astro';
import Revisao from '../../components/busca/onboarding/Revisao.astro';
import { handleFormPost } from '../../lib/actions';
import { isAdmin } from '../../lib/auth';
import { withTenant } from '../../lib/db';
import { setFlash } from '../../lib/flash';
import { ErroPlano } from '../../lib/planos/gating';
import { ETAPAS, ETAPAS_PARA_PUBLICAR, ETAPA_FOTOS, ETAPA_REVISAO, etapasConcluidas, proximaEtapa } from '../../lib/busca/onboarding';
import { appUrl } from '../../lib/mail';
import { buscaUrl } from '../../lib/busca/url';
import '../../styles/busca.css';
import '../../styles/onboarding.css';
import { garantirPerfil } from '../../server/busca/perfil';
import {
  adicionarFotos, capacidadeSchema, contagens, dadosDaEmpresa, definirCapa, despublicar, empresaSchema,
  eventosSchema, excluirFoto, fotoSchema, listarFotos, moverFoto, publicar, recursosOnboarding, regiaoSchema, salvarCapacidade,
  faltasDaEmpresa, salvarEmpresa, salvarEventos, salvarFoto, salvarRegiao, sincronizarPerfisComEmpresa,
} from '../../server/busca/onboarding';

const user = Astro.locals.user;
const url = Astro.url;
// Em erro de validação, o que foi digitado volta preenchido (cookie curto, só campos de texto das etapas 1 a 4)
const RASCUNHO = 'banket_busca_rascunho';

if (Astro.request.method === 'POST') {
  return handleFormPost(
    Astro,
    async (data, raw) => {
      const etapa = Math.min(Math.max(Number(data._etapa) || 1, 1), ETAPA_REVISAO);
      const acao = String(data._acao ?? 'salvar');
      const aqui = `/busca?etapa=${etapa}`;
      const AVISO = ' O perfil voltou a rascunho: conclua as etapas que faltam para publicar de novo.';
      const com = (msg: string, r?: { despublicado: boolean } | void) => `${msg}${r && r.despublicado ? AVISO : ''}`;
      const seguir = (r?: { despublicado: boolean }) => {
        const proxima = acao === 'continuar' ? `/busca?etapa=${Math.min(etapa + 1, ETAPA_REVISAO)}` : aqui;
        const aviso = r?.despublicado ? ' O perfil voltou a rascunho: conclua as etapas que faltam para publicar de novo.' : '';
        return { message: `${acao === 'continuar' ? 'Etapa salva.' : 'Alterações salvas.'}${aviso}`, redirect: proxima };
      };
      try {
        return await withTenant(user.tenantId, async (db) => {
          const id = typeof data.id === 'string' && /^[0-9a-f-]{36}$/i.test(data.id) ? data.id : null;
          // Etapas 1–4: formulário; 5: fotos; 6: revisão e publicação
          switch (`${etapa}:${acao}`) {
            case '1:salvar': case '1:continuar':
              return seguir(await salvarEmpresa(db, user, empresaSchema.parse(data)));
            case '2:salvar': case '2:continuar':
              return seguir(await salvarEventos(db, user, eventosSchema.parse(data)));
            case '3:salvar': case '3:continuar':
              return seguir(await salvarRegiao(db, user, regiaoSchema.parse(data)));
            case '4:salvar': case '4:continuar':
              return seguir(await salvarCapacidade(db, user, capacidadeSchema.parse(data)));
            case '5:continuar':
              return { message: '', redirect: `/busca?etapa=${ETAPA_REVISAO}` };
            case '5:enviar':
              await adicionarFotos(db, user, raw.getAll('fotos').filter((f): f is File => f instanceof File), typeof data.grupo === 'string' ? data.grupo : null);
              return { message: 'Fotos enviadas.', redirect: aqui };
            case '5:foto':
              if (id) await salvarFoto(db, user, id, fotoSchema.parse(data));
              return { message: 'Foto atualizada.', redirect: aqui };
            case '5:capa':
              if (id) await definirCapa(db, user, id);
              return { message: 'Capa definida.', redirect: aqui };
            case '5:antes': case '5:depois':
              if (id) await moverFoto(db, user, id, acao as 'antes' | 'depois');
              return { message: '', redirect: aqui };
            case '5:excluir':
              return { message: com('Foto excluída.', id ? await excluirFoto(db, user, id) : undefined), redirect: aqui };
            case '6:publicar':
              await publicar(db, user, data.aceite === 'on');
              return { message: 'Perfil publicado! Ele já aparece nas buscas compatíveis.', redirect: `/busca?etapa=${ETAPA_REVISAO}` };
            case '6:despublicar':
              await despublicar(db, user);
              return { message: 'Perfil despublicado. Ele não aparece mais na busca.', redirect: aqui };
            default:
              return { message: '', redirect: aqui };
          }
        });
      } catch (err) {
        if (etapa <= 4 && !(err instanceof ErroPlano)) {
          const valores: Record<string, unknown> = { _etapa: etapa };
          for (const [k, v] of Object.entries(data)) if (!k.startsWith('_') && (typeof v === 'string' || Array.isArray(v))) valores[k] = v;
          Astro.cookies.set(RASCUNHO, JSON.stringify(valores).slice(0, 3800), { path: '/busca', httpOnly: true, sameSite: 'lax', maxAge: 600 });
        }
        // Limite do plano: mensagem e o painel de upsell aberto na mesma etapa
        if (err instanceof ErroPlano) {
          setFlash(Astro.cookies, 'error', err.message);
          return { message: '', redirect: `${aqui}&bloqueado=${err.recurso}` };
        }
        throw err;
      }
    },
    { arrays: ['tipos_evento', 'tipos_servico', 'restricoes', 'cidades'] }
  );
}

const dados = await withTenant(user.tenantId, async (db) => {
  // O perfil acompanha o cadastro da empresa (Configurações › Empresa): copia antes de mostrar
  if (isAdmin(user)) {
    await garantirPerfil(db, user.tenantId);
    await sincronizarPerfisComEmpresa(db, user.tenantId);
  }
  const perfil = await garantirPerfil(db, user.tenantId);
  const c = await contagens(db, perfil.id);
  const fotos = await listarFotos(db, perfil.id);
  const empresa = await dadosDaEmpresa(db, user.tenantId);
  const { rows: cidades } = await db.query<{ nome: string; uf: string; slug: string; base: boolean }>(
    `SELECT c.nome, c.uf, c.slug, (c.id = $2) AS base FROM busca_cidades c
      WHERE c.id = $2 OR c.id IN (SELECT cidade_id FROM busca_perfil_cidades WHERE perfil_id = $1) ORDER BY base DESC, c.nome`,
    [perfil.id, perfil.cidade_id]
  );
  return { perfil, c, fotos, cidades, empresa };
});
const recursos = await recursosOnboarding(user.tenantId);
let rascunho: Record<string, string | string[]> | null = null;
try {
  const r = JSON.parse(Astro.cookies.get(RASCUNHO)?.value ?? 'null');
  if (r && Number(r._etapa) === Number(url.searchParams.get('etapa'))) rascunho = r;
} catch {
  rascunho = null;
}
if (Astro.cookies.has(RASCUNHO)) Astro.cookies.delete(RASCUNHO, { path: '/busca' });
const { perfil, c } = dados;
const pedida = Number(url.searchParams.get('etapa'));
// Endereços antigos (7 etapas, com pacotes): ?etapa=7 vira a revisão
const etapa = pedida >= 1 && pedida <= ETAPA_REVISAO ? pedida : pedida > ETAPA_REVISAO ? ETAPA_REVISAO : proximaEtapa(perfil, c);
const info = ETAPAS[etapa - 1];
const concluidas = [...etapasConcluidas(perfil, c)];
const editor = isAdmin(user);
const liberados = [recursos.cardapios && 'busca_cardapios', recursos.agenda && 'busca_disponibilidade'].filter(Boolean) as string[];
const cidadeBase = dados.cidades.find((x) => x.base) ?? null;
/** Perfil com os valores digitados por cima (texto, números e marcações) para repreencher o formulário */
function comRascunho<T extends Record<string, any>>(p: T, r: Record<string, string | string[]>): T {
  const out: Record<string, any> = { ...p };
  for (const [k, v] of Object.entries(r)) {
    if (!(k in p)) continue;
    if (Array.isArray(p[k])) out[k] = Array.isArray(v) ? v : [v];
    else if (typeof p[k] === 'boolean') out[k] = v === 'on';
    else if (typeof p[k] === 'number' || p[k] === null) out[k] = typeof v === 'string' && v !== '' && /^\d+$/.test(v) ? Number(v) : v || null;
    else out[k] = v;
  }
  // O endereço digitado fica no campo `endereco` (no perfil é o `slug`)
  if (typeof r.endereco === 'string' && 'slug' in p) out.slug = r.endereco || (p as any).id;
  // checkbox desmarcado não vai no POST
  for (const k of ['espaco_proprio', 'atende_domicilio', 'aceita_menor']) if (k in p && !(k in r)) out[k] = false;
  for (const k of ['tipos_evento', 'tipos_servico', 'restricoes']) if (k in p && !(k in r) && Number(r._etapa) === 2) out[k] = [];
  return out as T;
}
const extras = dados.cidades.filter((x) => !x.base);
const feitas = concluidas.filter((n) => n <= ETAPAS_PARA_PUBLICAR).length;
const publicoUrl = perfil.publicado ? buscaUrl(`/buffet/${perfil.slug}`) : appUrl(`/vitrine/buffet/${perfil.slug}?previa=1`);
---

<AppLayout title={`${info.titulo} · Banket Busca`} heading={`Banket Busca / ${info.titulo}`}>
  <div class="onb-situacao" data-situacao>
    <span class:list={['badge', perfil.publicado ? 'badge-success' : 'badge-warning']}>{perfil.publicado ? 'Publicado' : 'Rascunho'}</span>
    <span class="tabular">{feitas} de {ETAPAS_PARA_PUBLICAR} etapas concluídas</span>
    <span class="tabular">Completude {perfil.completude}%</span>
    <span class="onb-situacao-barra" role="progressbar" aria-label="Completude do perfil" aria-valuemin="0" aria-valuemax="100" aria-valuenow={perfil.completude}><span style={`width:${perfil.completude}%`}></span></span>
    <a href="/busca/desempenho" class="btn btn-outline btn-sm"><Icon name="chart-bar" size={16} /> Desempenho</a>
    <a href={publicoUrl} target="_blank" rel="noopener" class="btn btn-outline btn-sm"><Icon name="eye" size={16} /> {perfil.publicado ? 'Ver perfil público' : 'Ver prévia'}</a>
  </div>
  <div class="onb-corpo">
  <Etapas etapa={etapa} concluidas={concluidas} liberados={liberados} />
  <div class="onb-principal">
  <div class="onb-cabeca">
    <span class="eyebrow" style="color:var(--terracotta-700)">Etapa {etapa} · {info.titulo}</span>
    <h1>{info.h}</h1>
    <p>{info.p}</p>
  </div>
  {!editor && <div class="onb-aviso">Só proprietários e administradores editam o perfil. Você pode consultar as etapas.</div>}

  {etapa === 1 && <Empresa perfil={rascunho ? comRascunho(perfil, rascunho) : perfil} editor={editor} empresa={dados.empresa} faltas={faltasDaEmpresa(dados.empresa)} endereco={recursos.endereco} />}
  {etapa === 2 && <Eventos perfil={rascunho ? comRascunho(perfil, rascunho) : perfil} editor={editor} maxEventos={recursos.maxEventos} maxServicos={recursos.maxServicos} />}
  {etapa === 3 && <Regiao perfil={rascunho ? comRascunho(perfil, rascunho) : perfil} editor={editor} cidadeBase={cidadeBase} extras={extras} />}
  {etapa === 4 && <Capacidade perfil={rascunho ? comRascunho(perfil, rascunho) : perfil} editor={editor} />}
  {etapa === ETAPA_FOTOS && <Fotos fotos={dados.fotos} tenantId={user.tenantId} editor={editor} maxFotos={recursos.maxFotos} tags={recursos.tags} />}
  {etapa === ETAPA_REVISAO && <Revisao perfil={perfil} contagens={c} fotos={dados.fotos} cidade={cidadeBase} editor={editor} />}
  </div>
  </div>
</AppLayout>

---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';
import EstadoVazio from '../../components/ui/EstadoVazio.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import ReuniaoDrawer from '../../components/reunioes/ReuniaoDrawer.astro';
import { withTenant } from '../../lib/db';
import { handleFormPost } from '../../lib/actions';
import { UserError, optionalUuid } from '../../lib/forms';
import { html } from '../../lib/html';
import { dataCurta } from '../../lib/datas';
import { googleConfigurado } from '../../lib/google';
import { agendaAtiva } from '../../server/googleConta';
import { agendarReuniao, atualizarReuniao, cancelarReuniao, eventosParaReuniao, listarReunioes, reuniaoSchema } from '../../server/reunioes';

// Reuniões da empresa (próximas e passadas), agendadas na agenda Google de quem as organiza.
const user = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) =>
    withTenant(user.tenantId, async (db) => {
      if (data._action === 'cancelar') {
        const reuniaoId = optionalUuid().parse(data.reuniao_id);
        if (!reuniaoId) throw new UserError('Reunião não encontrada.');
        await cancelarReuniao(db, user, reuniaoId);
        return 'Reunião cancelada. Os participantes foram avisados pelo Google Agenda.';
      }
      const input = reuniaoSchema.parse(data);
      const reuniaoId = optionalUuid().parse(data.id);
      if (reuniaoId) {
        await atualizarReuniao(db, user, reuniaoId, input);
        return 'Reunião atualizada. Os participantes recebem a alteração pelo Google Agenda.';
      }
      const r = await agendarReuniao(db, user, input);
      return r.meet_link ? 'Reunião agendada na sua agenda Google, com o link do Google Meet.' : 'Reunião agendada na sua agenda Google.';
    })
  );
}

const filtro = Astro.url.searchParams.get('quando') === 'passadas' ? 'passadas' : 'proximas';
const [{ reunioes, eventos }, ativa] = await Promise.all([
  withTenant(user.tenantId, async (db) => ({ reunioes: await listarReunioes(db, filtro), eventos: await eventosParaReuniao(db) })),
  agendaAtiva(user.id),
]);
const configurado = googleConfigurado();
const podeAlterar = (r: { usuario_id: string | null }) => user.role !== 'usuario' || r.usuario_id === user.id;

// Células montadas por funções auxiliares (expressão html`` numa linha só: o compilador do Astro se perde em ${ } multilinha)
const valoresDe = (r: (typeof reunioes)[number]) =>
  JSON.stringify({
    id: r.id, titulo: r.titulo, evento_id: r.evento_id ?? '', data: r.data, hora: r.hora, duracao_min: String(r.duracao_min),
    participantes: r.participantes.join(', '), local: r.local ?? '', descricao: r.descricao ?? '',
  });
const celulaTitulo = (r: (typeof reunioes)[number]) => html`<strong class="reuniao-titulo">${r.titulo}</strong>${r.local ? html`<span class="reuniao-apoio">${r.local}</span>` : ''}`;
const celulaEvento = (r: (typeof reunioes)[number]) => (r.evento_id ? html`<a class="link" href="/eventos/${r.evento_id}/reunioes">${r.evento_titulo ?? 'Evento'}</a>` : '');
const linkMeet = (r: (typeof reunioes)[number]) => (r.meet_link && filtro === 'proximas' ? html`<a class="row-action" href="${r.meet_link}" target="_blank" rel="noopener">Meet</a>` : '');
const botaoEditar = (r: (typeof reunioes)[number]) => html`<button type="button" class="row-action" data-drawer-open="drawer-reuniao" data-values="${valoresDe(r)}">Editar</button>`;
const formCancelar = (r: (typeof reunioes)[number]) => html`<form method="post" class="inline-form"><input type="hidden" name="_action" value="cancelar" /><input type="hidden" name="reuniao_id" value="${r.id}" /><button type="submit" class="row-action perigo" data-confirm="Cancelar a reunião &quot;${r.titulo}&quot;?" data-confirm-texto="O evento sai da agenda Google e os participantes são avisados." data-confirm-rotulo="Cancelar reunião">Cancelar</button></form>`;
const celulaAcoes = (r: (typeof reunioes)[number]) => (filtro === 'proximas' && podeAlterar(r) ? html`${linkMeet(r)} ${botaoEditar(r)} ${formCancelar(r)}` : linkMeet(r));

const tableData = reunioes.map((r) => ({
  quando: html`<span class="tabular">${dataCurta(r.data)} · ${r.hora}</span>`,
  titulo: celulaTitulo(r),
  evento: celulaEvento(r),
  cliente: r.cliente_nome ?? '',
  organizador: r.organizador_nome ?? '',
  acoes: celulaAcoes(r),
}));
---

<AppLayout title="Reuniões" heading="Reuniões" voltar={{ href: '/agenda', label: 'Agenda' }}>
  <PageToolbar filters={[{ name: 'quando', placeholder: 'Próximas', options: [{ value: 'passadas', label: 'Passadas' }] }]}>
    {ativa ? (
      <Button icon="calendar-plus" data-drawer-open="drawer-reuniao" data-values={JSON.stringify({ duracao_min: '60' })}>Agendar reunião</Button>
    ) : configurado ? (
      <Button variant="secondary" icon="brand-google" href="/api/google/vincular?agenda=1">Ativar agenda do Google</Button>
    ) : null}
  </PageToolbar>

  <Table
    columns={[
      { key: 'quando', label: 'Quando' },
      { key: 'titulo', label: 'Reunião' },
      { key: 'evento', label: 'Evento' },
      { key: 'cliente', label: 'Cliente' },
      { key: 'organizador', label: 'Organizador' },
      { key: 'acoes', label: 'Ações', align: 'right' },
    ]}
    data={tableData}
  >
    <EstadoVazio
      slot="empty"
      icon="video"
      titulo={filtro === 'passadas' ? 'Nenhuma reunião passada' : 'Nenhuma reunião agendada'}
      texto={ativa ? 'Agende reuniões com clientes: elas vão para a sua agenda Google com a sala do Google Meet.' : configurado ? 'Vincule sua conta Google com acesso à agenda em Minha conta para agendar reuniões com Google Meet.' : 'O login com o Google não está configurado neste servidor.'}
    >
      {ativa ? (
        <button type="button" class="btn btn-primary btn-md" data-drawer-open="drawer-reuniao" data-values={JSON.stringify({ duracao_min: '60' })}>Agendar reunião</button>
      ) : configurado ? (
        <a class="btn btn-secondary btn-md" href="/conta">Minha conta</a>
      ) : null}
    </EstadoVazio>
  </Table>

  <ReuniaoDrawer slot="overlays" eventos={eventos} />
</AppLayout>

<style>
  :global(.reuniao-titulo) {
    display: block;
    color: var(--text-strong);
    font-weight: var(--fw-medium);
  }

  :global(.reuniao-apoio) {
    display: block;
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }
</style>

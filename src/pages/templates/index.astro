---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import EstadoVazio from '../../components/ui/EstadoVazio.astro';
import InfoCard from '../../components/ui/InfoCard.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import { withTenant } from '../../lib/db';
import { TEMPLATES_SUBMENU } from '../../lib/nav';
import { searchTerm } from '../../lib/pagination';
import { fileUrl } from '../../lib/storage';
import { listarTemplates } from '../../server/templates';

const { tenantId } = Astro.locals.user;
const busca = searchTerm(Astro.url);
const templates = await withTenant(tenantId, (db) => listarTemplates(db, busca));
---

<AppLayout title="Templates" heading="Templates" submenu={TEMPLATES_SUBMENU} submenuActive="templates">
  <PageToolbar>
    <Button icon="circle-plus" href="/templates/novo">Novo template</Button>
  </PageToolbar>

  {templates.length === 0 ? (
    <EstadoVazio
      icon={busca ? 'search-off' : 'template'}
      titulo={busca ? 'Nenhum template para esta busca' : 'Nenhum template cadastrado'}
      texto={busca ? undefined : 'O template define o visual do PDF da proposta: capa, fontes, cores e imagens de fundo.'}
    >
      {busca ? <a class="btn btn-secondary btn-md" href={Astro.url.pathname}>Limpar busca</a> : <Button icon="circle-plus" href="/templates/novo">Novo template</Button>}
    </EstadoVazio>
  ) : (
    <div class="cards-grid">
      {templates.map((t) => (
        <InfoCard
          title={t.nome}
          icon="template"
          description={t.descricao ?? 'Sem descrição.'}
          class={t.padrao ? 'card-template card-padrao' : 'card-template'}
          tags={t.tags.filter((x) => x.toLowerCase() !== 'padrão')}
        >
          {t.padrao && <span slot="status" class="badge badge-accent selo-padrao">Padrão</span>}
          <a
            href={`/templates/${t.id}`}
            class="miniatura"
            style={`--fundo:${t.cor_fundo};--destaque:${t.cor_texto_secundaria};--texto:${t.cor_texto_primaria};${t.capa_imagem_path ? `background-image:url('${fileUrl(tenantId, t.capa_imagem_path)}')` : ''}`}
            aria-label={`Editar ${t.nome}`}
          >
            <span class:list={['miniatura-titulo', { 'sobre-imagem': Boolean(t.capa_imagem_path) }]} style={`font-family:'${t.fonte_titulo}', sans-serif`}>
              {t.capa_titulo}
            </span>
          </a>
          <Button slot="footer" variant="secondary" block href={`/templates/${t.id}`}>Editar</Button>
        </InfoCard>
      ))}
    </div>
  )}
</AppLayout>

<style>
  /* Lista no padrão CatalogCard do design system: descrição, miniatura 16/9 da capa, tags e "Editar" secundário */
  .cards-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    max-width: 1000px;
  }

  .selo-padrao {
    padding-left: var(--space-2);
  }

  .selo-padrao::before {
    display: none;
  }

  /* Moldura da miniatura segue o design system; o conteúdo imita a capa do PDF (fonte, cor e caixa do template) */
  .miniatura {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--fundo);
    background-size: cover;
    background-position: center;
    text-align: center;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .miniatura:hover {
    border-color: var(--border-strong);
  }

  .miniatura-titulo {
    color: var(--destaque);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .miniatura-titulo.sobre-imagem {
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
</style>

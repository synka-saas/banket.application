---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionCard from '../../components/ui/SectionCard.astro';
import FileUpload from '../../components/ui/FileUpload.astro';
import { withTenant } from '../../lib/db';
import { handleFormPost } from '../../lib/actions';
import { formatarDocumento } from '../../lib/documento';
import { UserError } from '../../lib/forms';
import { CONFIG_SUBMENU } from '../../lib/nav';
import { fileUrl, removeFile, saveUpload } from '../../lib/storage';
import { VARIAVEIS_EMAIL, carregarEmpresa, empresaSchema, removerLogo, salvarEmpresa } from '../../server/empresa';

const { tenantId } = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data, raw) => {
    const input = empresaSchema.parse(data);
    const logo = raw.get('logo');
    let logoPath: string | null = null;
    if (logo instanceof File && logo.size > 0) {
      try {
        logoPath = await saveUpload(tenantId, 'empresa', logo);
      } catch (err) {
        throw new UserError(err instanceof Error ? err.message : 'Falha ao enviar o logotipo.');
      }
    }
    // Remover o logotipo vale junto com o salvar, sem descartar os demais campos (um logo novo prevalece)
    const removerAtual = data.remover_logo === 'on' && !logoPath;
    const antigo = await withTenant(tenantId, async (db) => {
      await salvarEmpresa(db, input, logoPath);
      return removerAtual ? removerLogo(db) : null;
    });
    if (antigo) await removeFile(tenantId, antigo);
    return 'Dados da empresa atualizados.';
  });
}

const empresa = await withTenant(tenantId, (db) => carregarEmpresa(db));
---

<AppLayout title="Empresa" heading="Configurações / Empresa" submenu={CONFIG_SUBMENU} submenuActive="empresa">
  <form method="post" enctype="multipart/form-data" class="empresa-form" data-form-sujo>
    <div class="form-actions">
      <Button type="submit" variant="primary" data-carregando="Salvando…">Salvar</Button>
    </div>

    <SectionCard title="Dados da empresa" icon="domain">
      <div class="form-grid">
        <div class="field">
          <label for="emp-nome">Nome fantasia<span class="obrigatorio">*</span></label>
          <input id="emp-nome" name="nome" required maxlength="255" value={empresa.nome} />
        </div>
        <div class="field">
          <label for="emp-razao">Razão social</label>
          <input id="emp-razao" name="razao_social" maxlength="255" value={empresa.razao_social ?? ''} />
        </div>
        <div class="field">
          <label for="emp-tipo">Tipo</label>
          <select id="emp-tipo" name="tipo_pessoa">
            <option value="PJ" selected={empresa.tipo_pessoa === 'PJ'}>Pessoa jurídica</option>
            <option value="PF" selected={empresa.tipo_pessoa === 'PF'}>Pessoa física</option>
          </select>
        </div>
        <div class="field">
          <label for="emp-doc" data-rotulo-documento>{empresa.tipo_pessoa === 'PF' ? 'CPF' : 'CNPJ'}</label>
          <input id="emp-doc" name="documento" inputmode="numeric" value={formatarDocumento(empresa.documento)} data-mascara="documento" data-mascara-tipo="emp-tipo" />
        </div>
        <div class="field">
          <label for="emp-email">E-mail</label>
          <input id="emp-email" name="email" type="email" value={empresa.email ?? ''} />
        </div>
        <div class="field">
          <label for="emp-tel">Telefone / WhatsApp</label>
          <input id="emp-tel" name="telefone" value={empresa.telefone ?? ''} inputmode="tel" data-mascara="telefone" />
        </div>
        <div class="field span-2">
          <label for="emp-end">Endereço</label>
          <input id="emp-end" name="endereco" maxlength="500" value={empresa.endereco ?? ''} />
        </div>
        <div class="field span-2">
          <span class="field-label">Logotipo</span>
          <FileUpload
            name="logo"
            atualUrl={empresa.logo_path ? fileUrl(tenantId, empresa.logo_path) : null}
            atualNome="Logotipo atual"
            removerName="remover_logo"
          />
          <span class="field-hint">Usado nos templates de orçamento.</span>
        </div>
      </div>
    </SectionCard>

    <SectionCard title="Parâmetros comerciais" icon="room_service">
      <div class="form-grid cols-3">
        <div class="field">
          <label for="cfg-validade">Validade da proposta (dias)<span class="obrigatorio">*</span></label>
          <input id="cfg-validade" name="validade_proposta_dias" type="number" min="1" required value={empresa.validade_proposta_dias} />
        </div>
        <div class="field">
          <label for="cfg-isenta">Criança não paga até (anos)<span class="obrigatorio">*</span></label>
          <input id="cfg-isenta" name="criancas_isentas_ate" type="number" min="0" required value={empresa.criancas_isentas_ate} />
        </div>
        <div class="field">
          <label for="cfg-meia">Criança paga meia até (anos)<span class="obrigatorio">*</span></label>
          <input id="cfg-meia" name="criancas_meia_ate" type="number" min="0" required value={empresa.criancas_meia_ate} />
        </div>
        <div class="field span-3">
          <label for="cfg-local">Local padrão dos eventos</label>
          <input id="cfg-local" name="local_padrao" maxlength="255" placeholder="Ex.: Salão Jardim" value={empresa.local_padrao ?? ''} />
        </div>
      </div>
    </SectionCard>

    <SectionCard title="Assinatura da proposta" icon="edit">
      <div class="form-grid cols-3">
        <div class="field">
          <label for="ass-nome">Nome</label>
          <input id="ass-nome" name="assinatura_nome" maxlength="255" placeholder="Ex.: Maria Souza" value={empresa.assinatura_nome ?? ''} />
        </div>
        <div class="field">
          <label for="ass-cargo">Cargo</label>
          <input id="ass-cargo" name="assinatura_cargo" maxlength="255" placeholder="Ex.: Proprietário" value={empresa.assinatura_cargo ?? ''} />
        </div>
        <div class="field">
          <label for="ass-tel">Telefone</label>
          <input id="ass-tel" name="assinatura_telefone" maxlength="30" value={empresa.assinatura_telefone ?? ''} />
        </div>
      </div>
    </SectionCard>

    <SectionCard title="E-mail de envio do orçamento" icon="description">
      <div class="form-grid">
        <div class="field span-2">
          <label for="mail-assunto">Assunto<span class="obrigatorio">*</span></label>
          <input id="mail-assunto" name="email_assunto" required maxlength="255" value={empresa.email_assunto} />
        </div>
        <div class="field span-2">
          <label for="mail-corpo">Mensagem<span class="obrigatorio">*</span></label>
          <textarea id="mail-corpo" name="email_corpo" required rows="8">{empresa.email_corpo}</textarea>
          <div class="vars">
            <span class="field-hint">Clique para inserir no campo:</span>
            {VARIAVEIS_EMAIL.map((v) => (
              <button type="button" class="chip-var" data-var={v}>{v}</button>
            ))}
          </div>
        </div>
        <div class="field span-2">
          <span class="field-label">Prévia com dados de exemplo</span>
          <div class="mail-previa" data-mail-previa>
            <p class="mail-previa-assunto" data-previa-assunto></p>
            <p class="mail-previa-corpo" data-previa-corpo></p>
          </div>
        </div>
      </div>
    </SectionCard>
  </form>
</AppLayout>

<style>
  .empresa-form {
    max-width: 1000px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 16px;
  }

  .cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cols-3 .span-3 {
    grid-column: 1 / -1;
  }

  @media (max-width: 768px) {
    .cols-3 {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .vars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .chip-var {
    padding: 3px 10px;
    border: 1px solid var(--color-border-input);
    border-radius: 12px;
    background: var(--color-white);
    font-size: 12px;
    font-family: monospace;
    color: var(--color-neutral-80);
    cursor: pointer;
  }

  .chip-var:hover {
    border-color: var(--color-primary-50);
    color: var(--color-primary-text);
  }

  .mail-previa {
    padding: 14px 16px;
    background: var(--color-neutral-10);
    border: 1px dashed var(--color-neutral-30);
    border-radius: var(--border-radius);
    font-size: 13px;
    line-height: 1.6;
  }

  .mail-previa-assunto {
    font-weight: 700;
    margin-bottom: 8px;
  }

  .mail-previa-corpo {
    white-space: pre-wrap;
  }
</style>

<script>
  // Modelo de e-mail: chips inserem a variável no cursor e a prévia mostra o resultado com dados de exemplo (UX-151)
  const assunto = document.getElementById('mail-assunto') as HTMLInputElement | null;
  const corpo = document.getElementById('mail-corpo') as HTMLTextAreaElement | null;
  const previaAssunto = document.querySelector<HTMLElement>('[data-previa-assunto]');
  const previaCorpo = document.querySelector<HTMLElement>('[data-previa-corpo]');
  if (assunto && corpo && previaAssunto && previaCorpo) {
    const EXEMPLO: Record<string, string> = {
      nome_cliente: 'Maria Souza',
      evento: 'Casamento – Maria Souza',
      data_evento: '12/06/2027',
      empresa: (document.getElementById('emp-nome') as HTMLInputElement | null)?.value || 'Sua empresa',
      valor_total: 'R$ 25.400,00',
      versao: '02',
    };
    const aplicar = (texto: string) => texto.replace(/\{(\w+)\}/g, (m, v: string) => EXEMPLO[v] ?? m);
    const atualizar = () => {
      previaAssunto.textContent = aplicar(assunto.value);
      previaCorpo.textContent = aplicar(corpo.value);
    };
    assunto.addEventListener('input', atualizar);
    corpo.addEventListener('input', atualizar);
    atualizar();

    let alvo: HTMLInputElement | HTMLTextAreaElement = corpo;
    assunto.addEventListener('focus', () => (alvo = assunto));
    corpo.addEventListener('focus', () => (alvo = corpo));
    document.querySelectorAll<HTMLButtonElement>('.chip-var').forEach((chip) =>
      chip.addEventListener('click', () => {
        const v = chip.dataset.var!;
        const inicio = alvo.selectionStart ?? alvo.value.length;
        const fim = alvo.selectionEnd ?? alvo.value.length;
        alvo.value = alvo.value.slice(0, inicio) + v + alvo.value.slice(fim);
        alvo.focus();
        alvo.setSelectionRange(inicio + v.length, inicio + v.length);
        atualizar();
      })
    );
  }
</script>

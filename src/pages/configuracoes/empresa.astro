---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import SectionCard from '../../components/ui/SectionCard.astro';
import Icon from '../../components/ui/Icon.astro';
import FileUpload from '../../components/ui/FileUpload.astro';
import { withTenant } from '../../lib/db';
import { handleFormPost } from '../../lib/actions';
import { formatarDocumento } from '../../lib/documento';
import { UFS, formatarCep } from '../../lib/endereco';
import { UserError } from '../../lib/forms';
import { configSubmenuDoPlano } from '../../lib/nav';
import { podeUsarEm } from '../../lib/planos/gating';
import { sincronizarPerfisComEmpresa } from '../../server/busca/onboarding';
import { fileUrl, removeFile, saveUpload } from '../../lib/storage';
import { carregarEmpresa, empresaSchema, removerLogo, salvarEmpresa } from '../../server/empresa';
import { espacosParaSelecao } from '../../server/espacos';

const { tenantId } = Astro.locals.user;
// Plano sem Configurações (plano Busca): só os dados da empresa; os parâmetros da proposta seguem no formulário, ocultos
const temConfiguracoes = podeUsarEm(Astro.locals.plano, 'configuracoes');

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data, raw) => {
    const input = empresaSchema.parse(data);
    const logo = raw.get('logo');
    let logoPath: string | null = null;
    if (logo instanceof File && logo.size > 0) {
      try {
        logoPath = await saveUpload(tenantId, 'empresa', logo);
      } catch (err) {
        throw new UserError(err instanceof Error ? err.message : 'Falha ao enviar o logotipo.');
      }
    }
    // Remover o logotipo vale junto com o salvar, sem descartar os demais campos (um logo novo prevalece)
    const removerAtual = data.remover_logo === 'on' && !logoPath;
    const antigo = await withTenant(tenantId, async (db) => {
      await salvarEmpresa(db, input, logoPath);
      const removido = removerAtual ? await removerLogo(db) : null;
      // O perfil no Banket Busca usa estes dados (nome, documento, e-mail, telefone, logotipo): mantém igual
      await sincronizarPerfisComEmpresa(db, tenantId, { logoAlterado: Boolean(logoPath) || removerAtual });
      return removido;
    });
    if (antigo) await removeFile(tenantId, antigo);
    return 'Dados da empresa atualizados.';
  });
}

const { empresa, espacos } = await withTenant(tenantId, async (db) => {
  const empresa = await carregarEmpresa(db);
  return { empresa, espacos: await espacosParaSelecao(db, empresa.espaco_padrao_id) };
});
---

<AppLayout title="Empresa" heading="Configurações / Empresa" submenu={configSubmenuDoPlano(temConfiguracoes)} submenuActive="empresa">
  <form method="post" enctype="multipart/form-data" class="empresa-form" data-form-sujo>
    <SectionCard title="Dados da empresa" icon="building">
      <div class="form-grid">
        <div class="field span-2">
          <label for="emp-tenant">Tenant da conta</label>
          <div class="emp-tenant">
            <input id="emp-tenant" value={tenantId} readonly aria-readonly="true" class="emp-tenant-id" aria-describedby="emp-tenant-ajuda" />
            <button type="button" class="btn btn-outline btn-md" data-copiar-tenant={tenantId}><Icon name="copy" size={16} /> Copiar</button>
          </div>
          <p class="field-hint" id="emp-tenant-ajuda">Identificador único da sua conta no Banket. Informe-o ao suporte quando precisar; não pode ser alterado.</p>
        </div>
        <div class="field">
          <label for="emp-nome">Nome fantasia<span class="obrigatorio">*</span></label>
          <input id="emp-nome" name="nome" required maxlength="255" value={empresa.nome} />
        </div>
        <div class="field">
          <label for="emp-razao">Razão social</label>
          <input id="emp-razao" name="razao_social" maxlength="255" value={empresa.razao_social ?? ''} />
        </div>
        <div class="field">
          <label for="emp-tipo">Tipo</label>
          <select id="emp-tipo" name="tipo_pessoa">
            <option value="PJ" selected={empresa.tipo_pessoa === 'PJ'}>Pessoa jurídica</option>
            <option value="PF" selected={empresa.tipo_pessoa === 'PF'}>Pessoa física</option>
          </select>
        </div>
        <div class="field">
          <label for="emp-doc" data-rotulo-documento>{empresa.tipo_pessoa === 'PF' ? 'CPF' : 'CNPJ'}</label>
          <input id="emp-doc" name="documento" inputmode="numeric" value={formatarDocumento(empresa.documento)} data-mascara="documento" data-mascara-tipo="emp-tipo" />
        </div>
        <div class="field">
          <label for="emp-email">E-mail</label>
          <input id="emp-email" name="email" type="email" value={empresa.email ?? ''} />
        </div>
        <div class="field">
          <label for="emp-tel">Telefone / WhatsApp</label>
          <input id="emp-tel" name="telefone" value={empresa.telefone ?? ''} inputmode="tel" data-mascara="telefone" />
        </div>
        <fieldset class="emp-endereco span-2" data-endereco>
          <legend class="field-label">Endereço</legend>
          <div class="emp-endereco-grid">
            <div class="field emp-cep">
              <label for="emp-cep">CEP</label>
              <input id="emp-cep" name="cep" inputmode="numeric" autocomplete="postal-code" placeholder="00000-000" maxlength="9" value={formatarCep(empresa.cep)} data-mascara="cep" data-cep />
              <span class="field-hint" data-cep-status aria-live="polite">Digite o CEP para preencher o endereço.</span>
            </div>
            <div class="field emp-logradouro">
              <label for="emp-logradouro">Rua</label>
              <input id="emp-logradouro" name="logradouro" maxlength="255" autocomplete="address-line1" value={empresa.logradouro ?? ''} data-cep-campo="logradouro" />
            </div>
            <div class="field emp-numero">
              <label for="emp-numero">Número</label>
              <input id="emp-numero" name="numero" maxlength="20" value={empresa.numero ?? ''} />
            </div>
            <div class="field emp-complemento">
              <label for="emp-complemento">Complemento</label>
              <input id="emp-complemento" name="complemento" maxlength="120" autocomplete="address-line2" placeholder="Sala, bloco, referência" value={empresa.complemento ?? ''} />
            </div>
            <div class="field emp-bairro">
              <label for="emp-bairro">Bairro</label>
              <input id="emp-bairro" name="bairro" maxlength="120" value={empresa.bairro ?? ''} data-cep-campo="bairro" />
            </div>
            <div class="field emp-cidade">
              <label for="emp-cidade">Cidade</label>
              <input id="emp-cidade" name="cidade" maxlength="120" autocomplete="address-level2" value={empresa.cidade ?? ''} data-cep-campo="cidade" />
            </div>
            <div class="field emp-uf">
              <label for="emp-uf">UF</label>
              <select id="emp-uf" name="uf" autocomplete="address-level1" data-cep-campo="uf">
                <option value="">—</option>
                {UFS.map((u) => <option value={u} selected={empresa.uf === u}>{u}</option>)}
              </select>
            </div>
          </div>
        </fieldset>
        <div class="field span-2">
          <span class="field-label">Logotipo</span>
          <FileUpload
            name="logo"
            atualUrl={empresa.logo_path ? fileUrl(tenantId, empresa.logo_path) : null}
            atualNome="Logotipo atual"
            removerName="remover_logo"
            comprimirKb={380}
          />
          <span class="field-hint">Usado nas propostas e no perfil do Banket Busca (PNG, JPG ou WebP aparecem na vitrine).</span>
        </div>
      </div>
    </SectionCard>

    <div hidden={!temConfiguracoes} class="empresa-extras">
    <SectionCard title="Parâmetros comerciais" icon="coin">
      <div class="form-grid cols-3">
        <div class="field">
          <label for="cfg-validade">Validade da proposta<span class="obrigatorio">*</span></label>
          <div class="com-sufixo">
            <input id="cfg-validade" name="validade_proposta_dias" type="number" min="1" required value={empresa.validade_proposta_dias} aria-describedby="cfg-validade-un" />
            <span class="sufixo" id="cfg-validade-un">dias</span>
          </div>
        </div>
        <div class="field">
          <label for="cfg-isenta">Criança não paga até<span class="obrigatorio">*</span></label>
          <div class="com-sufixo">
            <input id="cfg-isenta" name="criancas_isentas_ate" type="number" min="0" required value={empresa.criancas_isentas_ate} aria-describedby="cfg-isenta-un" />
            <span class="sufixo" id="cfg-isenta-un">anos</span>
          </div>
        </div>
        <div class="field">
          <label for="cfg-meia">Criança paga meia até<span class="obrigatorio">*</span></label>
          <div class="com-sufixo">
            <input id="cfg-meia" name="criancas_meia_ate" type="number" min="0" required value={empresa.criancas_meia_ate} aria-describedby="cfg-meia-un" />
            <span class="sufixo" id="cfg-meia-un">anos</span>
          </div>
        </div>
        <div class="field span-3">
          <label for="cfg-espaco">Espaço padrão dos eventos</label>
          <select id="cfg-espaco" name="espaco_padrao_id">
            <option value="">Nenhum</option>
            {espacos.map((e) => <option value={e.id} selected={e.id === empresa.espaco_padrao_id}>{e.nome}{e.tipo === 'terceiro' ? ' (terceiro)' : ''}{e.ativo ? '' : ' (inativo)'}</option>)}
          </select>
          <span class="field-hint">Já vem selecionado em eventos novos e nos pedidos do formulário "no nosso espaço". Cadastre espaços em <a class="link" href="/espacos">Espaços</a>.</span>
        </div>
      </div>
    </SectionCard>

    <SectionCard title="Assinatura da proposta" icon="signature">
      <div class="form-grid cols-3">
        <div class="field">
          <label for="ass-nome">Nome</label>
          <input id="ass-nome" name="assinatura_nome" maxlength="255" placeholder="Ex.: Maria Souza" value={empresa.assinatura_nome ?? ''} />
        </div>
        <div class="field">
          <label for="ass-cargo">Cargo</label>
          <input id="ass-cargo" name="assinatura_cargo" maxlength="255" placeholder="Ex.: Proprietário" value={empresa.assinatura_cargo ?? ''} />
        </div>
        <div class="field">
          <label for="ass-tel">Telefone</label>
          <input id="ass-tel" name="assinatura_telefone" maxlength="30" value={empresa.assinatura_telefone ?? ''} />
        </div>
      </div>
    </SectionCard>
    </div>

    <div class="form-actions">
      <Button type="submit" variant="primary" data-carregando="Salvando…">Salvar</Button>
    </div>
  </form>
</AppLayout>

<script>
  import { toast } from '../../lib/ui';
  import { buscarCep } from '../../lib/endereco';

  // CEP (primeiro campo do endereço) → ViaCEP: preenche rua, bairro, cidade e UF e leva ao número. Só troca o que estiver
  // vazio ou o que a própria busca anterior preencheu (não apaga o que a pessoa digitou).
  const bloco = document.querySelector<HTMLElement>('[data-endereco]');
  const cep = bloco?.querySelector<HTMLInputElement>('[data-cep]');
  const status = bloco?.querySelector<HTMLElement>('[data-cep-status]');
  const preenchidos = new Map<string, string>();
  let ultimo = cep?.value.replace(/\D/g, '') ?? '';
  async function consultar() {
    if (!bloco || !cep || !status) return;
    const digitos = cep.value.replace(/\D/g, '');
    if (digitos.length !== 8 || digitos === ultimo) return;
    ultimo = digitos;
    status.textContent = 'Buscando o endereço…';
    try {
      const r = await buscarCep(digitos);
      if (!r) {
        status.textContent = 'CEP não encontrado. Preencha o endereço à mão.';
        return;
      }
      const valores: Record<string, string> = { logradouro: r.logradouro, bairro: r.bairro, cidade: r.cidade, uf: r.uf };
      for (const campo of bloco.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-cep-campo]')) {
        const novo = valores[campo.dataset.cepCampo ?? ''];
        if (!novo) continue;
        const atual = campo.value.trim();
        if (!atual || atual === preenchidos.get(campo.name)) {
          campo.value = novo;
          preenchidos.set(campo.name, novo);
          campo.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
      status.textContent = 'Endereço encontrado. Confira e informe o número.';
      document.getElementById('emp-numero')?.focus();
    } catch {
      status.textContent = 'Não foi possível consultar o CEP agora. Preencha o endereço à mão.';
    }
  }
  cep?.addEventListener('input', consultar);
  cep?.addEventListener('blur', consultar);

  document.querySelector<HTMLButtonElement>('[data-copiar-tenant]')?.addEventListener('click', async (ev) => {
    const id = (ev.currentTarget as HTMLButtonElement).dataset.copiarTenant ?? '';
    try {
      await navigator.clipboard.writeText(id);
      toast('Tenant copiado.', 'success');
    } catch {
      (document.getElementById('emp-tenant') as HTMLInputElement | null)?.select();
    }
  });
</script>

<style>
  .empresa-form {
    max-width: 960px;
  }

  .emp-endereco {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .emp-endereco legend {
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .emp-endereco-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .emp-cep { grid-column: span 3; }
  .emp-logradouro { grid-column: span 7; }
  .emp-numero { grid-column: span 2; }
  .emp-complemento { grid-column: span 3; }
  .emp-bairro { grid-column: span 3; }
  .emp-cidade { grid-column: span 4; }
  .emp-uf { grid-column: span 2; }

  @media (max-width: 768px) {
    .emp-endereco-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .emp-cep, .emp-logradouro, .emp-complemento, .emp-bairro { grid-column: span 4; }
    .emp-numero { grid-column: span 2; }
    .emp-cidade { grid-column: span 3; }
    .emp-uf { grid-column: span 1; }
  }

  .emp-tenant {
    display: flex;
    gap: var(--space-2);
  }

  .emp-tenant-id {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--text-secondary);
    background: var(--clay-25);
  }

  /* Ação única da página, ao fim do formulário */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-5);
  }

  .cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cols-3 .span-3 {
    grid-column: 1 / -1;
  }

  /* Campo com unidade (addon final do design system): a unidade fica dentro da borda do campo */
  .com-sufixo {
    position: relative;
  }

  .sufixo {
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    background: var(--bg-subtle);
    border-left: 1px solid var(--border-default);
    border-radius: 0 calc(var(--radius-md) - 1px) calc(var(--radius-md) - 1px) 0;
    font-size: var(--fs-13);
    color: var(--text-secondary);
    pointer-events: none;
  }

  .com-sufixo input {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .cols-3 {
      grid-template-columns: minmax(0, 1fr);
    }

    .form-actions :global(.btn) {
      width: 100%;
    }
  }
</style>

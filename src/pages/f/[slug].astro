---
// Página pública do formulário de captação (sem login). Renderiza as seções ativas da configuração;
// o passo a passo, a bifurcação B2B/B2C e as perguntas condicionais rodam no navegador.
import Icon from '../../components/ui/Icon.astro';
import FormularioLayout from '../../layouts/FormularioLayout.astro';
import { contentTypeFor, readFile } from '../../lib/storage';
import { formularioPublico } from '../../server/formularios';
import { SESSION_COOKIE, verifySession } from '../../lib/auth';

// Prévia para o dono (UX-076): com sessão da mesma empresa, mostra também formulário inativo, sem aceitar envio.
// A rota é pública, então a sessão é lida direto do cookie (sem exigir login).
const sessao = Astro.url.searchParams.get('previa') === '1' ? await verifySession(Astro.cookies.get(SESSION_COOKIE)?.value) : null;
let formulario = await formularioPublico(Astro.params.slug ?? '', Boolean(sessao)).catch(() => null);
const previa = Boolean(sessao && formulario && sessao.tenantId === formulario.tenantId);
if (formulario && sessao && !previa) formulario = await formularioPublico(Astro.params.slug ?? '').catch(() => null);

let logo: string | null = null;
if (formulario?.empresa.logo_path) {
  const arquivo = await readFile(formulario.tenantId, formulario.empresa.logo_path).catch(() => null);
  // A rota /uploads exige login; o logo vai embutido na página
  if (arquivo && arquivo.length < 400_000) {
    logo = `data:${contentTypeFor(formulario.empresa.logo_path)};base64,${arquivo.toString('base64')}`;
  }
}

if (!formulario) Astro.response.status = 404;

const secoes = formulario ? formulario.secoes.filter((s) => s.ativa) : [];
const mensagemSucesso =
  formulario?.mensagem_sucesso ||
  'Seu pedido foi recebido. Nossa equipe vai analisar as informações e entrar em contato em breve.';
---

{!formulario ? (
  <FormularioLayout title="Formulário indisponível" empresa="Banket">
    <div class="fp-indisponivel">
      <div class="fp-quadro-icone"><Icon name="forms" size={26} /></div>
      <h2>Formulário indisponível</h2>
      <p>Este formulário não existe ou não está recebendo respostas no momento.</p>
    </div>
  </FormularioLayout>
) : (
  <FormularioLayout title={formulario.nome} empresa={formulario.empresa.nome} logo={logo} subtitulo={formulario.nome}>
    <div class="fp-andamento">
      <p class="fp-etapa-info" id="fp-etapa-info" aria-live="polite"></p>
      <div class="fp-progresso"><div class="fp-progresso-barra" id="fp-progresso"></div></div>
    </div>

    {previa && (
      <div class="fp-previa" role="status">
        <Icon name="eye" size={16} />
        <p><strong>Pré-visualização</strong> · é assim que o cliente vê a última versão salva. Os envios ficam desativados aqui.</p>
      </div>
    )}
    <form id="fp-form" class="fp-conteudo" novalidate data-slug={Astro.params.slug} data-previa={previa ? '1' : undefined}>
      <input type="text" name="_website" class="fp-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      {secoes.map((s, i) => (
        <section class:list={['fp-etapa', { ativa: i === 0 }]} data-etapa={s.chave} data-fluxo={s.fluxo}>
          <div class="fp-etapa-titulo">
            {i > 0 && <Icon name={s.icone} size={20} />}
            <h2>{s.titulo}</h2>
          </div>
          <p class="fp-etapa-descricao">{s.descricao}</p>

          <div class="fp-perguntas">
            {s.perguntas.filter((p) => p.ativa).map((p) => (
              <div
                class:list={['fp-pergunta', { 'fp-condicional': p.mostrarSe }]}
                data-pergunta={p.id}
                data-tipo={p.tipo}
                data-rotulo={p.rotulo}
                data-obrigatoria={p.obrigatoria ? '1' : undefined}
                data-mostrar-se-chave={p.mostrarSe?.chave}
                data-mostrar-se-valor={p.mostrarSe?.valor}
                hidden={Boolean(p.mostrarSe)}
              >
                {['unica', 'multipla', 'sim_nao'].includes(p.tipo) ? (
                  <span class="fp-rotulo">{p.rotulo}{p.obrigatoria && <span class="fp-req"> *</span>}</span>
                ) : (
                  <label class="fp-rotulo" for={`fp-${p.id}`}>{p.rotulo}{p.obrigatoria && <span class="fp-req"> *</span>}</label>
                )}
                {p.ajuda && <p class="fp-ajuda">{p.ajuda}</p>}

                {p.tipo === 'texto_longo' && (
                  <textarea id={`fp-${p.id}`} name={p.id} rows="5" maxlength="5000" placeholder={p.placeholder ?? ''} class="fp-input"></textarea>
                )}
                {['texto', 'email', 'telefone', 'numero', 'data'].includes(p.tipo) && (
                  <input
                    id={`fp-${p.id}`}
                    name={p.id}
                    class="fp-input"
                    type={p.tipo === 'email' ? 'email' : p.tipo === 'telefone' ? 'tel' : p.tipo === 'data' ? 'date' : 'text'}
                    inputmode={p.tipo === 'numero' ? 'numeric' : undefined}
                    placeholder={p.placeholder ?? ''}
                    maxlength={p.tipo === 'telefone' ? 16 : 500}
                    autocomplete={{ nome: 'name', email: 'email', whatsapp: 'tel' }[p.id]}
                    data-mascara={p.tipo === 'telefone' ? 'telefone' : p.tipo === 'numero' ? 'numero' : undefined}
                  />
                )}
                {p.tipo === 'selecao' && (
                  <select id={`fp-${p.id}`} name={p.id} class="fp-input">
                    <option value="">Selecione…</option>
                    {p.opcoes.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
                  </select>
                )}
                {(p.tipo === 'unica' || p.tipo === 'sim_nao') && (
                  <div class:list={['fp-opcoes', { 'fp-opcoes-lado': p.opcoes.length <= 3 && p.opcoes.every((o) => o.rotulo.length < 40) }]}>
                    {p.opcoes.map((o) => (
                      <label class="fp-opcao">
                        <input type="radio" name={p.id} value={o.valor} />
                        <span class="fp-opcao-caixa">
                          <strong>{o.rotulo}</strong>
                          {o.descricao && <small>{o.descricao}</small>}
                        </span>
                      </label>
                    ))}
                  </div>
                )}
                {p.tipo === 'multipla' && (
                  <div class="fp-checks">
                    {p.opcoes.map((o) => (
                      <label class="fp-check">
                        <input type="checkbox" name={p.id} value={o.valor} />
                        <span>{o.rotulo}</span>
                      </label>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="fp-etapa fp-sucesso" data-etapa="_sucesso">
        <div class="fp-quadro-icone"><Icon name="sparkles" size={28} /></div>
        <h2>Tudo certo!</h2>
        <p>{mensagemSucesso}</p>
        <p class="fp-sucesso-email" data-fp-sucesso-email hidden>Enviamos uma cópia da confirmação para o seu e-mail.</p>
        <div class="fp-resumo" data-fp-resumo hidden>
          <h3>Resumo do seu pedido</h3>
          <dl data-fp-resumo-linhas></dl>
        </div>
      </section>
    </form>

    <footer class="fp-rodape" id="fp-rodape">
      <button type="button" class="fp-voltar" id="fp-voltar" hidden>Voltar</button>
      <button type="button" class="fp-avancar" id="fp-avancar">Avançar</button>
    </footer>
  </FormularioLayout>
)}

<script>
  import { toast as mostrarToast, type ToastTipo } from '../../lib/ui';
  const form = document.getElementById('fp-form') as HTMLFormElement | null;
  if (form) iniciar(form);

  function iniciar(form: HTMLFormElement) {
    const etapas = [...form.querySelectorAll<HTMLElement>('.fp-etapa:not(.fp-sucesso)')];
    const sucesso = form.querySelector<HTMLElement>('.fp-sucesso')!;
    const btnVoltar = document.getElementById('fp-voltar') as HTMLButtonElement;
    const btnAvancar = document.getElementById('fp-avancar') as HTMLButtonElement;
    const rodape = document.getElementById('fp-rodape')!;
    const barra = document.getElementById('fp-progresso')!;
    let atual = 0;
    let enviando = false;

    const toast = (m: string, t: ToastTipo = 'error') => mostrarToast(m, t);

    const natureza = () => form.querySelector<HTMLInputElement>('input[name="natureza"]:checked')?.value ?? null;

    /** Etapas do caminho atual: as de fluxo "todos" e as da natureza escolhida. */
    const caminho = () => etapas.filter((e) => e.dataset.fluxo === 'todos' || e.dataset.fluxo === natureza());

    function valor(nome: string): string | string[] | null {
      const campos = [...form.querySelectorAll<HTMLInputElement>(`[name="${CSS.escape(nome)}"]`)];
      if (!campos.length) return null;
      if (campos[0].type === 'checkbox') return campos.filter((c) => c.checked).map((c) => c.value);
      if (campos[0].type === 'radio') return campos.find((c) => c.checked)?.value ?? null;
      return campos[0].value.trim() || null;
    }

    function atualizarCondicionais() {
      form.querySelectorAll<HTMLElement>('[data-mostrar-se-chave]').forEach((el) => {
        el.hidden = valor(el.dataset.mostrarSeChave!) !== el.dataset.mostrarSeValor;
      });
    }

    const etapaInfo = document.getElementById('fp-etapa-info')!;

    function mostrar() {
      const lista = caminho();
      etapas.forEach((e) => e.classList.toggle('ativa', e === lista[atual]));
      sucesso.classList.remove('ativa');
      btnVoltar.hidden = atual === 0;
      const ultima = atual === lista.length - 1;
      btnAvancar.textContent = ultima ? (natureza() === 'B2B' ? 'Solicitar proposta' : 'Finalizar solicitação') : 'Avançar';
      barra.style.width = `${Math.round(((atual + 1) / (lista.length + 1)) * 100)}%`;
      etapaInfo.textContent = `Etapa ${atual + 1} de ${lista.length} · ${lista[atual]?.querySelector('h2')?.textContent ?? ''}`;
      form.scrollTop = 0;
    }

    // A mensagem fica junto da pergunta (o aviso some sozinho, a mensagem não — UX-070)
    function marcarErro(el: HTMLElement, mensagem: string) {
      el.classList.add('fp-erro');
      let aviso = el.querySelector<HTMLElement>('.fp-erro-msg');
      if (!aviso) {
        aviso = document.createElement('p');
        aviso.className = 'fp-erro-msg';
        aviso.setAttribute('role', 'alert');
        el.appendChild(aviso);
      }
      aviso.textContent = mensagem;
      el.querySelector<HTMLElement>('input, select, textarea')?.focus();
      el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    function validar(etapa: HTMLElement): boolean {
      for (const el of etapa.querySelectorAll<HTMLElement>('.fp-pergunta')) {
        if (el.hidden) continue;
        const v = valor(el.dataset.pergunta!);
        const vazio = v === null || (Array.isArray(v) && v.length === 0);
        el.classList.remove('fp-erro');
        el.querySelector('.fp-erro-msg')?.remove();
        if (el.dataset.obrigatoria && vazio) {
          marcarErro(el, `Preencha "${el.dataset.rotulo}" para avançar.`);
          return false;
        }
        if (!vazio && el.dataset.tipo === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v))) {
          marcarErro(el, 'Informe um e-mail válido.');
          return false;
        }
      }
      return true;
    }

    // ---------- Rascunho: recarregar a página não perde as respostas (UX-071) ----------
    const chaveRascunho = `banket-fp-${form.dataset.slug}`;
    function salvarRascunho() {
      try {
        const dados: Record<string, unknown> = {};
        form.querySelectorAll<HTMLElement>('.fp-pergunta').forEach((el) => {
          const v = valor(el.dataset.pergunta!);
          if (v !== null && !(Array.isArray(v) && v.length === 0)) dados[el.dataset.pergunta!] = v;
        });
        sessionStorage.setItem(chaveRascunho, JSON.stringify(dados));
      } catch {
        // sem armazenamento (janela privada): segue sem rascunho
      }
    }
    function restaurarRascunho() {
      try {
        const bruto = sessionStorage.getItem(chaveRascunho);
        if (!bruto) return;
        const dados = JSON.parse(bruto) as Record<string, string | string[]>;
        for (const [nome, v] of Object.entries(dados)) {
          const campos = [...form.querySelectorAll<HTMLInputElement>(`[name="${CSS.escape(nome)}"]`)];
          if (!campos.length) continue;
          if (campos[0].type === 'checkbox') campos.forEach((c) => (c.checked = Array.isArray(v) && v.includes(c.value)));
          else if (campos[0].type === 'radio') campos.forEach((c) => (c.checked = c.value === v));
          else campos[0].value = String(v);
        }
      } catch {
        // rascunho inválido: ignora
      }
    }
    function limparRascunho() {
      try {
        sessionStorage.removeItem(chaveRascunho);
      } catch {
        // nada a limpar
      }
    }

    function coletar(): Record<string, unknown> {
      const dados: Record<string, unknown> = { _website: valor('_website') ?? '' };
      for (const etapa of caminho()) {
        etapa.querySelectorAll<HTMLElement>('.fp-pergunta').forEach((el) => {
          if (!el.hidden) dados[el.dataset.pergunta!] = valor(el.dataset.pergunta!);
        });
      }
      return dados;
    }

    // Resumo do que foi enviado, na tela de sucesso (UX-072)
    function montarResumo() {
      const dl = form.querySelector<HTMLElement>('[data-fp-resumo-linhas]')!;
      dl.replaceChildren();
      let linhas = 0;
      for (const etapa of caminho()) {
        etapa.querySelectorAll<HTMLElement>('.fp-pergunta').forEach((el) => {
          if (el.hidden) return;
          const legivel = valorLegivel(el);
          if (!legivel) return;
          const dt = document.createElement('dt');
          dt.textContent = el.dataset.rotulo ?? '';
          const dd = document.createElement('dd');
          dd.textContent = legivel;
          const par = document.createElement('div');
          par.append(dt, dd);
          dl.appendChild(par);
          linhas++;
        });
      }
      form.querySelector<HTMLElement>('[data-fp-resumo]')!.hidden = linhas === 0;
      const email = valor('email');
      form.querySelector<HTMLElement>('[data-fp-sucesso-email]')!.hidden = !email;
    }

    /** Valor da pergunta com o rótulo da opção (não o código) para selects, escolhas e múltiplas. */
    function valorLegivel(el: HTMLElement): string {
      const nome = el.dataset.pergunta!;
      const campos = [...form.querySelectorAll<HTMLInputElement>(`[name="${CSS.escape(nome)}"]`)];
      if (!campos.length) return '';
      if (campos[0].type === 'checkbox') {
        return campos
          .filter((c) => c.checked)
          .map((c) => c.closest('label')?.textContent?.trim() ?? c.value)
          .join(', ');
      }
      if (campos[0].type === 'radio') {
        const marcado = campos.find((c) => c.checked);
        return marcado ? (marcado.closest('label')?.querySelector('strong')?.textContent ?? marcado.value).trim() : '';
      }
      if (campos[0] instanceof HTMLSelectElement) {
        const sel = campos[0] as unknown as HTMLSelectElement;
        return sel.value ? (sel.selectedOptions[0]?.textContent ?? sel.value).trim() : '';
      }
      return campos[0].value.trim();
    }

    async function enviar() {
      if (form.dataset.previa) {
        toast('Esta é só uma pré-visualização: os envios ficam desativados.', 'info');
        return;
      }
      if (enviando) return;
      enviando = true;
      btnAvancar.disabled = true;
      btnAvancar.textContent = 'Enviando…';
      try {
        const res = await fetch(`/api/public/formularios/${encodeURIComponent(form.dataset.slug!)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(coletar()),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error ?? 'Não foi possível enviar. Tente novamente.');
        montarResumo();
        limparRascunho();
        etapas.forEach((e) => e.classList.remove('ativa'));
        sucesso.classList.add('ativa');
        rodape.hidden = true;
        barra.style.width = '100%';
        etapaInfo.textContent = 'Pedido enviado';
      } catch (err) {
        toast(err instanceof Error ? err.message : 'Não foi possível enviar. Tente novamente.');
        btnAvancar.disabled = false;
        mostrar();
      } finally {
        enviando = false;
      }
    }

    btnAvancar.addEventListener('click', () => {
      const lista = caminho();
      if (!validar(lista[atual])) return;
      if (atual === lista.length - 1) return void enviar();
      atual += 1;
      mostrar();
    });

    btnVoltar.addEventListener('click', () => {
      if (atual > 0) atual -= 1;
      mostrar();
    });

    form.addEventListener('change', (e) => {
      atualizarCondicionais();
      (e.target as HTMLElement).closest('.fp-pergunta')?.classList.remove('fp-erro');
      if ((e.target as HTMLInputElement).name === 'natureza') mostrar();
    });

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      el.closest('.fp-pergunta')?.classList.remove('fp-erro');
    });

    // Enter em campos de texto avança em vez de enviar
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btnAvancar.click();
    });

    form.addEventListener('input', salvarRascunho);
    form.addEventListener('change', salvarRascunho);

    restaurarRascunho();
    atualizarCondicionais();
    mostrar();
  }
</script>

<style>
  /* Formulário público: a voz do buffet para o cliente final, com os fundamentos do design system
     (campos de 48px, cartões selecionáveis, barra de progresso, erros em vinho). */

  /* Ícone em quadro terracota claro (tela de sucesso e formulário indisponível) */
  .fp-quadro-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .fp-indisponivel {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    color: var(--text-secondary);
  }

  .fp-indisponivel h2 {
    color: var(--text-strong);
  }

  .fp-indisponivel p {
    max-width: 360px;
    font-size: var(--fs-15);
    line-height: 1.55;
  }

  /* ---------- Andamento: etapa atual + barra de progresso ---------- */
  .fp-andamento {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8) 0;
  }

  .fp-etapa-info {
    font-size: var(--fs-12);
    line-height: 1.4;
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .fp-progresso {
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--chart-track);
    overflow: hidden;
  }

  .fp-progresso-barra {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--terracotta-500);
    transition: width var(--dur-slow) var(--ease-out);
  }

  .fp-previa {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: var(--space-4) var(--space-8) 0;
    padding: var(--space-2-5) var(--space-3);
    border: 1px solid var(--warning-border);
    border-radius: var(--radius-md);
    background: var(--warning-bg);
    color: var(--warning);
    font-size: var(--fs-13);
    line-height: 1.45;
  }

  .fp-previa :global(.icon) {
    margin-top: 1px;
  }

  .fp-previa p {
    font-size: inherit;
  }

  .fp-conteudo {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-7) var(--space-8) var(--space-8);
  }

  .fp-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* ---------- Etapa ---------- */
  .fp-etapa {
    display: none;
  }

  .fp-etapa.ativa {
    display: block;
    animation: fp-entrar var(--dur-slow) var(--ease-out);
  }

  .fp-etapa-titulo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Ícone da etapa em quadro terracota claro, como nos títulos de card */
  .fp-etapa-titulo :global(.icon) {
    box-sizing: content-box;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--bg-accent-subtle);
    color: var(--terracotta-600);
  }

  .fp-etapa-titulo h2 {
    font-size: var(--fs-24);
    line-height: 1.25;
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
  }

  .fp-etapa-descricao {
    margin: var(--space-2) 0 var(--space-7);
    font-size: var(--fs-15);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .fp-perguntas {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .fp-pergunta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fp-pergunta[hidden] {
    display: none;
  }

  /* Pergunta que só aparece conforme outra resposta: painel sutil */
  .fp-condicional {
    padding: var(--space-4);
    background: var(--clay-25);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .fp-rotulo {
    font-size: var(--fs-14);
    line-height: 1.4;
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .fp-req {
    color: var(--terracotta-600);
  }

  .fp-ajuda {
    margin-top: calc(var(--space-1) * -1);
    font-size: var(--fs-13);
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* ---------- Campos (tamanho grande do design system: 48px) ---------- */
  .fp-input {
    width: 100%;
    min-height: var(--control-h-lg);
    padding: 0 var(--space-4);
    font-size: var(--fs-15);
    color: var(--text-strong);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    outline: none;

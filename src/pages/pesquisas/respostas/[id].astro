---
import AppLayout from '../../../layouts/AppLayout.astro';
import SectionCard from '../../../components/ui/SectionCard.astro';
import Button from '../../../components/ui/Button.astro';
import { handleFormPost } from '../../../lib/actions';
import { withTenant } from '../../../lib/db';
import { isAdmin } from '../../../lib/auth';
import { dataCurta, dataHora } from '../../../lib/datas';
import { pesquisasSubmenu } from '../../../lib/nav';
import { CLASSES_NPS, ROTULOS_NOTA, avaliacaoBuscaSchema, carregarResposta, classeNps, salvarAvaliacaoBusca } from '../../../server/pesquisas';

// Respostas de uma pesquisa (um evento), na ordem do questionário respondido.
const user = Astro.locals.user;
const id = Astro.params.id ?? '';
if (!/^[0-9a-f-]{36}$/i.test(id)) return new Response(null, { status: 404 });

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    const input = avaliacaoBuscaSchema.parse(data);
    await withTenant(user.tenantId, (db) => salvarAvaliacaoBusca(db, user, id, input));
    return 'Avaliação do Banket Busca atualizada.';
  });
}

const detalhe = await withTenant(user.tenantId, (db) => carregarResposta(db, id)).catch(() => null);
if (!detalhe) return new Response(null, { status: 404 });
const { envio, respostas, busca } = detalhe;
const notaBusca = busca.nota_busca?.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const classe = envio.nps !== null ? classeNps(envio.nps) : null;
const TAG = { promotor: 'tag-sage', neutro: 'tag-ochre', detrator: 'tag-wine' } as const;
---

<AppLayout title="Resposta da pesquisa" heading={envio.evento_titulo ?? 'Pesquisa'} voltar={{ href: '/pesquisas/respostas', label: 'Respostas' }} submenu={pesquisasSubmenu(isAdmin(user))} submenuActive="respostas">
  <div class="rp-cabecalho">
    <div>
      <a class="link rp-evento" href={`/eventos/${envio.evento_id}`}>{envio.evento_titulo ?? 'Evento'}</a>
      <p class="rp-apoio">
        {[envio.cliente_nome, envio.data_evento ? `evento em ${dataCurta(envio.data_evento)}` : null, envio.respondida_em ? `respondida em ${dataHora(envio.respondida_em)}` : 'aguardando resposta'].filter(Boolean).join(' · ')}
      </p>
    </div>
    {classe && <span class={`tag ${TAG[classe]} rp-nps`}>NPS {envio.nps} · {CLASSES_NPS[classe]}</span>}
  </div>

  <SectionCard title="Respostas" icon="message-star">
    {respostas.length ? (
      <dl class="rp-lista">
        {respostas.map((r) => (
          <div class="rp-item">
            <dt>{r.pergunta_texto}</dt>
            <dd>
              {r.tipo === 'nps' && r.nota !== null && <span class="rp-nota tabular">{r.nota}<small>/10</small></span>}
              {r.tipo === 'nota' && r.nota !== null && <span class="rp-nota tabular">{r.nota}<small>/5 · {ROTULOS_NOTA[r.nota - 1]}</small></span>}
              {r.opcoes && <span class="rp-opcoes">{r.opcoes.map((o) => <span class="tag">{o}</span>)}</span>}
              {r.texto && <p class="rp-texto">{r.texto}</p>}
            </dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="rp-apoio">O cliente ainda não respondeu.</p>
    )}
  </SectionCard>

  {busca.nota_busca != null && (
    <SectionCard title="No Banket Busca" icon="banket" description="A nota entra na média do seu perfil público. O depoimento aparece só com a autorização do cliente.">
      <div class="rp-busca">
        <span class="rp-nota tabular">{notaBusca}<small>/5 · nota média das perguntas de nota</small></span>
        {busca.depoimento ? (
          <blockquote class="rp-depoimento">
            <p>{busca.depoimento}</p>
            <footer>{busca.depoimento_nome ?? 'Cliente'}{busca.busca_oculta ? ' · oculto no perfil' : ''}</footer>
          </blockquote>
        ) : (
          <p class="rp-apoio">Sem depoimento no perfil: o cliente não autorizou ou não deixou comentário.</p>
        )}
      </div>
      {isAdmin(user) ? (
        <form method="post" class="rp-busca-form" data-form-sujo>
          <div class="field">
            <label for="rp-resposta">Resposta pública da empresa</label>
            <textarea id="rp-resposta" name="busca_resposta" rows="3" maxlength="1000" placeholder="Agradeça e, se for o caso, conte o que vai melhorar.">{busca.busca_resposta ?? ''}</textarea>
            <span class="field-hint">Aparece abaixo do depoimento, no seu perfil do Banket Busca.</span>
          </div>
          <label class="rp-check">
            <input type="checkbox" name="busca_oculta" checked={busca.busca_oculta} />
            <span>Ocultar o depoimento e a resposta no perfil (a nota continua na média)</span>
          </label>
          <div><Button type="submit" variant="secondary" data-carregando="Salvando…">Salvar</Button></div>
        </form>
      ) : busca.busca_resposta && !busca.busca_oculta && (
        <p class="rp-texto"><strong>Resposta da empresa:</strong> {busca.busca_resposta}</p>
      )}
    </SectionCard>
  )}
</AppLayout>

<style>
  .rp-busca {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rp-depoimento {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--border-accent);
    background: var(--clay-25);
    border-radius: var(--radius-sm);
  }

  .rp-depoimento footer {
    margin-top: var(--space-2);
    font-size: var(--fs-12);
    color: var(--text-secondary);
  }

  .rp-busca-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .rp-check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-13);
  }

  .rp-cabecalho {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .rp-evento {
    font-size: var(--fs-15);
    font-weight: var(--fw-medium);
  }

  .rp-apoio {
    margin-top: var(--space-1);
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .rp-lista {
    display: flex;
    flex-direction: column;
  }

  .rp-item {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-2) var(--space-6);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .rp-item:last-child {
    border-bottom: 0;
  }

  .rp-item dt {
    color: var(--text-secondary);
    font-size: var(--fs-13);
  }

  .rp-item dd {
    margin: 0;
    color: var(--text-strong);
  }

  .rp-nota {
    font-size: var(--fs-20);
    font-weight: var(--fw-medium);
  }

  .rp-nota small {
    margin-left: var(--space-1);
    font-size: var(--fs-13);
    font-weight: var(--fw-regular);
    color: var(--text-secondary);
  }

  .rp-opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .rp-texto {
    white-space: pre-line;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .rp-cabecalho {
      flex-direction: column;
    }

    .rp-item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

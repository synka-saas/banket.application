---
import Icon from '../../components/ui/Icon.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import SectionCard from '../../components/ui/SectionCard.astro';
import Button from '../../components/ui/Button.astro';
import { withTenant } from '../../lib/db';
import { formatMoney } from '../../lib/money';
import { dataComDiaSemana, dataHora, dataMesAbreviado } from '../../lib/datas';
import {
  DIAS_SEM_RESPOSTA,
  PERIODOS,
  carregarIndicadores,
  definirPrimeirosPassosOcultos,
  primeirosPassos,
  primeirosPassosOcultos,
  type Periodo,
} from '../../server/dashboard';
import { handleFormPost } from '../../lib/actions';
import { dataCurta, hojeSaoPaulo } from '../../lib/datas';
import { isAdmin } from '../../lib/auth';

const user = Astro.locals.user;
// Ocultar/reexibir os primeiros passos (preferência por usuário — UX-051)
if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    await withTenant(user.tenantId, (db) => definirPrimeirosPassosOcultos(db, user.id, data._action === 'ocultar_passos'));
    return data._action === 'ocultar_passos' ? 'Primeiros passos ocultados. Você pode reexibi-los no fim da página.' : '';
  });
}

const p = Astro.url.searchParams.get('periodo');
const periodo: Periodo = p && p in PERIODOS ? (p as Periodo) : '90';
const { ind, passos, passosOcultos } = await withTenant(user.tenantId, async (db) => ({
  ind: await carregarIndicadores(db, periodo),
  // Configuração inicial para todos os papéis; passos de Configurações só para quem pode abri-las (UX-051)
  passos: (await primeirosPassos(db)).filter((passo) => !passo.adminOnly || isAdmin(user)),
  passosOcultos: await primeirosPassosOcultos(db, user.id),
}));
const pendentes = passos.filter((p) => !p.feito).length;
const hoje = hojeSaoPaulo();

const maxEventos = Math.max(1, ...ind.porStatus.map((s) => s.eventos));
const pct = (v: number | null) => (v === null ? '—' : `${Math.round(v * 100)}%`);
const primeiroNome = user.nome.split(' ')[0];
// Quadro de data dos itens de agenda: "2026-10-29" → dia "29", mês "out", dia da semana "Quinta-feira"
const quadroData = (iso: string) => {
  const [dia, mes] = dataMesAbreviado(iso).split(' ');
  return { dia, mes, semana: dataComDiaSemana(iso).split(' · ')[1] ?? '' };
};
---

<AppLayout title="Dashboard" heading="Dashboard">
  <div class="topo">
    <div>
      <h2>Olá, {primeiroNome}</h2>
      <p class="intro">Indicadores dos pedidos que entraram no período escolhido. Os valores vêm do orçamento mais recente de cada evento.</p>
    </div>
    <form method="get">
      <select name="periodo" class="control" aria-label="Período" data-autosubmit-row>
        {Object.entries(PERIODOS).map(([v, l]) => <option value={v} selected={v === periodo}>{l}</option>)}
      </select>
    </form>
  </div>

  {pendentes > 0 && !passosOcultos && (
    <div class="passos">
      <SectionCard title="Primeiros passos" icon="list-check">
        <Fragment slot="actions">
          <span class="passos-contagem">{passos.length - pendentes} de {passos.length} concluídos</span>
          <form method="post" class="passos-ocultar">
            <Button type="submit" name="_action" value="ocultar_passos" variant="text" size="sm">Ocultar</Button>
          </form>
        </Fragment>
        <ol>
          {passos.map((p) => (
            <li class:list={{ feito: p.feito }}>
              <Icon name={p.feito ? 'circle-check' : 'circle'} size={20} />
              <a href={p.href}>
                <strong>{p.titulo}</strong>
                <span class="muted">{p.descricao}</span>
              </a>
            </li>
          ))}
        </ol>
      </SectionCard>
    </div>
  )}

  <div class="kpis">
    <div class="kpi">
      <span class="rotulo eyebrow">Pedidos recebidos</span>
      <strong>{ind.pedidos}</strong>
      <span class="dica">{PERIODOS[periodo].toLowerCase()}</span>
    </div>
    <div class="kpi">
      <span class="rotulo eyebrow">Em aberto</span>
      <strong title={formatMoney(ind.pipeline.valor)}>{formatMoney(ind.pipeline.valor)}</strong>
      <span class="dica">{ind.pipeline.eventos} evento{ind.pipeline.eventos === 1 ? '' : 's'} no funil</span>
    </div>
    <div class="kpi">
      <span class="rotulo eyebrow">Aprovados</span>
      <strong class="positivo" title={formatMoney(ind.aprovados.valor)}>{formatMoney(ind.aprovados.valor)}</strong>
      <span class="dica">{ind.aprovados.eventos} evento{ind.aprovados.eventos === 1 ? '' : 's'}</span>
    </div>
    <div class="kpi">
      <span class="rotulo eyebrow">Taxa de conversão</span>
      <strong class:list={{ vazio: ind.conversao === null }}>{pct(ind.conversao)}</strong>
      <span class="dica">{ind.aprovados.eventos} aprovados · {ind.recusados} recusados</span>
    </div>
    <div class="kpi">
      <span class="rotulo eyebrow">Ticket médio</span>
      <strong class:list={{ vazio: ind.ticketMedio === null }}>{ind.ticketMedio === null ? '—' : formatMoney(ind.ticketMedio)}</strong>
      <span class="dica">dos eventos aprovados</span>
    </div>
  </div>

  <div class="grade">
    <div class="coluna">
    <SectionCard title="Funil por etapa" icon="layout-kanban" description={`Pedidos que entraram em: ${PERIODOS[periodo].toLowerCase()}`}>
      <Button slot="actions" variant="text" size="sm" href="/eventos">Ver funil <Icon name="chevron-right" size={15} /></Button>
      
      <ul class="funil">
        {ind.porStatus.map((s) => (
          <li>
            <a href={`/eventos?view=lista&status=${s.id}`} class="funil-nome">
              <span class="bolinha" style={`background:${s.cor}`}></span>{s.nome}
            </a>
            <span class="barra"><span style={`width:${(s.eventos / maxEventos) * 100}%;background:${s.cor}`}></span></span>
            <span class="funil-num">{s.eventos}</span>
            <span class="funil-valor">{formatMoney(s.valor)}</span>
          </li>
        ))}
      </ul>
    </SectionCard>
    <SectionCard title={`Propostas sem retorno há ${DIAS_SEM_RESPOSTA}+ dias`} icon="send" description="Situação de agora · não depende do período">
      
      {ind.parados.length === 0 ? (
        <p class="sem-itens">Nenhuma proposta enviada aguardando retorno há mais de {DIAS_SEM_RESPOSTA} dias.</p>
      ) : (
        <ul class="lista">
          {ind.parados.map((o) => (
            <li>
              <a href={`/eventos/${o.id}/orcamento`}>
                <span class="item-texto">
                  <strong>{o.titulo ?? o.cliente_nome ?? 'Evento'}</strong>
                  <span class="muted">Enviada em {dataHora(o.enviado_em)} para {o.enviado_para ?? '—'} · há {o.dias} dias</span>
                </span>
                <span class="selo selo-valor">{formatMoney(o.valor)}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </SectionCard>
    </div>

    <div class="coluna">
    <SectionCard title="Retornos combinados" icon="bell" description="Anotações com data de retorno · não depende do período">
      
      {ind.retornos.length === 0 ? (
        <p class="sem-itens">Nenhum retorno agendado. Registre anotações com data de retorno na linha do tempo dos eventos.</p>
      ) : (
        <ul class="lista">
          {ind.retornos.map((r) => {
            const quadro = quadroData(r.retorno_em);
            const vencido = r.retorno_em < hoje;
            return (
              <li>
                <a href={`/eventos/${r.id}/linha-do-tempo`}>
                  <span class="quadro-data">
                    <span class="quadro-dia">{quadro.dia}</span>
                    <span class="quadro-mes">{quadro.mes}</span>
                  </span>
                  <span class="item-texto">
                    <strong>{r.titulo ?? r.cliente_nome ?? 'Evento'}</strong>
                    <span class="muted">{r.descricao}</span>
                  </span>
                  <span class:list={['selo', vencido ? 'badge badge-warning' : 'selo-data']}>
                    {vencido ? `Venceu em ${dataCurta(r.retorno_em)}` : dataCurta(r.retorno_em)}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </SectionCard>
    <SectionCard title="Próximos 30 dias" icon="calendar" description="Eventos a partir de hoje · não depende do período">
      
      {ind.proximos.length === 0 ? (
        <p class="sem-itens">Nenhum evento agendado nos próximos 30 dias.</p>
      ) : (
        <ul class="lista">
          {ind.proximos.map((e) => {
            const quadro = quadroData(e.data_evento);
            return (
              <li>
                <a href={`/eventos/${e.id}`}>
                  <span class="quadro-data" title={dataComDiaSemana(e.data_evento)}>
                    <span class="quadro-dia">{quadro.dia}</span>
                    <span class="quadro-mes">{quadro.mes}</span>
                  </span>
                  <span class="item-texto">
                    <strong>{e.titulo ?? e.cliente_nome ?? 'Evento'}</strong>
                    <span class="muted">
                      {quadro.semana}{e.hora_inicio && ` · ${e.hora_inicio}`}
                      {e.numero_convidados !== null && ` · ${e.numero_convidados} convidados`}
                    </span>
                  </span>
                  <span class="selo status-name"><span class="dot" style={`background:${e.cor}`}></span>{e.status_nome}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
      <div class="ver-mais">
        <Button variant="text" size="sm" href="/agenda">Abrir agenda <Icon name="chevron-right" size={15} /></Button>
      </div>
    </SectionCard>
    </div>
  </div>

  {pendentes > 0 && passosOcultos && (
    <form method="post" class="passos-reexibir">
      <Button type="submit" name="_action" value="mostrar_passos" variant="text" size="sm">Mostrar primeiros passos</Button>
    </form>
  )}
</AppLayout>

<style>
  .topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  /* Saudação: 24px (o h2 global é o título de página, 20px) */
  .topo h2 {
    font-size: var(--fs-24);
    line-height: 1.25;
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
    margin-bottom: var(--space-1);
  }

  .topo .intro {
    max-width: none;
  }

  .topo select {
    width: 200px;
  }

  /* ---------- Primeiros passos (SectionCard com as etapas em linhas) ---------- */
  .passos {
    margin-bottom: var(--space-5);
  }

  .passos-contagem {
    font-size: var(--fs-13);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin-right: var(--space-2);
  }

  .passos ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
  }

  .passos li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--clay-25);
    color: var(--terracotta-600);
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .passos li:hover {
    background: var(--bg-surface);
    border-color: var(--border-default);
  }

  .passos li.feito {
    color: var(--success);
  }

  .passos li a {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--fs-14);
    color: var(--text-body);
  }

  .passos li strong {
    color: var(--text-strong);
  }

  .passos li.feito strong {
    text-decoration: line-through;
    color: var(--text-secondary);
  }

  .passos li .muted {
    font-size: var(--fs-13);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .passos-reexibir {
    margin-top: var(--space-6);
    text-align: center;
  }

  /* ---------- KPIs (StatCard do design system) ---------- */
  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .kpi strong {
    font-size: var(--fs-28);
    line-height: 1.1;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-tight);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kpi strong.positivo {
    color: var(--sage-700);
  }

  .kpi strong.vazio {
    color: var(--clay-400);
  }

  .kpi .dica {
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  /* ---------- Cards ---------- */
  .grade {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  /* O espaço entre os cards de uma coluna vem do próprio SectionCard (margem entre irmãos) */
  .coluna {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .grade {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Descrição do card: logo abaixo do cabeçalho */


  .sem-itens {
    color: var(--text-secondary);
  }

  /* ---------- Funil por etapa (FunnelBreakdown) ---------- */
  .funil {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .funil li {
    display: grid;
    grid-template-columns: minmax(140px, 1.1fr) minmax(80px, 2fr) 40px minmax(110px, auto);
    align-items: center;
    gap: var(--space-4);
    font-size: var(--fs-14);
  }

  .funil-nome {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    color: var(--text-body);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .funil-nome:hover {
    color: var(--text-link);
  }

  .bolinha {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .barra {
    height: 6px;
    background: var(--chart-track);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .barra span {
    display: block;
    height: 100%;
    border-radius: inherit;
    transition: width var(--dur-slow) var(--ease-out);
  }

  .funil-num {
    text-align: right;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-heading);
  }

  .funil-valor {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--text-secondary);
  }

  /* ---------- Listas dos cards (AgendaItem): quadro de data + título/detalhe + situação ---------- */
  .lista {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .lista a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--clay-25);
    color: var(--text-body);
    font-size: var(--fs-14);
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .lista a:hover {
    background: var(--bg-surface);
    border-color: var(--border-default);
  }

  .quadro-data {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    height: 52px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    line-height: 1;
  }

  .quadro-dia {
    font-size: var(--fs-18);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-strong);
  }

  .quadro-mes {
    margin-top: 3px;
    font-size: var(--fs-11);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--terracotta-600);
  }

  .item-texto {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item-texto strong {
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-texto .muted {
    font-size: var(--fs-13);
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lista .selo {
    flex: none;
    font-size: var(--fs-13);
    color: var(--text-secondary);
  }

  .lista .selo.badge {
    font-size: var(--fs-12);
    color: var(--warning);
  }

  .lista .selo-valor {
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--text-heading);
  }

  .lista .selo-data {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .ver-mais {
    margin-top: 14px;
  }

  /* Celular: a barra do funil desce para a linha de baixo; a situação do item desce para baixo do texto */
  @media (max-width: 768px) {
    .topo {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }

    .topo select {
      width: 100%;
    }

    .passos-contagem {
      display: none;
    }

    .funil li {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas:
        'nome num valor'
        'barra barra barra';
      gap: var(--space-2) var(--space-3);
    }

    .funil-nome { grid-area: nome; }
    .funil li .barra { grid-area: barra; }
    .funil-num { grid-area: num; }
    .funil-valor { grid-area: valor; }

    .lista a {
      flex-wrap: wrap;
    }

    /* O texto ocupa a linha ao lado do quadro de data; a situação quebra para a linha de baixo */
    .item-texto {
      flex: 1 1 calc(100% - 48px - var(--space-3));
    }

    .item-texto strong,
    .item-texto .muted {
      white-space: normal;
    }

    .lista .quadro-data ~ .selo {
      margin-left: calc(48px + var(--space-3));
    }
  }
</style>

---
// Chamado de suporte: descrição, conversa com a equipe e nova mensagem.
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { handleFormPost } from '../../lib/actions';
import { dataHora } from '../../lib/datas';
import { userMessage } from '../../lib/forms';
import { setFlash } from '../../lib/flash';
import {
  CATEGORIAS,
  PRIORIDADES,
  carregarChamado,
  descricaoDoChamado,
  responderChamado,
  respostaSchema,
  type Categoria,
  type Chamado,
} from '../../server/suporte';

const user = Astro.locals.user;
const id = Astro.params.id!;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    await responderChamado(user, id, respostaSchema.parse(data));
    return 'Mensagem enviada.';
  });
}

let chamado: Chamado | null;
try {
  chamado = await carregarChamado(user, id);
} catch (err) {
  setFlash(Astro.cookies, 'error', userMessage(err));
  return Astro.redirect('/suporte');
}
if (!chamado) return new Response(null, { status: 404 });

const eventos = chamado.events ?? [];
const encerrado = Boolean(chamado.status_is_final);
---

<AppLayout title={`Chamado #${chamado.id}`} heading={`Chamado #${chamado.id}`} voltar={{ href: '/suporte', label: 'Suporte' }}>
  <section class="chamado-card">
    <header class="chamado-cabecalho">
      <h3 class="chamado-assunto">{chamado.subject}</h3>
      <span class:list={['badge', { 'badge-accent': !encerrado }]}>{chamado.status_name ?? 'Aberto'}</span>
    </header>
    <p class="chamado-meta">
      {CATEGORIAS[chamado.category as Categoria] ?? chamado.category ?? 'Sem tipo'} · Prioridade {PRIORIDADES[chamado.priority]?.toLowerCase() ?? chamado.priority} ·
      Aberto em {dataHora(chamado.created_at)}
    </p>
    <p class="chamado-texto">{descricaoDoChamado(chamado)}</p>
  </section>

  <section class="chamado-card">
    <h3 class="bloco-titulo"><Icon name="messages" size={18} /> Conversa</h3>
    {eventos.length === 0 ? (
      <p class="sem-respostas">Ainda sem respostas. Nossa equipe recebeu o chamado e responde por aqui.</p>
    ) : (
      <ol class="conversa">
        {eventos.map((e) =>
          e.event_type === 'status_change' ? (
            <li class="conversa-status">
              <Icon name="arrows-exchange" size={16} /> Situação alterada{e.new_value ? ` para ${e.new_value}` : ''} · {dataHora(e.created_at)}
            </li>
          ) : (
            <li class:list={['mensagem', e.author_type === 'support' ? 'mensagem-suporte' : 'mensagem-cliente']}>
              <p class="mensagem-autor">
                {e.author_type === 'support' ? `${e.author_name ?? 'Suporte'} · Suporte Banket` : (e.author_name ?? 'Você')}
                <span class="mensagem-quando">{dataHora(e.created_at)}</span>
              </p>
              <p class="chamado-texto">{e.content}</p>
            </li>
          )
        )}
      </ol>
    )}

    {encerrado ? (
      <p class="chamado-encerrado">Este chamado foi encerrado. Se precisar de mais ajuda, <a class="link" href="/suporte">abra um novo chamado</a>.</p>
    ) : (
      <form method="post" class="resposta-form">
        <div class="field">
          <label for="ch-mensagem">Nova mensagem<span class="obrigatorio">*</span></label>
          <textarea id="ch-mensagem" name="mensagem" rows="4" required maxlength="5000" placeholder="Escreva sua resposta ou complemente o chamado."></textarea>
        </div>
        <div class="resposta-acoes">
          <Button type="submit" variant="primary" data-carregando="Enviando…">Enviar mensagem</Button>
        </div>
      </form>
    )}
  </section>
</AppLayout>

<style>
  .chamado-card {
    max-width: 900px;
    padding: var(--space-6);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .chamado-card + .chamado-card {
    margin-top: var(--space-5);
  }

  .chamado-cabecalho {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .chamado-assunto {
    font-size: var(--fs-17);
    line-height: 1.35;
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .chamado-cabecalho .badge {
    flex: none;
    margin-top: 1px;
  }

  .chamado-meta {
    margin: var(--space-1-5) 0 var(--space-4);
    font-size: var(--fs-13);
    color: var(--text-muted);
  }

  .chamado-texto {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--text-body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .sem-respostas {
    color: var(--text-secondary);
  }

  .conversa {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* Mensagem da equipe à esquerda (argila); mensagem do cliente à direita (terracota claro) */
  .mensagem {
    max-width: 85%;
    align-self: flex-start;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--clay-25);
  }

  .mensagem-cliente {
    align-self: flex-end;
    border-color: var(--terracotta-100);
    background: var(--bg-accent-subtle);
  }

  .mensagem-autor {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2-5);
    margin-bottom: var(--space-1);
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .mensagem-quando {
    font-size: var(--fs-12);
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .conversa-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1-5);
    font-size: var(--fs-12);
    color: var(--text-muted);
  }

  .resposta-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .resposta-acoes {
    display: flex;
    justify-content: flex-end;
  }

  .chamado-encerrado {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .chamado-card {
      padding: var(--space-5) var(--space-4);
    }

    .mensagem {
      max-width: 100%;
    }
  }
</style>

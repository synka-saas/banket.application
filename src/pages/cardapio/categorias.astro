---
// Categorias de item do cardápio, junto do próprio cardápio (UX-052) — antes ficavam em Configurações.
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import Drawer from '../../components/ui/Drawer.astro';
import { withTenant } from '../../lib/db';
import { formId, handleFormPost } from '../../lib/actions';
import { html } from '../../lib/html';
import { CARDAPIO_SUBMENU } from '../../lib/nav';
import { searchTerm } from '../../lib/pagination';
import {
  TIPOS_CATEGORIA_ITEM,
  categoriaItemSchema,
  excluirCategoriaItem,
  listarCategoriasItem,
  salvarCategoriaItem,
} from '../../server/configuracoes';

const { tenantId } = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    const id = formId(data);
    if (data._action === 'delete' && id) {
      await withTenant(tenantId, (db) => excluirCategoriaItem(db, id));
      return 'Categoria removida.';
    }
    const input = categoriaItemSchema.parse(data);
    await withTenant(tenantId, (db) => salvarCategoriaItem(db, tenantId, id, input));
    return id ? 'Categoria atualizada.' : 'Categoria criada.';
  });
}

const busca = searchTerm(Astro.url);
const filtro = Astro.url.searchParams.get('filtro');
const categorias = await withTenant(tenantId, (db) => listarCategoriasItem(db, busca, filtro));

const tableData = categorias.map((c) => {
  const valores = JSON.stringify({ id: c.id, nome: c.nome, tipo: c.tipo });
  return {
    // Principal (tipo do item) em terracota; secundária (momento do serviço) neutra
    nome: html`<button type="button" class="tag ${c.tipo === 'principal' ? 'tag-accent' : ''} tag-botao" data-drawer-open="drawer-cat-item" data-values="${valores}">${c.nome}</button>`,
    tipo: html`<span class="muted">${TIPOS_CATEGORIA_ITEM[c.tipo]}</span>`,
    acoes: html`<form method="post" class="cell-actions">
        <input type="hidden" name="id" value="${c.id}" />
        <button type="button" class="row-action" data-drawer-open="drawer-cat-item" data-values="${valores}">Editar</button>
        <button type="submit" name="_action" value="delete" class="row-action danger" data-confirm="Excluir a categoria ${c.nome}?">Excluir</button>
      </form>`,
  };
});
---

<AppLayout title="Categorias de item" heading="Cardápios / Categorias" submenu={CARDAPIO_SUBMENU} submenuActive="categorias">
  <PageToolbar
    filter={{
      name: 'filtro',
      placeholder: 'Principal ou secundária',
      options: Object.entries(TIPOS_CATEGORIA_ITEM).map(([value, label]) => ({ value, label })),
    }}
  >
    <Button icon="circle-plus" data-drawer-open="drawer-cat-item">Nova categoria</Button>
  </PageToolbar>

  <Table
    columns={[
      { key: 'nome', label: 'Categoria' },
      { key: 'tipo', label: 'Aplica-se a' },
      { key: 'acoes', label: 'Ações', align: 'right' },
    ]}
    data={tableData}
    emptyMessage="Nenhuma categoria de item cadastrada."
  />
  <p class="intro ajuda">
    A <strong>categoria principal</strong> indica o tipo do item (Salgado, Doce, Bebida).
    A <strong>secundária</strong> indica o momento do serviço (Recepção, Entrada, Prato principal, Sobremesa).
    Itens com categoria principal "Bebida" aparecem na aba Bebidas do orçamento.
  </p>

  <Drawer slot="overlays" id="drawer-cat-item" formId="form-cat-item" title="Nova categoria de item" editTitle="Editar categoria" width="md">
    <form id="form-cat-item" method="post" class="form-grid">
      <input type="hidden" name="id" />
      <div class="field span-2">
        <label for="cati-nome">Nome da categoria<span class="obrigatorio">*</span></label>
        <input id="cati-nome" name="nome" required maxlength="80" placeholder="Ex.: Salgado, Entrada" />
      </div>
      <div class="field span-2">
        <label for="cati-tipo">Aplica-se a<span class="obrigatorio">*</span></label>
        <select id="cati-tipo" name="tipo" required>
          {Object.entries(TIPOS_CATEGORIA_ITEM).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>
    </form>
  </Drawer>
</AppLayout>

<style>
  .ajuda {
    margin-top: var(--space-4);
  }

  /* O nome abre a edição: tag do design system em um botão */
  :global(.tag-botao) {
    border: 0;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  :global(.tag-botao:hover) {
    background: var(--bg-muted);
    color: var(--text-strong);
  }

  :global(.tag-botao.tag-accent:hover) {
    background: var(--bg-accent-soft);
    color: var(--terracotta-900);
  }
</style>

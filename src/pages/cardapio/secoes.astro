---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';
import Pagination from '../../components/ui/Pagination.astro';
import PageToolbar from '../../components/ui/PageToolbar.astro';
import Drawer from '../../components/ui/Drawer.astro';
import { withTenant } from '../../lib/db';
import { formId, handleFormPost } from '../../lib/actions';
import { html } from '../../lib/html';
import { formatMoney, moneyInput } from '../../lib/money';
import { CARDAPIO_SUBMENU } from '../../lib/nav';
import { estaFiltrando, pageInfo, pageParams, searchTerm } from '../../lib/pagination';
import { UNIDADES_COBRANCA, excluirSecao, listarSecoes, salvarSecao, secaoSchema } from '../../server/cardapio';
import EstadoVazio from '../../components/ui/EstadoVazio.astro';

const { tenantId } = Astro.locals.user;

if (Astro.request.method === 'POST') {
  return handleFormPost(Astro, async (data) => {
    const id = formId(data);
    if (data._action === 'delete' && id) {
      await withTenant(tenantId, (db) => excluirSecao(db, id));
      return 'Seção removida.';
    }
    const input = secaoSchema.parse(data);
    await withTenant(tenantId, (db) => salvarSecao(db, tenantId, id, input));
    return id ? 'Seção atualizada.' : 'Seção criada.';
  });
}

const page = pageParams(Astro.url);
const { rows: secoes, total } = await withTenant(tenantId, (db) => listarSecoes(db, searchTerm(Astro.url), page));

const tableData = secoes.map((s) => ({
  _id: s.id,
  _nome: s.nome,
  nome: s.nome,
  descricao: s.descricao || '-',
  preco: s.preco === null ? '-' : `${formatMoney(s.preco)} ${UNIDADES_COBRANCA[s.unidade_cobranca]}`,
  itens: html`<a class="link" href="/cardapio/itens?secao=${s.id}">${s.itens}</a>`,
  opcoes: s.opcoes,
  acoes: html`<button type="button" class="row-action" data-drawer-open="drawer-secao" data-values="${JSON.stringify({
    id: s.id,
    nome: s.nome,
    descricao: s.descricao,
    preco: moneyInput(s.preco),
    unidade_cobranca: s.unidade_cobranca,
    ordem: s.ordem,
    _nome: s.nome,
    _itens: s.itens,
  })}">Editar</button>`,
}));
const filtrando = estaFiltrando(Astro.url);
---

<AppLayout title="Seções do cardápio" heading="Cardápios / Seções" submenu={CARDAPIO_SUBMENU} submenuActive="secoes">
  <PageToolbar>
    <Button icon="add_circle" data-drawer-open="drawer-secao">Nova seção</Button>
  </PageToolbar>

  <Table
    columns={[
      { key: 'nome', label: 'Seção', width: '26%' },
      { key: 'descricao', label: 'Descrição', width: '32%' },
      { key: 'preco', label: 'Preço' },
      { key: 'itens', label: 'Itens vinculados', align: 'center' },
      { key: 'opcoes', label: 'Em opções', align: 'center' },
      { key: 'acoes', label: 'Ações', align: 'right' },
    ]}
    data={tableData}
    reordenar="/api/cardapio/secoes/ordem"
  >
    <EstadoVazio slot="empty" icon="category" titulo={filtrando ? 'Nenhuma seção para esta busca' : 'Nenhuma seção cadastrada'} texto={filtrando ? undefined : 'Seções organizam o cardápio (ex.: Entradas, Pratos principais, Bebidas). Depois de criar uma seção, cadastre os itens dela.'}>
      {filtrando ? <a class="btn btn-outline btn-md" href={Astro.url.pathname}>Limpar busca</a> : <button type="button" class="btn btn-primary btn-md" data-drawer-open="drawer-secao">Nova seção</button>}
    </EstadoVazio>
    <Pagination slot="footer" info={pageInfo(page, total)} />
  </Table>

  <Drawer
    slot="overlays"
    id="drawer-secao"
    formId="form-secao"
    title="Nova seção"
    editTitle="Editar seção"
    width="md"
    deleteConfirm="Excluir esta seção?"
  >
    <form id="form-secao" method="post" class="form-grid">
      <input type="hidden" name="id" />
      <div class="field span-2">
        <label for="se-nome">Nome da seção<span class="obrigatorio">*</span></label>
        <input id="se-nome" name="nome" required maxlength="120" placeholder="Ex.: Saladas, Mesa de pães" />
      </div>
      <div class="field span-2">
        <label for="se-desc">Descrição</label>
        <textarea id="se-desc" name="descricao" maxlength="1000"></textarea>
      </div>
      <div class="field">
        <label for="se-preco">Preço da seção (R$)</label>
        <input id="se-preco" name="preco" inputmode="decimal" placeholder="Opcional" data-mascara="dinheiro" />
      </div>
      <div class="field">
        <label for="se-unidade">Cobrança</label>
        <select id="se-unidade" name="unidade_cobranca">
          {Object.entries(UNIDADES_COBRANCA).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>
      <p class="span-2 field-hint">
        Quando a seção tem preço (ex.: pacote de soft drinks por pessoa), ele é usado no orçamento no lugar da soma dos itens.
      </p>
      <div class="field">
        <label for="se-ordem">Ordem de exibição</label>
        <input id="se-ordem" name="ordem" type="number" min="0" />
      </div>
    </form>
  </Drawer>
</AppLayout>
<script>
  // A exclusão da seção leva os itens junto (ON DELETE CASCADE): o modal informa quantos
  document.addEventListener('drawer:open', (e) => {
    const drawer = e.target as HTMLElement;
    if (drawer.id !== 'drawer-secao') return;
    const { values } = (e as CustomEvent<{ values: Record<string, unknown> }>).detail;
    const excluir = drawer.querySelector<HTMLElement>('.drawer-delete');
    if (!excluir || !values.id) return;
    const itens = Number(values._itens ?? 0);
    excluir.dataset.confirm = `Excluir a seção "${values._nome}"?`;
    excluir.dataset.confirmTexto = itens
      ? `${itens} ${itens === 1 ? 'item cadastrado nela também será excluído' : 'itens cadastrados nela também serão excluídos'}. Esta ação não pode ser desfeita.`
      : 'A seção não tem itens.';
  });
</script>


---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import { withTenant } from '../../lib/db';
import { faixaHorario } from '../../lib/datas';
import { VARIANTES_STATUS } from '../../server/configuracoes';
import { reunioesNoPeriodo } from '../../server/reunioes';
import Icon from '../../components/ui/Icon.astro';
import {
  DIAS_CURTOS,
  MESES_NOME,
  agruparPorDia,
  dataValida,
  eventosNoPeriodo,
  gradeDoMes,
  hoje,
  semanaDe,
  somarDias,
} from '../../server/agenda';

// Agenda de eventos (calendário mensal/semanal). Parâmetros: data, visao (mes|semana), status (variante).
const { tenantId } = Astro.locals.user;
const params = Astro.url.searchParams;
const hojeIso = hoje();
const data = dataValida(params.get('data')) ?? hojeIso;
const visao = params.get('visao') === 'semana' ? 'semana' : 'mes';
const variante = params.get('status') && params.get('status')! in VARIANTES_STATUS ? params.get('status') : null;

const grade = gradeDoMes(data);
const dias = visao === 'semana' ? semanaDe(data) : grade.semanas.flat();
const { eventos, reunioes } = await withTenant(tenantId, async (db) => ({
  eventos: await eventosNoPeriodo(db, dias[0], dias[dias.length - 1], variante),
  reunioes: await reunioesNoPeriodo(db, dias[0], dias[dias.length - 1]),
}));
const porDia = agruparPorDia(eventos);
const reunioesPorDia = new Map<string, typeof reunioes>();
for (const r of reunioes) reunioesPorDia.set(r.data, [...(reunioesPorDia.get(r.data) ?? []), r]);
const linkReuniao = (r: (typeof reunioes)[number]) => (r.evento_id ? `/eventos/${r.evento_id}/reunioes` : '/reunioes');

const [ano, mes] = data.split('-').map(Number);
const mesVizinho = (delta: number) => {
  const d = new Date(Date.UTC(ano, mes - 1 + delta, 1));
  return d.toISOString().slice(0, 10);
};
const anterior = visao === 'semana' ? somarDias(data, -7) : mesVizinho(-1);
const proximo = visao === 'semana' ? somarDias(data, 7) : mesVizinho(1);

const link = (over: Record<string, string | null>) => {
  const p = new URLSearchParams({ data, visao, ...(variante ? { status: variante } : {}) });
  for (const [k, v] of Object.entries(over)) (v === null ? p.delete(k) : p.set(k, v));
  return `/agenda?${p}`;
};

const diaNum = (iso: string) => Number(iso.slice(8, 10));
const titulo =
  visao === 'semana'
    ? `${diaNum(dias[0])} ${MESES_NOME[Number(dias[0].slice(5, 7)) - 1].slice(0, 3).toLowerCase()} – ${diaNum(dias[6])} ${MESES_NOME[Number(dias[6].slice(5, 7)) - 1].slice(0, 3).toLowerCase()} ${dias[6].slice(0, 4)}`
    : `${MESES_NOME[grade.mes - 1]} ${grade.ano}`;
const MAX_NO_DIA = 3;
---

<AppLayout title="Agenda" heading="Agenda">
  <div class="agenda-topo">
    <div class="navegacao">
      <div class="navegacao-botoes">
        <Button variant="secondary" size="sm" href={link({ data: anterior })} aria-label="Anterior" icon="chevron-left" />
        <Button variant="secondary" size="sm" href={link({ data: hojeIso })}>Hoje</Button>
        <Button variant="secondary" size="sm" href={link({ data: proximo })} aria-label="Próximo" icon="chevron-right" />
      </div>
      <h2>{titulo}</h2>
    </div>
    <div class="filtros">
      <form method="get" class="filtro-status">
        <input type="hidden" name="data" value={data} />
        <input type="hidden" name="visao" value={visao} />
        <select name="status" class="control" aria-label="Filtrar por status" data-autosubmit-row>
          <option value="">Todos os status</option>
          {Object.entries(VARIANTES_STATUS).map(([v, l]) => <option value={v} selected={v === variante}>{l}</option>)}
        </select>
      </form>
      <div class="alternar segmented" role="group" aria-label="Visualização">
        <a href={link({ visao: 'mes' })} class:list={{ ativo: visao === 'mes', active: visao === 'mes' }}>Mês</a>
        <a href={link({ visao: 'semana' })} class:list={{ ativo: visao === 'semana', active: visao === 'semana' }}>Semana</a>
      </div>
      <Button variant="secondary" size="sm" href="/reunioes" icon="video">Reuniões</Button>
    </div>
  </div>

  {visao === 'mes' ? (
    <div class="mes">
      {DIAS_CURTOS.map((d) => <div class="cabecalho-dia">{d}</div>)}
      {dias.map((dia) => {
        const lista = porDia.get(dia) ?? [];
        return (
          <div class:list={['dia', { fora: Number(dia.slice(5, 7)) !== grade.mes, hoje: dia === hojeIso }]}>
            <a class="numero" href={link({ data: dia, visao: 'semana' })}>{diaNum(dia)}</a>
            {lista.slice(0, MAX_NO_DIA).map((e) => (
              <a class="evento" href={`/eventos/${e.id}`} style={`--cor:${e.cor}`} title={`${e.titulo ?? ''} · ${e.status_nome}`}>
                {e.hora_inicio && <b>{e.hora_inicio}</b>}
                <span class="evento-titulo">{e.titulo ?? e.cliente_nome ?? 'Evento'}</span>
              </a>
            ))}
            {lista.length > MAX_NO_DIA && (
              <a class="mais" href={link({ data: dia, visao: 'semana' })}>+{lista.length - MAX_NO_DIA} mais</a>
            )}
            {(reunioesPorDia.get(dia) ?? []).map((r) => (
              <a class="evento reuniao" href={linkReuniao(r)} title={`Reunião · ${r.titulo}`}>
                <b>{r.hora}</b>
                <span class="evento-titulo">{r.titulo}</span>
              </a>
            ))}
          </div>
        );
      })}
    </div>
  ) : (
    <div class="semana">
      {dias.map((dia, i) => {
        const lista = porDia.get(dia) ?? [];
        return (
          <section class:list={['coluna', { hoje: dia === hojeIso }]}>
            <header>
              <span>{DIAS_CURTOS[i]}</span>
              <strong>{diaNum(dia)}</strong>
            </header>
            {lista.length === 0 && (reunioesPorDia.get(dia) ?? []).length === 0 && <p class="vazio">—</p>}
            {(reunioesPorDia.get(dia) ?? []).map((r) => (
              <a class="cartao cartao-reuniao" href={linkReuniao(r)}>
                <span class="status"><Icon name="video" size={14} /> Reunião</span>
                <strong>{r.titulo}</strong>
                {(r.evento_titulo ?? r.cliente_nome) && <span>{r.evento_titulo ?? r.cliente_nome}</span>}
                <span class="muted">{r.hora} às {r.hora_fim}</span>
                {r.meet_link && <a class="link" href={r.meet_link} target="_blank" rel="noopener">Entrar no Meet</a>}
              </a>
            ))}
            {lista.map((e) => (
              <a class="cartao" href={`/eventos/${e.id}`}>
                <span class="status"><span class="dot" style={`background:${e.cor}`}></span>{e.status_nome}</span>
                <strong>{e.titulo ?? 'Evento'}</strong>
                {e.cliente_nome && <span>{e.cliente_nome}</span>}
                <span class="muted">{faixaHorario(e.hora_inicio, e.hora_fim)}</span>
                {e.numero_convidados !== null && <span class="muted">{e.numero_convidados} convidados</span>}
                {e.local_nome && <span class="muted">{e.local_nome}</span>}
              </a>
            ))}
          </section>
        );
      })}
    </div>
  )}

  <p class="rodape">
    {eventos.length === 0
      ? 'Nenhum evento com data neste período.'
      : `${eventos.length} evento${eventos.length === 1 ? '' : 's'} no período.`}{' '}
    {reunioes.length > 0 && `${reunioes.length} ${reunioes.length === 1 ? 'reunião' : 'reuniões'}. `}
    Eventos sem data definida não aparecem na agenda.
  </p>
</AppLayout>

<style>
  .agenda-topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .navegacao,
  .filtros {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .navegacao-botoes {
    display: flex;
    gap: var(--space-1-5);
  }

  /* Anterior/Próximo: botão de ícone quadrado (IconButton sm do design system) */
  .navegacao-botoes :global(.btn[aria-label]) {
    width: var(--control-h-sm);
    padding: 0;
  }

  .navegacao h2 {
    font-size: var(--fs-20);
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
  }

  .filtro-status select {
    width: 200px;
  }

  .alternar {
    margin-bottom: 0;
  }

  /* ---------- Mês (CalendarMonth) ---------- */
  .mes {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .cabecalho-dia {
    padding: var(--space-2-5) var(--space-3);
    font-size: var(--fs-11);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--clay-25);
    border-bottom: 1px solid var(--border-default);
  }

  .dia {
    min-height: 112px;
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    min-width: 0;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .dia:nth-child(7n) {
    border-right: 0;
  }

  .dia:nth-last-child(-n + 7) {
    border-bottom: 0;
  }

  .dia:hover {
    background: var(--clay-25);
  }

  .dia.fora {
    background: var(--bg-app);
  }

  .dia.fora .numero {
    color: var(--clay-400);
  }

  .numero {
    align-self: flex-start;
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-13);
    font-variant-numeric: tabular-nums;
    border-radius: 50%;
    color: var(--text-heading);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .numero:hover {
    background: var(--bg-subtle);
  }

  .dia.hoje .numero {
    background: var(--terracotta-500);
    color: var(--text-on-accent);
    font-weight: var(--fw-medium);
  }

  /* Evento do dia: barra vertical na cor da etapa (vem do banco) + hora + título */
  .evento {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    height: 24px;
    padding: 0 var(--space-2) 0 var(--space-1-5);
    font-size: var(--fs-12);
    white-space: nowrap;
    overflow: hidden;
    min-width: 0;
    background: var(--terracotta-50);
    border-radius: var(--radius-sm);
    color: var(--terracotta-900);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .evento::before {
    content: '';
    flex: none;
    width: 3px;
    height: 14px;
    border-radius: 2px;
    background: var(--cor, var(--stage-negotiation));
  }

  .evento:hover {
    background: var(--terracotta-100);
  }

  /* Reunião: tom cobalto, para distinguir dos eventos */
  .evento.reuniao {
    background: var(--cobalt-50);
    color: var(--cobalt-700);
  }

  .evento.reuniao::before {
    background: var(--cobalt-500, var(--info));
  }

  .evento.reuniao:hover {
    background: var(--cobalt-100);
  }

  .cartao-reuniao {
    border-color: var(--cobalt-100);
  }

  .cartao-reuniao .status {
    color: var(--cobalt-700);
  }

  .evento b {
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
  }

  .evento-titulo {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mais {
    font-size: var(--fs-12);
    color: var(--text-link);
    padding-left: var(--space-1-5);
  }

  .mais:hover {
    color: var(--text-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* ---------- Semana ---------- */
  .semana {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .coluna {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .coluna header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .coluna header span {
    font-size: var(--fs-11);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .coluna header strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    font-size: var(--fs-16);
    font-variant-numeric: tabular-nums;
    border-radius: 50%;
    color: var(--text-strong);
  }

  .coluna.hoje header strong {
    background: var(--terracotta-500);
    color: var(--text-on-accent);
  }

  .cartao {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    font-size: var(--fs-13);
    line-height: 1.45;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    color: var(--text-body);
    overflow-wrap: anywhere;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .cartao:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .cartao strong {
    font-size: var(--fs-14);
    color: var(--text-strong);
  }

  .cartao .status {
    display: flex;
    align-items: center;
    gap: var(--space-1-5);
    margin-bottom: 2px;
    font-size: var(--fs-12);
    color: var(--text-secondary);
  }

  .cartao .muted {
    color: var(--text-secondary);
  }

  .coluna .vazio {
    padding: var(--space-2) 0;
    text-align: center;
  }

  .rodape {
    margin-top: 14px;
    font-size: var(--fs-13);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .semana {
      grid-template-columns: minmax(0, 1fr);
    }

    .coluna header {
      justify-content: flex-start;
    }
  }

  /* Celular: filtros na largura toda e células do mês mais compactas */
  @media (max-width: 768px) {
    .filtros {
      width: 100%;
    }

    .filtro-status {
      flex: 1;
      min-width: 0;
    }

    .filtro-status select {
      width: 100%;
    }

    .alternar {
      flex: none;
    }

    .cabecalho-dia {
      padding: var(--space-2) 0;
      text-align: center;
      letter-spacing: var(--ls-wide);
    }

    .dia {
      min-height: 88px;
      padding: var(--space-1);
    }

    .numero {
      align-self: center;
    }

    .evento {
      gap: var(--space-1);
      padding: 0 var(--space-1);
    }

    .evento-titulo {
      display: none;
    }
  }
</style>

---
// Página de erro 500: não expõe detalhes técnicos (eles ficam no log do servidor).
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<Layout title="Erro inesperado">
  <main class="nao-encontrado">
    <img class="logo" src="/logo-dark.png" alt="Banket" />
    <div class="cartao">
      <span class="cartao-icone"><Icon name="alert-triangle" size={26} /></span>
      <h1>Algo deu errado</h1>
      <p>Ocorreu um erro inesperado ao carregar esta página. Tente novamente em instantes; se persistir, fale com o suporte.</p>
      <div class="cartao-acoes">
        <Button href="/dashboard">Voltar ao início</Button>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nao-encontrado {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .logo {
    height: 36px;
  }

  /* Card central (mesmo padrão do estado vazio: ícone em quadro, título e orientação) */
  .cartao {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 440px;
    padding: var(--space-10) var(--space-8);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .cartao-icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--danger-bg);
    color: var(--danger);
  }

  h1 {
    font-size: var(--fs-20);
    line-height: 1.3;
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
  }

  .cartao > p {
    max-width: 44ch;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .cartao-acoes {
    margin-top: var(--space-4);
  }

  @media (max-width: 768px) {
    .cartao {
      padding: var(--space-8) var(--space-5);
    }
  }
</style>

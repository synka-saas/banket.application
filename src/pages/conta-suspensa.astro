---
// Empresa suspensa ou cancelada pelo Manager Hwesta (kill-switch): o middleware traz para cá qualquer
// página da empresa atual. Quem pertence a outra empresa pode trocar; os demais só conseguem sair.
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { getMembership } from '../lib/membership';
import { empresasDoUsuario } from '../server/autoatendimento';

const user = Astro.locals.user;
const [membership, empresas] = await Promise.all([getMembership(user.id, user.tenantId), empresasDoUsuario(user.id)]);
const atual = empresas.find((e) => e.id === user.tenantId);
const outras = empresas.filter((e) => e.id !== user.tenantId);
const cancelada = membership?.tenantStatus === 'canceled';
---

<Layout title={cancelada ? 'Conta encerrada' : 'Conta suspensa'}>
  <main class="suspensa">
    <img class="logo" src="/logo-dark.png" alt="Banket" />
    <div class="cartao">
      <span class="cartao-icone"><Icon name={cancelada ? 'ban' : 'lock'} size={26} /></span>
      <h1>{cancelada ? 'Conta encerrada' : 'Acesso suspenso'}</h1>
      <p>
        {cancelada
          ? `A conta${atual ? ` de ${atual.nome}` : ''} no Banket foi encerrada.`
          : `O acesso${atual ? ` de ${atual.nome}` : ''} ao Banket está temporariamente suspenso.`}
        {' '}Para regularizar ou tirar dúvidas, fale com a gente em{' '}
        <a class="link" href="mailto:contato@banket.com.br">contato@banket.com.br</a>.
      </p>

      {outras.length > 0 && (
        <div class="outras">
          <p class="outras-rotulo">Entrar em outra empresa</p>
          {outras.map((e) => (
            <form method="post" action="/api/sessao/empresa">
              <input type="hidden" name="tenant_id" value={e.id} />
              <button type="submit" class="btn btn-secondary btn-md btn-block">
                <Icon name="building" size={16} stroke={1.75} class="btn-icon" /> {e.nome}
              </button>
            </form>
          ))}
        </div>
      )}

      <div class="cartao-acoes">
        <Button variant="text" href="/auth/logout" icon="logout">Sair</Button>
      </div>
    </div>
  </main>
</Layout>

<style>
  .suspensa {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .logo {
    height: 36px;
  }

  /* Card central (mesmo padrão do estado vazio: ícone em quadro, título e orientação) */
  .cartao {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 480px;
    padding: var(--space-10) var(--space-8);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .cartao-icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--warning-bg);
    color: var(--warning);
  }

  h1 {
    font-size: var(--fs-20);
    line-height: 1.3;
    letter-spacing: var(--ls-snug);
    color: var(--text-strong);
  }

  .cartao > p {
    max-width: 44ch;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .outras {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 320px;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  .outras-rotulo {
    margin-bottom: var(--space-1);
    font-size: var(--fs-13);
    font-weight: var(--fw-medium);
    color: var(--text-heading);
  }

  .cartao-acoes {
    margin-top: var(--space-5);
  }

  @media (max-width: 768px) {
    .cartao {
      padding: var(--space-8) var(--space-5);
    }
  }
</style>
